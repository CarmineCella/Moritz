; 05-spectrum.moritz - tutorial 5: the spectrum. A sound is a sum of
; partials (frequencies); the spectroscope shows them. A phase vocoder
; (sparkle~) works on them frame by frame, so speed and pitch become
; independent; the spectral envelope (the formants) is the sound's colour,
; and can be given to another sound (impose~).
(patch
  (obj title comment "Tutorial 5 · The spectrum: partials, time, pitch and colour" (pos 20 12))
  (obj s1 comment "1. A sine has one partial, a sawtooth many (all multiples of its frequency), noise all at once. Look at the spectroscope." (pos 20 40))
  (obj k1 message 1 (pos 20 65))
  (obj k2 message 2 (pos 60 65))
  (obj k3 message 3 (pos 100 65))
  (obj k4 message 4 (pos 140 65))
  (obj ck comment "1 sine, 2 sawtooth, 3 noise, 4 the voice through sparkle~ (below)" (pos 180 66))
  (obj sn cycle~ 220 (pos 20 100))
  (obj sw saw~ 220 (pos 110 100))
  (obj nz noise~ (pos 200 100))
  (obj nzg *~ 0.3 (pos 200 130))
  (obj s2 comment "2. sparkle~ plays a voice through a phase vocoder: the speed changes the duration only, the pitch only the pitch." (pos 20 175))
  (obj s3 comment "   Speed 0 freezes the sound; negative plays it backwards. Keep the formants to transpose a voice without a chipmunk effect." (pos 20 193))
  (obj b buffer~ t5vox ../examples/sounds/Vox.wav (pos 20 220))
  (obj pl message "loop 1, start" (pos 340 220))
  (obj cspd comment "speed" (pos 20 255))
  (obj spd slider -1. 2. (pos 20 275))
  (obj cst comment "pitch (semitones)" (pos 180 255))
  (obj st slider -12 12 (pos 180 275))
  (obj ratio expr "pow(2, $f1 / 12.)" (pos 180 310))
  (obj kf toggle (pos 340 275))
  (obj ckf comment "keep the formants" (pos 370 278))
  (obj env expr "$i1 * 60" (pos 340 310))
  (obj envm message "envelope $1" (pos 340 345))
  (obj sp sparkle~ t5vox (pos 20 385))
  (obj s4 comment "3. The colour of a sound is its spectral envelope. impose~ gives the voice's colour to an orchestra: it speaks." (pos 20 430))
  (obj bb buffer~ t5beet ../examples/sounds/Beethoven_Symph7.wav (pos 20 455))
  (obj pb message "loop 1, start 36000" (pos 360 455))
  (obj beet sparkle~ t5beet (pos 360 490))
  (obj imp impose~ 60 (pos 20 530))
  (obj k5 message 5 (pos 400 530))
  (obj ck5 comment "5: the speaking orchestra" (pos 440 531))
  (obj pick selector~ 5 1 (pos 20 575))
  (obj on message "0.4 50" (pos 220 575))
  (obj off message "0 50" (pos 290 575))
  (obj cvol comment "volume" (pos 350 576))
  (obj ramp line~ (pos 220 610))
  (obj vca *~ (pos 20 610))
  (obj out dac~ (pos 20 650))
  (obj spec spectroscope~ 400 110 (pos 520 560))
  (obj lb loadbang (pos 780 250))
  (obj i1 message 1 (pos 780 280))
  (obj i0 message 0 (pos 820 280))
  (obj next comment "Next: tutorial 6, grains. Examples: pitch-shift, sparkle-cross, spectral-envelope, pvoc (Help > Browser)." (pos 20 700))
  (connect k1 0 pick 0)
  (connect k2 0 pick 0)
  (connect k3 0 pick 0)
  (connect k4 0 pick 0)
  (connect k5 0 pick 0)
  (connect sn 0 pick 1)
  (connect sw 0 pick 2)
  (connect nz 0 nzg 0)
  (connect nzg 0 pick 3)
  (connect pl 0 sp 0)
  (connect spd 0 sp 0)
  (connect st 0 ratio 0)
  (connect ratio 0 sp 1)
  (connect kf 0 env 0)
  (connect env 0 envm 0)
  (connect envm 0 sp 0)
  (connect sp 0 pick 4)
  (connect pb 0 beet 0)
  (connect sp 0 imp 0)
  (connect beet 0 imp 1)
  (connect imp 0 pick 5)
  (connect pick 0 vca 0)
  (connect pick 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 i1 0)
  (connect lb 0 i0 0)
  (connect i1 0 spd 0)
  (connect i0 0 st 0)
  (connect lb 0 pl 0)
  (connect lb 0 pb 0))
