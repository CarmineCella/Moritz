; 09-analysis.moritz - tutorial 9: listening machines. A sound becomes a
; picture (a spectrogram), then numbers a musician understands: where the
; notes begin (onsets), the pulse (tempo, beats), the harmony (chroma, key)
; and the form (self-similarity, novelty). The analyses work on a buffer~ in
; the background and write their results into other buffer~s, which plot
; draws; their live versions follow a signal as it plays.
(patch
  (obj title comment "Tutorial 9 · Listening machines: analysis and music information retrieval" (pos 20 12))
  (obj s1 comment "1. A sound as a picture. A spectrogram shows time left to right, frequency bottom to top, loudness as colour. Every partial of every" (pos 20 40))
  (obj s1b comment "   note is a line; the mel spectrogram groups them in bands as the ear does. Double-click a plot to zoom in and read its values." (pos 20 58))
  (obj b1 buffer~ t9bach ../data/Bach_Prelude_Dmajor.flac (pos 20 85))
  (obj bsp buffer~ t9spec (pos 20 115))
  (obj lb1 loadbang (pos 20 145))
  (obj r1 message "maxfreq 4000, run t9bach t9spec" (pos 20 175))
  (obj sp spectrogram (pos 20 205))
  (obj c1 comment "D major prelude: the" (pos 20 235))
  (obj c1b comment "left hand's bass notes" (pos 20 251))
  (obj c1c comment "are the low lines" (pos 20 267))
  (obj l1 loadbang (pos 200 205))
  (obj g1 message "range -90 -20, xrange 0 20" (pos 200 235))
  (obj p1 plot t9spec 560 110 (pos 400 85))
  (obj s2 comment "2. Where the notes begin. onsets finds the moments where the spectrum suddenly grows: each is the start of a note or a hit." (pos 20 300))
  (obj s2b comment "   segment k gives the k-th piece between two onsets: click a number to hear one note of the prelude (or press it repeatedly)." (pos 20 318))
  (obj lb2 loadbang (pos 20 345))
  (obj r2 message "run t9bach" (pos 20 375))
  (obj on onsets (pos 20 405))
  (obj nn number (pos 130 440))
  (obj cnn comment "notes" (pos 190 441))
  (obj k number (pos 20 440))
  (obj seg message "segment $1" (pos 20 470))
  (obj pl message "start $1 $2" (pos 20 525))
  (obj l2 loadbang (pos 200 405))
  (obj g2 message "xrange 0 20, title the first 20 seconds and their onsets" (pos 200 470))
  (obj p2 plot t9bach 560 90 (pos 400 345))
  (obj play play~ t9bach (pos 20 560))
  (obj v2 *~ 0.4 (pos 130 560))
  (obj o2 dac~ (pos 200 560))
  (obj s3 comment "3. The pulse. beats measures how regularly the onsets come back: the tempo whose period repeats best, then the beats themselves." (pos 20 610))
  (obj s3b comment "   A march has a strong pulse; listen to it with the click track beats wrote. (The tempo prior: see beats' help, with Beethoven.)" (pos 20 628))
  (obj b3 buffer~ t9march ../data/Sousa_StarsAndStripes.flac (pos 20 655))
  (obj bck buffer~ t9click (pos 400 655))
  (obj lb3 loadbang (pos 20 685))
  (obj r3 message "run t9march" (pos 20 715))
  (obj bt beats (pos 20 745))
  (obj bpm flonum (pos 20 780))
  (obj cbpm comment "bpm" (pos 85 781))
  (obj once counter 0 1000 (pos 150 745))
  (obj first sel 0 (pos 150 775))
  (obj ck message "clicks t9click" (pos 150 805))
  (obj go message start (pos 400 690))
  (obj st message stop (pos 455 690))
  (obj pm play~ t9march (pos 400 720))
  (obj pk play~ t9click (pos 520 720))
  (obj v3 *~ 0.4 (pos 400 760))
  (obj o3 dac~ (pos 400 795))
  (obj s4 comment "4. Harmony. chroma counts how much of each of the 12 pitch classes sounds; keyfind compares that profile with every key's." (pos 20 850))
  (obj s4b comment "   The march is in E-flat; its trio (from 72 s) moves to A-flat; the C minor prelude shares its notes with E-flat major, yet sounds minor." (pos 20 868))
  (obj b5 buffer~ t9cmin ../data/Bach_Prelude_Cminor.flac (pos 20 895))
  (obj k1 message "run t9march" (pos 20 925))
  (obj k2 message "run t9march 72000 128000" (pos 115 925))
  (obj k3 message "run t9cmin" (pos 290 925))
  (obj kf keyfind (pos 20 960))
  (obj pre prepend set (pos 20 995))
  (obj key message "" (pos 20 1025))
  (obj l4 loadbang (pos 200 960))
  (obj g4 message "labels chroma" (pos 200 990))
  (obj p4 plot 360 110 bars (pos 400 900))
  (obj s5 comment "5. Form. Compare every moment's chroma with every other (similarity): repeats appear as squares and stripes, and the novelty curve" (pos 20 1065))
  (obj s5b comment "   peaks where the music changes. The full analysis of the march, with its sections and their keys, is in examples/09-analysis-and-mir/mir-structure.moritz." (pos 20 1083))
  (obj s6 comment "6. Live. melbands~, mfcc~, chroma~ and onset~ do the same on a signal as it plays: see examples/09-analysis-and-mir/mir-live.moritz, with your microphone." (pos 20 1110))
  (obj s7 comment "Machines listen differently: they hear partials as notes (a fifth's worth of overtones can tip a key), need enough music to judge, and know no style." (pos 20 1140))
  (obj s7b comment "Their errors are worth listening to: they show what a musician infers without noticing." (pos 20 1158))
  (connect lb1 0 r1 0)
  (connect r1 0 sp 0)
  (connect l1 0 g1 0)
  (connect g1 0 p1 0)
  (connect lb2 0 r2 0)
  (connect r2 0 on 0)
  (connect on 4 nn 0)
  (connect on 2 p2 1)
  (connect k 0 seg 0)
  (connect seg 0 on 0)
  (connect on 3 pl 0)
  (connect pl 0 play 0)
  (connect l2 0 g2 0)
  (connect g2 0 p2 0)
  (connect lb3 0 r3 0)
  (connect r3 0 bt 0)
  (connect bt 2 bpm 0)
  (connect bt 1 once 0)
  (connect once 0 first 0)
  (connect first 0 ck 0)
  (connect ck 0 bt 0)
  (connect go 0 pm 0)
  (connect go 0 pk 0)
  (connect st 0 pm 0)
  (connect st 0 pk 0)
  (connect k1 0 kf 0)
  (connect k2 0 kf 0)
  (connect k3 0 kf 0)
  (connect kf 2 pre 0)
  (connect pre 0 key 0)
  (connect kf 4 p4 0)
  (connect l4 0 g4 0)
  (connect g4 0 p4 0)
  (connect play 0 v2 0)
  (connect v2 0 o2 0)
  (connect v2 0 o2 1)
  (connect pm 0 v3 0)
  (connect pk 0 v3 0)
  (connect v3 0 o3 0)
  (connect v3 0 o3 1))
