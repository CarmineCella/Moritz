; 07-space.moritz - tutorial 7: sound in space. Two ears hear a sound from
; the left louder and earlier on the left; the outer ear colours it by
; direction, which tells up from down. On headphones, hrtf~ reproduces all
; of this from measurements of a dummy head; ambisonics (ambienc~,
; binaural~, ambidec~) describes a whole sound field, for headphones or
; loudspeakers.
(patch
  (obj title comment "Tutorial 7 · Sound in space" (pos 20 12))
  (obj t1 comment "Use headphones. Turn the audio on, then the volume, and start the bursts (broadband sounds are the easiest to place)." (pos 20 40))
  (obj tog toggle (pos 20 70))
  (obj ctog comment "noise bursts" (pos 50 73))
  (obj met metro 220 (pos 20 100))
  (obj burst message "0.25, 0 120" (pos 20 130))
  (obj env line~ (pos 20 160))
  (obj nz noise~ (pos 130 130))
  (obj src *~ (pos 130 160))
  (obj s1 comment "1. Stereo: only the levels of the two channels change. The sound moves between the ears, inside the head." (pos 20 200))
  (obj cpan comment "pan: 0 left, 1 right" (pos 20 220))
  (obj pan slider 0. 1. (pos 20 240))
  (obj pr expr "sqrt($f1)" (pos 180 240))
  (obj pl expr "sqrt(1 - $f1)" (pos 280 240))
  (obj gl *~ (pos 130 280))
  (obj gr *~ (pos 230 280))
  (obj s2 comment "2. hrtf~: the sound filtered as a head and two ears would hear it from that direction. It comes from outside the head," (pos 20 325))
  (obj s3 comment "   all around: in front, behind (180), above (elevation 60). Up/down and front/back are less sure than left/right for most people." (pos 20 343))
  (obj caz comment "azimuth (90 left, -90 right, 180 behind)" (pos 20 370))
  (obj az slider -180 180 (pos 20 390))
  (obj cel comment "elevation (up)" (pos 300 370))
  (obj el slider -40 90 (pos 300 390))
  (obj hr hrtf~ (pos 130 430))
  (obj s4 comment "3. Ambisonics: the direction is encoded in a sound field (9 channels at order 2), decoded here for headphones. Same sliders." (pos 20 475))
  (obj enc ambienc~ 2 (pos 130 500))
  (obj bin binaural~ 2 (pos 130 540))
  (obj bg *~ 0.45 (pos 130 580))
  (obj bg2 *~ 0.45 (pos 330 580))
  (obj k1 message 1 (pos 520 220))
  (obj k2 message 2 (pos 560 220))
  (obj k3 message 3 (pos 600 220))
  (obj ck comment "1 stereo, 2 hrtf~, 3 ambisonics" (pos 640 221))
  (obj selL selector~ 3 1 (pos 520 620))
  (obj selR selector~ 3 1 (pos 640 620))
  (obj on message "0.6 50" (pos 760 620))
  (obj off message "0 50" (pos 830 620))
  (obj cvol comment "volume" (pos 890 621))
  (obj ramp line~ (pos 760 655))
  (obj vl *~ (pos 520 655))
  (obj vr *~ (pos 640 655))
  (obj out dac~ (pos 520 695))
  (obj lb loadbang (pos 800 70))
  (obj half message 0.5 (pos 800 100))
  (obj zero message 0 (pos 860 100))
  (obj next comment "Next: tutorial 8, separating sounds. Examples: hrtf, binaural, ambisonics, ambisonics-order2 (Help > Browser)." (pos 20 740))
  (connect tog 0 met 0)
  (connect met 0 burst 0)
  (connect burst 0 env 0)
  (connect nz 0 src 0)
  (connect env 0 src 1)
  (connect pan 0 pr 0)
  (connect pan 0 pl 0)
  (connect src 0 gl 0)
  (connect src 0 gr 0)
  (connect pl 0 gl 1)
  (connect pr 0 gr 1)
  (connect src 0 hr 0)
  (connect az 0 hr 1)
  (connect el 0 hr 2)
  (connect src 0 enc 0)
  (connect az 0 enc 1)
  (connect el 0 enc 2)
  (connect enc 0 bin 0)
  (connect enc 1 bin 1)
  (connect enc 2 bin 2)
  (connect enc 3 bin 3)
  (connect enc 4 bin 4)
  (connect enc 5 bin 5)
  (connect enc 6 bin 6)
  (connect enc 7 bin 7)
  (connect enc 8 bin 8)
  (connect bin 0 bg 0)
  (connect bin 1 bg2 0)
  (connect k1 0 selL 0)
  (connect k1 0 selR 0)
  (connect k2 0 selL 0)
  (connect k2 0 selR 0)
  (connect k3 0 selL 0)
  (connect k3 0 selR 0)
  (connect gl 0 selL 1)
  (connect gr 0 selR 1)
  (connect hr 0 selL 2)
  (connect hr 1 selR 2)
  (connect bg 0 selL 3)
  (connect bg2 0 selR 3)
  (connect selL 0 vl 0)
  (connect selR 0 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect lb 0 half 0)
  (connect lb 0 zero 0)
  (connect half 0 pan 0)
  (connect zero 0 az 0)
  (connect zero 0 el 0))
