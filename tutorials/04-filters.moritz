; 04-filters.moritz - tutorial 4: filters. A filter changes the balance of
; frequencies in a sound: a low-pass keeps the lows, a high-pass the highs,
; a band-pass a band around a centre; resonance (Q) narrows it.
(patch
  (obj title comment "Tutorial 4 · Filters" (pos 20 12))
  (obj t1 comment "Noise contains every frequency at once: a good sound to hear what a filter keeps. Turn the audio on, then the volume." (pos 20 40))
  (obj s1 comment "1. lores~: a resonant low-pass. Drag the cutoff; raise the resonance and hear the peak at the cutoff." (pos 20 75))
  (obj nz noise~ (pos 20 100))
  (obj ccut comment "cutoff (Hz)" (pos 150 100))
  (obj cut slider 100 8000 (pos 150 120))
  (obj cres comment "resonance (0-0.99)" (pos 320 100))
  (obj res slider 0. 0.99 (pos 320 120))
  (obj lp lores~ 1000 0.5 (pos 20 160))
  (obj s2 comment "2. filterdesign gives the coefficients of eight classic shapes for biquad~; filterplot draws what the filter does." (pos 20 205))
  (obj s3 comment "   Choose a shape, move the frequency and Q (and the gain, for peak and shelves). The plot is the filter's frequency response." (pos 20 223))
  (obj ty1 message lowpass (pos 20 250))
  (obj ty2 message highpass (pos 90 250))
  (obj ty3 message bandpass (pos 165 250))
  (obj ty4 message notch (pos 245 250))
  (obj ty5 message peak (pos 300 250))
  (obj cf comment "frequency" (pos 20 285))
  (obj f slider 50 10000 (pos 20 305))
  (obj cq comment "Q" (pos 180 285))
  (obj q slider 0.3 15 (pos 180 305))
  (obj cg comment "gain (dB)" (pos 340 285))
  (obj g slider -24 24 (pos 340 305))
  (obj fd filterdesign bandpass 1000 2 0 (pos 20 345))
  (obj plot filterplot 360 140 (pos 500 250))
  (obj bq biquad~ (pos 20 385))
  (obj s4 comment "3. Listen: 1 the lores~, 2 the designed filter, 3 the noise unfiltered." (pos 20 430))
  (obj k0 message 3 (pos 20 455))
  (obj k1 message 1 (pos 60 455))
  (obj k2 message 2 (pos 100 455))
  (obj ck comment "3 = unfiltered" (pos 140 456))
  (obj pick selector~ 3 1 (pos 20 490))
  (obj on message "0.15 50" (pos 220 490))
  (obj off message "0 50" (pos 290 490))
  (obj cvol comment "volume" (pos 350 491))
  (obj ramp line~ (pos 220 525))
  (obj vca *~ (pos 20 525))
  (obj out dac~ (pos 20 565))
  (obj spec spectroscope~ 360 110 (pos 500 420))
  (obj cspec comment "what comes out: the spectrum" (pos 500 535))
  (obj lb loadbang (pos 900 100))
  (obj i1 message 1000 (pos 900 130))
  (obj i2 message 0.5 (pos 960 130))
  (obj i3 message 1000 (pos 900 160))
  (obj i4 message 2 (pos 960 160))
  (obj next comment "Next: tutorial 5, the spectrum. Also see the example filters (Help > Browser) and the help of filterdesign." (pos 20 610))
  (connect nz 0 lp 0)
  (connect cut 0 lp 1)
  (connect res 0 lp 2)
  (connect ty1 0 fd 0)
  (connect ty2 0 fd 0)
  (connect ty3 0 fd 0)
  (connect ty4 0 fd 0)
  (connect ty5 0 fd 0)
  (connect f 0 fd 0)
  (connect q 0 fd 1)
  (connect g 0 fd 2)
  (connect fd 0 plot 0)
  (connect fd 0 bq 0)
  (connect nz 0 bq 0)
  (connect k0 0 pick 0)
  (connect k1 0 pick 0)
  (connect k2 0 pick 0)
  (connect lp 0 pick 1)
  (connect bq 0 pick 2)
  (connect nz 0 pick 3)
  (connect pick 0 vca 0)
  (connect pick 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 i1 0)
  (connect lb 0 i2 0)
  (connect lb 0 i3 0)
  (connect lb 0 i4 0)
  (connect i1 0 cut 0)
  (connect i2 0 res 0)
  (connect i3 0 f 0)
  (connect i4 0 q 0))
