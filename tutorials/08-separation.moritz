; 08-separation.moritz - tutorial 8: separating sounds. Offline objects
; compute a result from a whole recording, in the background (the patch
; keeps playing; the outlets give the progress, then a bang). hpss splits
; sustained sounds from attacks; nmf finds the parts a sound is made of.
(patch
  (obj title comment "Tutorial 8 · Separating sounds" (pos 20 12))
  (obj t1 comment "Each step computes new buffer~s from a recording, then you listen. Turn the audio on, then the volume." (pos 20 40))
  (obj s1 comment "1. hpss: sustained sounds are horizontal lines in a spectrogram, attacks vertical ones. Two filters keep one kind each." (pos 20 75))
  (obj b1 buffer~ t8mix ../data/hpss_demo.wav (pos 20 100))
  (obj bh buffer~ t8harm (pos 320 100))
  (obj bp buffer~ t8perc (pos 450 100))
  (obj go1 message "run t8mix t8harm t8perc" (pos 20 135))
  (obj hp hpss (pos 20 170))
  (obj p1 flonum (pos 20 205))
  (obj d1 button (pos 100 205))
  (obj cp1 comment "progress, done" (pos 130 208))
  (obj s2 comment "2. nmf: the magnitude spectrogram as a few spectra (W) switched on and off over time (H): parts of the sound, found by" (pos 20 250))
  (obj s3 comment "   themselves. Four parts of a mix of four instruments: listen to each; which part is which instrument is up to the method." (pos 20 268))
  (obj b2 buffer~ t8stems ../data/stems_demo.wav (pos 20 295))
  (obj bn buffer~ t8parts (pos 340 295))
  (obj go2 message "components 4, run t8stems t8parts" (pos 20 330))
  (obj nm nmf 4 80 (pos 20 365))
  (obj p2 flonum (pos 20 400))
  (obj d2 button (pos 100 400))
  (obj cp2 comment "progress, done (it takes a few seconds)" (pos 130 403))
  (obj s4 comment "3. Listen: the original, then what each method found." (pos 20 445))
  (obj l1 message start (pos 20 470))
  (obj l2 message start (pos 120 470))
  (obj l3 message start (pos 220 470))
  (obj l4 message start (pos 340 470))
  (obj l5 message start (pos 450 470))
  (obj cl1 comment "hpss: mix" (pos 20 495))
  (obj cl2 comment "harmonic" (pos 120 495))
  (obj cl3 comment "percussive" (pos 220 495))
  (obj cl4 comment "nmf: mix" (pos 340 495))
  (obj cl5 comment "part" (pos 450 495))
  (obj part number 1 (pos 510 470))
  (obj cpart comment "which part (1-4)" (pos 570 471))
  (obj q1 play~ t8mix (pos 20 525))
  (obj q2 play~ t8harm (pos 120 525))
  (obj q3 play~ t8perc (pos 220 525))
  (obj q4 play~ t8stems (pos 340 525))
  (obj q5 play~ t8parts 4 (pos 450 525))
  (obj which selector~ 4 1 (pos 450 565))
  (obj mix +~ (pos 20 610))
  (obj on message "0.5 50" (pos 200 610))
  (obj off message "0 50" (pos 270 610))
  (obj cvol comment "volume" (pos 330 611))
  (obj ramp line~ (pos 200 645))
  (obj vca *~ (pos 20 645))
  (obj out dac~ (pos 20 685))
  (obj next comment "More: the separation and nmf-supervised examples (Help > Browser), where nmf first learns each source alone." (pos 20 730))
  (connect go1 0 hp 0)
  (connect hp 0 p1 0)
  (connect hp 1 d1 0)
  (connect go2 0 nm 0)
  (connect nm 0 p2 0)
  (connect nm 1 d2 0)
  (connect l1 0 q1 0)
  (connect l2 0 q2 0)
  (connect l3 0 q3 0)
  (connect l4 0 q4 0)
  (connect l5 0 q5 0)
  (connect part 0 which 0)
  (connect q5 0 which 1)
  (connect q5 1 which 2)
  (connect q5 2 which 3)
  (connect q5 3 which 4)
  (connect q1 0 mix 0)
  (connect q2 0 mix 0)
  (connect q3 0 mix 0)
  (connect q4 0 mix 0)
  (connect which 0 mix 0)
  (connect mix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
