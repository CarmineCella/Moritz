; 02-numbers.moritz - tutorial 2: hot and cold inlets, integers and decimals
(patch
  (obj title comment "Tutorial 2 · Numbers and messages" (pos 20 12))
  (obj h1 comment "Hot and cold. The left inlet of a control object is hot: what arrives there makes the object output." (pos 20 40))
  (obj h2 comment "The other inlets are cold: they only store a value for the next time. Drag a, then b, then a again." (pos 20 58))
  (obj a number 3 (pos 40 95))
  (obj ca comment "a (hot)" (pos 100 96))
  (obj b number 4 (pos 200 95))
  (obj cb comment "b (cold)" (pos 260 96))
  (obj add + (pos 40 135))
  (obj sum number (pos 40 170))
  (obj order comment "To make a cold inlet react, send its value first and then bang the hot one: trigger does it right to left." (pos 20 205))
  (obj b2 number 4 (pos 40 235))
  (obj tr t b i (pos 40 270))
  (obj add2 + 3 (pos 40 305))
  (obj sum2 number (pos 40 340))
  (obj ctr comment "t b i: first the number to the right inlet, then a bang to the left one" (pos 120 271))
  (obj i1 comment "Integers and decimals, as in Max. An object with an integer argument (or none) works in integers:" (pos 20 385))
  (obj i2 comment "[/ 2] turns 7 into 3, and [* 1] turns 0.75 into 0. Write the argument with a point, [/ 2.] or [* 1.], for decimals." (pos 20 403))
  (obj x flonum 7.5 (pos 40 435))
  (obj cx comment "drag me" (pos 110 436))
  (obj d1 / 2 (pos 40 470))
  (obj d2 / 2. (pos 140 470))
  (obj r1 flonum (pos 40 505))
  (obj r2 flonum (pos 140 505))
  (obj cr comment "integer: 3      decimal: 3.75" (pos 220 506))
  (obj pk1 comment "pack and unpack are typed the same way: pack 0 0. makes an integer and a decimal. expr too: 7 / 2 is 3, 7. / 2 is 3.5." (pos 20 545))
  (obj msg comment "A message box sends its text when clicked; $1 is replaced by the number that arrives:" (pos 20 580))
  (obj m1 number 5 (pos 40 610))
  (obj m3 message "freq $1" (pos 160 645))
  (obj pr print tutorial (pos 160 680))
  (obj cpr comment "print writes to the console: Patch > Console (Shift+Cmd+M)" (pos 250 681))
  (obj next comment "Next: the help patch of each object (right-click a box) and the examples (File > Open)." (pos 20 720))
  (connect a 0 add 0)
  (connect b 0 add 1)
  (connect add 0 sum 0)
  (connect b2 0 tr 0)
  (connect tr 1 add2 1)
  (connect tr 0 add2 0)
  (connect add2 0 sum2 0)
  (connect x 0 d1 0)
  (connect x 0 d2 0)
  (connect d1 0 r1 0)
  (connect d2 0 r2 0)
  (connect m1 0 m3 0)
  (connect m3 0 pr 0))
