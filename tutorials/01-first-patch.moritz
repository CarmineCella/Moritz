; 01-first-patch.moritz - tutorial 1: boxes, cables, and the two modes
(patch
  (obj title comment "Tutorial 1 · A first patch" (pos 20 12))
  (obj t1 comment "A patch is made of boxes joined by cables. Messages travel along thin cables, sound along thick striped ones." (pos 20 40))
  (obj t2 comment "The patch opens locked: you play it. Cmd+E (or the Edit button) unlocks it, to add, move and connect boxes." (pos 20 58))
  (obj s1 comment "1. Turn the sound on: Audio On in the toolbar. Then click a message box below." (pos 20 95))
  (obj p1 message 220 (pos 40 125))
  (obj p2 message 330 (pos 90 125))
  (obj p3 message 440 (pos 140 125))
  (obj freq flonum 220 (pos 40 170))
  (obj cfreq comment "a number box: drag it up and down, or click it and type a number and Return" (pos 120 171))
  (obj osc cycle~ 220 (pos 40 215))
  (obj cosc comment "cycle~ is a sine oscillator: the number arriving at its left inlet is the frequency" (pos 120 216))
  (obj on message "0.2 50" (pos 40 260))
  (obj off message "0 50" (pos 110 260))
  (obj ramp line~ (pos 40 300))
  (obj con comment "line~ goes to 0.2 (or 0) in 50 ms: a smooth volume" (pos 120 301))
  (obj vca *~ (pos 40 340))
  (obj cvca comment "*~ multiplies the oscillator by the volume" (pos 120 341))
  (obj out dac~ (pos 40 385))
  (obj cout comment "dac~ is the loudspeakers: left and right" (pos 120 386))
  (obj s2 comment "2. Unlock the patch (Cmd+E). Double-click an empty place and type: saw~ 110, then Return. Now drag a cable" (pos 20 435))
  (obj s3 comment "from its outlet (the dark bottom edge) to the left inlet of *~. Lock again (Cmd+E) and listen: both sounds are added." (pos 20 453))
  (obj s4 comment "3. Select a box and press Backspace to delete it; Cmd+Z undoes. Right-click any box: its help, and View Source," (pos 20 480))
  (obj s5 comment "the C++ code that makes it work. Inlets and outlets explain themselves when the mouse rests on them in edit mode." (pos 20 498))
  (obj next comment "Next: tutorial 2, numbers and messages." (pos 20 530))
  (connect p1 0 freq 0)
  (connect p2 0 freq 0)
  (connect p3 0 freq 0)
  (connect freq 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
