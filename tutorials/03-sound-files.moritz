; 03-sound-files.moritz - tutorial 3: sound files and buffers. A buffer~
; holds a sound in memory under a name; play~ plays it once, groove~ at any
; speed and in a loop, waveform~ shows it, record~ writes into it.
(patch
  (obj title comment "Tutorial 3 · Sound files and buffers" (pos 20 12))
  (obj t1 comment "A buffer~ loads a sound file and keeps it in memory under a name; any object can then use it by that name." (pos 20 40))
  (obj t2 comment "Paths are relative to the patch. Turn the audio on (the toolbar) before playing." (pos 20 58))
  (obj b buffer~ t3drums ../data/drums.wav (pos 20 90))
  (obj wave waveform~ t3drums 500 70 (pos 20 120))
  (obj s1 comment "1. play~ plays the buffer once, from the start." (pos 20 210))
  (obj go message start (pos 20 235))
  (obj stp message stop (pos 80 235))
  (obj pl play~ t3drums (pos 20 270))
  (obj s2 comment "2. groove~ plays at the speed of the signal in its left inlet: 1 normal, 0.5 slower and lower, -1 backwards. loop 1 repeats." (pos 20 315))
  (obj r1 message 1 (pos 20 340))
  (obj r2 message 0.5 (pos 60 340))
  (obj r3 message 2 (pos 110 340))
  (obj r4 message -1 (pos 150 340))
  (obj crate comment "speed (a number into sig~ becomes a signal)" (pos 200 341))
  (obj rate sig~ 0 (pos 20 375))
  (obj gl message "loop 1, 0" (pos 330 375))
  (obj cgl comment "loop on, from 0 ms" (pos 420 376))
  (obj gr groove~ t3drums (pos 20 410))
  (obj s3 comment "3. Speed changes pitch and duration together: that is what a tape does. Tutorial 5 separates them." (pos 20 450))
  (obj s4 comment "4. Record your own sound: 1 starts recording into a 4-second buffer~ from the microphone (adc~), 0 stops. Then play it." (pos 20 490))
  (obj mine buffer~ t3mine 4000 (pos 20 515))
  (obj rec1 message 1 (pos 180 515))
  (obj rec0 message 0 (pos 220 515))
  (obj mic adc~ 1 (pos 280 515))
  (obj rec record~ t3mine (pos 180 550))
  (obj pm message start (pos 360 515))
  (obj pmine play~ t3mine (pos 360 550))
  (obj mix +~ (pos 20 600))
  (obj on message "0.5 50" (pos 200 600))
  (obj off message "0 50" (pos 270 600))
  (obj cvol comment "volume" (pos 330 601))
  (obj ramp line~ (pos 200 635))
  (obj vca *~ (pos 20 635))
  (obj out dac~ (pos 20 675))
  (obj next comment "Next: tutorial 4, filters. Also see the examples sampler, tape and stretch (Help > Browser)." (pos 20 715))
  (connect go 0 pl 0)
  (connect stp 0 pl 0)
  (connect r1 0 rate 0)
  (connect r2 0 rate 0)
  (connect r3 0 rate 0)
  (connect r4 0 rate 0)
  (connect rate 0 gr 0)
  (connect gl 0 gr 0)
  (connect rec1 0 rec 0)
  (connect rec0 0 rec 0)
  (connect mic 0 rec 0)
  (connect pm 0 pmine 0)
  (connect pl 0 mix 0)
  (connect gr 0 mix 0)
  (connect pmine 0 mix 0)
  (connect mix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
