; 10-atoms-and-types.moritz - tutorial 10: atoms and types. Matching
; pursuit (after Maple) explains a sound as a sum of atoms from a
; dictionary: windowed cosines, or pieces of other recordings (here a
; clarinet), which gives hybrids. Sound types (after SoundTypes) turn a
; sound into a sequence of symbols at several levels (notes, phrases,
; sections of a Bach prelude); new sequences become new music, and the types
; of one sound can be played with the sounds of another (John Cage with the
; Beach Boys). The methods are described in the document "Sound
; decomposition strategies for creative hybridizations" (Help > Documents).
(patch
  (obj title comment "Tutorial 10 · Atoms and types: matching pursuit and sound types" (pos 20 12))
  (obj paper link "Read more: Sound decomposition strategies for creative hybridizations (PDF)" docs/hybridization/hybridizations.pdf (pos 520 8))
  (obj s1 comment "1. A sound as a sum of atoms. pursuit finds the windowed cosine that explains most of the bell, subtracts it, and starts again." (pos 20 40))
  (obj s1b comment "   Each dot of the map is an atom (time, frequency; colour: level). Rebuild from the strongest ones only: the bell's skeleton." (pos 20 58))
  (obj b1 buffer~ t10bell ../data/archeos-bell.wav (pos 20 85))
  (obj bk1 buffer~ t10book (pos 330 85))
  (obj sy1 buffer~ t10syn (pos 440 85))
  (obj lb1 loadbang (pos 20 115))
  (obj g1 message "gabor 128 8192" (pos 20 145))
  (obj d1 atoms t10gabor (pos 20 175))
  (obj r1 message "atoms 600, run t10bell t10gabor t10book" (pos 20 205))
  (obj pu1 pursuit (pos 20 235))
  (obj ck comment "keep:" (pos 20 275))
  (obj k1 message "keep 0.02" (pos 65 273))
  (obj k2 message "keep 0.2" (pos 145 273))
  (obj k3 message "keep 1" (pos 220 273))
  (obj tk t b l (pos 20 305))
  (obj sm1 message "synth t10book t10gabor t10syn" (pos 20 335))
  (obj pu2 pursuit (pos 20 365))
  (obj pl1 message start (pos 260 335))
  (obj pp1 play~ t10syn (pos 260 365))
  (obj o1 dac~ (pos 260 400))
  (obj l1 loadbang (pos 820 85))
  (obj m1 message "ylog 1, title the bell's atoms" (pos 520 115))
  (obj map plot t10book 440 170 scatter (pos 520 145))
  (obj s2 comment "2. Atoms of other sounds. With a dictionary of clarinet notes cut into 100 ms frames, pursuit explains each part of a voice with a clarinet:" (pos 20 440))
  (obj s2b comment "   what comes out keeps the voice's rhythm and contour, played by the clarinet (a hybrid). The notes are TinySOL's (CC BY 4.0)." (pos 20 458))
  (obj b2 buffer~ t10vox ../data/Vox.wav (pos 20 485))
  (obj bk2 buffer~ t10book2 (pos 300 485))
  (obj hy buffer~ t10hyb (pos 410 485))
  (obj g2 message "frames ../data/clarinet 100 50" (pos 20 515))
  (obj d2 atoms t10clar (pos 20 545))
  (obj r2 message "segments blocks, block 50, components 4, candidates 32, run t10vox t10clar t10book2" (pos 20 575))
  (obj pu3 pursuit (pos 20 605))
  (obj sm2 message "synth t10book2 t10clar t10hyb" (pos 20 635))
  (obj pu4 pursuit (pos 20 665))
  (obj pl2 message start (pos 300 635))
  (obj pp2 play~ t10hyb (pos 300 665))
  (obj vv2 *~ 0.6 (pos 300 695))
  (obj o2 dac~ (pos 300 725))
  (obj cb2 comment "click to build it (some seconds)" (pos 350 546))
  (obj bb2 button (pos 320 545))
  (obj s3 comment "3. Sound types. soundtypes cuts a Bach prelude at its onsets and clusters the notes into types (colours: timbre and pitch classes): level 1;" (pos 20 765))
  (obj s3b comment "   where the next type is surprising a phrase ends: phrases are clustered into the types of level 2, and phrases into sections (level 3)." (pos 20 783))
  (obj b3 buffer~ t10bach ../data/Bach_Prelude_Cminor.flac (pos 20 810))
  (obj lab buffer~ t10lab (pos 420 810))
  (obj lb3 loadbang (pos 20 840))
  (obj a3 message "segment onsets, pitch 1, types 16 8 4, levels 3, analyse t10bach" (pos 20 870))
  (obj st3 soundtypes t10types (pos 20 900))
  (obj w3 message "labels t10lab" (pos 20 930))
  (obj l3 loadbang (pos 820 810))
  (obj m3 message "colors types, title the prelude: notes phrases sections" (pos 520 840))
  (obj pt3 plot t10lab 440 90 (pos 520 870))
  (obj s4 comment "4. New sequences. typegen follows the types: the oracle plays the original (continuity 1) or jumps where the last two types repeat." (pos 20 975))
  (obj s4b comment "   Lower the continuity: Bach recombines. At level 2 whole phrases recombine; with inner, the phrases keep their order but their notes are new." (pos 20 993))
  (obj out4 buffer~ t10new (pos 20 1020))
  (obj cco comment "continuity" (pos 20 1050))
  (obj co slider 0. 1. (pos 20 1070))
  (obj om message "oracle $1 2, generate 30 t10new" (pos 20 1100))
  (obj lv1 message "level 1" (pos 300 1070))
  (obj lv2 message "level 2" (pos 360 1070))
  (obj in1 message "inner 1" (pos 420 1070))
  (obj in5 message "inner 0.5 2" (pos 480 1070))
  (obj g4 typegen t10types (pos 20 1130))
  (obj pl4 message start (pos 300 1100))
  (obj pp4 play~ t10new (pos 300 1130))
  (obj o4 dac~ (pos 300 1165))
  (obj s5 comment "5. Rematch. typematch plays John Cage's voice with the Beach Boys: every frame of Cage becomes a grain of the closest frame of the song," (pos 20 1205))
  (obj s5b comment "   each measured against its own sound's range; contour gives it Cage's loudness. Level 1 splices whole units instead." (pos 20 1223))
  (obj out5 buffer~ t10match (pos 20 1250))
  (obj b5a buffer~ t10cage ../data/cage.wav (pos 130 1250))
  (obj b5b buffer~ t10bb ../data/beachboys.wav (pos 390 1250))
  (obj a5 message "types 32 16, size 8192, hop 2048, analyse t10cage" (pos 20 1280))
  (obj a6 message "types 32 16, size 8192, hop 2048, analyse t10bb" (pos 360 1280))
  (obj st6 soundtypes t10song (pos 360 1310))
  (obj st5 soundtypes t10speech (pos 20 1310))
  (obj r5 message "contour 0.5, run t10speech t10song t10match 0" (pos 20 1340))
  (obj r5b message "contour 0.7, run t10speech t10song t10match 1" (pos 360 1340))
  (obj tm5 typematch (pos 20 1370))
  (obj pl5 message start (pos 300 1370))
  (obj pp5 play~ t10match (pos 300 1400))
  (obj o5 dac~ (pos 300 1435))
  (connect lb1 0 g1 0)
  (connect g1 0 d1 0)
