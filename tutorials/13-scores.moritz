; 13-scores.moritz - tutorial 13: scores. A score is music written in time:
; notes, sounds, messages, patches and other scores, each at its time in
; seconds, on rows (staves, or tracks). In Moritz a score is an object: the
; score box draws it as a roll, plays it on the patch's clock (the transport)
; and sends its events out; its window shows the same score as a Roll, a
; Piano roll, a List or a Timeline. Scores are written by hand, by messages,
; by the sound editor, by orchidea and by Musil, and kept in the patch or in
; a .score file.
(patch
  (obj title comment "Tutorial 13 · Scores: events in time, the transport, the roll and the timeline" (pos 20 12))
  (obj t1 comment "A score is music written in time: notes, sounds, messages, patches and other scores, each at its time in seconds, on rows (staves, or tracks)." (pos 20 40))
  (obj t2 comment "A score box draws its score, plays it on the patch's clock and sends its events out. Turn the audio on (the toolbar)." (pos 20 58))
  (obj s1 comment "1. Listen: click play. The score below has a flute melody and a cello bass (notes), a drum loop (sounds) and messages (bright) that open a filter." (pos 20 90))
  (obj s1b comment "   Its notes leave the box as lists (pitch velocity duration-ms ...) for a small synth; its sounds come out as audio; its messages reach the receive of their name." (pos 20 108))
  (obj play message play (pos 20 140))
  (obj stop message stop (pos 65 140))
  (obj loc message "locate 1" (pos 110 140))
  (obj lp message "loop 1 5" (pos 190 140))
  (obj nlp message "loop 0" (pos 262 140))
  (obj tr transport 120 4 4 (pos 330 140))
  (obj ctr comment "loop 1 5: the four bars again and again" (pos 460 141))
  (obj rc r t13cmd (pos 20 175))
  (obj crc comment "the messages of steps 6 to 10 come here (send t13cmd)" (pos 100 176))
  (obj sc score t13tune @size 640 210 (pos 20 205)
    (script
      "; four bars (8 seconds at 120): a flute and a cello, a drum loop, a motif placed four times, a lane of messages"
      "(score \"t13tune\""
      "  (sr 44100) (bpm 120) (meter 4 4) (next-id 1)"
      "  (row Fl treble)"
      "  (row Vc bass)"
      "  (row drums)"
      "  (row bright (data lanes (list (list t13bright 300 6000))))"
      "  (note 0 0.45 Fl Eb5 mf) (note 0.5 0.45 Fl G5 mf) (note 1 0.45 Fl Ab5 f) (note 1.5 0.45 Fl G5 mf)"
      "  (note 2 0.9 Fl Eb5 mf) (note 3 0.45 Fl D5 mp) (note 3.5 0.45 Fl C5 mp)"
      "  (score 4 \"../examples/15-scores/motif.score\" (row Fl))"
      "  (score 5 \"../examples/15-scores/motif.score\" (transpose 5) (row Fl))"
      "  (score 6 \"../examples/15-scores/motif.score\" (transpose 7) (row Fl))"
      "  (score 7 \"../examples/15-scores/motif.score\" (transpose 2) (row Fl))"
      "  (note 0 1.9 Vc C3 p) (note 2 1.9 Vc Ab2 p) (note 4 1.9 Vc F2 p) (note 6 1.9 Vc G2 p)"
      "  (sound 0 4 \"drums.wav\" (gain 0.5) (row drums)) (sound 4 4 \"drums.wav\" (gain 0.5) (row drums))"
      "  (msg 0 t13bright 700 (row bright)) (msg 2 t13bright 2500 (row bright))"
      "  (msg 4 t13bright 6000 (row bright)) (msg 6 t13bright 1500 (row bright)))"))
  (obj pn prepend note (pos 20 445))
  (obj poly poly~ scorevoice 8 (pos 20 475))
  (obj cpoly comment "notes: a free voice each (scorevoice, a small synth of the examples: double-click poly~ to see it)" (pos 140 476))
  (obj rb r t13bright (pos 400 505))
  (obj nb number (pos 400 535))
  (obj ramp message "$1 300" (pos 400 565))
  (obj ln line~ 700 (pos 400 595))
  (obj cb comment "messages: bright, the filter's cutoff (Hz), a ramp to each" (pos 470 536))
  (obj ml +~ (pos 20 535))
  (obj mr +~ (pos 160 535))
  (obj cm comment "+ its sounds, left and right" (pos 210 505))
  (obj fl lores~ 700 0.3 (pos 20 625))
  (obj fr lores~ 700 0.3 (pos 160 625))
  (obj lb loadbang (pos 600 625))
  (obj vol message "0.7 200" (pos 600 655))
  (obj mute message "0 200" (pos 670 655))
  (obj cv comment "volume" (pos 730 656))
