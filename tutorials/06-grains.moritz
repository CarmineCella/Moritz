; 06-grains.moritz - tutorial 6: granular synthesis. A grain is a very short
; sound with a smooth envelope; alone it is a click or a blip, by the
; hundreds it becomes a texture. nebula~ makes clouds of grains, from
; waveforms or from a recording.
(patch
  (obj title comment "Tutorial 6 · Grains: from one blip to a cloud" (pos 20 12))
  (obj t1 comment "Turn the audio and the cloud on. Then follow the steps; each message sets nebula~, the sliders change one thing at a time." (pos 20 40))
  (obj tog toggle (pos 20 70))
  (obj ctog comment "cloud on / off" (pos 50 73))
  (obj s1 message "proto1 sine, proto2 sine, density 2, length 200, freq 440, gliss 0, grainlets 0, jitter 0.5 0, amp 0.3, morph 0" (pos 20 105))
  (obj c1 comment "1. Two grains a second, 200 ms each, in the middle: you hear each one, a soft blip with a smooth envelope." (pos 20 128))
  (obj s2 message "density 30, length 60" (pos 20 155))
  (obj c2 comment "2. Thirty a second, shorter: they start to fuse into one sound with a buzz at the grain rate." (pos 190 156))
  (obj s3 message "density 60 0.8, freq 440 0.5, jitter 0.5 1, amp 0.15" (pos 20 185))
  (obj c3 comment "3. Randomness: irregular times, frequencies spread around 440 Hz, grains spread left to right. A cloud." (pos 20 208))
  (obj s4 message "gliss 0.5" (pos 20 235))
  (obj c4 comment "4. Each grain glides to another pitch while it sounds." (pos 100 236))
  (obj b buffer~ t6vox ../data/Vox.wav (pos 20 270))
  (obj s5 message "proto1 t6vox, proto2 t6vox, freq 1 0.02, gliss 0, speed 0.3, density 40 0.3, length 100 0.3, amp 0.4" (pos 20 300))
  (obj c5 comment "5. Grains of a recording: freq is now a speed ratio (1 = as recorded), speed how fast they move through it." (pos 20 323))
  (obj s6 message "speed 0" (pos 20 350))
  (obj s7 message "speed 0.3" (pos 90 350))
  (obj c6 comment "6. speed 0 freezes the voice on one moment: it keeps sounding, with no time passing." (pos 170 351))
  (obj cd comment "density (grains/s)" (pos 20 385))
  (obj d slider 1 200 (pos 20 405))
  (obj cl comment "length (ms)" (pos 180 385))
  (obj l slider 5 500 (pos 180 405))
  (obj neb nebula~ sine sine (pos 20 450))
  (obj on message "0.6 50" (pos 220 490))
  (obj off message "0 50" (pos 290 490))
  (obj cvol comment "volume" (pos 350 491))
  (obj ramp line~ (pos 220 525))
  (obj vl *~ (pos 20 525))
  (obj vr *~ (pos 120 525))
  (obj out dac~ (pos 20 565))
  (obj sc scope~ (pos 450 450))
  (obj next comment "Next: tutorial 7, space. Examples: nebula and granulator (Help > Browser); nebula~'s help lists every parameter." (pos 20 610))
  (connect tog 0 neb 0)
  (connect s1 0 neb 0)
  (connect s2 0 neb 0)
  (connect s3 0 neb 0)
  (connect s4 0 neb 0)
  (connect s5 0 neb 0)
  (connect s6 0 neb 0)
  (connect s7 0 neb 0)
  (connect d 0 neb 1)
  (connect l 0 neb 2)
  (connect neb 0 vl 0)
  (connect neb 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect vl 0 sc 0))
