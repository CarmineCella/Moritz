; granulator.moritz - asynchronous granular synthesis with poly~. The
; scheduler (p grains) fires grains at random intervals around the chosen
; density, each from a random place within the spread and with a random
; pan; poly~ plays each one in a free grainvoice (32 of them). Random
; timing keeps the texture smooth: no grain-rate buzz.
; topic: Synthesis
(patch
  (obj title comment "granulator: poly~ with 32 grain voices reading a voice (sounds/Vox.wav)" (pos 20 12))
  (obj buf buffer~ grainvox sounds/Vox.wav (pos 20 40))
  (obj lb loadbang (pos 20 75))
  (obj init message "25 90 1 2200 150" (pos 20 110))
  (obj on message 1 (pos 130 110))
  (obj tex comment "textures: density, size, pitch, position, spread" (pos 330 75))
  (obj t1 message "60 40 1 400 60" (pos 330 100))
  (obj t2 message "8 240 0.5 2400 900" (pos 330 130))
  (obj t3 message "40 60 2 4200 20" (pos 330 160))
  (obj t4 message "30 150 1 5000 15" (pos 520 100))
  (obj t5 message "15 200 0.75 1500 300" (pos 520 130))
  (obj up unpack 0. 0. 0. 0. 0. (pos 20 150))
  (obj density slider 1 80 (pos 20 195))
  (obj s1 s gr-density (pos 170 195))
  (obj l1 comment "grains per second" (pos 290 196))
  (obj size slider 10 250 (pos 20 230))
  (obj s2 s gr-size (pos 170 230))
  (obj l2 comment "grain size (ms)" (pos 290 231))
  (obj pitch slider 0.25 2 (pos 20 265))
  (obj s3 s gr-pitch (pos 170 265))
  (obj l3 comment "pitch (1 = original)" (pos 290 266))
  (obj pos slider 0 15000 (pos 20 300))
  (obj s4 s gr-pos (pos 170 300))
  (obj l4 comment "position in the file (ms)" (pos 290 301))
  (obj spread slider 0 800 (pos 20 335))
  (obj s5 s gr-spread (pos 170 335))
  (obj l5 comment "random spread around it (ms)" (pos 290 336))
  (obj play toggle (pos 20 385))
  (obj l6 comment "play" (pos 50 386))
  (obj grains p grains (pos 20 420)
    (patch
      (obj c0 comment "grain scheduler: random intervals, positions and pans" (pos 20 10))
      (obj in inlet (pos 20 40))
      (obj sel sel 1 (pos 20 75))
      (obj stop message stop (pos 120 110))
      (obj tick t b b (pos 20 110))
      (obj rd r gr-density (pos 240 110))
      (obj ival expr "1000 / $f2 * random(0.2, 1.8)" (pos 120 150))
      (obj c1 comment "next grain after a random interval" (pos 340 151))
      (obj del delay (pos 120 190))
      (obj em t b b b b (pos 20 230))
      (obj rp r gr-pos (pos 160 230))
      (obj rs r gr-spread (pos 270 230))
      (obj rz r gr-size (pos 390 230))
      (obj rpi r gr-pitch (pos 490 230))
      (obj pe expr "max(0, $f2 + random(-1, 1) * $f3)" (pos 20 270))
      (obj fz f 90 (pos 390 270))
      (obj fp f 1 (pos 490 270))
      (obj pan expr "random(0, 1)" (pos 560 270))
      (obj pk pack 0. 0. 0. 0. (pos 20 310))
      (obj nm message "note $1 $2 $3 $4" (pos 20 350))
      (obj out outlet (pos 20 390))
      (connect in 0 sel 0)
      (connect sel 0 tick 0)
      (connect sel 1 stop 0)
      (connect stop 0 del 0)
      (connect tick 1 ival 0)
      (connect rd 0 ival 1)
      (connect ival 0 del 0)
      (connect del 0 tick 0)
      (connect tick 0 em 0)
      (connect em 0 pe 0)
      (connect em 1 fz 0)
      (connect em 2 fp 0)
      (connect em 3 pan 0)
      (connect rp 0 pe 1)
      (connect rs 0 pe 2)
      (connect rz 0 fz 1)
      (connect rpi 0 fp 1)
      (connect pe 0 pk 0)
      (connect fz 0 pk 1)
      (connect fp 0 pk 2)
      (connect pan 0 pk 3)
      (connect pk 0 nm 0)
      (connect nm 0 out 0)))
  (obj poly poly~ grainvoice 32 grainvox (pos 20 460))
  (obj left *~ 0.6 (pos 20 500))
  (obj right *~ 0.6 (pos 160 500))
  (obj out dac~ (pos 20 540))
  (obj sc scope~ (pos 480 400))
  (connect lb 0 init 0)
  (connect lb 0 on 0)
  (connect on 0 play 0)
  (connect init 0 up 0)
  (connect t1 0 up 0)
  (connect t2 0 up 0)
  (connect t3 0 up 0)
  (connect t4 0 up 0)
  (connect t5 0 up 0)
  (connect up 0 density 0)
  (connect up 1 size 0)
  (connect up 2 pitch 0)
  (connect up 3 pos 0)
  (connect up 4 spread 0)
  (connect density 0 s1 0)
  (connect size 0 s2 0)
  (connect pitch 0 s3 0)
  (connect pos 0 s4 0)
  (connect spread 0 s5 0)
  (connect play 0 grains 0)
  (connect grains 0 poly 0)
  (connect poly 0 left 0)
  (connect poly 1 right 0)
  (connect left 0 out 0)
  (connect right 0 out 1)
  (connect left 0 sc 0))
