; sine.moritz - the patch from the spec, with a frequency box, a volume box
; and three message boxes acting as presets. Click a message box (patch
; locked) or drag a number box up/down.
(patch
  (obj p1 message 220 (pos 40 30))
  (obj p2 message 440 (pos 90 30))
  (obj p3 message 880 (pos 140 30))
  (obj freq flonum 440 (pos 40 80))
  (obj osc cycle~ 440 (pos 40 130))
  (obj vol flonum 0.2 (pos 160 130))
  (obj gain *~ 0.2 (pos 40 180))
  (obj out dac~ (pos 40 240))
  (connect p1 0 freq 0)
  (connect p2 0 freq 0)
  (connect p3 0 freq 0)
  (connect freq 0 osc 0)
  (connect osc 0 gain 0)
  (connect vol 0 gain 1)
  (connect gain 0 out 0)
  (connect gain 0 out 1))
