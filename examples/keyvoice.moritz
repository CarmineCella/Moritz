; keyvoice.moritz - an abstraction: one voice for keyboard.moritz, played by
; poly~ with "midinote pitch velocity". A velocity above 0 starts the note:
; the envelope rises to velocity/127 in 10 ms and settles at 70% in 300 ms,
; and holds while the key is down. Velocity 0 (the note-off) releases it in
; 400 ms. thispoly~ watches the envelope, so the voice stays busy until the
; release has finished.
(patch
  (obj c0 comment "keyvoice: pitch velocity in, sustain and release" (pos 20 10))
  (obj in inlet (pos 20 40))
  (obj split unpack 0 0 (pos 20 75))
  (obj m2f mtof (pos 20 115))
  (obj osc1 saw~ (pos 20 155))
  (obj det * 1.006 (pos 120 115))
  (obj osc2 saw~ (pos 120 155))
  (obj mixo +~ (pos 20 195))
  (obj filt lores~ 1800 0.3 (pos 20 235))
  (obj vca *~ (pos 20 275))
  (obj gain *~ 0.12 (pos 20 315))
  (obj out outlet~ (pos 20 355))
  (obj off sel 0 (pos 260 75))
  (obj rel message "0 400" (pos 260 115))
  (obj amp expr "$f1 / 127" (pos 330 115))
  (obj both t f f (pos 330 150))
  (obj sus * 0.7 (pos 420 185))
  (obj ad pack 0. 0. (pos 330 220))
  (obj atk message "$1 10 $2 300" (pos 330 255))
  (obj env line~ (pos 260 295))
  (obj busy thispoly~ (pos 380 335))
  (connect in 0 split 0)
  (connect split 0 m2f 0)
  (connect m2f 0 osc1 0)
  (connect m2f 0 det 0)
  (connect det 0 osc2 0)
  (connect osc1 0 mixo 0)
  (connect osc2 0 mixo 1)
  (connect mixo 0 filt 0)
  (connect filt 0 vca 0)
  (connect vca 0 gain 0)
  (connect gain 0 out 0)
  (connect split 1 off 0)
  (connect off 0 rel 0)
  (connect off 1 amp 0)
  (connect amp 0 both 0)
  (connect both 1 sus 0)
  (connect sus 0 ad 1)
  (connect both 0 ad 0)
  (connect ad 0 atk 0)
  (connect rel 0 env 0)
  (connect atk 0 env 0)
  (connect env 0 vca 1)
  (connect env 0 busy 0))
