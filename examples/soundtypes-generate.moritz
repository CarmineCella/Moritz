; soundtypes-generate.moritz - new music from the types of a recording
; (after SoundTypes). The analysis turns a sound into sequences of types
; at three levels; typegen makes new sequences and plays them with the
; original's own sound. Three ways: the classic n-grams of SoundTypes; a
; variable-order Markov model (the longest context heard often enough); a
; factor oracle, which follows the original (continuity) or jumps to
; another place where the recent past repeats. Generating at level 2 or 3
; recombines whole gestures or sections instead of short sounds.
; topic: Music information retrieval
(patch
  (obj title comment "New sequences of sound types: n-grams, Markov, oracle; at three levels" (pos 20 12))
  (obj sub comment "Choose a sound (it is analysed), a method and a level, then generate. Compare with the original; try continuity from 1 down to 0." (pos 20 34))
  (obj b1 buffer~ stgdrums sounds/drums.wav (pos 20 65))
  (obj b2 buffer~ stgmarch sounds/Sousa_StarsAndStripes.flac (pos 260 65))
  (obj b3 buffer~ stgbach sounds/Bach_Prelude_Cminor.flac (pos 565 65))
  (obj out buffer~ stgout (pos 565 95))
  (obj lab buffer~ stglab (pos 670 95))
  (obj olab buffer~ stgolab (pos 770 95))
  (obj cs comment "sound:" (pos 20 100))
  (obj s1 message "analyse stgdrums; stgplay set stgdrums" (pos 75 98))
  (obj s2 message "analyse stgmarch; stgplay set stgmarch" (pos 75 140))
  (obj s3 message "analyse stgbach; stgplay set stgbach" (pos 75 182))
  (obj cs2 comment "drums; the march (3:34); a Bach prelude" (pos 330 140))
  (obj lb loadbang (pos 330 98))
  (obj st soundtypes stgmodel (pos 20 230))
  (obj prog flonum (pos 20 265))
  (obj pre prepend set (pos 90 265))
  (obj units message "" (pos 190 265))
  (obj ol message "labels stgolab" (pos 90 295))
  (obj cm comment "method:" (pos 20 330))
  (obj m1 message "classic 2" (pos 80 328))
  (obj m2 message "classic 4" (pos 155 328))
  (obj m3 message "markov 4 2" (pos 230 328))
  (obj m4 message "oracle $1 1" (pos 315 400))
  (obj cc comment "oracle continuity" (pos 315 355))
  (obj co slider 0. 1. (pos 315 375))
  (obj cl comment "level:" (pos 20 360))
  (obj l1 message "level 1" (pos 80 358))
  (obj l2 message "level 2" (pos 140 358))
  (obj l3 message "level 3" (pos 200 358))
  (obj gen message "generate 30 stgout stglab" (pos 20 400))
  (obj g typegen stgmodel (pos 20 435))
  (obj gp flonum (pos 20 470))
  (obj done button (pos 90 470))
  (obj cpl comment "listen:" (pos 20 510))
  (obj p0 message start (pos 75 508))
  (obj p1 message start (pos 155 508))
  (obj stp message stop (pos 235 508))
  (obj cpl2 comment "the original, the new sound" (pos 290 510))
  (obj rp receive stgplay (pos 75 540))
  (obj a0 play~ stgdrums (pos 75 570))
  (obj a1 play~ stgout (pos 155 570))
  (obj mix +~ (pos 75 605))
  (obj vca *~ 0.4 (pos 75 635))
  (obj o dac~ (pos 75 670))
  (obj l9 loadbang (pos 760 130))
  (obj sp1 message "colors types, title the original: types at levels 1 2 3" (pos 520 160))
  (obj sp2 message "colors types, title the new sound: the same types in a new order" (pos 520 330))
  (obj po plot stgolab 460 120 (pos 520 190))
  (obj pg plot stglab 460 120 (pos 520 360))
  (obj clive comment "live: next plays the next unit of an endless sequence, one at a time" (pos 520 510))
  (obj tg toggle (pos 520 535))
  (obj met metro 200 (pos 520 565))
  (obj cmet comment "ms between units" (pos 640 536))
  (obj ms number 200 (pos 640 556))
  (obj nx message next (pos 520 595))
  (obj ty number (pos 600 625))
  (obj cty comment "type" (pos 660 626))
  (obj lp message "start $1 $2" (pos 520 625))
  (obj rp2 receive stgplay (pos 700 595))
  (obj a2 play~ stgdrums (pos 520 660))
  (obj c9 comment "At continuity 1 the oracle plays the original; lower, it jumps more often, always where the recent types repeat." (pos 20 715))
  (obj c10 comment "classic 4 copies long stretches (few contexts of 3 types are shared); markov backs off to shorter contexts when a long one is rare." (pos 20 733))
  (connect lb 0 s1 0)
  (connect s1 0 st 0)
  (connect s2 0 st 0)
  (connect s3 0 st 0)
  (connect st 0 prog 0)
  (connect st 2 pre 0)
  (connect pre 0 units 0)
