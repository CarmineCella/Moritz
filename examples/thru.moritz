; thru.moritz - audio input to output at half level. Use headphones!
; macOS asks for microphone access the first time.
; topic: First steps
(patch
  (obj in adc~ (pos 40 40))
  (obj l *~ 0.5 (pos 40 100))
  (obj r *~ 0.5 (pos 120 100))
  (obj out dac~ (pos 40 160))
  (connect in 0 l 0)
  (connect in 1 r 0)
  (connect l 0 out 0)
  (connect r 0 out 1))
