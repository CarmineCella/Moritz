; granulator.mlsp - granular synthesis with four copies of the grain
; abstraction (grain.mlsp), each a quarter cycle apart. Sliders set the
; grain rate, pitch, read position and random spread in the sound file.
(patch
  (obj title comment "granulator: four grain voices reading sounds/voice.wav (a sung phrase)" (pos 20 12))
  (obj buf buffer~ voice sounds/voice.wav (pos 20 40))
  (obj lb loadbang (pos 20 80))
  (obj init message "12 1 1700 120" (pos 20 115))
  (obj tex comment "textures: rate, pitch, position, spread" (pos 240 80))
  (obj t1 message "30 0.5 1700 40" (pos 240 105))
  (obj t2 message "4 1.5 1000 500" (pos 240 135))
  (obj t3 message "18 2 2600 0" (pos 240 165))
  (obj t4 message "40 1 3300 10" (pos 240 195))
  (obj up unpack 0 0 0 0 (pos 20 160))
  (obj l1 comment "grains per second (per voice)" (pos 270 216))
  (obj rate slider 1 40 (pos 20 215))
  (obj s1 s grain-rate (pos 170 215))
  (obj l2 comment "pitch (1 = original)" (pos 270 251))
  (obj pitch slider 0.25 2 (pos 20 250))
  (obj s2 s grain-pitch (pos 170 250))
  (obj l3 comment "position in the file (ms)" (pos 270 286))
  (obj pos slider 0 3800 (pos 20 285))
  (obj s3 s grain-pos (pos 170 285))
  (obj l4 comment "random spread (ms)" (pos 270 321))
  (obj spread slider 0 600 (pos 20 320))
  (obj s4 s grain-spread (pos 170 320))
  (obj g1 grain 0 voice (pos 20 375))
  (obj g2 grain 0.25 voice (pos 130 375))
  (obj g3 grain 0.5 voice (pos 260 375))
  (obj g4 grain 0.75 voice (pos 390 375))
  (obj left *~ 0.7 (pos 20 420))
  (obj right *~ 0.7 (pos 260 420))
  (obj out dac~ (pos 20 465))
  (obj sc scope~ (pos 540 370))
  (connect lb 0 init 0)
  (connect init 0 up 0)
  (connect t1 0 up 0)
  (connect t2 0 up 0)
  (connect t3 0 up 0)
  (connect t4 0 up 0)
  (connect up 0 rate 0)
  (connect up 1 pitch 0)
  (connect up 2 pos 0)
  (connect up 3 spread 0)
  (connect rate 0 s1 0)
  (connect pitch 0 s2 0)
  (connect pos 0 s3 0)
  (connect spread 0 s4 0)
  (connect g1 0 left 0)
  (connect g3 0 left 0)
  (connect g2 0 right 0)
  (connect g4 0 right 0)
  (connect left 0 out 0)
  (connect right 0 out 1)
  (connect left 0 sc 0))
