; mir-key.moritz - which key? Two Bach preludes (Kimiko Ishizaka, Open
; Well-Tempered Clavier, CC0) and a Sousa march (U.S. Marine Band, public
; domain). keyfind averages the chromagram into a pitch-class distribution
; (how much of each pitch class sounds) and compares it with Krumhansl and
; Kessler's profile of every key. The march is in E-flat; its trio moves to
; A-flat. A short passage can mislead: the first 20 seconds of the D major
; prelude sound like F-sharp minor.
; topic: Music information retrieval
(patch
  (obj title comment "Which key? Pitch classes against the profiles of the 24 keys" (pos 20 12))
  (obj sub comment "Choose a piece (or a part of it): the bars show how much of each pitch class sounds, and how well each key fits. Listen and compare." (pos 20 34))
  (obj b1 buffer~ mkcmin sounds/Bach_Prelude_Cminor.flac (pos 20 65))
  (obj b2 buffer~ mkdmaj sounds/Bach_Prelude_Dmajor.flac (pos 320 65))
  (obj b3 buffer~ mksousa sounds/Sousa_StarsAndStripes.flac (pos 620 65))
  (obj c1 comment "whole pieces" (pos 20 100))
  (obj r1 message "run mkcmin" (pos 20 120))
  (obj r2 message "run mkdmaj" (pos 110 120))
  (obj r3 message "run mksousa" (pos 200 120))
  (obj c2 comment "parts (from to, in ms)" (pos 320 100))
  (obj r4 message "run mkdmaj 0 20000" (pos 320 120))
  (obj r5 message "run mksousa 35000 72000" (pos 460 120))
  (obj r6 message "run mksousa 128000 155000" (pos 640 120))
  (obj c3 comment "the D major prelude's first 20 s; the march's second strain; its trio" (pos 140 176))
  (obj lb loadbang (pos 820 120))
  (obj kf keyfind (pos 20 175))
  (obj pre prepend set (pos 20 210))
  (obj key message "" (pos 20 240))
  (obj r flonum (pos 160 240))
  (obj cr comment "how well it fits (correlation, -1..1)" (pos 225 241))
  (obj l1 loadbang (pos 20 285))
  (obj lab1 message "labels chroma, title pitch classes" (pos 20 315))
  (obj p1 plot 380 150 bars (pos 20 350))
  (obj l2 loadbang (pos 420 285))
  (obj lab2 message "labels keys, title the 24 keys" (pos 420 315))
  (obj p2 plot 520 150 bars (pos 420 350))
  (obj cp comment "The best key is the highest bar on the right. Its neighbours fit too: the relative key (C minor and E-flat major share their notes) and the keys a fifth away." (pos 20 515))
  (obj cpl comment "listen:" (pos 20 555))
  (obj s1 message "start" (pos 75 553))
  (obj s2 message "start" (pos 175 553))
  (obj s3 message "start" (pos 275 553))
  (obj st message stop (pos 375 553))
  (obj cpl2 comment "C minor, D major, the march" (pos 430 555))
  (obj pa play~ mkcmin (pos 20 585))
  (obj pb play~ mkdmaj (pos 140 585))
  (obj pc play~ mksousa (pos 260 585))
  (obj mix +~ (pos 20 620))
  (obj vca *~ 0.4 (pos 20 650))
  (obj out dac~ (pos 20 680))
  (connect lb 0 r1 0)
  (connect r1 0 kf 0)
  (connect r2 0 kf 0)
  (connect r3 0 kf 0)
  (connect r4 0 kf 0)
  (connect r5 0 kf 0)
  (connect r6 0 kf 0)
  (connect kf 2 pre 0)
  (connect pre 0 key 0)
  (connect kf 3 r 0)
  (connect kf 4 p1 0)
  (connect kf 5 p2 0)
  (connect l1 0 lab1 0)
  (connect lab1 0 p1 0)
  (connect l2 0 lab2 0)
  (connect lab2 0 p2 0)
  (connect s1 0 pa 0)
  (connect s2 0 pb 0)
  (connect s3 0 pc 0)
  (connect st 0 pa 0)
  (connect st 0 pb 0)
  (connect st 0 pc 0)
  (connect pa 0 mix 0)
  (connect pb 0 mix 0)
  (connect pc 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
