; ambisonics.moritz - first-order ambisonics on four loudspeakers. Each
; source is encoded at a direction (ambienc~: azimuth, elevation) into a
; sound field of four channels (W Y Z X); fields add channel by channel;
; ambirot~ turns the whole scene; ambidec~ decodes it to a square of
; speakers: front left, back left, back right, front right (outputs 1 to 4
; of the sound card). On headphones, open binaural.moritz instead.
(patch
  (obj title comment "Ambisonics: two sources in a sound field, decoded to four speakers" (pos 20 12))
  (obj sub comment "Needs a four-channel output (1 FL, 2 BL, 3 BR, 4 FR). The voice circles by itself; place the drums with the slider." (pos 20 34))
  (obj b1 buffer~ ambvox sounds/Vox.wav (pos 20 65))
  (obj b2 buffer~ ambdrums sounds/drums.wav (pos 220 65))
  (obj pl message "loop 1, start" (pos 20 100))
  (obj v groove~ ambvox (pos 20 135))
  (obj d groove~ ambdrums (pos 330 135))
  (obj rate sig~ 1 (pos 150 100))
  (obj cspd comment "voice: turns per second" (pos 20 175))
  (obj spd flonum 0.1 (pos 20 195))
  (obj ph phasor~ 0.1 (pos 20 230))
  (obj deg *~ 360 (pos 20 265))
  (obj cdaz comment "drums azimuth (0 front, 90 left, -90 right)" (pos 330 175))
  (obj daz slider -180 180 (pos 330 195))
  (obj dazn number (pos 485 195))
  (obj lb loadbang (pos 600 100))
  (obj zero message 0 (pos 600 130))
  (obj e1 ambienc~ 1 (pos 20 310))
  (obj e2 ambienc~ 1 (pos 330 310))
  (obj w +~ (pos 20 360))
  (obj y +~ (pos 90 360))
  (obj z +~ (pos 160 360))
  (obj x +~ (pos 230 360))
  (obj crot comment "turn the whole scene (degrees)" (pos 330 380))
  (obj rot slider -180 180 (pos 330 400))
  (obj rotn number (pos 485 400))
  (obj r ambirot~ 1 (pos 20 440))
  (obj dec ambidec~ 1 45 135 -135 -45 (pos 20 490))
  (obj on message "0.8 50" (pos 330 490))
  (obj off message "0 50" (pos 400 490))
  (obj cvol comment "volume" (pos 460 491))
  (obj ramp line~ (pos 330 525))
  (obj g1 *~ (pos 20 540))
  (obj g2 *~ (pos 90 540))
  (obj g3 *~ (pos 160 540))
  (obj g4 *~ (pos 230 540))
  (obj out dac~ 1 2 3 4 (pos 20 590))
  (obj m1 meter~ (pos 20 630))
  (obj m2 meter~ (pos 90 630))
  (obj m3 meter~ (pos 160 630))
  (obj m4 meter~ (pos 230 630))
  (obj cm comment "FL BL BR FR" (pos 300 640))
  (connect pl 0 v 0)
  (connect pl 0 d 0)
  (connect rate 0 v 0)
  (connect rate 0 d 0)
  (connect spd 0 ph 0)
  (connect ph 0 deg 0)
  (connect deg 0 e1 1)
  (connect daz 0 dazn 0)
  (connect dazn 0 e2 1)
  (connect v 0 e1 0)
  (connect d 0 e2 0)
  (connect e1 0 w 0)
  (connect e1 1 y 0)
  (connect e1 2 z 0)
  (connect e1 3 x 0)
  (connect e2 0 w 1)
  (connect e2 1 y 1)
  (connect e2 2 z 1)
  (connect e2 3 x 1)
  (connect w 0 r 0)
  (connect y 0 r 1)
  (connect z 0 r 2)
  (connect x 0 r 3)
  (connect rot 0 rotn 0)
  (connect rotn 0 r 4)
  (connect r 0 dec 0)
  (connect r 1 dec 1)
  (connect r 2 dec 2)
  (connect r 3 dec 3)
  (connect dec 0 g1 0)
  (connect dec 1 g2 0)
  (connect dec 2 g3 0)
  (connect dec 3 g4 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 g1 1)
  (connect ramp 0 g2 1)
  (connect ramp 0 g3 1)
  (connect ramp 0 g4 1)
  (connect g1 0 out 0)
  (connect g2 0 out 1)
  (connect g3 0 out 2)
  (connect g4 0 out 3)
  (connect g1 0 m1 0)
  (connect g2 0 m2 0)
  (connect g3 0 m3 0)
  (connect g4 0 m4 0)
  (connect lb 0 zero 0)
  (connect zero 0 daz 0)
  (connect zero 0 rot 0))
