; poly-synth.mlsp - polyphony with poly~: eight copies of polyvoice.mlsp.
; "note pitch velocity" goes to a free voice; when all eight are sounding
; the oldest is stolen. Click the chords, or turn on the arpeggiator.
; Double-click poly~ in locked mode to open voice 1.
(patch
  (obj title comment "poly~: eight voices of polyvoice.mlsp, allocated per note" (pos 20 12))
  (obj c1 comment "chords" (pos 20 40))
  (obj k1 message "note 48 100, note 55 90, note 60 90, note 64 90" (pos 20 60))
  (obj k2 message "note 45 100, note 52 90, note 60 90, note 64 90" (pos 20 90))
  (obj k3 message "note 41 100, note 48 90, note 57 90, note 60 90" (pos 20 120))
  (obj k4 message "note 43 100, note 50 90, note 59 90, note 62 90" (pos 20 150))
  (obj arp toggle (pos 400 60))
  (obj c2 comment "arpeggiator" (pos 430 61))
  (obj met metro 125 (pos 400 95))
  (obj rnd random 15 (pos 400 130))
  (obj vel random 60 (pos 520 130))
  (obj pitch expr "48 + 12 * int($f1 / 5) + 2 * ($i1 % 5) + ($i1 % 5 >= 1) + ($i1 % 5 >= 4)" (pos 400 165))
  (obj v + 50 (pos 620 130))
  (obj pk pack 0 0 (pos 400 225))
  (obj nm message "note $1 $2" (pos 400 260))
  (obj c3 comment "C minor pentatonic over three octaves" (pos 400 192))
  (obj poly poly~ polyvoice 8 (pos 20 300))
  (obj vol *~ 0.28 (pos 20 345))
  (obj d1 tapin~ 1000 (pos 200 345))
  (obj d2 tapout~ 375 500 (pos 200 385))
  (obj fb *~ 0.3 (pos 320 425))
  (obj out dac~ (pos 20 450))
  (obj sc scope~ (pos 420 330))
  (connect k1 0 poly 0)
  (connect k2 0 poly 0)
  (connect k3 0 poly 0)
  (connect k4 0 poly 0)
  (connect arp 0 met 0)
  (connect met 0 vel 0)
  (connect met 0 rnd 0)
  (connect rnd 0 pitch 0)
  (connect vel 0 v 0)
  (connect v 0 pk 1)
  (connect pitch 0 pk 0)
  (connect pk 0 nm 0)
  (connect nm 0 poly 0)
  (connect poly 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 d1 0)
  (connect d1 0 d2 0)
  (connect d2 0 out 0)
  (connect d2 1 out 1)
  (connect d2 1 fb 0)
  (connect fb 0 d1 0)
  (connect vol 0 sc 0))
