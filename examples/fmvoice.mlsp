; fmvoice.mlsp - an abstraction: one FM voice. Used by fm-bells.mlsp as
;   fmvoice <harmonicity> <index peak> <decay ms>
; A MIDI note in the inlet plays it. #1, #2 and #3 are the arguments.
(patch
  (obj c0 comment "fmvoice #1 #2 #3: harmonicity, index peak, decay ms" (pos 20 10))
  (obj in inlet (pos 20 40))
  (obj note t b f (pos 20 80))
  (obj mtof mtof (pos 120 120))
  (obj c sig~ (pos 120 160))
  (obj h sig~ #1 (pos 240 160))
  (obj mf *~ (pos 240 200))
  (obj mod cycle~ (pos 240 240))
  (obj dev *~ (pos 240 280))
  (obj idx *~ (pos 240 320))
  (obj sum +~ (pos 120 360))
  (obj car cycle~ (pos 120 400))
  (obj ienv message "#2 5 0 #3" (pos 20 160))
  (obj iline line~ (pos 20 200))
  (obj aenv message "1 5 0 #3" (pos 360 120))
  (obj aline line~ (pos 360 160))
  (obj vca *~ (pos 120 440))
  (obj out outlet~ (pos 120 480))
  (connect in 0 note 0)
  (connect note 1 mtof 0)
  (connect note 0 ienv 0)
  (connect note 0 aenv 0)
  (connect mtof 0 c 0)
  (connect c 0 mf 0)
  (connect h 0 mf 1)
  (connect mf 0 mod 0)
  (connect mod 0 dev 0)
  (connect mf 0 dev 1)
  (connect dev 0 idx 0)
  (connect ienv 0 iline 0)
  (connect iline 0 idx 1)
  (connect c 0 sum 0)
  (connect idx 0 sum 1)
  (connect sum 0 car 0)
  (connect car 0 vca 0)
  (connect aenv 0 aline 0)
  (connect aline 0 vca 1)
  (connect vca 0 out 0))
