; polyvoice.mlsp - one voice of poly-synth.mlsp, run by poly~.
; "pitch velocity" in, a plucked detuned-saw tone out. Its envelope also
; feeds thispoly~, so poly~ knows the voice is free once it fades out.
(patch
  (obj c0 comment "a poly~ voice: pitch velocity -> plucked saws" (pos 20 10))
  (obj in in (pos 20 40))
  (obj up unpack 0 0 (pos 20 80))
  (obj mtof mtof (pos 20 120))
  (obj det * 1.006 (pos 120 160))
  (obj o1 saw~ (pos 20 200))
  (obj o2 saw~ (pos 120 200))
  (obj cf * 3 (pos 220 160))
  (obj mix +~ (pos 20 245))
  (obj lp lores~ 1000 0.4 (pos 20 285))
  (obj amp expr "$f1 / 127 * 0.15" (pos 330 120))
  (obj env message "$1 4 0 1800" (pos 330 160))
  (obj line line~ (pos 330 200))
  (obj vca *~ (pos 20 330))
  (obj out out~ (pos 20 375))
  (obj tp thispoly~ (pos 330 245))
  (obj c1 comment "free when the envelope ends" (pos 420 246))
  (connect in 0 up 0)
  (connect up 0 mtof 0)
  (connect up 1 amp 0)
  (connect mtof 0 o1 0)
  (connect mtof 0 det 0)
  (connect mtof 0 cf 0)
  (connect det 0 o2 0)
  (connect cf 0 lp 1)
  (connect o1 0 mix 0)
  (connect o2 0 mix 1)
  (connect mix 0 lp 0)
  (connect amp 0 env 0)
  (connect env 0 line 0)
  (connect line 0 vca 1)
  (connect line 0 tp 0)
  (connect lp 0 vca 0)
  (connect vca 0 out 0))
