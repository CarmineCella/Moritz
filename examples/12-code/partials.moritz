; partials.moritz - a patch written with code: sixteen sine partials of a
; low note, each with its own slow tremolo, made by a loop instead of being
; drawn one by one. Change the numbers at the top and run the file again
; (Patch > Code View, then Shift-Cmd-Enter): the window follows. Freeze (Patch
; menu) keeps the boxes and lets you edit them by hand.
var partials 16
var fundamental 55
var spread 90

(patch
  (obj title comment ,(concat (str partials) " partials of " (str fundamental) " Hz, each with a slow tremolo: written by a loop") (pos 20 12))
  (obj on toggle (pos 20 45))
  (obj c-on comment "play" (pos 50 48))
  (obj vol message "$1 2000" (pos 20 80))
  (obj fade line~ (pos 20 115))
  (obj mix *~ ,(/ 0.6 partials) (pos 20 360))
  (obj level *~ (pos 20 400))
  (obj out dac~ (pos 20 440))
  (connect on 0 vol 0)
  (connect vol 0 fade 0)
  (connect mix 0 level 0)
  (connect fade 0 level 1)
  (connect level 0 out 0)
  (connect level 0 out 1)
  (each (range partials) (function (k) {
      var osc (concat "osc" (str k))
      var trem (concat "trem" (str k))
      var amp (concat "amp" (str k))
      var x (+ 20 (* (mod k 8) spread))
      var y (+ 160 (* (floor (/ k 8)) 90))
      obj ,trem cycle~ ,(* 0.07 (+ k 1)) (pos ,x ,y)
      obj ,osc cycle~ ,(* fundamental (+ k 1)) (pos ,x ,(+ y 30))
      obj ,amp *~ (pos ,x ,(+ y 60))
      connect ,osc 0 ,amp 0
      connect ,trem 0 ,amp 1
      connect ,amp 0 mix 0
  })))
