; soundtypes-levels.moritz - a march as a hierarchy of sound types (after
; SoundTypes). Level 1: every frame of sound gets a type (k-means on its
; MFCCs, centroid and level); a run of one type is a unit. Level 2: units
; grouped into gestures, cut where the next type is surprising (it rarely
; follows the one before), and the gestures clustered into types. Level 3:
; the same over gestures: the sections of the march (strains, trio,
; breakstrain) appear as long bands. Sousa, The Stars and Stripes Forever,
; U.S. Marine Band (public domain).
; topic: Music information retrieval
(patch
  (obj title comment "Sound types at three levels: frames, gestures, sections" (pos 20 12))
  (obj sub comment "The analysis runs when the patch opens. A colour is a type; click the bands to play from there, or play units of one type." (pos 20 34))
  (obj src buffer~ stlsrc sounds/Sousa_StarsAndStripes.flac (pos 20 65))
  (obj lab buffer~ stllab (pos 330 65))
  (obj tr1 buffer~ stltr1 (pos 440 65))
  (obj tr2 buffer~ stltr2 (pos 550 65))
  (obj lb loadbang (pos 20 100))
  (obj an message "types 12 6 4, levels 3, analyse stlsrc" (pos 20 130))
  (obj st soundtypes stlmarch (pos 20 165))
  (obj prog flonum (pos 20 200))
  (obj pre prepend set (pos 90 200))
  (obj units message "" (pos 90 230))
  (obj cu comment "units at levels 1 2 3" (pos 190 201))
  (obj t1 t b b b (pos 20 265))
  (obj w1 message "labels stllab" (pos 20 295))
  (obj w2 message "transitions 1 stltr1" (pos 20 322))
  (obj w3 message "transitions 2 stltr2" (pos 165 322))
  (obj l1 loadbang (pos 660 100))
  (obj s1 message "colors types, labels 1 2 3, title types at levels 1 (bottom) 2 and 3" (pos 330 130))
  (obj strips plot stllab 640 150 (pos 330 160))
  (obj wave plot stlsrc 640 60 (pos 330 320))
  (obj ccl comment "click the bands or the wave: the march plays from there" (pos 330 385))
  (obj clk message "start $1" (pos 330 405))
  (obj l2 loadbang (pos 20 360))
  (obj s2 message "title level 1 transitions" (pos 20 390))
  (obj s3 message "title level 2 transitions" (pos 170 390))
  (obj p1 plot stltr1 140 140 (pos 20 420))
  (obj p2 plot stltr2 140 140 (pos 170 420))
  (obj ctr comment "rows: from; columns: to. Few bright cells: the march is predictable" (pos 20 565))
  (obj ct comment "a unit of a type: level, type" (pos 330 450))
  (obj lv number 3 (pos 330 470))
  (obj ty number 0 (pos 390 470))
  (obj tt t b f (pos 390 500))
  (obj pk pack 1 0 (pos 330 530))
  (obj pm message "play $1 $2" (pos 330 560))
  (obj ct2 comment "level 3 type 0: a strain; level 1: a short sound of one colour" (pos 450 471))
  (obj pl message "start $1 $2" (pos 330 600))
  (obj stp message stop (pos 430 600))
  (obj play play~ stlsrc (pos 330 635))
  (obj vca *~ 0.4 (pos 330 670))
  (obj out dac~ (pos 330 705))
  (obj c9 comment "Level 3's bands follow the form: the strains, the trio from about 66 s (another key), the breakstrain, the trio again." (pos 20 745))
  (connect lb 0 an 0)
  (connect an 0 st 0)
  (connect st 0 prog 0)
  (connect st 2 pre 0)
  (connect pre 0 units 0)
  (connect st 1 t1 0)
  (connect t1 2 w1 0)
  (connect t1 1 w2 0)
  (connect t1 0 w3 0)
  (connect w1 0 st 0)
  (connect w2 0 st 0)
  (connect w3 0 st 0)
  (connect l1 0 s1 0)
  (connect s1 0 strips 0)
  (connect strips 0 clk 0)
  (connect wave 0 clk 0)
  (connect clk 0 play 0)
  (connect l2 0 s2 0)
  (connect l2 0 s3 0)
  (connect s2 0 p1 0)
  (connect s3 0 p2 0)
  (connect lv 0 pk 0)
  (connect ty 0 tt 0)
  (connect tt 1 pk 1)
  (connect tt 0 lv 0)
  (connect pk 0 pm 0)
  (connect pm 0 st 0)
  (connect st 3 pl 0)
  (connect pl 0 play 0)
  (connect stp 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
