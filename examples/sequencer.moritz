; sequencer.moritz - metro -> counter -> expr picks 8 pitches; trigger sends
; each pitch to a band-limited saw, then re-triggers a line~ envelope.
; Sliders: step time and filter cutoff. reverb~ (a stereo Freeverb
; abstraction) adds space; its number boxes set the mix and the decay T60.
; topic: First steps
(patch
  (obj title comment "step sequencer: toggle starts it, sliders shape it" (pos 20 12))
  (obj lb loadbang (pos 20 45))
  (obj on message 1 (pos 20 80))
  (obj tinit message 150 (pos 65 80))
  (obj lb2 loadbang (pos 300 335))
  (obj cinit message 1500 (pos 300 370))
  (obj tog toggle (pos 20 120))
  (obj tempo slider 60 400 (pos 60 120))
  (obj tlabel comment "step (ms)" (pos 205 121))
  (obj met metro 150 (pos 20 165))
  (obj cnt counter 0 7 (pos 20 205))
  (obj pitch expr "45 + ($i1 % 4) * 7 % 12 + 12 * int($i1 / 4)" (pos 20 245))
  (obj m2f mtof (pos 20 285))
  (obj trig t b f (pos 20 325))
  (obj env message "1 4 0 220" (pos 20 365))
  (obj line line~ (pos 20 405))
  (obj saw saw~ 110 (pos 120 365))
  (obj vca *~ (pos 120 445))
  (obj cut slider 200 4000 (pos 300 405))
  (obj clabel comment "cutoff (Hz)" (pos 445 406))
  (obj filt lores~ 1500 0.6 (pos 120 485))
  (obj vol *~ 0.2 (pos 120 525))
  (obj rv reverb~ 0.25 1.5 (pos 120 565))
  (obj mix flonum 0.25 (pos 495 525))
  (obj mlabel comment "reverb mix" (pos 570 526))
  (obj t60 flonum 1.5 (pos 495 565))
  (obj tlabel2 comment "reverb T60 (s)" (pos 570 566))
  (obj out dac~ (pos 120 615))
  (obj lvl meter~ (pos 250 485))
  (obj sc scope~ (pos 290 485))
  (connect lb 0 on 0)
  (connect lb 0 tinit 0)
  (connect lb2 0 cinit 0)
  (connect on 0 tog 0)
  (connect tinit 0 tempo 0)
  (connect cinit 0 cut 0)
  (connect tog 0 met 0)
  (connect tempo 0 met 1)
  (connect met 0 cnt 0)
  (connect cnt 0 pitch 0)
  (connect pitch 0 m2f 0)
  (connect m2f 0 trig 0)
  (connect trig 1 saw 0)
  (connect trig 0 env 0)
  (connect env 0 line 0)
  (connect saw 0 vca 0)
  (connect line 0 vca 1)
  (connect vca 0 filt 0)
  (connect cut 0 filt 1)
  (connect filt 0 vol 0)
  (connect vol 0 rv 0)
  (connect mix 0 rv 1)
  (connect t60 0 rv 2)
  (connect rv 0 out 0)
  (connect rv 1 out 1)
  (connect vca 0 lvl 0)
  (connect vca 0 sc 0))
