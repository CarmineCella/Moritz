; synth.mlsp - click a note: trigger sends the pitch to a pulse and a
; triangle oscillator, then bangs a line~ envelope (attack, decay, release).
(patch
  (obj title comment "click a note (patch locked); the slider sets the pulse width" (pos 20 12))
  (obj n1 message 60 (pos 20 40))
  (obj n2 message 63 (pos 62 40))
  (obj n3 message 67 (pos 104 40))
  (obj n4 message 70 (pos 146 40))
  (obj n5 message 72 (pos 188 40))
  (obj note number 60 (pos 20 85))
  (obj trig t b f (pos 20 125))
  (obj env message "1 8 0.4 150 0 1200" (pos 20 165))
  (obj line line~ (pos 20 205))
  (obj m2f mtof (pos 180 165))
  (obj pulse rect~ 262 0.5 (pos 180 205))
  (obj tri tri~ 262 (pos 300 205))
  (obj duty slider 0.05 0.95 (pos 380 125))
  (obj dlabel comment "pulse width" (pos 525 126))
  (obj dinit loadbang (pos 380 85))
  (obj dval message 0.5 (pos 460 85))
  (obj mix +~ (pos 180 250))
  (obj vca *~ (pos 180 290))
  (obj vol *~ 0.25 (pos 180 330))
  (obj out dac~ (pos 180 380))
  (obj sc scope~ (pos 330 290))
  (connect n1 0 note 0)
  (connect n2 0 note 0)
  (connect n3 0 note 0)
  (connect n4 0 note 0)
  (connect n5 0 note 0)
  (connect note 0 trig 0)
  (connect trig 1 m2f 0)
  (connect trig 0 env 0)
  (connect env 0 line 0)
  (connect m2f 0 pulse 0)
  (connect m2f 0 tri 0)
  (connect dinit 0 dval 0)
  (connect dval 0 duty 0)
  (connect duty 0 pulse 1)
  (connect pulse 0 mix 0)
  (connect tri 0 mix 1)
  (connect mix 0 vca 0)
  (connect line 0 vca 1)
  (connect vca 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vca 0 sc 0))
