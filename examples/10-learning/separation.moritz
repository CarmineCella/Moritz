; separation.moritz - offline separation, as background jobs (the patch
; keeps playing while they work). Left: hpss splits hpss_demo.wav into its
; sustained, harmonic part and its attacks; the two add up to the original.
; Right: nmf factorises stems_demo.wav, a mix of four stems (drums, bass,
; chords, melody), into four parts, one per channel. Nothing tells nmf which
; part is which instrument: a part may take a whole stem, half of one, or
; bits of two.
(patch
  (obj title comment "separation: hpss (harmonic / percussive) on hpss_demo.wav, nmf (four parts) on a four-stem mix" (pos 20 12))
  (obj bsrc buffer~ sephp hpss_demo.wav (pos 20 40))
  (obj bh buffer~ sepharm (pos 20 62))
  (obj bp buffer~ sepperc (pos 130 62))
  (obj dsrc buffer~ sepstems stems_demo.wav (pos 460 40))
  (obj dp buffer~ sepparts (pos 460 62))
  (obj hrun message "run sephp sepharm sepperc" (pos 20 90))
  (obj hp hpss (pos 20 125))
  (obj hprog flonum (pos 20 160))
  (obj hdone button (pos 100 160))
  (obj chp comment "progress, done" (pos 130 163))
  (obj hs1 message start (pos 20 200))
  (obj hs2 message start (pos 115 200))
  (obj hs3 message start (pos 210 200))
  (obj hst message stop (pos 305 200))
  (obj o play~ sephp (pos 20 235))
  (obj h play~ sepharm (pos 115 235))
  (obj p play~ sepperc (pos 210 235))
  (obj chs comment "original, harmonic, percussive" (pos 20 265))
  (obj hw1 waveform~ sepharm 380 50 (pos 20 290))
  (obj hw2 waveform~ sepperc 380 50 (pos 20 345))
  (obj nrun message "run sepstems sepparts" (pos 460 90))
  (obj nm nmf 4 100 (pos 460 125))
  (obj nprog flonum (pos 460 160))
  (obj ndone button (pos 540 160))
  (obj cn comment "progress, done" (pos 570 163))
  (obj go message "start, loop 1" (pos 460 200))
  (obj ns message stop (pos 560 200))
  (obj pp play~ sepparts 4 (pos 460 235))
  (obj g1 message 1 (pos 460 270))
  (obj g2 message 2 (pos 495 270))
  (obj g3 message 3 (pos 530 270))
  (obj g4 message 4 (pos 565 270))
  (obj g5 message 5 (pos 600 270))
  (obj cg comment "part 1..4, 5 all" (pos 640 271))
  (obj a1 +~ (pos 760 235))
  (obj a2 +~ (pos 760 265))
  (obj a3 +~ (pos 760 295))
  (obj sel selector~ 5 5 (pos 460 305))
  (obj nw waveform~ sepparts 330 100 (pos 460 345))
  (obj mix +~ (pos 20 410))
  (obj on message "0.4 50" (pos 20 450))
  (obj off message "0 50" (pos 85 450))
  (obj cv comment "volume" (pos 140 451))
  (obj ramp line~ (pos 20 485))
  (obj vca *~ (pos 160 485))
  (obj out dac~ (pos 160 520))
  (connect hrun 0 hp 0)
  (connect hp 0 hprog 0)
  (connect hp 1 hdone 0)
  (connect hs1 0 o 0)
  (connect hs2 0 h 0)
  (connect hs3 0 p 0)
  (connect hst 0 o 0)
  (connect hst 0 h 0)
  (connect hst 0 p 0)
  (connect o 0 mix 0)
  (connect h 0 mix 0)
  (connect p 0 mix 0)
  (connect nrun 0 nm 0)
  (connect nm 0 nprog 0)
  (connect nm 1 ndone 0)
  (connect go 0 pp 0)
  (connect ns 0 pp 0)
  (connect pp 0 sel 1)
  (connect pp 1 sel 2)
  (connect pp 2 sel 3)
  (connect pp 3 sel 4)
  (connect pp 0 a1 0)
  (connect pp 1 a1 1)
  (connect a1 0 a2 0)
  (connect pp 2 a2 1)
  (connect a2 0 a3 0)
  (connect pp 3 a3 1)
  (connect a3 0 sel 5)
  (connect g1 0 sel 0)
  (connect g2 0 sel 0)
  (connect g3 0 sel 0)
  (connect g4 0 sel 0)
  (connect g5 0 sel 0)
  (connect sel 0 mix 0)
  (connect mix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
