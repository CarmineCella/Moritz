; render.moritz - a piece rendered to a sound file: the timeline's Render... writes the score as a
; stereo WAV file, faster than real time, with the tracks' strips (gain, pan, mute, solo) and the
; clips' fades as the score box plays them. Here a short arrangement of the stems, kept in the patch;
; once rendered, the file is read into a buffer~ and played beside the score, to compare.
; Try: 1. play: the score itself; 2. right-click the score box, Open as Timeline, then Render...:
; save it as render.wav next to this patch; 3. read render.wav, then start: the file sounds as the
; score did; 4. mute a track in the timeline and render again: the file follows the strips; 5.
; double-click the buffer~: the rendered file in the sound editor.
(patch
  (obj title comment "a piece rendered to a file: the timeline's Render... writes the score as a stereo WAV" (pos 20 12))
  (obj sub comment "Open as Timeline (right-click the score), Render..., save it as render.wav here; then read it and listen" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loc message "locate 1" (pos 110 70))
  (obj tr transport 100 4 4 (pos 180 70))
  (obj sc score arrangement @size 600 180 (pos 20 105)
    (script
      "; eight bars of the stems: the chords alone, then the bass, then the melody, fading out"
      "(score \"arrangement\""
      "  (sr 44100) (bpm 100) (meter 4 4) (next-id 5)"
      "  (row chords (data az 30))"
      "  (row bass)"
      "  (row melody (data az -30) (data gain 0.9))"
      "  (row drums (data gain 0.7))"
      "  (sound 0 19.2 \"stems_chords.wav\" (id 1) (to 19.2) (row chords) (data fade-in 1.2))"
      "  (sound 4.8 14.4 \"stems_bass.wav\" (id 2) (from 4.8) (to 19.2) (row bass))"
      "  (sound 9.6 9.6 \"stems_melody.wav\" (id 3) (from 9.6) (to 19.2) (row melody) (data fade-out 4.8))"
      "  (sound 9.6 9.6 \"stems_drums.wav\" (id 4) (from 9.6) (to 19.2) (row drums) (data fade-out 4.8)))"))
  (obj buf buffer~ rendermix (pos 20 300))
  (obj rd message "read render.wav" (pos 160 300))
  (obj crd comment "the rendered file, next to this patch (write it first)" (pos 280 301))
  (obj p0 message start (pos 20 335))
  (obj p1 message stop (pos 70 335))
  (obj cp comment "the file" (pos 120 336))
  (obj pl play~ rendermix 2 (pos 20 365))
  (obj wf waveform~ rendermix 400 60 (pos 200 365))
  (obj lb loadbang (pos 300 440))
  (obj vol message "0.9 200" (pos 300 470))
  (obj mute message "0 200" (pos 370 470))
  (obj cv comment "volume" (pos 430 471))
  (obj ramp line~ (pos 300 505))
  (obj vl *~ (pos 20 540))
  (obj vr *~ (pos 120 540))
  (obj out dac~ (pos 20 580))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loc 0 tr 0)
  (connect rd 0 buf 0)
  (connect p0 0 pl 0)
  (connect p1 0 pl 0)
  (connect lb 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect pl 0 vl 0)
  (connect pl 1 vr 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
