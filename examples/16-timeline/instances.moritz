; instances.moritz - a sub-score placed several times: cell.score (three slices of stems_drums.wav,
; a bar) is placed six times in the score kept in this patch, each placement an instance of the
; same cell, with its own start, gain, pan, transposition (its sounds faster and higher) and stretch
; (its slices further apart). An edit inside the cell is heard in every placement; Make Unique gives
; one placement a copy of its own, edited alone.
; Try: 1. play; 2. right-click the score box, Open as Timeline: the placements are clips on two
; tracks; click one: its start, length, stretch, transpose and gain in the inspector; 3. double-
; click a placement: the cell's own timeline (the breadcrumb shows where); drag a slice: all six
; follow; Save writes cell.score; Esc or the breadcrumb goes back up; 4. select the last placement,
; Make Unique, then edit it: only that one changes.
(patch
  (obj title comment "instances: one drum bar (cell.score) placed six times, transposed, stretched, panned" (pos 20 12))
  (obj sub comment "Open as Timeline (right-click the score), double-click a placement: the cell itself; Make Unique: a copy" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loc message "locate 1" (pos 110 70))
  (obj loop message "loop 1 5" (pos 180 70))
  (obj noloop message "loop 0" (pos 250 70))
  (obj tr transport 100 4 4 (pos 320 70))
  (obj sc score groove @size 600 200 (pos 20 105)
    (script
      "; cell.score placed six times: (score at file (gain g) (az a) (transpose n) (stretch k) (row name))"
      "(score \"groove\""
      "  (sr 44100) (bpm 100) (meter 4 4) (next-id 7)"
      "  (row left (data az 45))"
      "  (row right (data az -45))"
      "  (score 0 \"cell.score\" (id 1) (row left))"
      "  (score 2.4 \"cell.score\" (id 2) (row right))"
      "  (score 4.8 \"cell.score\" (id 3) (row left) (transpose 5) (gain 0.8))"
      "  (score 7.2 \"cell.score\" (id 4) (row right) (transpose -5))"
      "  (score 9.6 \"cell.score\" (id 5) (row left) (stretch 2) (gain 0.9))"
      "  (score 14.4 \"cell.score\" (id 6) (row right) (transpose 12) (stretch 0.5) (gain 0.7)))"))
  (obj cs comment "a bar each: as it is, left then right; a fourth up, a fourth down; twice as slow; an octave up, twice as fast" (pos 20 310))
  (obj lb loadbang (pos 300 340))
  (obj vol message "0.7 200" (pos 300 370))
  (obj mute message "0 200" (pos 370 370))
  (obj cv comment "volume" (pos 430 371))
  (obj ramp line~ (pos 300 405))
  (obj vl *~ (pos 20 440))
  (obj vr *~ (pos 120 440))
  (obj out dac~ (pos 20 480))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loc 0 tr 0)
  (connect loop 0 tr 0)
  (connect noloop 0 tr 0)
  (connect lb 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
