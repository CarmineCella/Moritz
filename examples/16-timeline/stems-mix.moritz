; stems-mix.moritz - four stems of one song (drums, bass, chords, melody) arranged on four tracks of
; a score kept in this patch, each track with its strip: gain, pan (an azimuth: left positive), mute
; and solo. The bass starts muted, the chords sit left, the melody right; the drums come in after
; two bars and the melody only for the second half. The score's playback follows the strips.
; Try: 1. play; 2. right-click the score box, Open as Timeline: a track a stem; click M on the bass
; to unmute it, S on the drums to hear them alone (S again: all); 3. click a track's name: its gain
; and pan in the inspector; pan the chords to -60; 4. drag the melody clip earlier, drag its left
; edge to trim it, S splits it at the playhead; Edit > Undo; 5. Save the patch: the arrangement is
; kept inside it.
(patch
  (obj title comment "stems arranged on tracks: gain, pan, mute and solo, the playback following the strips" (pos 20 12))
  (obj sub comment "right-click the score: Open as Timeline; M and S in each track's header, gain and pan in the inspector" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loc message "locate 1" (pos 110 70))
  (obj l5 message "locate 5" (pos 180 70))
  (obj tr transport 100 4 4 (pos 250 70))
  (obj sc score stems @size 600 200 (pos 20 105)
    (script
      "; four stems, a track each: the strip of a track is its row's data (gain, az, mute, solo)"
      "(score \"stems\""
      "  (sr 44100) (bpm 100) (meter 4 4) (next-id 5)"
      "  (row drums (data gain 0.8))"
      "  (row bass (data mute 1))"
      "  (row chords (data az 40))"
      "  (row melody (data az -40))"
      "  (sound 4.8 14.4 \"stems_drums.wav\" (id 1) (from 4.8) (to 19.2) (row drums))"
      "  (sound 0 19.2 \"stems_bass.wav\" (id 2) (to 19.2) (row bass))"
      "  (sound 0 19.2 \"stems_chords.wav\" (id 3) (to 19.2) (row chords) (data fade-in 2.4))"
      "  (sound 9.6 9.6 \"stems_melody.wav\" (id 4) (from 9.6) (to 19.2) (row melody) (data fade-out 2.4)))"))
  (obj cs comment "the drums from bar 3, the bass muted, the chords left and fading in, the melody right in the second half" (pos 20 310))
  (obj lb loadbang (pos 300 340))
  (obj vol message "0.9 200" (pos 300 370))
  (obj mute message "0 200" (pos 370 370))
  (obj cv comment "volume" (pos 430 371))
  (obj ramp line~ (pos 300 405))
  (obj vl *~ (pos 20 440))
  (obj vr *~ (pos 120 440))
  (obj out dac~ (pos 20 480))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loc 0 tr 0)
  (connect l5 0 tr 0)
  (connect lb 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
