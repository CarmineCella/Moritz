; timeline.moritz - a score of four stems (piece.score, next to this patch) played on the transport, and an
; automation lane of the score that drives this patch's receive "cutoff": the mix goes through a low-pass filter
; whose cutoff follows the lane. Double-click the score box: its window opens in the Timeline view (the box's
; @view timeline); Roll, Piano roll and List, at its top, show the same score in the same window. Move, trim and
; split the clips, mute or solo a track, draw points on the lane, drag a track's lower edge to size it; a click on
; the track filter's lane name selects the receive it drives here; Space plays from the playhead; then Save writes
; piece.score again.
(patch
  (obj title comment "timeline: a score seen as tracks, its automation lane driving the patch" (pos 20 12))
  (obj tip comment "double-click the score: its timeline (Roll, Piano roll, List: the same score, at the window's top)" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loc message "locate 1" (pos 110 70))
  (obj loop message "loop 3 7" (pos 180 70))
  (obj noloop message "loop 0" (pos 250 70))
  (obj tr transport 100 4 4 (pos 320 70))
  (obj sc score piece piece.score @view timeline (pos 20 110))
  (obj rc r cutoff (pos 300 160))
  (obj nb number (pos 300 190))
  (obj ramp message "$1 80" (pos 300 220))
  (obj ln line~ 400 (pos 300 250))
  (obj cc comment "the lane's points, each at its time: a ramp of 80 ms to each" (pos 380 191))
  (obj fl lores~ 400 0.2 (pos 20 290))
  (obj fr lores~ 400 0.2 (pos 120 290))
  (obj gain *~ 0.8 (pos 20 330))
  (obj gainr *~ 0.8 (pos 120 330))
  (obj out dac~ (pos 20 370))
  (obj cs comment "the four stems, each track with its gain and pan, mixed in stereo" (pos 220 111))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loc 0 tr 0)
  (connect loop 0 tr 0)
  (connect noloop 0 tr 0)
  (connect rc 0 nb 0)
  (connect nb 0 ramp 0)
  (connect ramp 0 ln 0)
  (connect ln 0 fl 1)
  (connect ln 0 fr 1)
  (connect sc 0 fl 0)
  (connect sc 1 fr 0)
  (connect fl 0 gain 0)
  (connect fr 0 gainr 0)
  (connect gain 0 out 0)
  (connect gainr 0 out 1))
