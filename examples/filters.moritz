; filters.moritz - a saw through svf~, its cutoff swept by a phasor~ LFO
; scaled in the signal domain. Left: low-pass, right: band-pass.
(patch
  (obj title comment "svf~ swept by phasor~: left = low-pass, right = band-pass" (pos 20 12))
  (obj src saw~ 55 (pos 20 50))
  (obj rate flonum 0.2 (pos 150 45))
  (obj rlabel comment "sweep rate (Hz)" (pos 215 46))
  (obj lfo phasor~ 0.2 (pos 150 85))
  (obj depth *~ 2000 (pos 150 125))
  (obj base +~ 200 (pos 150 165))
  (obj f svf~ 800 0.8 (pos 20 210))
  (obj lb loadbang (pos 350 125))
  (obj qinit message 0.8 (pos 350 160))
  (obj q slider 0 0.99 (pos 350 200))
  (obj qlabel comment "resonance" (pos 495 201))
  (obj lo *~ 0.3 (pos 20 260))
  (obj bp *~ 0.6 (pos 120 260))
  (obj out dac~ (pos 20 310))
  (obj sc scope~ (pos 200 260))
  (connect src 0 f 0)
  (connect rate 0 lfo 0)
  (connect lfo 0 depth 0)
  (connect depth 0 base 0)
  (connect base 0 f 1)
  (connect lb 0 qinit 0)
  (connect qinit 0 q 0)
  (connect q 0 f 2)
  (connect f 0 lo 0)
  (connect f 2 bp 0)
  (connect lo 0 out 0)
  (connect bp 0 out 1)
  (connect lo 0 sc 0))
