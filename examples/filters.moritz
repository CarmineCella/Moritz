; filters.moritz - filters, two ways. Top: a saw through svf~, its cutoff
; swept by a phasor~ LFO scaled in the signal domain (left: low-pass, right:
; band-pass). Bottom: filter design. filterdesign computes the coefficients
; of a biquad~ for eight classic shapes (Robert Bristow-Johnson's cookbook,
; as in Musil), from a frequency, a Q and a gain; filterplot draws the
; frequency response. Drag on the plot to move the filter.
(patch
  (obj title comment "1. svf~ swept by phasor~: left = low-pass, right = band-pass" (pos 20 12))
  (obj src saw~ 55 (pos 20 50))
  (obj rate flonum 0.2 (pos 150 45))
  (obj rlabel comment "sweep rate (Hz)" (pos 215 46))
  (obj lfo phasor~ 0.2 (pos 150 85))
  (obj depth *~ 2000 (pos 150 125))
  (obj base +~ 200 (pos 150 165))
  (obj f svf~ 800 0.8 (pos 20 210))
  (obj lb loadbang (pos 350 125))
  (obj qinit message 0.8 (pos 350 160))
  (obj q slider 0 0.99 (pos 350 200))
  (obj qlabel comment "resonance" (pos 495 201))
  (obj lo *~ 0.3 (pos 20 260))
  (obj bp *~ 0.6 (pos 120 260))
  (obj out dac~ (pos 20 310))
  (obj sc scope~ (pos 200 260))
  (obj t2 comment "2. Filter design: choose a type, then move the frequency, Q and gain, or drag on the plot" (pos 20 380))
  (obj ty1 message lowpass (pos 20 410))
  (obj ty2 message highpass (pos 90 410))
  (obj ty3 message bandpass (pos 165 410))
  (obj ty4 message notch (pos 245 410))
  (obj ty5 message peak (pos 300 410))
  (obj ty6 message lowshelf (pos 350 410))
  (obj ty7 message highshelf (pos 425 410))
  (obj ty8 message allpass (pos 505 410))
  (obj cfr comment "frequency (log)" (pos 20 445))
  (obj fr slider 0. 1. (pos 20 465))
  (obj frhz expr "20 * pow(1000, $f1)" (pos 20 500))
  (obj frn flonum (pos 165 500))
  (obj cfrn comment "Hz" (pos 230 501))
  (obj cq comment "Q" (pos 280 445))
  (obj q2 slider 0.3 20 (pos 280 465))
  (obj q2n flonum (pos 280 500))
  (obj cg comment "gain (dB): peak and shelves" (pos 440 445))
  (obj g slider -24 24 (pos 440 465))
  (obj gn number (pos 440 500))
  (obj fd filterdesign lowpass 1000 0.707 0 (pos 20 545))
  (obj coef message "-" (pos 20 580))
  (obj setc message "set $1 $2 $3 $4 $5" (pos 270 545))
  (obj ccoef comment "a0 a1 a2 b1 b2, for biquad~" (pos 300 581))
  (obj plot filterplot 420 160 (pos 600 445))
  (obj drag unpack 0. 0. (pos 600 615))
  (obj tofr expr "log($f1 / 20.) / log(1000.)" (pos 600 650))
  (obj cdrag comment "dragging the plot moves the frequency (and the gain)" (pos 600 680))
  (obj s1 message 1 (pos 20 625))
  (obj s2 message 2 (pos 60 625))
  (obj csrc comment "source: 1 noise, 2 Beethoven" (pos 100 626))
  (obj nz noise~ (pos 20 655))
  (obj nzg *~ 0.2 (pos 20 690))
  (obj bb buffer~ fltbeet sounds/Beethoven_Symph7.wav (pos 120 655))
  (obj pb message "loop 1, 36000" (pos 425 655))
  (obj bg groove~ fltbeet (pos 425 690))
  (obj br sig~ 1 (pos 545 655))
  (obj src2 selector~ 2 1 (pos 20 730))
  (obj bq biquad~ (pos 20 770))
  (obj spec spectroscope~ 420 110 (pos 600 730))
  (obj on2 message "0.4 50" (pos 200 810))
  (obj off2 message "0 50" (pos 265 810))
  (obj cvol2 comment "volume" (pos 320 811))
  (obj ramp2 line~ (pos 200 845))
  (obj vca2 *~ (pos 20 845))
  (obj lb2 loadbang (pos 620 380))
  (obj init2 message "0.5 0.707 0" (pos 700 380))
  (obj iu unpack 0. 0. 0 (pos 820 380))
  (connect src 0 f 0)
  (connect rate 0 lfo 0)
  (connect lfo 0 depth 0)
  (connect depth 0 base 0)
  (connect base 0 f 1)
  (connect lb 0 qinit 0)
  (connect qinit 0 q 0)
  (connect q 0 f 2)
  (connect f 0 lo 0)
  (connect f 2 bp 0)
  (connect lo 0 out 0)
  (connect bp 0 out 1)
  (connect lo 0 sc 0)
  (connect ty1 0 fd 0)
  (connect ty2 0 fd 0)
  (connect ty3 0 fd 0)
  (connect ty4 0 fd 0)
  (connect ty5 0 fd 0)
  (connect ty6 0 fd 0)
  (connect ty7 0 fd 0)
  (connect ty8 0 fd 0)
  (connect fr 0 frhz 0)
  (connect frhz 0 frn 0)
  (connect frn 0 fd 0)
  (connect q2 0 q2n 0)
  (connect q2n 0 fd 1)
  (connect g 0 gn 0)
  (connect gn 0 fd 2)
  (connect fd 0 setc 0)
  (connect setc 0 coef 0)
  (connect fd 0 plot 0)
  (connect fd 0 bq 0)
  (connect plot 0 drag 0)
  (connect drag 0 tofr 0)
  (connect drag 1 g 0)
  (connect tofr 0 fr 0)
  (connect s1 0 src2 0)
  (connect s2 0 src2 0)
  (connect nz 0 nzg 0)
  (connect nzg 0 src2 1)
  (connect pb 0 bg 0)
  (connect br 0 bg 0)
  (connect bg 0 src2 2)
  (connect src2 0 bq 0)
  (connect bq 0 spec 0)
  (connect bq 0 vca2 0)
  (connect on2 0 ramp2 0)
  (connect off2 0 ramp2 0)
  (connect ramp2 0 vca2 1)
  (connect vca2 0 out 0)
  (connect vca2 0 out 1)
  (connect lb2 0 init2 0)
  (connect lb2 0 pb 0)
  (connect init2 0 iu 0)
  (connect iu 0 fr 0)
  (connect iu 1 q2 0)
  (connect iu 2 g 0))
