; follower.moritz - descriptors~ listening to a voice (Vox.wav) and driving a
; synthesizer: f0 sets the pitch of a sawtooth, the centroid (brightness)
; opens its filter, the rms level shapes its amplitude. Mix it with the
; voice, or hear it alone; the numbers show what descriptors~ measures.
(patch
  (obj title comment "descriptors~ -> synthesis: f0, centroid and rms of the voice drive a filtered sawtooth" (pos 20 12))
  (obj buf buffer~ follvoice sounds/Vox.wav (pos 20 45))
  (obj lb loadbang (pos 310 45))
  (obj lp message "loop 1" (pos 310 75))
  (obj one sig~ 1 (pos 400 75))
  (obj gr groove~ follvoice (pos 20 110))
  (obj d descriptors~ 2048 512 f0 centroid rms periodicity (pos 20 150))
  (obj f0 flonum (pos 20 195))
  (obj cen flonum (pos 110 195))
  (obj rms flonum (pos 200 195))
  (obj per flonum (pos 290 195))
  (obj cn comment "f0 (Hz), centroid (Hz), rms, periodicity" (pos 380 196))
  (obj voiced sel 0 (pos 20 235))
  (obj fl message "$1 30" (pos 90 235))
  (obj osc saw~ (pos 90 295))
  (obj cl message "$1 30" (pos 200 235))
  (obj cut line~ (pos 200 265))
  (obj filt lores~ 1000 0.5 (pos 90 330))
  (obj al message "$1 30" (pos 290 235))
  (obj amp line~ (pos 290 265))
  (obj boost *~ 3 (pos 290 295))
  (obj vca *~ (pos 90 365))
  (obj fline line~ (pos 90 265))
  (obj m1 message 1 (pos 380 270))
  (obj m2 message 0.5 (pos 420 270))
  (obj m3 message 0 (pos 470 270))
  (obj cm comment "1 synth only, 0.5 both, 0 the voice" (pos 510 271))
  (obj mix line~ (pos 380 305))
  (obj inv expr~ "1 - $v1" (pos 380 340))
  (obj ws *~ (pos 90 400))
  (obj wv *~ (pos 200 400))
  (obj sum +~ (pos 90 435))
  (obj spec spectroscope~ 300 90 (pos 380 400))
  (obj on message "0.15 50" (pos 200 450))
  (obj off message "0 50" (pos 270 450))
  (obj cv comment "volume" (pos 330 451))
  (obj ramp line~ (pos 200 485))
  (obj vol *~ (pos 90 485))
  (obj out dac~ (pos 90 520))
  (obj init message 0.5 (pos 380 235))
  (connect lb 0 lp 0)
  (connect lb 0 init 0)
  (connect lp 0 gr 0)
  (connect one 0 gr 0)
  (connect gr 0 d 0)
  (connect d 0 f0 0)
  (connect d 1 cen 0)
  (connect d 2 rms 0)
  (connect d 3 per 0)
  (connect f0 0 voiced 0)
  (connect voiced 1 fl 0)
  (connect fl 0 fline 0)
  (connect fline 0 osc 0)
  (connect cen 0 cl 0)
  (connect cl 0 cut 0)
  (connect cut 0 filt 1)
  (connect osc 0 filt 0)
  (connect rms 0 al 0)
  (connect al 0 amp 0)
  (connect amp 0 boost 0)
  (connect filt 0 vca 0)
  (connect boost 0 vca 1)
  (connect m1 0 mix 0)
  (connect m2 0 mix 0)
  (connect m3 0 mix 0)
  (connect init 0 mix 0)
  (connect mix 0 ws 1)
  (connect mix 0 inv 0)
  (connect inv 0 wv 1)
  (connect vca 0 ws 0)
  (connect gr 0 wv 0)
  (connect ws 0 sum 0)
  (connect wv 0 sum 1)
  (connect sum 0 vol 0)
  (connect sum 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vol 1)
  (connect vol 0 out 0)
  (connect vol 0 out 1))
