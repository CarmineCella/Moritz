; maple-atoms.moritz - a sound broken into atoms by matching pursuit (after
; the author's Maple): the strongest windowed cosine first, subtracted, then
; the next, until the sound is explained. The atom map shows each atom as a
; dot (time, frequency; colour: level): a bell's partials are lines, its
; strike a burst of short atoms. Rebuilt from its atoms, a sound can be
; transposed and stretched freely (each atom keeps its own length, so
; nothing smears), or made of its strongest atoms only.
; topic: Spectral
(patch
  (obj title comment "A sound in atoms: matching pursuit with Gabor and gammatone atoms" (pos 20 12))
  (obj sub comment "Choose a sound, a dictionary and how many atoms; the atom map fills in. Then rebuild it: transposed, stretched, from its strongest atoms." (pos 20 34))
  (obj b1 buffer~ mabell sounds/archeos-bell.wav (pos 20 65))
  (obj b2 buffer~ mavox sounds/Vox.wav (pos 260 65))
  (obj b3 buffer~ magong sounds/gong_c_sharp.wav (pos 450 65))
  (obj bk buffer~ mabook (pos 720 65))
  (obj rs buffer~ mares (pos 830 65))
  (obj sy buffer~ masyn (pos 930 65))
  (obj cd comment "dictionary:" (pos 20 100))
  (obj d1 message "gabor 128 8192" (pos 100 98))
  (obj d2 message "gammatone 128 8192" (pos 220 98))
  (obj cd2 comment "Gaussian windows, or a sharp attack and slow decay" (pos 365 100))
  (obj d atoms madict (pos 20 130))
  (obj cn comment "atoms:" (pos 20 165))
  (obj n1 message "atoms 100" (pos 75 163))
  (obj n2 message "atoms 1000" (pos 155 163))
  (obj n3 message "atoms 5000" (pos 240 163))
  (obj cn2 comment "(or 40 dB down)" (pos 330 165))
  (obj cs comment "sound:" (pos 20 195))
  (obj s1 message "run mabell madict mabook mares" (pos 75 193))
  (obj s2 message "run magong madict mabook mares" (pos 75 220))
  (obj s3 message "run mavox madict mabook mares" (pos 75 247))
  (obj cs2 comment "a bell, a gong, a voice" (pos 300 220))
  (obj an pursuit (pos 20 285))
  (obj prog flonum (pos 20 320))
  (obj na number (pos 90 320))
  (obj snr flonum (pos 160 320))
  (obj cpo comment "progress, atoms, signal/residual (dB)" (pos 230 321))
  (obj l1 loadbang (pos 20 360))
  (obj init message "gabor 128 8192" (pos 20 390))
  (obj init2 message "atoms 1000, snr 40, run mabell madict mabook mares" (pos 20 420))
  (obj l2 loadbang (pos 880 125))
  (obj sc message "ylog 1, title the atom map: time and frequency (colour: level)" (pos 520 125))
  (obj map plot mabook 460 300 scatter (pos 520 160))
  (obj ccl comment "click the map: play the sound from there" (pos 520 465))
  (obj clk message "start $1" (pos 520 485))
  (obj c3 comment "rebuild from the atoms:" (pos 20 470))
  (obj cr comment "transposition (ratio)" (pos 20 495))
  (obj ra slider 0.25 4. (pos 20 515))
  (obj cst comment "stretch" (pos 180 495))
  (obj st slider 0.25 8. (pos 180 515))
  (obj ck comment "keep (strongest share)" (pos 340 495))
  (obj ke slider 0.01 1. (pos 340 515))
  (obj tr t b f (pos 20 545))
  (obj ts t b f (pos 180 545))
  (obj tk t b f (pos 340 545))
  (obj rm message "ratio $1" (pos 20 575))
  (obj sm message "stretch $1" (pos 180 575))
  (obj km message "keep $1" (pos 340 575))
  (obj sy1 message "synth mabook madict masyn" (pos 20 610))
  (obj syn pursuit (pos 20 645))
  (obj l3 loadbang (pos 450 545))
  (obj set1 message "set 1" (pos 450 575))
  (obj cl comment "listen:" (pos 20 690))
  (obj p0 message start (pos 75 688))
  (obj p1 message start (pos 155 688))
  (obj p2 message start (pos 235 688))
  (obj stp message stop (pos 315 688))
  (obj cl2 comment "the sound, rebuilt, residual (what the atoms leave)" (pos 370 690))
  (obj a0 play~ mabell (pos 75 750))
  (obj a1 play~ masyn (pos 155 750))
  (obj a2 play~ mares (pos 235 750))
  (obj mix +~ (pos 75 785))
  (obj vca *~ 0.4 (pos 75 815))
  (obj out dac~ (pos 75 850))
  (obj c4 comment "Fewer atoms keep the strongest partials (the sound's skeleton); a stretched bell rings longer without blurring its strike." (pos 520 510))
  (obj c5 comment "The voice needs many more atoms than the bell: noise is expensive to explain with sinusoids (listen to the residual)." (pos 520 528))
  (obj w1 message "set mabell" (pos 75 720))
  (obj w2 message "set magong" (pos 160 720))
  (obj w3 message "set mavox" (pos 245 720))
  (connect d1 0 d 0)
  (connect d2 0 d 0)
  (connect n1 0 an 0)
  (connect n2 0 an 0)
  (connect n3 0 an 0)
  (connect s1 0 an 0)
  (connect s2 0 an 0)
  (connect s3 0 an 0)
  (connect an 0 prog 0)
  (connect an 2 na 0)
  (connect an 3 snr 0)
  (connect an 1 sy1 0)
  (connect l1 0 init 0)
  (connect init 0 d 0)
  (connect d 1 init2 0)
  (connect init2 0 an 0)
  (connect l2 0 sc 0)
  (connect sc 0 map 0)
  (connect map 0 clk 0)
  (connect clk 0 a0 0)
  (connect ra 0 tr 0)
  (connect st 0 ts 0)
  (connect ke 0 tk 0)
  (connect tr 1 rm 0)
  (connect ts 1 sm 0)
  (connect tk 1 km 0)
  (connect tr 0 sy1 0)
  (connect ts 0 sy1 0)
  (connect tk 0 sy1 0)
  (connect rm 0 syn 0)
  (connect sm 0 syn 0)
  (connect km 0 syn 0)
  (connect sy1 0 syn 0)
  (connect l3 0 set1 0)
  (connect set1 0 ra 0)
  (connect set1 0 st 0)
  (connect set1 0 ke 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect p2 0 a2 0)
  (connect stp 0 a0 0)
  (connect stp 0 a1 0)
  (connect stp 0 a2 0)
  (connect s1 0 w1 0)
  (connect s2 0 w2 0)
  (connect s3 0 w3 0)
  (connect w1 0 a0 0)
  (connect w2 0 a0 0)
  (connect w3 0 a0 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect a2 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
