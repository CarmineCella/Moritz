; spectra.moritz - what signals look like in frequency: selector~ picks a
; source for spectroscope~ and scope~. The fifth source is noise through a
; band-pass whose centre jumps to random frequencies; slide~ glides between
; them. dspstatus~ shows the sample rate and the CPU load.
(patch
  (obj title comment "spectroscope~: the spectrum of a sine, a saw, a pulse, noise and a swept band-pass" (pos 20 12))
  (obj s1 message 1 (pos 20 45))
  (obj s2 message 2 (pos 60 45))
  (obj s3 message 3 (pos 100 45))
  (obj s4 message 4 (pos 140 45))
  (obj s5 message 5 (pos 180 45))
  (obj cs comment "1 sine, 2 saw, 3 pulse, 4 noise, 5 swept band-pass (crossfades, no clicks)" (pos 225 46))
  (obj sine cycle~ 220 (pos 120 85))
  (obj saw saw~ 220 (pos 210 85))
  (obj pulse rect~ 220 0.2 (pos 290 85))
  (obj noise noise~ (pos 390 85))
  (obj tog toggle (pos 470 85))
  (obj ctog comment "sweep" (pos 500 88))
  (obj met metro 700 (pos 470 120))
  (obj rnd random 3000 (pos 470 150))
  (obj lo + 200 (pos 470 180))
  (obj target sig~ 1000 (pos 470 210))
  (obj glide slide~ 3000 3000 (pos 470 240))
  (obj cglide comment "slide~: glides to each new frequency" (pos 595 241))
  (obj bp svf~ 1000 0.9 (pos 390 280))
  (obj sel selector~ 5 2 (pos 20 320))
  (obj spec spectroscope~ 440 160 (pos 20 360))
  (obj sc scope~ (pos 480 360))
  (obj on message "0.1 50" (pos 480 475))
  (obj off message "0 50" (pos 545 475))
  (obj cv comment "volume" (pos 600 476))
  (obj ramp line~ (pos 480 505))
  (obj vca *~ (pos 120 540))
  (obj out dac~ (pos 120 575))
  (obj ds dspstatus~ 500 (pos 20 540))
  (obj sr number (pos 20 610))
  (obj cpu flonum (pos 120 610))
  (obj cds comment "sample rate, CPU % (dspstatus~)" (pos 210 611))
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect s4 0 sel 0)
  (connect s5 0 sel 0)
  (connect sine 0 sel 1)
  (connect saw 0 sel 2)
  (connect pulse 0 sel 3)
  (connect noise 0 sel 4)
  (connect noise 0 bp 0)
  (connect tog 0 met 0)
  (connect met 0 rnd 0)
  (connect rnd 0 lo 0)
  (connect lo 0 target 0)
  (connect target 0 glide 0)
  (connect glide 0 bp 1)
  (connect bp 2 sel 5)
  (connect sel 0 spec 0)
  (connect sel 0 sc 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect ds 2 sr 0)
  (connect ds 1 cpu 0))
