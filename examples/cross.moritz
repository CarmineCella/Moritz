; cross.moritz - cross synthesis with pfft~ (xsynth.moritz). Each bin mixes
; the amplitudes and phases of signal 1, the carrier (Beethoven's Seventh or a
; sawtooth chord), and signal 2, a voice (Vox.wav):
;     A = X a1 + x a2 + q sqrt(a1 a2),   phi = Y phi1 + y phi2
; The presets set X x q Y y and the denoise threshold; the first, the
; geometric mean of the two spectra with the carrier's phases, makes the
; orchestra speak. Double-click the pfft~ box in locked mode to open it.
; topic: Spectral
(patch
  (obj title comment "cross synthesis: Beethoven's 7th (or a saw chord) speaking with a voice: A = X a1 + x a2 + q sqrt(a1 a2), phi = Y phi1 + y phi2" (pos 20 12))
  (obj buf buffer~ crossvox sounds/Vox.wav (pos 20 40))
  (obj bb buffer~ crossbeet sounds/Beethoven_Symph7.wav (pos 220 40))
  (obj lb loadbang (pos 20 75))
  (obj init message "loop 1, 0" (pos 20 110))
  (obj binit message "loop 1, 36000" (pos 220 110))
  (obj rate sig~ 1 (pos 140 150))
  (obj gr groove~ crossvox (pos 20 150))
  (obj c1 comment "signal 2: Vox.wav" (pos 20 180))
  (obj gb groove~ crossbeet (pos 220 150))
  (obj cb comment "from 36 s, where the orchestra is loud" (pos 220 180))
  (obj r1 r cr1 (pos 500 75))
  (obj r2 r cr2 (pos 565 75))
  (obj r3 r cr3 (pos 630 75))
  (obj r4 r cr4 (pos 695 75))
  (obj o1 saw~ 98 (pos 500 110))
  (obj o2 saw~ 147 (pos 565 110))
  (obj o3 saw~ 196.5 (pos 630 110))
  (obj o4 saw~ 246.9 (pos 700 110))
  (obj mix +~ (pos 500 150))
  (obj k1 message 1 (pos 360 150))
  (obj k2 message 2 (pos 400 150))
  (obj car selector~ 2 1 (pos 220 210))
  (obj c2 comment "signal 1: 1 Beethoven, 2 the saw chord" (pos 360 211))
  (obj xs pfft~ xsynth 1024 4 (pos 20 260))
  (obj cpr comment "presets: geometric mean / exchange / amplitude mix / phase blend" (pos 240 280))
  (obj pr1 message "0 0 2 1 0 0" (pos 240 300))
  (obj pr2 message "0 1 0 1 0 0" (pos 335 300))
  (obj pr3 message "0.5 0.5 0 1 0 0" (pos 430 300))
  (obj pr4 message "0 0 2 0.5 0.5 0" (pos 550 300))
  (obj split unpack 0. 0. 0. 0. 0. 0. (pos 240 335))
  (obj pX flonum (pos 240 370))
  (obj px flonum (pos 300 370))
  (obj pq flonum (pos 360 370))
  (obj pY flonum (pos 420 370))
  (obj py flonum (pos 480 370))
  (obj pd flonum (pos 540 370))
  (obj c3 comment "X  x  q  Y  y  denoise" (pos 600 371))
  (obj vol *~ 0.5 (pos 20 300))
  (obj out dac~ (pos 20 340))
  (obj sc scope~ (pos 20 380))
  (obj c4 comment "chords (signal 1 = 2)" (pos 240 420))
  (obj ch1 message "; cr1 98; cr2 147; cr3 196.5; cr4 246.9" (pos 240 440))
  (obj ch2 message "; cr1 87.3; cr2 130.8; cr3 207.7; cr4 261.6" (pos 325 440))
  (obj ch3 message "; cr1 65.4; cr2 98; cr3 164.8; cr4 233.1" (pos 410 440))
  (connect lb 0 init 0)
  (connect lb 0 pr1 0)
  (connect init 0 gr 0)
  (connect lb 0 binit 0)
  (connect binit 0 gb 0)
  (connect rate 0 gr 0)
  (connect rate 0 gb 0)
  (connect r1 0 o1 0)
  (connect r2 0 o2 0)
  (connect r3 0 o3 0)
  (connect r4 0 o4 0)
  (connect o1 0 mix 0)
  (connect o2 0 mix 0)
  (connect o3 0 mix 0)
  (connect o4 0 mix 0)
  (connect k1 0 car 0)
  (connect k2 0 car 0)
  (connect gb 0 car 1)
  (connect mix 0 car 2)
  (connect car 0 xs 0)
  (connect gr 0 xs 1)
  (connect pr1 0 split 0)
  (connect pr2 0 split 0)
  (connect pr3 0 split 0)
  (connect pr4 0 split 0)
  (connect split 0 pX 0)
  (connect split 1 px 0)
  (connect split 2 pq 0)
  (connect split 3 pY 0)
  (connect split 4 py 0)
  (connect split 5 pd 0)
  (connect pX 0 xs 2)
  (connect px 0 xs 3)
  (connect pq 0 xs 4)
  (connect pY 0 xs 5)
  (connect py 0 xs 6)
  (connect pd 0 xs 7)
  (connect xs 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 sc 0))
