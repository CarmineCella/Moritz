; nebula.moritz - nebula~, granular synthesis from sound_math: clouds of
; short windowed grains taken from two prototypes (waveforms or sounds) and
; mixed by the morph amount. Each preset sets the prototypes and the
; parameters (the second number after a parameter is its randomness, as a
; ratio); the sliders then change density, length, frequency and morph.
; topic: Synthesis
(patch
  (obj title comment "nebula~: granular clouds of waveforms and sounds" (pos 20 12))
  (obj sub comment "Audio on, turn the cloud on, choose a preset, then play with the sliders." (pos 20 34))
  (obj vox buffer~ nbvox sounds/Vox.wav (pos 20 65))
  (obj gong buffer~ nbgong sounds/gong_c_sharp.wav (pos 230 65))
  (obj tog toggle (pos 20 100))
  (obj ctog comment "cloud on / off" (pos 50 103))
  (obj p1 message "proto1 sine, proto2 sine, density 60 0.5, length 60 0.5, freq 600 0.5, gliss 0, grainlets 0, jitter 0.5 1, amp 0.1, morph 0" (pos 20 140))
  (obj c1 comment "1 a cloud of sine grains, scattered in pitch and space" (pos 20 163))
  (obj p2 message "proto1 triangle, proto2 square, density 15 0.9, length 25 0.4, freq 2000 0.4, gliss 0.4, grainlets 0, amp 0.35, morph 0.3" (pos 20 190))
  (obj c2 comment "2 glass rain: short, high, gliding grains" (pos 20 213))
  (obj p3 message "proto1 sine, proto2 sine, density 80 0.3, freq 300 0.8, grainlets 6, gliss 0, amp 0.1, morph 0" (pos 20 240))
  (obj c3 comment "3 grainlets: each grain lasts 6 periods, so low grains are long and high ones short" (pos 20 263))
  (obj p4 message "proto1 nbvox, proto2 nbvox, density 30 0.3, length 120 0.3, freq 1 0.05, speed 0.3, gliss 0, grainlets 0, amp 0.5, morph 0" (pos 20 290))
  (obj c4 comment "4 the voice as a cloud: grains read through the recording at 0.3 times its speed" (pos 20 313))
  (obj p5 message "proto1 sine, proto2 nbgong, density 40 0.5, length 150 0.5, freq 220 0.2, speed 0.5, gliss 0, grainlets 0, amp 0.15" (pos 20 340))
  (obj c5 comment "5 morph between a sine (0) and the gong (1): move the morph slider" (pos 20 363))
  (obj cd comment "density (grains/s)" (pos 20 400))
  (obj d slider 1 200 (pos 20 420))
  (obj cl comment "length (ms)" (pos 180 400))
  (obj l slider 5 500 (pos 180 420))
  (obj cf comment "frequency (Hz, or speed ratio for a sound)" (pos 340 400))
  (obj f slider 0.05 4000 (pos 340 420))
  (obj cm comment "morph" (pos 600 400))
  (obj m slider 0. 1. (pos 600 420))
  (obj dn number (pos 20 455))
  (obj ln number (pos 180 455))
  (obj fn flonum (pos 340 455))
  (obj mn flonum (pos 600 455))
  (obj neb nebula~ sine sine (pos 20 500))
  (obj on message "0.6 50" (pos 250 540))
  (obj off message "0 50" (pos 320 540))
  (obj cvol comment "volume" (pos 380 541))
  (obj ramp line~ (pos 250 575))
  (obj vl *~ (pos 20 575))
  (obj vr *~ (pos 120 575))
  (obj out dac~ (pos 20 620))
  (obj sc scope~ (pos 450 560))
  (obj lb loadbang (pos 700 100))
  (obj init message 1 (pos 700 130))
  (connect tog 0 neb 0)
  (connect p1 0 neb 0)
  (connect p2 0 neb 0)
  (connect p3 0 neb 0)
  (connect p4 0 neb 0)
  (connect p5 0 neb 0)
  (connect d 0 dn 0)
  (connect l 0 ln 0)
  (connect f 0 fn 0)
  (connect m 0 mn 0)
  (connect dn 0 neb 1)
  (connect ln 0 neb 2)
  (connect fn 0 neb 3)
  (connect mn 0 neb 4)
  (connect neb 0 vl 0)
  (connect neb 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect vl 0 sc 0)
  (connect lb 0 init 0)
  (connect init 0 p1 0))
