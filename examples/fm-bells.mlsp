; fm-bells.mlsp - generative FM bells built from the fmvoice abstraction
; (fmvoice.mlsp, next to this patch). Each copy takes its own arguments:
; harmonicity, index peak and decay. Turn on "play".
(patch
  (obj title comment "two copies of the fmvoice abstraction, alternating notes on a pentatonic scale" (pos 20 12))
  (obj play toggle (pos 20 45))
  (obj plabel comment "play" (pos 50 46))
  (obj met metro 300 (pos 20 80))
  (obj tick t b b (pos 20 115))
  (obj alt counter 1 2 (pos 160 150))
  (obj rnd random 10 (pos 20 150))
  (obj scale expr "67 + 12 * int($f1 / 5) + 2 * ($i1 % 5) + (($i1 % 5) >= 3)" (pos 20 185))
  (obj g gate 2 (pos 20 225))
  (obj v1 fmvoice 1.4 6 2600 (pos 20 270))
  (obj v2 fmvoice 3.5 2.5 900 (pos 260 270))
  (obj c1 comment "bell: h 1.4" (pos 165 271))
  (obj c2 comment "glass: h 3.5" (pos 405 271))
  (obj g1 *~ 0.18 (pos 20 335))
  (obj g2 *~ 0.18 (pos 260 335))
  (obj d1 tapin~ 2000 (pos 380 335))
  (obj d2 tapout~ 375 (pos 380 375))
  (obj fb *~ 0.45 (pos 480 375))
  (obj out dac~ (pos 20 430))
  (obj tempo comment "step (ms)" (pos 300 46))
  (obj speed slider 120 600 (pos 300 75))
  (obj lb loadbang (pos 300 115))
  (obj init message 300 (pos 300 150))
  (connect play 0 met 0)
  (connect met 0 tick 0)
  (connect tick 1 alt 0)
  (connect tick 0 rnd 0)
  (connect alt 0 g 0)
  (connect rnd 0 scale 0)
  (connect scale 0 g 1)
  (connect g 0 v1 0)
  (connect g 1 v2 0)
  (connect v1 0 g1 0)
  (connect v2 0 g2 0)
  (connect g1 0 out 0)
  (connect g2 0 out 1)
  (connect g1 0 d1 0)
  (connect g2 0 d1 0)
  (connect d1 0 d2 0)
  (connect d2 0 fb 0)
  (connect fb 0 d1 0)
  (connect d2 0 out 0)
  (connect d2 0 out 1)
  (connect speed 0 met 1)
  (connect lb 0 init 0)
  (connect init 0 speed 0))
