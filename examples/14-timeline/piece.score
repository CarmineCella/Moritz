; piece.score: four stems on four tracks, and a track whose automation lane drives the patch's receive "cutoff"
; (Musil data: Moritz's timeline edits it and writes it back; Musil reads it with score-read)
(score "piece"
  (sr 44100) (bpm 100) (meter 4 4) (next-id 11)
  (row drums (data gain 0.8))
  (row bass)
  (row chords (data az 35))
  (row melody (data az -35))
  (row filter (data lanes (list (list cutoff 200 8000))))
  (sound 0 9.6 "stems_drums.wav" (id 1) (to 9.6) (row drums))
  (sound 9.6 9.6 "stems_drums.wav" (id 2) (from 9.6) (to 19.2) (row drums))
  (sound 0 19.2 "stems_bass.wav" (id 3) (to 19.2) (row bass) (data fade-in 2.4))
  (sound 4.8 14.4 "stems_chords.wav" (id 4) (gain 0.8) (from 4.8) (to 19.2) (row chords) (data fade-in 1.2))
  (sound 9.6 9.6 "stems_melody.wav" (id 5) (from 9.6) (to 19.2) (row melody) (data fade-out 2.4))
  (msg 0 cutoff 400 (id 6) (row filter))
  (msg 4.8 cutoff 1500 (id 7) (row filter))
  (msg 9.6 cutoff 6000 (id 8) (row filter))
  (msg 14.4 cutoff 2500 (id 9) (row filter))
  (msg 16.8 cutoff 700 (id 10) (row filter)))
