; sparkle-cross.moritz - sparkle~'s three cross-syntheses of two sounds:
; 1 multiplicative (the geometric mean of the two spectra: each sound is
; heard through the other), 2 spectral flattener (the first sound takes the
; spectral envelope of the second: an orchestra that speaks), 3 morphing
; (from one sound to the other). "cross mode buffer" chooses the mode and the
; second sound, read at the same position as the first; the amount (0 to 1)
; goes to sparkle~'s fourth inlet.
(patch
  (obj title comment "sparkle~ cross-synthesis: two sounds become one" (pos 20 12))
  (obj sub comment "Turn the audio on, click a preset, then move the amount. Each preset sets the first sound, the mode and the second sound." (pos 20 34))
  (obj b1 buffer~ sxvox Vox.wav (pos 20 65))
  (obj b2 buffer~ sxdrums drums.wav (pos 225 65))
  (obj b3 buffer~ sxbeet Beethoven_Symph7.wav (pos 445 65))
  (obj b4 buffer~ sxgong gong_c_sharp.wav (pos 730 65))
  (obj p1 message "set sxvox, cross 1 sxdrums, envelope 0, start" (pos 20 110))
  (obj c1 comment "1 multiplicative: the voice with the drums' rhythm and colour (amount: whose phases)" (pos 340 111))
  (obj p2 message "set sxbeet, cross 2 sxvox, envelope 60, start 36000" (pos 20 140))
  (obj c2 comment "2 spectral flattener: Beethoven's 7th with the voice's formants (amount: how much)" (pos 340 141))
  (obj p3 message "set sxvox, cross 3 sxgong, envelope 0, start" (pos 20 170))
  (obj c3 comment "3 morphing: from the voice (0) to the gong (1)" (pos 340 171))
  (obj p0 message "cross 0, start" (pos 20 200))
  (obj c0 comment "off: the first sound alone" (pos 130 201))
  (obj stp message stop (pos 330 200))
  (obj lb loadbang (pos 620 240))
  (obj init message "loop 1" (pos 620 270))
  (obj camt comment "amount" (pos 20 241))
  (obj amt slider 0. 1. (pos 20 260))
  (obj amtn flonum (pos 175 260))
  (obj ainit message 0.5 (pos 260 240))
  (obj sp sparkle~ sxvox 1 2048 8 (pos 20 310))
  (obj on message "0.5 50" (pos 330 390))
  (obj off message "0 50" (pos 400 390))
  (obj cvol comment "volume" (pos 460 391))
  (obj ramp line~ (pos 330 425))
  (obj vca *~ (pos 20 425))
  (obj out dac~ (pos 20 470))
  (obj spec spectroscope~ 380 110 (pos 520 300))
  (connect p1 0 sp 0)
  (connect p2 0 sp 0)
  (connect p3 0 sp 0)
  (connect p0 0 sp 0)
  (connect stp 0 sp 0)
  (connect lb 0 init 0)
  (connect lb 0 ainit 0)
  (connect init 0 sp 0)
  (connect ainit 0 amt 0)
  (connect amt 0 amtn 0)
  (connect amtn 0 sp 3)
  (connect sp 0 vca 0)
  (connect sp 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
