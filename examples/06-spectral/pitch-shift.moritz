; pitch-shift.moritz - transposing a voice with sparkle~. The pitch ratio
; (inlet 2) moves every partial; without formant preservation the formants
; move too (a chipmunk up, a giant down); with "envelope C" the spectral
; envelope stays where it was and only the pitch changes. The formant ratio
; (inlet 3) then moves the formants alone. robot and whisper replace the
; phases; threshold drops the weak bins (denoising). The same works on the
; live input: sparkle~ without a buffer~ transforms the signal it receives.
(patch
  (obj title comment "Pitch shifting with sparkle~: transpose, keep or move the formants" (pos 20 12))
  (obj sub comment "Audio on, then play. Drag the semitones; switch formant preservation on and off to hear the difference." (pos 20 34))
  (obj buf buffer~ pshvox Vox.wav (pos 20 65))
  (obj play message "loop 1, start" (pos 20 100))
  (obj stp message stop (pos 120 100))
  (obj cst comment "semitones" (pos 20 140))
  (obj st slider -12 12 (pos 20 160))
  (obj stn number (pos 175 160))
  (obj ratio expr "pow(2, $f1 / 12.)" (pos 20 200))
  (obj rn flonum (pos 175 200))
  (obj crn comment "pitch ratio" (pos 240 201))
  (obj ckf comment "keep the formants" (pos 330 140))
  (obj kf toggle (pos 330 160))
  (obj env expr "$i1 * 60" (pos 330 200))
  (obj envm message "envelope $1" (pos 330 235))
  (obj cfs comment "formant ratio (with formants kept)" (pos 520 140))
  (obj fs slider 0.5 2 (pos 520 160))
  (obj fsn flonum (pos 675 160))
  (obj sp sparkle~ pshvox (pos 20 290))
  (obj fx comment "effects" (pos 330 275))
  (obj rob message "robot 1" (pos 330 295))
  (obj whi message "whisper 1" (pos 400 295))
  (obj nat message "robot 0" (pos 480 295))
  (obj cfx comment "robot: zero phases (a buzz); whisper: random phases; robot 0: normal" (pos 330 320))
  (obj cdn comment "denoise threshold" (pos 330 350))
  (obj dn slider 0. 0.05 (pos 330 370))
  (obj dnm message "threshold $1" (pos 485 370))
  (obj sr s psratio (pos 175 235))
  (obj sf s psform (pos 760 200))
  (obj sm1 s psmsg (pos 420 235))
  (obj sm2 s psmsg (pos 560 295))
  (obj sm3 s psmsg (pos 590 370))
  (obj live comment "live input (microphone): the same settings on what you say; use headphones" (pos 20 420))
  (obj rr r psratio (pos 230 485))
  (obj rf r psform (pos 330 485))
  (obj rm r psmsg (pos 230 450))
  (obj ltog toggle (pos 20 445))
  (obj cltog comment "on" (pos 50 448))
  (obj mic adc~ 1 (pos 100 445))
  (obj lsp sparkle~ (pos 100 515))
  (obj lgate *~ (pos 100 550))
  (obj mix +~ (pos 20 585))
  (obj on message "0.5 50" (pos 250 585))
  (obj off message "0 50" (pos 320 585))
  (obj cvol comment "volume" (pos 380 586))
  (obj ramp line~ (pos 250 620))
  (obj vca *~ (pos 20 620))
  (obj out dac~ (pos 20 660))
  (obj spec spectroscope~ 300 100 (pos 450 500))
  (obj lb loadbang (pos 700 230))
  (obj fsinit message 1 (pos 700 260))
  (obj stinit message 0 (pos 750 260))
  (connect play 0 sp 0)
  (connect stp 0 sp 0)
  (connect st 0 stn 0)
  (connect stn 0 ratio 0)
  (connect ratio 0 rn 0)
  (connect rn 0 sp 1)
  (connect kf 0 env 0)
  (connect env 0 envm 0)
  (connect envm 0 sp 0)
  (connect fs 0 fsn 0)
  (connect fsn 0 sp 2)
  (connect rob 0 sp 0)
  (connect whi 0 sp 0)
  (connect nat 0 sp 0)
  (connect dn 0 dnm 0)
  (connect dnm 0 sp 0)
  (connect rn 0 sr 0)
  (connect fsn 0 sf 0)
  (connect envm 0 sm1 0)
  (connect rob 0 sm2 0)
  (connect whi 0 sm2 0)
  (connect nat 0 sm2 0)
  (connect dnm 0 sm3 0)
  (connect rr 0 lsp 1)
  (connect rf 0 lsp 2)
  (connect rm 0 lsp 0)
  (connect mic 0 lsp 0)
  (connect lsp 0 lgate 0)
  (connect ltog 0 lgate 1)
  (connect sp 0 mix 0)
  (connect lgate 0 mix 0)
  (connect mix 0 vca 0)
  (connect mix 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 fsinit 0)
  (connect fsinit 0 fs 0)
  (connect lb 0 stinit 0)
  (connect stinit 0 st 0))
