; maple-hybrid.moritz - a sound rebuilt from other sounds (Maple's
; hybridisation): pursuit explains each segment of the target (cut at its
; onsets) with a few atoms cut from recordings of a kitchen or of people,
; each atom slid to the place where it fits best. What comes out has the
; target's rhythm and contour, made of cups, lids and laughter. A book made
; with one dictionary can also be rebuilt with the closest atoms of another
; (cross). The recordings are the author's.
; topic: Spectral
(patch
  (obj title comment "Hybridisation: a voice made of kitchen sounds" (pos 20 12))
  (obj sub comment "Build the dictionaries (they build when the patch opens), choose a target and run; then listen, and cross to the other dictionary." (pos 20 34))
  (obj t1 buffer~ mhvox sounds/Vox.wav (pos 20 65))
  (obj t2 buffer~ mhdrums sounds/drums.wav (pos 230 65))
  (obj t3 buffer~ mhbee sounds/Beethoven_Symph7.wav (pos 450 65))
  (obj bk buffer~ mhbook (pos 760 65))
  (obj hy buffer~ mhhyb (pos 870 65))
  (obj cx buffer~ mhcross (pos 970 65))
  (obj cd comment "dictionaries (cut at the onsets of every recording):" (pos 20 100))
  (obj lb loadbang (pos 20 120))
  (obj m1 message "onsets sounds/kitchen 2 1000" (pos 20 150))
  (obj m2 message "onsets sounds/people 2 1000" (pos 300 150))
  (obj dk atoms mhkitchen (pos 20 180))
  (obj dp atoms mhpeople (pos 300 180))
  (obj nk number (pos 20 215))
  (obj np number (pos 300 215))
  (obj cnk comment "atoms" (pos 80 216))
  (obj cnp comment "atoms" (pos 360 216))
  (obj ct comment "target and dictionary:" (pos 20 255))
  (obj r1 message "run mhvox mhkitchen mhbook; mhsynth set synth mhbook mhkitchen mhhyb" (pos 20 275))
  (obj r2 message "run mhdrums mhkitchen mhbook; mhsynth set synth mhbook mhkitchen mhhyb" (pos 20 320))
  (obj r3 message "run mhbee mhkitchen mhbook; mhsynth set synth mhbook mhkitchen mhhyb" (pos 20 365))
  (obj r4 message "run mhvox mhpeople mhbook; mhsynth set synth mhbook mhpeople mhhyb" (pos 300 275))
  (obj r5 message "run mhdrums mhpeople mhbook; mhsynth set synth mhbook mhpeople mhhyb" (pos 300 320))
  (obj r6 message "run mhbee mhpeople mhbook; mhsynth set synth mhbook mhpeople mhhyb" (pos 300 365))
  (obj cc comment "atoms per segment:" (pos 20 412))
  (obj c1 message "components 1" (pos 145 410))
  (obj c2 message "components 4" (pos 250 410))
  (obj c3 message "components 12" (pos 355 410))
  (obj cs comment "segments:" (pos 20 439))
  (obj g1 message "segments onsets" (pos 90 437))
  (obj g2 message "segments blocks, block 50" (pos 210 437))
  (obj an pursuit (pos 20 475))
  (obj prog flonum (pos 20 510))
  (obj na number (pos 90 510))
  (obj cpo comment "progress, atoms" (pos 150 511))
  (obj rsy receive mhsynth (pos 300 475))
  (obj sy1 message "synth mhbook mhkitchen mhhyb" (pos 20 560))
  (obj csy comment "then it is rebuilt with the dictionary the book was made with:" (pos 20 540))
  (obj cxx comment "or cross: rebuild a kitchen book with the closest laughs, and the other way round:" (pos 20 595))
  (obj x1 message "cross mhbook mhkitchen mhpeople mhcross" (pos 20 615))
  (obj x2 message "cross mhbook mhpeople mhkitchen mhcross" (pos 20 642))
  (obj tl message "tails 0" (pos 360 615))
  (obj tl1 message "tails 1" (pos 420 615))
  (obj ctl comment "atoms ring whole (1), or stop where they matched (0)" (pos 360 642))
  (obj syn pursuit (pos 20 680))
  (obj l2 loadbang (pos 900 105))
  (obj sc message "ylog 1, title atoms: time and spectral centroid (colour: level)" (pos 590 135))
  (obj map plot mhbook 420 250 scatter (pos 590 165))
  (obj cl comment "listen:" (pos 20 722))
  (obj p0 message start (pos 75 720))
  (obj p1 message start (pos 160 720))
  (obj p2 message start (pos 245 720))
  (obj stp message stop (pos 330 720))
  (obj cl2 comment "the target, the hybrid, the cross" (pos 385 722))
  (obj w1 message "set mhvox" (pos 75 752))
  (obj w2 message "set mhdrums" (pos 160 752))
  (obj w3 message "set mhbee" (pos 255 752))
  (obj a0 play~ mhvox (pos 75 787))
  (obj a1 play~ mhhyb (pos 160 787))
  (obj a2 play~ mhcross (pos 245 787))
  (obj mix +~ (pos 75 822))
  (obj vca *~ 0.5 (pos 75 852))
  (obj out dac~ (pos 75 887))
  (obj c4 comment "More atoms a segment: closer to the target, less kitchen;" (pos 590 440))
  (obj c4b comment "blocks of 50 ms: a granular texture. Dots: the atoms' centroids." (pos 590 458))
  (connect lb 0 m1 0)
  (connect lb 0 m2 0)
  (connect m1 0 dk 0)
  (connect m2 0 dp 0)
  (connect dk 2 nk 0)
  (connect dp 2 np 0)
  (connect dk 1 r1 0)
  (connect r1 0 an 0)
  (connect r2 0 an 0)
  (connect r3 0 an 0)
  (connect r4 0 an 0)
  (connect r5 0 an 0)
  (connect r6 0 an 0)
  (connect c1 0 an 0)
  (connect c2 0 an 0)
  (connect c3 0 an 0)
  (connect g1 0 an 0)
  (connect g2 0 an 0)
  (connect an 0 prog 0)
  (connect an 2 na 0)
  (connect sy1 0 syn 0)
  (connect rsy 0 sy1 0)
  (connect an 1 sy1 0)
  (connect x1 0 syn 0)
  (connect x2 0 syn 0)
  (connect tl 0 syn 0)
  (connect tl1 0 syn 0)
  (connect l2 0 sc 0)
  (connect sc 0 map 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect p2 0 a2 0)
  (connect stp 0 a0 0)
  (connect stp 0 a1 0)
  (connect stp 0 a2 0)
  (connect r1 0 w1 0)
  (connect r2 0 w2 0)
  (connect r3 0 w3 0)
  (connect r4 0 w1 0)
  (connect r5 0 w2 0)
  (connect r6 0 w3 0)
  (connect w1 0 a0 0)
  (connect w2 0 a0 0)
  (connect w3 0 a0 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect a2 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
