; atmospheres.moritz - Atmosphères (1961), György Ligeti's piece for orchestra, with the orchestral
; granulator, after Musil's atmospheres.mu and atmospheres2.mu. The piece is a sequence of chromatic
; clusters whose only variables are the band they fill, how full it is, the dynamics and the colour:
; exactly the granulator's parameters. sections: the register diagram of the piece (INTRO and
; letters A to T, C0 to C7) transcribed as granulators, one a section, each a band (a wedge where
; the band moves), a density and durations that make it a sustained or a moving cluster, colours by
; style (ordinario, tremolo, harmonics, col legno, pizzicato); the clusters drawn with method
; cluster (every pitch of the band once before any repeats), the micropolyphonic canons with leap 2
; (each player by steps from its last pitch); one orchestra, Ligeti's halved and seated, its players
; booked by the overlapping sections in turn (continue), so nobody plays two notes at once (the
; Console's validation says so); the dynamics read from a recording's loudness
; (data/atmospheres_curves.csv). curves: one granulator over the whole piece, its register,
; dynamics, polyphony, density, durations and colour all read from that recording's curves
; (atmospheres2.mu). At the end the piano's strings are brushed (a filtered noise, the buffer~
; atbrush). 0.25 is four times faster (a two-minute preview: what the patch makes when it opens); 1
; is the piece, nine minutes. MicroSOL has four instruments around C4-G4: the bands from C0 to C7
; are its samples resampled far, a sketch of the shapes; with FullSOL (fullsol, then compose) the
; clusters are the orchestra's.
; Try: 1. play the preview; 2. double-click the score box: the Timeline, a track an instrument; the
; Roll at the window's top, the bands and their wedges; 3. sections 1: the piece at its length (nine
; minutes); 4. curves 0.25: the same piece from the recording's curves alone, compare; 5.
; double-click the code box: a section's band or density, Cmd-S, compose again.
(patch
  (obj title comment "Ligeti, Atmosphères: clusters as granular processes, section by section or from a recording's curves" (pos 20 12))
  (obj sub comment "compose (a preview at 0.25, the piece at 1), then play; the Timeline shows the orchestra, the Roll the bands" (pos 20 34))
  (obj dmic message microsol (pos 20 62))
  (obj dful message fullsol (pos 100 62))
  (obj cds comment "the samples: MicroSOL (comes with Moritz: Ob Hn Vn Vc, C4-G4) or FullSOL (registered in Extras > Datasets...); then compose again" (pos 170 63))
  (obj s25 message "sections 0.25" (pos 150 97))
  (obj s1 message "sections 1" (pos 255 97))
  (obj c25 message "curves 0.25" (pos 340 97))
  (obj c1 message "curves 1" (pos 435 97))
  (obj lb loadbang (pos 520 97))
  (obj cctl comment "the register diagram (sections) or the recording's curves; the timescale" (pos 610 98))
  (obj c code 2 1 (pos 20 132)
    (script
      "; Atmosphères (Ligeti, 1961) with the orchestral granulator, after Musil's atmospheres.mu and atmospheres2.mu. in1: how"
      "; (sections: the register diagram of the piece, a granulator a section; curves: one granulator driven by the curves"
      "; of a recording) and the timescale (0.25: four times faster, a two-minute preview; 1: the piece, nine minutes);"
      "; in2 the dataset. The loudness, and with curves everything, comes from data/atmospheres_curves.csv (a recording"
      "; measured: one line a second, the loudness in dB, the lowest strong partial, the centroid and the spread in octaves,"
      "; the flux peaks a second, the coherence time)"
      "load \"music.mu\""
      "var name (if (equal? in2 nil) \"microsol\" in2)     ; MicroSOL comes with Moritz: Ob Hn Vn Vc, C4-G4 (a sketch)"
      "var db (db-load name)                             ; fullsol: FullSOL where you registered it (Extras > Datasets...)"
      "var how (if (equal? (type in1) \"list\") (str (head in1)) \"sections\")"
      "var k (if (equal? (type in1) \"list\") (last in1) 0.25)"
      "seed 11"
      "var sr 44100"
      "var curves (read-csv \"../../data/atmospheres_curves.csv\")    ; next to the examples' folder"
      "var here (db-instruments-available db)"
      "function have (L) (filter L (function (i) (contains? here (str i))))"
      "function ossia-of (L) (join (map (have L) str) \"|\")"
      "function players (spec n) (filter (map (vec->list (range n)) (function (j) spec)) (function (p) (not (equal? p \"\"))))"
      "var styles (unique (reduce (map here (function (i) (db-techniques-of db i))) concat-list (list)))"
      "function styled (L) { var got (filter L (function (t) (contains? styles (str t))))"
      "                      return (if (== (length got) 0) (list 'ord) got) }"
      "var s (score \"atmospheres\" sr)"
      "var total 0"
      ""
      "if (equal? how \"sections\") {"
      "    ; --- the orchestra: Ligeti's, halved, seated as a real one; one set of players for the piece: the sections, which"
      "    ;     overlap, book the same people ('continue) and never one twice -------------------------------------------"
      "    var string-spec (concat-list (players (ossia-of (list 'Vn)) 13) (concat-list (players (ossia-of (list 'Va)) 5) (concat-list (players (ossia-of (list 'Vc)) 5) (players (ossia-of (list 'Cb)) 4))))"
      "    var wind-spec (concat-list (players (ossia-of (list 'Fl 'Picc)) 2) (concat-list (players (ossia-of (list 'Ob)) 2) (concat-list (players (ossia-of (list 'ClBb)) 2) (players (ossia-of (list 'Bn 'Cbn)) 2))))"
      "    var brass-spec (concat-list (players (ossia-of (list 'Hn)) 3) (concat-list (players (ossia-of (list 'TpC)) 2) (concat-list (players (ossia-of (list 'Tbn)) 2) (players (ossia-of (list 'BTb)) 1))))"
      "    var tutti (orchestra (concat-list string-spec (concat-list wind-spec brass-spec)))"
      "    function of (L) (filter tutti (function (p) (any? (get p 'instrs) (function (i) (contains? (map L str) i)))))"
      "    var strings (of (list 'Vn 'Va 'Vc 'Cb))"
      "    var upper-strings (of (list 'Vn 'Va))"
      "    var winds (of (list 'Fl 'Picc 'Ob 'ClBb 'Bn 'Cbn))"
      "    var brass (of (list 'Hn 'TpC 'Tbn 'BTb))"
      "    var low (of (list 'Vc 'Cb 'Bn 'Cbn 'Tbn 'BTb))"
      "    var high (of (list 'Fl 'Picc 'Ob 'ClBb 'Vn 'Va))"
      "    var upper (filter tutti (function (p) (not (any? low (function (q) (same? p q))))))"
      "    print (orchestra-size tutti) \"players:\" (orchestra-instruments tutti)"
      "    var ord (list 'ord)"
      "    var trem (styled (list 'ord 'trem 'flatt))"
      "    var harm (styled (list 'art-harm 'nat-harm 'sul-tasto 'ord))"
      "    var points (styled (list 'pizz-sec 'col-legno-batt 'stacc 'pizz-bartok 'ord))"
      "    ; the dynamics: the recording's loudness, -62 dB ppp to -20 dB fff, the middle kept soft"
      "    function db->level (d) (pow (max 0 (min 1 (/ (+ d 62) 42))) 1.6)"
      "    function level-at (t) {"
      "        var j (max 0 (min (- (length curves) 2) (floor t)))"
      "        var a (db->level (getidx (getidx curves j) 1))"
      "        var b (db->level (getidx (getidx curves (+ j 1)) 1))"
      "        return (+ a (* (- t j) (- b a)))"
      "    }"
      "    function level-env (start end) {"
      "        var kv (list)"
      "        var secs (* k (- end start))"
      "        var t 0"
      "        while (< t secs) { push kv t"
      "                           push kv (level-at (+ start (/ t k)))"
      "                           set t (+ t (* 2 k)) }"
      "        push kv secs"
      "        push kv (level-at end)"
      "        return (env kv)"
      "    }"
      "    ; (section name start end players reg-from reg-to density duration styles how): times in the recording's seconds,"
      "    ; a band in octaves (C4 = 4) from its start to its end (a wedge when they differ); 'cluster every pitch of the"
      "    ; band once before any repeats, 'lines each player by steps (the micropolyphony), 'random points"
      "    function section (name start end orch reg-from reg-to density duration sty way) {"
      "        var secs (* k (- end start))"
      "        var reach (orchestra-octaves db orch)"
      "        var clip (function (b) { var hi (min (last reach) (max (+ (head reach) 0.5) (last b)))"
      "                                 return (list (max (head reach) (min (- hi 0.5) (head b))) hi) })"
      "        var r (orchestrate-granular db orch secs (record (list"
      "            'method (if (equal? way 'lines) 'random way)  'seat (* k 30)  'leap (if (equal? way 'lines) 2 nil)  'inertia 0.8"
      "            'continue 1  'start (* k start)"
      "            'register (env (list 0 (clip reg-from) secs (clip reg-to)))"
      "            'density (list (/ (head density) k) (/ (last density) k))  'duration (list (* k (head duration)) (* k (last duration)))"
      "            'styles sty  'dynamics (level-env start end))))"
      "        connect! s (* k start) r (list 0)"
      "        print name \":\" (fixed (* k start) 0) \"-\" (fixed (* k end) 0) \"s,\" (length (best-connection r)) \"notes\""
      "        set total (max total (* k end))"
      "    }"
      "    section \"intro\"    0    52   tutti         (list 1 7)     (list 1 7)      (list 3 5)   (list 8 14)  ord 'cluster"
      "    section \"A\"        52   90   upper-strings (list 2.5 4.5) (list 2.5 4.5)  (list 2 3)   (list 6 12)  ord 'cluster"
      "    section \"A pedal\"  55   90   low           (list 1 1.3)   (list 1 1.3)    (list 0.5 1) (list 10 15) ord 'random"
      "    section \"B\"        90   150  upper         (list 2.5 6.5) (list 2.5 6.5)  (list 3 6)   (list 5 10)  trem 'cluster"
      "    section \"B bass\"   95   150  low           (list 0.5 1.2) (list 0.5 1.2)  (list 0.5 1) (list 10 15) ord 'lines"
      "    section \"C high\"   150  185  high          (list 4 6.5)   (list 4 6.5)    (list 2 4)   (list 5 10)  ord 'cluster"
      "    section \"C low\"    150  182  low           (list 1.5 3)   (list 1.5 3)    (list 1 2)   (list 6 10)  ord 'cluster"
      "    section \"D\"        185  210  tutti         (list 3 4)     (list 3 7)      (list 4 8)   (list 3 6)   trem 'cluster"
      "    section \"E high\"   210  225  winds         (list 5 6)     (list 5 6)      (list 1 2)   (list 5 8)   ord 'random"
      "    section \"E mid\"    210  225  strings       (list 2.5 3.5) (list 2.5 3.5)  (list 1 2)   (list 5 8)   harm 'random"
      "    section \"F\"        225  266  high          (list 5 6.5)   (list 7 8)      (list 3 5)   (list 4 8)   harm 'cluster"
      "    section \"G\"        266  292  low           (list 1.5 2.5) (list 1.5 2.5)  (list 1.5 3) (list 6 10)  trem 'cluster"
      "    section \"H\"        292  320  strings       (list 1 6)     (list 3.5 3.5)  (list 6 10)  (list 1 3)   ord 'lines"
      "    section \"points\"   320  352  strings       (list 1 5.5)   (list 1 5.5)    (list 8 14)  (list 0.1 0.3) points 'random"
      "    section \"I-M\"      330  355  upper-strings (list 3 3.5)   (list 3 3.5)    (list 1 2)   (list 6 12)  harm 'random"
      "    section \"brass\"    336  352  brass         (list 2.5 4.5) (list 2.5 4.5)  (list 2 4)   (list 2 4)   trem 'random"
      "    section \"N\"        355  378  tutti         (list 2 5.5)   (list 2 5.5)    (list 3 5)   (list 5 10)  ord 'cluster"
      "    section \"O\"        378  418  tutti         (list 2.5 7)   (list 2.5 7)    (list 4 8)   (list 4 8)   trem 'cluster"
      "    section \"P\"        418  432  tutti         (list 2.5 6)   (list 4 4.5)    (list 3 5)   (list 3 6)   ord 'cluster"
      "    section \"QR low\"   432  465  low           (list 0.5 1.5) (list 0.5 1.5)  (list 0.5 1) (list 6 10)  ord 'random"
      "    section \"QR mid\"   436  462  upper-strings (list 2 3)     (list 2 3)      (list 1 2)   (list 5 8)   harm 'lines"
      "    section \"ST\"       465  530  strings       (list 1 5.5)   (list 3 3.2)    (list 2 4)   (list 6 10)  harm 'lines"
      "    section \"end bass\" 500  530  low           (list 0 1)     (list 0 1)      (list 0.5 1) (list 8 12)  ord 'random"
      "    validation-print (score-validate s tutti)"
      "} {"
      "    ; --- one granulator over the whole piece, its envelopes the recording's curves (a breakpoint every two seconds):"
      "    ;     register from the lowest partial to the centroid plus the spread, dynamics and polyphony from the loudness,"
      "    ;     density from the flux peaks, durations from the coherence time, tremolo where the flux is high ------------"
      "    var secs (+ 1 (head (last curves)))"
      "    var orch (orchestra (concat-list (players (ossia-of (list 'Vn 'Va 'Vc 'Cb)) 26) (concat-list (players (ossia-of (list 'Picc 'Fl 'Ob 'ClBb 'Bn 'Cbn)) 10) (players (ossia-of (list 'TpC 'Hn 'Tbn 'BTb)) 9))))"
      "    var n-players (orchestra-size orch)"
      "    print n-players \"players:\" (orchestra-instruments orch)"
      "    var ord (list 'ord)"
      "    var trem (styled (list 'trem 'flatt 'ord))"
      "    var harm (styled (list 'art-harm 'nat-harm 'ord))"
      "    function level-of (row) (max 0 (min 1 (/ (+ (getidx row 1) 60) 40)))"
      "    function curve-env (f) {"
      "        var kv (list)"
      "        var j 0"
      "        while (< j (length curves)) { push kv (* k (head (getidx curves j)))"
      "                                      push kv (f (getidx curves j))"
      "                                      set j (+ j 2) }"
      "        return (env kv)"
      "    }"
      "    var reach (orchestra-octaves db orch)"
      "    var r (orchestrate-granular db orch (* k secs) (record (list"
      "        'method 'cluster  'seat (* k 30)  'inertia 0.8"
      "        'register (curve-env (function (r) { var hi (min (last reach) (max (+ (head reach) 0.5) (+ (getidx r 3) (getidx r 4))))"
      "                                             var lo (max (head reach) (min (- hi 0.5) (- (getidx r 2) 0.25)))"
      "                                             return (list lo hi) }))"
      "        'dynamics (curve-env level-of)"
      "        'polyphony (curve-env (function (r) (max 2 (round (* n-players (pow (level-of r) 0.7))))))"
      "        'density (curve-env (function (r) { var d (if (< (level-of r) 0.02) 0.05 (max (/ 0.8 k) (/ (* 2 (getidx r 5)) k)))"
      "                                            return (list d d) }))"
      "        'duration (curve-env (function (r) { var c (max 0.5 (min 12 (getidx r 6)))"
      "                                             return (list (* k 0.6 c) (* k 1.3 c)) }))"
      "        'styles (curve-env (function (r) (if (> (getidx r 5) 1.5) trem (if (> (getidx r 2) 5.5) harm ord)))))))"
      "    connect! s 0 r (list 0)"
      "    var rep (get r 'report)"
      "    print \"one granulator over\" (fixed (* k secs) 0) \"s:\" (get rep 'notes) \"notes, saturation\" (fixed (* 100 (get rep 'saturation)) 0) \"%\""
      "    set total (* k secs)"
      "    validation-print (score-validate s orch)"
      "}"
      "; the piano strings brushed at the end, ppppp: a filtered noise breathing in and out, written into the buffer~ atbrush"
      "var brush-secs (* k 18)"
      "var bn (floor (* brush-secs sr))"
      "set-buffer! \"atbrush\" (* 0.03 (lowpass (noise bn) sr 700 0.7) (bpf 0 (list (list (floor (* 0.5 bn)) 1) (list (floor (* 0.5 bn)) 0)))) sr"
      "score-add! s (record (list 'kind 'buffer 'source \"atbrush\" 'at (- total (* k 18)) 'dur brush-secs 'gain 4))"
      "print how \"at\" k \":\" (length (score-events s)) \"events,\" (fixed total 0) \"s\""
      "out 1 s"))
  (obj cuc comment "the piece in Musil: orchestrate-granular a section (or one for the piece), continue, the loudness of a recording" (pos 110 133))
  (obj sc score atmospheres 2 @size 700 240 @view timeline (pos 20 172))
  (obj tr transport 60 4 4 (pos 750 172))
  (obj sp message play (pos 750 207))
  (obj ss message stop (pos 795 207))
  (obj cpl comment "play / stop" (pos 845 208))
  (obj bbr buffer~ atbrush (pos 750 267))
  (obj cbr comment "the piano strings brushed at the end (written by the script)" (pos 750 292))
  (obj sum +~ (pos 20 437))
  (obj chall comment "the two channels summed, the volume ramped, then a hall (reverb~)" (pos 70 438))
  (obj half *~ 0.25 (pos 20 467))
  (obj lbv loadbang (pos 140 482))
  (obj vol message "0.8 300" (pos 140 512))
  (obj mute message "0 300" (pos 210 512))
  (obj cvol comment "volume up, down" (pos 270 513))
  (obj ramp line~ (pos 140 542))
  (obj vca *~ (pos 20 577))
  (obj rv reverb~ 0.3 2.8 (pos 20 607))
  (obj dac dac~ (pos 20 642))
  (connect dmic 0 c 1)
  (connect dful 0 c 1)
  (connect s25 0 c 0)
  (connect s1 0 c 0)
  (connect c25 0 c 0)
  (connect c1 0 c 0)
  (connect lb 0 s25 0)
  (connect c 0 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sc 0 sum 0)
  (connect sc 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 vca 0)
  (connect lbv 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 rv 0)
  (connect rv 0 dac 0)
  (connect rv 1 dac 1))
