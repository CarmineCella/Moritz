; fm.moritz - two-operator FM synthesis (Chowning). The FM operator lives in
; a subpatcher: double-click "p fm" in locked mode to open it.
;   carrier frequency c, harmonicity h, modulation index I:
;   out = cos(2 pi c t + I * h c * cos(2 pi h c t))
; Click a note. Presets change h, the index peak and the decay.
; topic: Synthesis
(patch
  (obj title comment "FM synthesis: notes, presets, and a p subpatcher holding the operator" (pos 20 12))
  (obj n1 message 48 (pos 20 45))
  (obj n2 message 55 (pos 60 45))
  (obj n3 message 60 (pos 100 45))
  (obj n4 message 63 (pos 140 45))
  (obj n5 message 67 (pos 180 45))
  (obj n6 message 72 (pos 220 45))
  (obj nlabel comment "click a note (MIDI)" (pos 262 46))
  (obj note t b f (pos 20 90))
  (obj mtof mtof (pos 140 130))
  (obj env t b b (pos 20 130))
  (obj idx f 8 (pos 20 175))
  (obj dec f 2500 (pos 110 175))
  (obj pk pack 0. 0. (pos 20 215))
  (obj ienv message "$1 5 0 $2" (pos 20 255))
  (obj aenv message "1 5 0 $1" (pos 110 255))
  (obj iline line~ (pos 20 295))
  (obj aline line~ (pos 110 295))
  (obj fm p fm (pos 140 345)
    (patch
      (obj c0 comment "carrier Hz, harmonicity, index (signal)" (pos 20 10))
      (obj in1 inlet (pos 20 40))
      (obj in2 inlet (pos 140 40))
      (obj in3 inlet~ (pos 260 40))
      (obj c sig~ 220 (pos 20 85))
      (obj h sig~ 1 (pos 140 85))
      (obj mf *~ (pos 140 125))
      (obj c1 comment "modulator frequency h*c" (pos 200 126))
      (obj mod cycle~ (pos 140 165))
      (obj dev *~ (pos 140 205))
      (obj c2 comment "deviation = I * h*c" (pos 200 246))
      (obj idx *~ (pos 140 245))
      (obj sum +~ (pos 20 285))
      (obj car cycle~ (pos 20 325))
      (obj out outlet~ (pos 20 370))
      (connect in1 0 c 0)
      (connect in2 0 h 0)
      (connect c 0 mf 0)
      (connect h 0 mf 1)
      (connect mf 0 mod 0)
      (connect mod 0 dev 0)
      (connect mf 0 dev 1)
      (connect dev 0 idx 0)
      (connect in3 0 idx 1)
      (connect c 0 sum 0)
      (connect idx 0 sum 1)
      (connect sum 0 car 0)
      (connect car 0 out 0)))
  (obj vca *~ (pos 140 390))
  (obj vol *~ 0.3 (pos 140 430))
  (obj out dac~ (pos 140 475))
  (obj sc scope~ (pos 300 420))
  (obj presets comment "presets (harmonicity, index peak, decay ms): bell, brass, glass, gong" (pos 420 45))
  (obj p1 message "; fmh 1.4; fmidx 8; fmdec 2500" (pos 420 72))
  (obj p2 message "; fmh 1; fmidx 5; fmdec 600" (pos 505 72))
  (obj p3 message "; fmh 3.5; fmidx 2; fmdec 1200" (pos 590 72))
  (obj p4 message "; fmh 0.5; fmidx 12; fmdec 4000" (pos 675 72))
  (obj rh r fmh (pos 420 215))
  (obj ri r fmidx (pos 520 215))
  (obj rd r fmdec (pos 620 215))
  (obj hnum flonum 1.4 (pos 420 250))
  (obj inum flonum 8 (pos 520 250))
  (obj dnum number 2500 (pos 620 250))
  (obj lb loadbang (pos 420 300))
  (obj auto toggle (pos 300 90))
  (obj alabel comment "auto-play" (pos 330 91))
  (obj met metro 1800 (pos 300 125))
  (obj rnd random 6 (pos 300 160))
  (obj scale expr "48 + 2 * $i1 + ($i1 > 2)" (pos 240 215))
  (connect n1 0 note 0)
  (connect n2 0 note 0)
  (connect n3 0 note 0)
  (connect n4 0 note 0)
  (connect n5 0 note 0)
  (connect n6 0 note 0)
  (connect note 1 mtof 0)
  (connect note 0 env 0)
  (connect mtof 0 fm 0)
  (connect env 1 dec 0)
  (connect env 0 idx 0)
  (connect dec 0 pk 1)
  (connect dec 0 aenv 0)
  (connect idx 0 pk 0)
  (connect pk 0 ienv 0)
  (connect ienv 0 iline 0)
  (connect aenv 0 aline 0)
  (connect iline 0 fm 2)
  (connect fm 0 vca 0)
  (connect aline 0 vca 1)
  (connect vca 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 sc 0)
  (connect rh 0 hnum 0)
  (connect ri 0 inum 0)
  (connect rd 0 dnum 0)
  (connect hnum 0 fm 1)
  (connect inum 0 idx 1)
  (connect dnum 0 dec 1)
  (connect lb 0 p1 0)
  (connect auto 0 met 0)
  (connect met 0 rnd 0)
  (connect rnd 0 scale 0)
  (connect scale 0 note 0))
