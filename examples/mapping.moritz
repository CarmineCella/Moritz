; mapping.moritz - interactive machine learning, in the manner of
; Wekinator: knn learns where four FM sounds sit on an x/y plane (loaded at
; start) and, with inverse-distance weighting, glides between them as you
; move the sliders. To teach it a new sound: set the three number boxes
; (carrier, ratio, index), put the sliders where you want it, and click
; "record". "write" saves what it learnt, "read" loads it back.
; topic: Analysis and learning
(patch
  (obj title comment "knn mapping: two sliders control three FM parameters, learnt from examples you can record" (pos 20 12))
  (obj presets message "add 0 0 -> 110 1 2, add 100 0 -> 220 3.5 8, add 0 100 -> 440 1.41 4, add 100 100 -> 165 7 1" (pos 20 40))
  (obj lb loadbang (pos 620 40))
  (obj w message weighted 1, k 4 (pos 620 70))
  (obj cx comment "x" (pos 20 85))
  (obj sx slider 0 100 (pos 40 85))
  (obj cy comment "y" (pos 20 115))
  (obj sy slider 0 100 (pos 40 115))
  (obj ty t b f (pos 200 145))
  (obj pk pack 0. 0. (pos 20 175))
  (obj kn knn 4 (pos 20 210))
  (obj split unpack 0. 0. 0. (pos 20 245))
  (obj fc flonum 110 (pos 20 280))
  (obj ra flonum 1 (pos 100 280))
  (obj ix flonum 2 (pos 180 280))
  (obj cp comment "carrier (Hz), ratio, index" (pos 260 281))
  (obj mf expr "$f1 * $f2" (pos 100 320))
  (obj dev expr "$f1 * $f2 * $f3" (pos 220 320))
  (obj ml line~ (pos 100 390))
  (obj dl line~ (pos 220 390))
  (obj cl line~ (pos 20 355))
  (obj m1 message "$1 30" (pos 20 320))
  (obj m2 message "$1 30" (pos 100 355))
  (obj m3 message "$1 30" (pos 220 355))
  (obj mod cycle~ (pos 100 425))
  (obj mdev *~ (pos 100 460))
  (obj sum +~ (pos 20 495))
  (obj car cycle~ (pos 20 530))
  (obj rec button (pos 420 145))
  (obj crec comment "record: the sliders' place -> the numbers below" (pos 450 148))
  (obj rp pack 0. 0. 0. 0. 0. 0. (pos 420 210))
  (obj radd message "add $2 $3 -> $4 $5 $6" (pos 420 245))
  (obj wr message "write mapping.txt" (pos 420 280))
  (obj rd message "read mapping.txt" (pos 560 280))
  (obj cl2 message clear (pos 420 310))
  (obj on message "0.15 50" (pos 420 400))
  (obj off message "0 50" (pos 490 400))
  (obj cv comment "volume" (pos 550 401))
  (obj ramp line~ (pos 420 435))
  (obj vca *~ (pos 20 565))
  (obj out dac~ (pos 20 600))
  (connect lb 0 presets 0)
  (connect lb 0 w 0)
  (connect presets 0 kn 0)
  (connect w 0 kn 0)
  (connect sx 0 pk 0)
  (connect sy 0 ty 0)
  (connect ty 1 pk 1)
  (connect ty 0 pk 0)
  (connect pk 0 kn 0)
  (connect kn 0 split 0)
  (connect split 0 fc 0)
  (connect split 1 ra 0)
  (connect split 2 ix 0)
  (connect ix 0 dev 2)
  (connect ra 0 mf 1)
  (connect ra 0 dev 1)
  (connect fc 0 mf 0)
  (connect fc 0 dev 0)
  (connect fc 0 m1 0)
  (connect m1 0 cl 0)
  (connect mf 0 m2 0)
  (connect m2 0 ml 0)
  (connect dev 0 m3 0)
  (connect m3 0 dl 0)
  (connect ml 0 mod 0)
  (connect mod 0 mdev 0)
  (connect dl 0 mdev 1)
  (connect cl 0 sum 0)
  (connect mdev 0 sum 1)
  (connect sum 0 car 0)
  (connect car 0 vca 0)
  (connect rec 0 rp 0)
  (connect sx 0 rp 1)
  (connect sy 0 rp 2)
  (connect fc 0 rp 3)
  (connect ra 0 rp 4)
  (connect ix 0 rp 5)
  (connect rp 0 radd 0)
  (connect radd 0 kn 0)
  (connect wr 0 kn 0)
  (connect rd 0 kn 0)
  (connect cl2 0 kn 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
