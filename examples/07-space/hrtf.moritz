; hrtf.moritz - a sound in 3D on headphones with hrtf~: the measured head
; responses of the MIT KEMAR dummy head (710 directions), interpolated
; between the four measured directions around the source. Height is heard
; mostly through the outer ear's spectral notches (5-10 kHz), so it is
; clearest on broadband sounds (the noise bursts) and with the direct
; responses; an ambisonic rendering (ambienc~ 2 into binaural~ 2) mixes
; several responses and blurs those notches. Switch between the two to
; compare. Generic responses: up/down and front/back are less sure than
; left/right for most listeners.
(patch
  (obj title comment "hrtf~: a sound anywhere around and above you, on headphones" (pos 20 12))
  (obj sub comment "Headphones. Choose a source and let it fly (circling, rising and falling), or place it with the sliders. Compare hrtf~ and ambisonics." (pos 20 34))
  (obj b buffer~ hrvox Vox.wav (pos 20 65))
  (obj pl message "loop 1, start" (pos 20 100))
  (obj v groove~ hrvox (pos 20 135))
  (obj rate sig~ 1 (pos 140 100))
  (obj vg *~ 0.5 (pos 20 170))
  (obj bt toggle (pos 240 100))
  (obj cbt comment "noise bursts" (pos 270 103))
  (obj met metro 180 (pos 240 135))
  (obj burst message "0.6, 0 90" (pos 240 170))
  (obj env line~ (pos 240 205))
  (obj nz noise~ (pos 340 170))
  (obj nb *~ (pos 340 205))
  (obj cs comment "source: 1 voice, 2 noise" (pos 460 100))
  (obj s1 message 1 (pos 460 120))
  (obj s2 message 2 (pos 500 120))
  (obj src selector~ 2 1 (pos 20 250))
  (obj cm comment "movement: 1 flying by itself, 2 the sliders" (pos 460 155))
  (obj mv1 message 1 (pos 460 175))
  (obj mv2 message 2 (pos 500 175))
  (obj cspd comment "turns per second" (pos 640 85))
  (obj spd flonum 0.1 (pos 640 105))
  (obj ph phasor~ 0.1 (pos 640 140))
  (obj deg *~ 360 (pos 640 175))
  (obj up cycle~ 0.07 (pos 760 105))
  (obj upd *~ 60 (pos 760 140))
  (obj upo +~ 25 (pos 760 175))
  (obj caz comment "azimuth" (pos 20 285))
  (obj az slider -180 180 (pos 20 305))
  (obj azn number (pos 175 305))
  (obj azs sig~ (pos 175 340))
  (obj cel comment "elevation" (pos 260 285))
  (obj el slider -40 90 (pos 260 305))
  (obj eln number (pos 415 305))
  (obj els sig~ (pos 415 340))
  (obj aza selector~ 2 1 (pos 640 300))
  (obj ela selector~ 2 1 (pos 760 300))
  (obj hr hrtf~ (pos 20 390))
  (obj enc ambienc~ 2 (pos 260 390))
  (obj bin binaural~ 2 (pos 260 430))
  (obj bgl *~ 0.45 (pos 260 470))
  (obj bgr *~ 0.45 (pos 380 470))
  (obj cbg comment "-7 dB: same loudness as hrtf~ on average" (pos 450 471))
  (obj ccmp comment "1 hrtf~ (the measured responses), 2 ambisonics order 2" (pos 560 390))
  (obj k1 message 1 (pos 560 410))
  (obj k2 message 2 (pos 600 410))
  (obj sl selector~ 2 1 (pos 20 510))
  (obj sr selector~ 2 1 (pos 140 510))
  (obj on message "0.6 50" (pos 300 550))
  (obj off message "0 50" (pos 370 550))
  (obj cvol comment "volume" (pos 430 551))
  (obj ramp line~ (pos 300 585))
  (obj gl *~ (pos 20 585))
  (obj gr *~ (pos 140 585))
  (obj out dac~ (pos 20 630))
  (obj lb loadbang (pos 900 85))
  (obj zero message 0 (pos 900 115))
  (connect pl 0 v 0)
  (connect rate 0 v 0)
  (connect v 0 vg 0)
  (connect bt 0 met 0)
  (connect met 0 burst 0)
  (connect burst 0 env 0)
  (connect nz 0 nb 0)
  (connect env 0 nb 1)
  (connect s1 0 src 0)
  (connect s2 0 src 0)
  (connect vg 0 src 1)
  (connect nb 0 src 2)
  (connect spd 0 ph 0)
  (connect ph 0 deg 0)
  (connect up 0 upd 0)
  (connect upd 0 upo 0)
  (connect az 0 azn 0)
  (connect azn 0 azs 0)
  (connect el 0 eln 0)
  (connect eln 0 els 0)
  (connect mv1 0 aza 0)
  (connect mv1 0 ela 0)
  (connect mv2 0 aza 0)
  (connect mv2 0 ela 0)
  (connect deg 0 aza 1)
  (connect azs 0 aza 2)
  (connect upo 0 ela 1)
  (connect els 0 ela 2)
  (connect src 0 hr 0)
  (connect aza 0 hr 1)
  (connect ela 0 hr 2)
  (connect src 0 enc 0)
  (connect aza 0 enc 1)
  (connect ela 0 enc 2)
  (connect enc 0 bin 0)
  (connect enc 1 bin 1)
  (connect enc 2 bin 2)
  (connect enc 3 bin 3)
  (connect enc 4 bin 4)
  (connect enc 5 bin 5)
  (connect enc 6 bin 6)
  (connect enc 7 bin 7)
  (connect enc 8 bin 8)
  (connect k1 0 sl 0)
  (connect k1 0 sr 0)
  (connect k2 0 sl 0)
  (connect k2 0 sr 0)
  (connect hr 0 sl 1)
  (connect hr 1 sr 1)
  (connect bin 0 bgl 0)
  (connect bin 1 bgr 0)
  (connect bgl 0 sl 2)
  (connect bgr 0 sr 2)
  (connect sl 0 gl 0)
  (connect sr 0 gr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 gl 1)
  (connect ramp 0 gr 1)
  (connect gl 0 out 0)
  (connect gr 0 out 1)
  (connect lb 0 zero 0)
  (connect zero 0 az 0)
  (connect zero 0 el 0))
