; dark-drone.moritz - dark drone music that changes by itself. Four layers:
; a drone of detuned sawtooths and a sub sine through a resonant low-pass;
; breath (noise through a band-pass that sweeps slowly); metal (bursts of
; noise ringing in two long combs tuned to high partials of the drone, at
; random times); and a long reverb over everything. Slow processes move it:
; every 40 seconds the root glides for 20 seconds to a darker neighbour (a
; semitone, a tritone), every 13 seconds the filter heads for a new
; cutoff, the metal strikes every 2 to 10 seconds, and a swell of some two
; minutes breathes over the whole.
(patch
  (obj title comment "Dark drone: slow processes that never repeat" (pos 20 12))
  (obj sub comment "Turn audio on, then play; it changes by itself. Move the layers' levels and the reverb while it plays. Double-click a part to open it." (pos 20 34))
  (obj tog toggle (pos 20 75))
  (obj ctog comment "play (fades in and out over 6 s)" (pos 48 77))
  (obj croot comment "root (MIDI): it moves by itself" (pos 300 60))
  (obj root number (pos 300 80))
  (obj ccut comment "filter (Hz)" (pos 500 60))
  (obj cutn number (pos 500 80))
  (obj cdr comment "drone" (pos 20 118))
  (obj ldr slider 0. 1. (pos 20 138))
  (obj cbr comment "breath" (pos 190 118))
  (obj lbr slider 0. 1. (pos 190 138))
  (obj cmt comment "metal" (pos 360 118))
  (obj lmt slider 0. 1. (pos 360 138))
  (obj crv comment "reverb" (pos 530 118))
  (obj rv slider 0. 1. (pos 530 138))
  (obj cvol comment "volume" (pos 700 118))
  (obj vol slider 0. 1. (pos 700 138))
  (obj lb loadbang (pos 900 60))
  (obj init message "0.8 0.5 0.6 0.7 0.6 38 300" (pos 900 90))
  (obj iu unpack 0. 0. 0. 0. 0. 0 0 (pos 900 120))
  (obj harm p harmony (pos 20 200)
    (patch
      (obj c0 comment "Harmony: every 40 s the root moves to a dark neighbour of D (a semitone below or above, the tritone, a minor third), never staying; the drone glides there in 20 s." (pos 20 10))
      (obj on inlet (pos 20 45))
      (obj set inlet (pos 300 45))
      (obj hs select 0 (pos 20 75))
      (obj hst message stop (pos 20 100))
      (obj hgo t b (pos 120 100))
      (obj sk delay 40000 (pos 120 125))
      (obj csk comment "the first move after 40 s, then one every 40 s" (pos 210 127))
      (obj mt metro 40000 (pos 20 125))
      (obj rd random 4 (pos 20 150))
      (obj ix expr "($i2 + 1 + $i1) % 5" (pos 20 170))
      (obj cix comment "another of the five than the one now" (pos 180 172))
      (obj tix t i i (pos 20 200))
      (obj mp expr "38 + ($i1 == 1) * -1 + ($i1 == 2) * 1 + ($i1 == 3) * 6 + ($i1 == 4) * 3" (pos 20 230))
      (obj cmp comment "D, C#, D#, G# (the tritone), F (the minor third)" (pos 20 258))
      (obj out outlet (pos 20 290))
      (connect on 0 hs 0)
      (connect hs 0 hst 0)
      (connect hst 0 sk 0)
      (connect hst 0 mt 0)
      (connect hs 1 hgo 0)
      (connect hgo 0 sk 0)
      (connect sk 0 mt 0)
      (connect mt 0 rd 0)
      (connect rd 0 ix 0)
      (connect ix 0 tix 0)
      (connect tix 1 ix 1)
      (connect tix 0 mp 0)
      (connect mp 0 out 0)
      (connect set 0 out 0)))
  (obj filt p filter-walk (pos 140 200)
    (patch
      (obj c0 comment "Filter walk: every 13 s a new cutoff between 90 and 900 Hz (low ones more often: the square of a random number), reached in 9 s." (pos 20 10))
      (obj on inlet (pos 20 45))
      (obj mt metro 13000 (pos 20 80))
      (obj rd expr "90 + 810 * pow(random(0, 1), 2)" (pos 20 110))
      (obj out outlet (pos 20 140))
      (connect on 0 mt 0)
      (connect mt 0 rd 0)
      (connect rd 0 out 0)))
  (obj drone p drone (pos 20 260)
    (patch
      (obj c0 comment "Drone: two sawtooths a little apart (they beat), one a fifth up, one an octave up, and a sine an octave down, into a resonant low-pass; slow sines move the cutoff and the beating." (pos 20 10))
      (obj root inlet (pos 20 45))
      (obj cut inlet (pos 400 45))
      (obj mf mtof (pos 20 70))
      (obj ft t b f (pos 20 95))
      (obj g2 message 2 (pos 20 120))
      (obj fg gate 2 1 (pos 100 120))
      (obj gm message "$1 20000" (pos 160 145))
      (obj cfg comment "the first root jumps, the next ones glide" (pos 250 147))
      (obj f line~ (pos 20 150))
      (obj dt cycle~ 0.07 (pos 200 140))
      (obj dtx expr~ "$v1 * (1.003 + 0.002 * $v2)" (pos 200 170))
      (obj f5 *~ 1.498 (pos 380 170))
      (obj f8 *~ 2.004 (pos 480 170))
      (obj fsub *~ 0.5 (pos 580 170))
      (obj o1 saw~ (pos 20 210))
      (obj o2 saw~ (pos 200 210))
      (obj o3 saw~ (pos 380 210))
      (obj o4 saw~ (pos 480 210))
      (obj o5 cycle~ (pos 580 210))
      (obj g3 *~ 0.5 (pos 380 240))
      (obj g4 *~ 0.3 (pos 480 240))
      (obj g5 *~ 1.2 (pos 580 240))
      (obj a1 +~ (pos 20 280))
      (obj a2 +~ (pos 20 310))
      (obj a3 +~ (pos 20 340))
      (obj ct t b f (pos 400 70))
      (obj c2 message 2 (pos 400 95))
      (obj cg gate 2 1 (pos 480 95))
      (obj cm message "$1 9000" (pos 540 70))
      (obj cl line~ (pos 400 110))
      (obj lfo cycle~ 0.019 (pos 640 110))
      (obj cmod expr~ "$v1 * (1 + 0.35 * $v2)" (pos 400 140))
      (obj lp lores~ 300 0.55 (pos 20 380))
      (obj sat tanh~ (pos 20 410))
      (obj sb comment "the sub sine is added after the filter and the saturation, clean" (pos 120 440))
      (obj a4 +~ (pos 20 440))
      (obj g *~ 0.3 (pos 20 470))
      (obj out outlet~ (pos 20 500))
      (connect root 0 mf 0)
      (connect mf 0 ft 0)
      (connect ft 1 fg 1)
      (connect ft 0 g2 0)
      (connect g2 0 fg 0)
      (connect fg 0 f 0)
      (connect fg 1 gm 0)
      (connect gm 0 f 0)
      (connect f 0 o1 0)
      (connect f 0 dtx 0)
      (connect dt 0 dtx 1)
      (connect dtx 0 o2 0)
      (connect f 0 f5 0)
      (connect f 0 f8 0)
      (connect f 0 fsub 0)
      (connect f5 0 o3 0)
      (connect f8 0 o4 0)
      (connect fsub 0 o5 0)
      (connect o3 0 g3 0)
      (connect o4 0 g4 0)
      (connect o5 0 g5 0)
      (connect o1 0 a1 0)
      (connect o2 0 a1 1)
      (connect a1 0 a2 0)
      (connect g3 0 a2 1)
      (connect a2 0 a3 0)
      (connect g4 0 a3 1)
      (connect cut 0 ct 0)
      (connect ct 1 cg 1)
      (connect ct 0 c2 0)
      (connect c2 0 cg 0)
      (connect cg 0 cl 0)
      (connect cg 1 cm 0)
      (connect cm 0 cl 0)
      (connect cl 0 cmod 0)
      (connect lfo 0 cmod 1)
      (connect a3 0 lp 0)
      (connect cmod 0 lp 1)
      (connect lp 0 sat 0)
      (connect sat 0 a4 0)
      (connect g5 0 a4 1)
      (connect a4 0 g 0)
      (connect g 0 out 0)))
  (obj breath p breath (pos 100 260)
    (patch
      (obj c0 comment "Breath: noise through a band-pass whose centre wanders between 150 and 1200 Hz (two slow sines, 47 and 71 s), its level rising and falling (a third, 29 s)." (pos 20 10))
      (obj nz noise~ (pos 20 45))
      (obj l1 cycle~ 0.0213 (pos 200 45))
      (obj l2 cycle~ 0.0141 (pos 320 45))
      (obj l3 cycle~ 0.0345 (pos 440 45))
      (obj fc expr~ "150 * pow(8, 0.5 + 0.3 * $v1 + 0.2 * $v2)" (pos 200 80))
      (obj bp svf~ 400 3 (pos 20 120))
      (obj lv expr~ "0.25 + 0.75 * (0.5 + 0.5 * $v1) * (0.5 + 0.5 * $v1)" (pos 440 80))
      (obj vca *~ (pos 20 160))
      (obj g *~ 0.9 (pos 20 190))
      (obj out outlet~ (pos 20 220))
      (connect l1 0 fc 0)
      (connect l2 0 fc 1)
      (connect nz 0 bp 0)
      (connect fc 0 bp 1)
      (connect bp 2 vca 0)
      (connect l3 0 lv 0)
      (connect lv 0 vca 1)
      (connect vca 0 g 0)
      (connect g 0 out 0)))
  (obj metal p metal (pos 180 260)
    (patch
      (obj c0 comment "Metal: at random times (2 to 10 s apart) a short burst of noise strikes two long combs tuned to the 7th and 11th partials of the root (or the 9th and 13th), which ring for many seconds." (pos 20 10))
      (obj on inlet (pos 20 45))
      (obj root inlet (pos 400 45))
      (obj sel select 0 (pos 20 80))
      (obj stp message stop (pos 20 110))
      (obj go t b (pos 100 110))
      (obj dl delay 3000 (pos 100 140))
      (obj tr t b b b (pos 100 170))
      (obj nd expr "random(2000, 10000)" (pos 300 200))
      (obj pk message "1 5 0 120" (pos 100 200))
      (obj env line~ (pos 100 230))
      (obj nz noise~ (pos 20 230))
      (obj ex *~ (pos 20 260))
      (obj hi svf~ 2500 0.7 (pos 20 290))
      (obj ch random 2 (pos 600 200))
      (obj mf mtof (pos 400 80))
      (obj cht t i i (pos 600 230))
      (obj d1 expr "1000. / ($f2 * (7 + 2 * $i1))" (pos 400 270))
      (obj d2 expr "1000. / ($f2 * (11 + 2 * $i1))" (pos 600 270))
      (obj cd comment "the choice (0 or 1) at each strike; the root's frequency kept" (pos 400 300))
      (obj cb1 comb~ 50 5 0.5 0 0.9993 (pos 20 330))
      (obj cb2 comb~ 50 3 0.5 0 0.9991 (pos 200 330))
      (obj mx +~ (pos 20 370))
      (obj lp lores~ 3500 0.2 (pos 20 400))
      (obj g *~ 0.9 (pos 20 430))
      (obj out outlet~ (pos 20 460))
      (connect on 0 sel 0)
      (connect sel 0 stp 0)
      (connect stp 0 dl 0)
      (connect sel 1 go 0)
      (connect go 0 dl 0)
      (connect dl 0 tr 0)
      (connect tr 2 nd 0)
      (connect nd 0 dl 1)
      (connect tr 1 ch 0)
      (connect ch 0 cht 0)
      (connect cht 1 d2 0)
      (connect cht 0 d1 0)
      (connect tr 0 pk 0)
      (connect tr 0 dl 0)
      (connect pk 0 env 0)
      (connect nz 0 ex 0)
      (connect env 0 ex 1)
      (connect ex 0 hi 0)
      (connect root 0 mf 0)
      (connect mf 0 d1 1)
      (connect mf 0 d2 1)
      (connect hi 1 cb1 0)
      (connect hi 1 cb2 0)
      (connect d1 0 cb1 1)
      (connect d2 0 cb2 1)
      (connect cb1 0 mx 0)
      (connect cb2 0 mx 1)
      (connect mx 0 lp 0)
      (connect lp 0 g 0)
      (connect g 0 out 0)))
  (obj cmix comment "levels, the swell (a sine of 130 s), reverb, volume and the fade" (pos 300 205))
  (obj gdr *~ (pos 20 300))
  (obj gbr *~ (pos 100 300))
  (obj gmt *~ (pos 180 300))
  (obj sw cycle~ 0.0077 (pos 300 300))
  (obj swx expr~ "0.65 + 0.35 * $v1" (pos 300 330))
  (obj m1 +~ (pos 20 340))
  (obj m2 +~ (pos 20 370))
  (obj msw *~ (pos 20 400))
  (obj rev reverb~ 0.7 9 (pos 20 440))
  (obj rvs expr "$f1 * 0.9" (pos 530 300))
  (obj fd message "$1 6000" (pos 250 440))
  (obj fl line~ (pos 250 470))
  (obj tv t f f (pos 360 470))
  (obj vL *~ (pos 20 500))
  (obj vR *~ (pos 120 500))
  (obj fL *~ (pos 20 530))
  (obj fR *~ (pos 120 530))
  (obj lL tanh~ (pos 20 560))
  (obj lR tanh~ (pos 120 560))
  (obj dac dac~ (pos 20 595))
  (obj c9 comment "Nothing repeats: the harmony (40 s), the filter (13 s), the breath (29, 47, 71 s), the swell (130 s) and the metal (2-10 s) never line up the same way." (pos 20 640))
  (obj c10 comment "Lower the metal and raise the breath for a wind; drone alone with little reverb for a pedal; everything up for a cathedral." (pos 20 658))
  (connect lb 0 init 0)
  (connect init 0 iu 0)
  (connect iu 0 ldr 0)
  (connect iu 1 lbr 0)
  (connect iu 2 lmt 0)
  (connect iu 3 rv 0)
  (connect iu 4 vol 0)
  (connect iu 5 harm 1)
  (connect iu 6 cutn 0)
  (connect tog 0 harm 0)
  (connect tog 0 filt 0)
  (connect tog 0 metal 0)
  (connect harm 0 root 0)
  (connect root 0 drone 0)
  (connect root 0 metal 1)
  (connect filt 0 cutn 0)
  (connect cutn 0 drone 1)
  (connect drone 0 gdr 0)
  (connect ldr 0 gdr 1)
  (connect breath 0 gbr 0)
  (connect lbr 0 gbr 1)
  (connect metal 0 gmt 0)
  (connect lmt 0 gmt 1)
  (connect gdr 0 m1 0)
  (connect gbr 0 m1 1)
  (connect m1 0 m2 0)
  (connect gmt 0 m2 1)
  (connect sw 0 swx 0)
  (connect m2 0 msw 0)
  (connect swx 0 msw 1)
  (connect msw 0 rev 0)
  (connect rv 0 rvs 0)
  (connect rvs 0 rev 1)
  (connect tog 0 fd 0)
  (connect fd 0 fl 0)
  (connect vol 0 tv 0)
  (connect rev 0 vL 0)
  (connect rev 1 vR 0)
  (connect tv 1 vL 1)
  (connect tv 0 vR 1)
  (connect vL 0 fL 0)
  (connect vR 0 fR 0)
  (connect fl 0 fL 1)
  (connect fl 0 fR 1)
  (connect fL 0 lL 0)
  (connect fR 0 lR 0)
  (connect lL 0 dac 0)
  (connect lR 0 dac 1))
