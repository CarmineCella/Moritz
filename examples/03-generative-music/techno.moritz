; techno.moritz - a techno machine where every sound is synthesized: a
; kick (a sine whose pitch falls), a clap (bursts of band-passed noise),
; hats (six square waves, as in the TR-808), an acid bass (a sawtooth into
; a resonant low-pass with a falling cutoff), a dub stab (a minor chord
; with echoes) and rumble (the kick through a long reverb). A clock steps
; through 16 sixteenths; each part's pattern is a number whose bits are
; the steps. Choose a pattern, mutate it, switch parts off, turn the knobs.
; With auto on, every 10 seconds the machine mutates by itself: new hats and
; bass, and the bass filter, resonance, open hat, echoes and rumble move to
; new values.
(patch
  (obj title comment "Techno machine: every sound synthesized, patterns of 16 steps" (pos 20 12))
  (obj sub comment "Turn audio on, then play. It mutates by itself every 10 s (auto); choose a pattern, mutate it, switch parts on and off, turn the knobs. Double-click a part to see how it is made." (pos 20 34))
  (obj tog toggle (pos 20 75))
  (obj ctog comment "play" (pos 48 77))
  (obj cbpm comment "tempo (BPM)" (pos 110 60))
  (obj bpm number (pos 110 80))
  (obj crt comment "root (MIDI)" (pos 210 60))
  (obj root number (pos 210 80))
  (obj cst comment "step" (pos 310 60))
  (obj stp number (pos 310 80))
  (obj cpat comment "patterns: kick clap closed-hats open-hats bass stab" (pos 420 60))
  (obj pt0 message "4369 0 0 17476 61166 0" (pos 420 80))
  (obj cpt0 comment "minimal" (pos 640 82))
  (obj pt1 message "4369 4112 48059 17476 61166 0" (pos 420 106))
  (obj cpt1 comment "drive" (pos 640 108))
  (obj pt2 message "4369 4112 43690 17476 17476 1032" (pos 420 132))
  (obj cpt2 comment "dub" (pos 640 134))
