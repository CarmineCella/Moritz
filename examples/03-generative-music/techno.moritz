  (obj seq p sequencer (pos 20 270)
    (patch
      (obj c0 comment "The clock steps through 16 sixteenths (15000 / BPM ms each). A pattern is a number: bit n (worth 2 to the n) is step n; each part plays where its bit is set." (pos 20 10))
      (obj c1 comment "4369 = 1 + 16 + 256 + 4096: steps 0 4 8 12, four to the floor." (pos 20 28))
      (obj on inlet (pos 20 60))
      (obj bpm inlet (pos 150 60))
