  (obj dec slider 20 600 (pos 360 210))
  (obj crum comment "rumble" (pos 530 190))
  (obj rumk slider 0. 1. (pos 530 210))
  (obj cfb comment "stab echoes" (pos 700 190))
  (obj fb slider 0. 0.9 (pos 700 210))
  (obj cvol comment "volume" (pos 870 190))
  (obj vol slider 0. 1. (pos 870 210))
