      (connect nz 0 ex1 0)
      (connect ev1 0 ex1 1)
      (connect ex1 0 lp1 0)
      (connect lp1 0 cb1 0)
      (connect dl1 0 cb1 1)
      (connect tsa 1 ad2 0)
      (connect ad2 0 mf2 0)
      (connect mf2 0 dl2 0)
      (connect ts 2 pk2 0)
      (connect pk2 0 ev2 0)
      (connect nz 0 ex2 0)
      (connect ev2 0 ex2 1)
      (connect ex2 0 lp2 0)
      (connect lp2 0 cb2 0)
      (connect dl2 0 cb2 1)
      (connect tsa 0 ad3 0)
      (connect ad3 0 mf3 0)
      (connect mf3 0 dl3 0)
      (connect ts 3 pk3 0)
      (connect pk3 0 ev3 0)
      (connect nz 0 ex3 0)
      (connect ev3 0 ex3 1)
      (connect ex3 0 lp3 0)
      (connect lp3 0 cb3 0)
      (connect dl3 0 cb3 1)
      (connect cb0 0 s1 0)
      (connect cb1 0 s1 1)
      (connect s1 0 s2 0)
      (connect cb2 0 s2 1)
      (connect s2 0 s3 0)
      (connect cb3 0 s3 1)
      (connect s3 0 sat 0)
      (connect sat 0 g 0)
      (connect g 0 out 0)))
  (obj mel p melody (pos 200 200)
    (patch
      (obj c0 comment "Melody: every 200 ms a note may start (density); its pitch is a random walk on the raga's notes, and the string glides into it." (pos 20 10))
      (obj on inlet (pos 20 45))
      (obj sa inlet (pos 250 45))
      (obj rg inlet (pos 400 45))
      (obj den inlet (pos 520 45))
      (obj gl inlet (pos 680 45))
      (obj mm metro 200 (pos 20 80))
      (obj rd random 15 (pos 20 110))
      (obj dx expr "int(2 + (1 - $f1) * 30)" (pos 520 80))
      (obj cdx comment "a chance of 1 in n" (pos 520 110))
      (obj sel0 select 0 (pos 20 140))
      (obj tb t b b (pos 20 170))
      (obj st random 5 (pos 250 200))
      (obj sm - 2 (pos 250 230))
      (obj acc + (pos 250 260))
      (obj clp expr "min(max($i1, 0), 14)" (pos 250 290))
      (obj tii t i i (pos 250 320))
      (obj cwalk comment "a step of -2 to +2 notes, kept between Sa and two octaves above" (pos 400 230))
      (obj gt gate 3 1 (pos 250 350))
      (obj csc comment "the note of the scale (semitones above Sa): Bhupali, Yaman, Bhairav" (pos 250 380))
      (obj sc0 expr "(int($i1 / 5) * 12) + ($i1 % 5 == 1) * 2 + ($i1 % 5 == 2) * 4 + ($i1 % 5 == 3) * 7 + ($i1 % 5 == 4) * 9" (pos 250 400))
      (obj sc1 expr "(int($i1 / 7) * 12) + ($i1 % 7 == 1) * 2 + ($i1 % 7 == 2) * 4 + ($i1 % 7 == 3) * 6 + ($i1 % 7 == 4) * 7 + ($i1 % 7 == 5) * 9 + ($i1 % 7 == 6) * 11" (pos 250 430))
      (obj sc2 expr "(int($i1 / 7) * 12) + ($i1 % 7 == 1) * 1 + ($i1 % 7 == 2) * 4 + ($i1 % 7 == 3) * 5 + ($i1 % 7 == 4) * 7 + ($i1 % 7 == 5) * 8 + ($i1 % 7 == 6) * 11" (pos 250 460))
      (obj addsa + 50. (pos 250 500))
      (obj mtf mtof (pos 250 530))
      (obj dms expr "1000. / $f1" (pos 320 530))
      (obj cdms comment "the period in ms: the delay of the string" (pos 430 532))
      (obj pkg pack 0. 90. (pos 320 560))
      (obj glm message "$1 $2" (pos 320 590))
      (obj lb loadbang (pos 400 590))
      (obj m0 message 6.8 (pos 400 620))
      (obj gli line~ (pos 250 650))
      (obj mpk message "1 2 0 30" (pos 20 200))
      (obj mev line~ (pos 20 230))
      (obj nz noise~ (pos 120 230))
      (obj mex *~ (pos 20 260))
      (obj mlp lores~ 4500 0.3 (pos 20 290))
      (obj mcb comb~ 40 7 1 0 0.995 (pos 20 680))
      (obj msat tanh~ (pos 20 710))
      (obj out outlet~ (pos 20 740))
      (connect on 0 mm 0)
      (connect mm 0 rd 0)
      (connect den 0 dx 0)
      (connect dx 0 rd 1)
      (connect rd 0 sel0 0)
      (connect sel0 0 tb 0)
      (connect tb 1 st 0)
      (connect st 0 sm 0)
      (connect sm 0 acc 0)
      (connect acc 0 clp 0)
      (connect clp 0 tii 0)
      (connect tii 1 acc 1)
      (connect tii 0 gt 1)
      (connect rg 0 gt 0)
      (connect gt 0 sc0 0)
      (connect gt 1 sc1 0)
      (connect gt 2 sc2 0)
      (connect sc0 0 addsa 0)
      (connect sc1 0 addsa 0)
      (connect sc2 0 addsa 0)
      (connect sa 0 addsa 1)
      (connect addsa 0 mtf 0)
      (connect mtf 0 dms 0)
      (connect dms 0 pkg 0)
      (connect gl 0 pkg 1)
      (connect pkg 0 glm 0)
      (connect lb 0 m0 0)
      (connect glm 0 gli 0)
      (connect m0 0 gli 0)
      (connect tb 0 mpk 0)
