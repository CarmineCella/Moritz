; raga.moritz - a generative raga (after the "ragamatic" demo of Perry
; Cook's Synthesis ToolKit): music that goes on by itself. A tanpura of four
; plucked strings (comb filters excited by bursts of noise, as in
; Karplus-Strong) repeats its cycle; six resonators tuned to the tonic's
; partials, fed by noise and by the melody, swell slowly like sympathetic
; strings; a melody string wanders on the notes of a raga (a random walk)
; and glides into each note. Choose the tonic, the raga, how often the
; melody plays, the glide and the balance.
(patch
  (obj title comment "Raga: plucked strings, sympathetic resonators and a wandering melody" (pos 20 12))
  (obj sub comment "Turn audio on, then play; the music goes on by itself. Change the tonic, the raga and the controls while it plays. Double-click a part to open it." (pos 20 34))
  (obj tog toggle (pos 20 75))
  (obj ctog comment "play (fades in and out)" (pos 48 77))
  (obj csa comment "Sa: the tonic (MIDI)" (pos 230 60))
  (obj sa number (pos 230 80))
  (obj cr comment "raga" (pos 400 60))
  (obj r1 message 1 (pos 400 80))
  (obj r2 message 2 (pos 435 80))
  (obj r3 message 3 (pos 470 80))
  (obj cr2 comment "1 Bhupali   2 Yaman   3 Bhairav" (pos 510 82))
  (obj cden comment "melody: how often" (pos 20 118))
  (obj den slider 0. 1. (pos 20 138))
  (obj cgl comment "glide into notes (ms)" (pos 190 118))
  (obj gl slider 0 400 (pos 190 138))
  (obj cbal comment "strings / resonators" (pos 360 118))
  (obj bal slider 0. 1. (pos 360 138))
  (obj crv comment "reverb" (pos 530 118))
  (obj rv slider 0. 1. (pos 530 138))
  (obj cvol comment "volume" (pos 700 118))
  (obj vol slider 0. 1. (pos 700 138))
  (obj lb loadbang (pos 880 60))
  (obj init message "50 0.55 90 0.45 0.4 0.6 1" (pos 880 90))
  (obj iu unpack 0. 0. 0. 0. 0. 0. 0 (pos 880 120))
  (obj tan p tanpura (pos 20 200)
    (patch
      (obj c0 comment "Tanpura: four strings plucked in turn (Pa, Sa, Sa, low Sa), then a rest. A string is a comb filter (a delay of one period, fed back) excited by a burst of noise: Karplus-Strong." (pos 20 10))
      (obj on inlet (pos 20 45))
      (obj sa inlet (pos 300 45))
      (obj tm metro 1250 (pos 20 80))
      (obj tc counter 0 4 (pos 20 110))
      (obj ts select 0 1 2 3 (pos 20 140))
      (obj nz noise~ (pos 620 80))
      (obj tsa t f f f f (pos 300 80))
      (obj n0 comment "Pa (-5 semitones)" (pos 20 175))
      (obj ad0 + -5 (pos 20 200))
      (obj mf0 mtof (pos 90 200))
      (obj dl0 expr "1000. / $f1" (pos 90 230))
      (obj pk0 message "1 4 0 45" (pos 20 230))
      (obj ev0 line~ (pos 20 260))
      (obj ex0 *~ (pos 20 290))
      (obj lp0 lores~ 2200 0.1 (pos 20 320))
      (obj cb0 comb~ 40 7 1 0 0.9965 (pos 20 350))
      (obj n1 comment "Sa (0.03 semitones)" (pos 220 175))
      (obj ad1 + 0.03 (pos 220 200))
      (obj mf1 mtof (pos 290 200))
      (obj dl1 expr "1000. / $f1" (pos 290 230))
      (obj pk1 message "1 4 0 45" (pos 220 230))
      (obj ev1 line~ (pos 220 260))
      (obj ex1 *~ (pos 220 290))
      (obj lp1 lores~ 2200 0.1 (pos 220 320))
      (obj cb1 comb~ 40 7 1 0 0.9965 (pos 220 350))
      (obj n2 comment "Sa (-0.03 semitones)" (pos 420 175))
      (obj ad2 + -0.03 (pos 420 200))
      (obj mf2 mtof (pos 490 200))
      (obj dl2 expr "1000. / $f1" (pos 490 230))
      (obj pk2 message "1 4 0 45" (pos 420 230))
      (obj ev2 line~ (pos 420 260))
      (obj ex2 *~ (pos 420 290))
      (obj lp2 lores~ 2200 0.1 (pos 420 320))
      (obj cb2 comb~ 40 7 1 0 0.9965 (pos 420 350))
      (obj n3 comment "low Sa (-12 semitones)" (pos 620 175))
      (obj ad3 + -12 (pos 620 200))
      (obj mf3 mtof (pos 690 200))
      (obj dl3 expr "1000. / $f1" (pos 690 230))
      (obj pk3 message "1 4 0 45" (pos 620 230))
      (obj ev3 line~ (pos 620 260))
      (obj ex3 *~ (pos 620 290))
      (obj lp3 lores~ 2200 0.1 (pos 620 320))
      (obj cb3 comb~ 40 7 1 0 0.994 (pos 620 350))
      (obj s1 +~ (pos 20 390))
      (obj s2 +~ (pos 20 420))
      (obj s3 +~ (pos 20 450))
      (obj sat tanh~ (pos 20 480))
      (obj csat comment "a little saturation: the buzz of the jawari bridge" (pos 80 482))
      (obj g *~ 0.5 (pos 20 510))
      (obj out outlet~ (pos 20 540))
      (obj c1 comment "feedback 0.9965: each period keeps 99.65% of the sound, so a string rings for some seconds" (pos 300 420))
      (connect on 0 tm 0)
      (connect tm 0 tc 0)
      (connect tc 0 ts 0)
      (connect sa 0 tsa 0)
      (connect tsa 3 ad0 0)
      (connect ad0 0 mf0 0)
      (connect mf0 0 dl0 0)
      (connect ts 0 pk0 0)
      (connect pk0 0 ev0 0)
      (connect nz 0 ex0 0)
      (connect ev0 0 ex0 1)
