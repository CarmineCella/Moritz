      (connect mex 0 mlp 0)
      (connect mlp 0 mcb 0)
      (connect gli 0 mcb 1)
      (connect mcb 0 msat 0)
      (connect msat 0 out 0)))
  (obj ir message 1 (pos 880 150))
  (obj res p resonators (pos 380 200)
    (patch
      (obj c0 comment "Resonators: six narrow band-pass filters on the tonic's partials (1, 1.5, 2, 2.5, 3, 4 times Sa), fed by noise and by the melody, as sympathetic strings; each swells slowly." (pos 20 10))
      (obj sa inlet (pos 20 45))
      (obj sig inlet~ (pos 400 45))
      (obj smf mtof (pos 20 80))
      (obj tf6 t f f f f f f (pos 20 110))
      (obj nz noise~ (pos 300 80))
      (obj nzg *~ 2. (pos 300 110))
      (obj mg *~ 0.4 (pos 400 80))
      (obj in +~ (pos 300 140))
      (obj mul0 * 1 (pos 20 180))
      (obj rs0 reson~ 4 200 150 (pos 20 210))
      (obj lf0 cycle~ 0.031 (pos 70 240))
      (obj am0 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 20 270))
