      (obj lf1 cycle~ 0.047 (pos 200 240))
      (obj am1 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 150 270))
      (obj mul2 * 2 (pos 280 180))
      (obj rs2 reson~ 4 200 150 (pos 280 210))
      (obj lf2 cycle~ 0.053 (pos 330 240))
      (obj am2 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 280 270))
      (obj mul3 * 2.5 (pos 410 180))
      (obj rs3 reson~ 4 200 150 (pos 410 210))
      (obj lf3 cycle~ 0.071 (pos 460 240))
      (obj am3 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 410 270))
      (obj mul4 * 3 (pos 540 180))
      (obj rs4 reson~ 4 200 150 (pos 540 210))
      (obj lf4 cycle~ 0.089 (pos 590 240))
      (obj am4 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 540 270))
      (obj mul5 * 4 (pos 670 180))
      (obj rs5 reson~ 4 200 150 (pos 670 210))
      (obj lf5 cycle~ 0.11 (pos 720 240))
      (obj am5 expr~ "$v1 * (0.5 + 0.5 * $v2)" (pos 670 270))
      (obj ccy comment "slow cosines (periods of 9 to 32 s) swell each partial" (pos 20 300))
      (obj ra0 +~ (pos 20 330))
      (obj ra1 +~ (pos 20 358))
      (obj ra2 +~ (pos 20 386))
      (obj ra3 +~ (pos 20 414))
      (obj ra4 +~ (pos 20 442))
      (obj out outlet~ (pos 20 480))
      (connect sa 0 smf 0)
