; helicopter.moritz - a helicopter flying around your head, on headphones.
; The sound is synthesised (p sound): the main rotor's chop and thump, the
; tail rotor, the turbine's whine. p flight computes its position along a
; path (a straight line, a circle, or both) and gives its direction
; (azimuth, elevation) and distance; p distance makes the distance heard:
; the level falls, the air takes away the treble, and a delay of
; distance / 343 m/s gives the Doppler effect (the pitch drops as it
; passes). Then the direction: plain stereo, binaural~ (ambisonics) or
; hrtf~ (the measured head responses), at the same loudness. Listen to the
; fly-over with each: with hrtf~ the sound darkens behind your head.
; topic: Space
(patch
  (obj title comment "A helicopter around your head: distance, Doppler and direction (headphones!)" (pos 20 12))
  (obj sub comment "Audio on, volume on, choose a flight. Compare 1 stereo, 2 binaural~, 3 hrtf~ on the same flight. Open the p boxes to see how." (pos 20 34))
  (obj cfl comment "a flight: x0 x1 y0 y1 z0 z1 (m: x ahead, y left, z up) radius turns duration (ms)" (pos 20 62))
  (obj f1 message "150 -150 6 6 25 25 0 0 26000" (pos 20 82))
  (obj cf1 comment "1 fly-over: from far in front, over your head, away behind you" (pos 300 83))
  (obj f2 message "0 0 0 0 3 3 20 2 20000" (pos 20 107))
  (obj cf2 comment "2 two circles around your head, 20 m away" (pos 300 108))
  (obj f3 message "-120 120 -12 -12 -5 -5 0 0 22000" (pos 20 132))
  (obj cf3 comment "3 a low pass on your right, from behind to the front" (pos 300 133))
  (obj f4 message "14 -14 0 0 -7 30 0 0 14000" (pos 20 157))
  (obj sfl s hflight (pos 20 185))
  (obj cf4 comment "4 it climbs in front of you and passes over to behind" (pos 300 158))
  (obj snd p sound (pos 20 230)
    (patch
      (obj c0 comment "the main rotor chops 11 times a second; a thump, a slap; the tail rotor; the turbine" (pos 20 10))
      (obj rot phasor~ 11 (pos 20 40))
      (obj pulse expr~ "pow(1 - $v1, 8)" (pos 20 75))
      (obj nz noise~ (pos 220 40))
      (obj slap lores~ 900 0.4 (pos 220 75))
      (obj thump lores~ 120 0.6 (pos 340 75))
      (obj chop *~ (pos 220 115))
      (obj thmp *~ (pos 340 115))
      (obj tail phasor~ 47 (pos 480 40))
      (obj tp expr~ "pow(1 - $v1, 4)" (pos 480 75))
      (obj tf svf~ 3000 0.5 (pos 600 75))
      (obj tl *~ (pos 480 115))
      (obj w1 cycle~ 2900 (pos 700 40))
      (obj w2 cycle~ 3040 (pos 800 40))
      (obj mix expr~ "1.05 * $v1 + 3.75 * $v2 + 0.38 * $v3 + 0.018 * ($v4 + $v5)" (pos 220 165))
      (obj out outlet~ (pos 220 205))
      (connect rot 0 pulse 0)
      (connect nz 0 slap 0)
      (connect nz 0 thump 0)
      (connect nz 0 tf 0)
      (connect slap 0 chop 0)
      (connect pulse 0 chop 1)
      (connect thump 0 thmp 0)
      (connect pulse 0 thmp 1)
      (connect tail 0 tp 0)
      (connect tf 2 tl 0)
      (connect tp 0 tl 1)
      (connect chop 0 mix 0)
      (connect thmp 0 mix 1)
      (connect tl 0 mix 2)
      (connect w1 0 mix 3)
      (connect w2 0 mix 4)
      (connect mix 0 out 0)))
  (obj fl p flight (pos 260 230)
    (patch
      (obj c0 comment "position along the path, t from 0 to 1: a line from (x0 y0 z0) to (x1 y1 z1), plus a circle of radius R, k turns" (pos 20 10))
      (obj c1 comment "x ahead, y to the left, z up, in metres; the listener at the origin" (pos 20 28))
      (obj rf r hflight (pos 20 60))
      (obj up unpack 0. 0. 0. 0. 0. 0. 0. 0. 0 (pos 20 95))
      (obj seg message "0, 1 $1" (pos 520 130))
      (obj t line~ (pos 20 140))
      (obj x expr~ "$v2 + ($v3 - $v2) * $v1 + $v4 * cos(6.2832 * $v5 * $v1)" (pos 20 180))
      (obj y expr~ "$v2 + ($v3 - $v2) * $v1 + $v4 * sin(6.2832 * $v5 * $v1)" (pos 20 220))
      (obj z expr~ "$v2 + ($v3 - $v2) * $v1" (pos 20 260))
      (obj az expr~ "atan2($v2, $v1) * 57.2958" (pos 20 310))
      (obj el expr~ "atan2($v3, sqrt($v1 * $v1 + $v2 * $v2)) * 57.2958" (pos 20 350))
      (obj d expr~ "sqrt($v1 * $v1 + $v2 * $v2 + $v3 * $v3)" (pos 20 390))
      (obj oaz outlet~ (pos 20 440))
      (obj oel outlet~ (pos 120 440))
      (obj od outlet~ (pos 220 440))
      (connect rf 0 up 0)
      (connect up 8 seg 0)
      (connect seg 0 t 0)
      (connect t 0 x 0)
      (connect t 0 y 0)
      (connect t 0 z 0)
      (connect up 0 x 1)
      (connect up 1 x 2)
      (connect up 6 x 3)
      (connect up 7 x 4)
      (connect up 2 y 1)
      (connect up 3 y 2)
      (connect up 6 y 3)
      (connect up 7 y 4)
      (connect up 4 z 1)
      (connect up 5 z 2)
      (connect x 0 az 0)
      (connect y 0 az 1)
      (connect x 0 el 0)
      (connect y 0 el 1)
      (connect z 0 el 2)
      (connect x 0 d 0)
      (connect y 0 d 1)
      (connect z 0 d 2)
      (connect az 0 oaz 0)
      (connect el 0 oel 0)
      (connect d 0 od 0)))
  (obj dist p distance (pos 20 300)
    (patch
      (obj c0 comment "distance: delay d/343 s (Doppler), air absorption (a low-pass that falls with d), level 10/d" (pos 20 10))
      (obj in inlet~ (pos 20 40))
      (obj din inlet~ (pos 220 40))
      (obj ms expr~ "$v1 * 1000. / 343." (pos 220 80))
      (obj tin tapin~ 1500 (pos 20 80))
      (obj tout tapout~ 100 (pos 20 120))
      (obj cut expr~ "400 + 16000 * min(1, 15. / max($v1, 1))" (pos 220 120))
      (obj air lores~ 8000 0 (pos 20 160))
      (obj g expr~ "min(1, 10. / max($v1, 1))" (pos 220 160))
      (obj lev *~ (pos 20 200))
      (obj out outlet~ (pos 20 240))
      (connect in 0 tin 0)
      (connect tin 0 tout 0)
      (connect din 0 ms 0)
      (connect ms 0 tout 0)
      (connect din 0 cut 0)
      (connect tout 0 air 0)
      (connect cut 0 air 1)
      (connect din 0 g 0)
      (connect air 0 lev 0)
      (connect g 0 lev 1)
      (connect lev 0 out 0)))
  (obj saz snapshot~ 100 (pos 560 260))
  (obj sel snapshot~ 100 (pos 660 260))
  (obj sd snapshot~ 100 (pos 760 260))
  (obj naz flonum (pos 560 295))
  (obj nel flonum (pos 660 295))
  (obj nd flonum (pos 760 295))
  (obj cn comment "azimuth   elevation   distance (m)" (pos 560 320))
  (obj pan expr~ "0.5 - 0.5 * sin($v1 * 0.01745)" (pos 300 340))
  (obj pl expr~ "sqrt(1 - $v1)" (pos 300 375))
  (obj pr expr~ "sqrt($v1)" (pos 420 375))
  (obj stl *~ (pos 20 420))
  (obj str *~ (pos 120 420))
  (obj enc ambienc~ 2 (pos 230 420))
  (obj bin binaural~ 2 (pos 230 460))
  (obj bl *~ 0.45 (pos 230 500))
  (obj br *~ 0.45 (pos 330 500))
  (obj hr hrtf~ (pos 460 420))
  (obj k1 message 1 (pos 560 380))
  (obj k2 message 2 (pos 600 380))
  (obj k3 message 3 (pos 640 380))
  (obj ck comment "1 stereo, 2 binaural~, 3 hrtf~" (pos 680 381))
  (obj sl selector~ 3 3 (pos 560 540))
  (obj sr selector~ 3 3 (pos 680 540))
  (obj on message "0.5 50" (pos 800 540))
  (obj off message "0 50" (pos 870 540))
  (obj cvol comment "volume" (pos 930 541))
  (obj ramp line~ (pos 800 575))
  (obj vl *~ (pos 560 575))
  (obj vr *~ (pos 680 575))
  (obj ll tanh~ (pos 560 610))
  (obj lr tanh~ (pos 680 610))
  (obj climit comment "a soft limiter, for the close passes" (pos 760 611))
  (obj out dac~ (pos 560 650))
  (obj lb loadbang (pos 900 70))
  (obj init message "150 150 6 6 25 25 0 0 1" (pos 900 100))
  (connect snd 0 dist 0)
  (connect fl 2 dist 1)
  (connect fl 0 saz 0)
  (connect fl 1 sel 0)
  (connect fl 2 sd 0)
  (connect saz 0 naz 0)
  (connect sel 0 nel 0)
  (connect sd 0 nd 0)
  (connect fl 0 pan 0)
  (connect pan 0 pl 0)
  (connect pan 0 pr 0)
  (connect dist 0 stl 0)
  (connect dist 0 str 0)
  (connect pl 0 stl 1)
  (connect pr 0 str 1)
  (connect dist 0 enc 0)
  (connect fl 0 enc 1)
  (connect fl 1 enc 2)
  (connect enc 0 bin 0)
  (connect enc 1 bin 1)
  (connect enc 2 bin 2)
  (connect enc 3 bin 3)
  (connect enc 4 bin 4)
  (connect enc 5 bin 5)
  (connect enc 6 bin 6)
  (connect enc 7 bin 7)
  (connect enc 8 bin 8)
  (connect bin 0 bl 0)
  (connect bin 1 br 0)
  (connect dist 0 hr 0)
  (connect fl 0 hr 1)
  (connect fl 1 hr 2)
  (connect k1 0 sl 0)
  (connect k1 0 sr 0)
  (connect k2 0 sl 0)
  (connect k2 0 sr 0)
  (connect k3 0 sl 0)
  (connect k3 0 sr 0)
  (connect stl 0 sl 1)
  (connect str 0 sr 1)
  (connect bl 0 sl 2)
  (connect br 0 sr 2)
  (connect hr 0 sl 3)
  (connect hr 1 sr 3)
  (connect sl 0 vl 0)
  (connect sr 0 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 ll 0)
  (connect vr 0 lr 0)
  (connect ll 0 out 0)
  (connect lr 0 out 1)
  (connect lb 0 init 0)
  (connect init 0 sfl 0)
  (connect f1 0 sfl 0)
  (connect f2 0 sfl 0)
  (connect f3 0 sfl 0)
  (connect f4 0 sfl 0))
