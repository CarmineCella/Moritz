; score-in-score.moritz - scores in a score, after Musil's score_in_score.mu: two phrases written as
; scores of their own (atonal lines on the oboe over a cello pedal), a chordal one on the horn; a
; section places them as events among its own notes (one whole, one at the left, one only its first
; 1.2 seconds); the piece places the section, then a score that places the section again with a
; four-voice texture over it, and a note of its own between them. A score cannot hold itself: the
; Console says so. The box draws each score placed as a faint block with its name; in the window a
; double-click enters it.
; Try: 1. play; 2. double-click the score box, then a block: the section (the breadcrumb says where
; you are), then a phrase inside it; an edit there is heard at every place the phrase is placed; Esc
; goes up; 3. Timeline: the placements as clips; 4. another seed: the texture and the arpeggio drawn
; again.
(patch
  (obj title comment "scores in a score: phrases placed in a section, the section placed twice in a piece" (pos 20 12))
  (obj sub comment "play; double-click the score box, then a block to enter it (Esc goes up); a seed draws the texture again" (pos 20 34))
  (obj dmic message microsol (pos 20 62))
  (obj dful message fullsol (pos 100 62))
  (obj cds comment "the samples: MicroSOL (comes with Moritz: Ob Hn Vn Vc, C4-G4) or FullSOL (registered in Extras > Datasets...); then compose again" (pos 170 63))
  (obj i1 message 5 (pos 150 97))
  (obj i2 message 6 (pos 185 97))
  (obj i3 message 7 (pos 220 97))
  (obj lb loadbang (pos 265 97))
  (obj cctl comment "a seed" (pos 355 98))
  (obj c code 2 1 (pos 20 132)
    (script
      "; scores in a score, after Musil's score_in_score.mu: two phrases written as scores of their own (atonal lines on the"
      "; oboe over a cello pedal), a chordal one on the horn; a section places them as events among its own notes; the"
      "; piece places the section twice, the second time with a texture over it. in1 a seed, in2 the dataset"
      "load \"music.mu\""
      "var name (if (equal? in2 nil) \"microsol\" in2)     ; MicroSOL comes with Moritz: Ob Hn Vn Vc, C4-G4 (a sketch)"
      "var db (db-load name)                             ; fullsol: FullSOL where you registered it (Extras > Datasets...)"
      "seed (if (equal? in1 nil) 5 in1)"
      "var sr 44100"
      "var row (list \"C4\" \"F#4\" \"D4\" \"G#4\" \"E4\" \"A#4\" \"B3\" \"F4\")     ; the phrases draw on it"
      "; --- 1. phrases as scores -------------------------------------------------------------------------------------"
      "function phrase (name pitches) {"
      "    var p (score name sr)"
      "    add! p 0 (notes db 'Ob 'mf 'ord pitches (beats 96 (rhythm (list 1 0.5 0.5 1 -0.5 0.5 0.75 0.25))))"
      "    event-at p 0 (* 5 (/ 60 96)) (note db 'Vc (- (pitch->number (head pitches)) 12) 'p 'ord) -20 0   ; a pedal an octave under"
      "    return p"
      "}"
      "var a (phrase \"phrase a\" row)"
      "var b (phrase \"phrase b\" (transpose-pitches (retrograde row) 3))                     ; backwards, a minor third up"
      "var c (fragment->score \"chordal\" sr (chords db 'Hn 'p 'ord (list (list \"C4\" \"F#4\") (list \"D#4\" \"G4\") (list \"C#4\" \"G#4\")) (beats 96 (rhythm (list 1.5 1.5 3)))))"
      "; --- 2. a section: the phrases as events, its own notes between and over them ---------------------------------"
      "var section (score \"section\" sr)"
      "event section 0 0 a                                                             ; the whole phrase"
      "event-at section 3.5 0 b 40 0                                                   ; at the left"
      "event section 7 1.2 a                                                           ; only its first 1.2 s"
      "event section 8.5 0 c"
      "add-placed! section 1 (notes db 'Vn 'pp 'ord (list \"A#5\" nil \"G5\" \"C#5\") (beats 96 (rhythm (list 0.5 0.5 1 2)))) -30 20"
      "add! section 6 (arpeggio db 'Vn 'p 'ord (list \"D4\" \"G#4\" \"C#5\" \"F5\") 0.15 'up 1.5)"
      "event-at section 9.5 2 (note db 'Vc \"F#3\" 'ff 'ord) 0 0"
      "; --- 3. the piece: the section, then the section again with a four-voice texture over it ------------------------"
      "var piece (score \"piece\" sr)"
      "event piece 0 0 section"
      "var second (score \"section 2\" sr)"
      "event second 0 0 section"
      "add-placed! second 0 (texture db (list 'Vn 'Vc 'Ob 'Hn) 'pp 'ord (list \"G#4\" \"A4\" \"F4\" \"F#4\" \"E4\") (beats 96 (rhythm (list 0.25 0.25 0.5 0.25))) (list 1 1.15 1.3 1.5)) 30 10"
      "event piece (+ (score-duration section) 1) 0 second"
      "event-at piece (+ (score-duration section) 0.5) 1 (note db 'Ob \"B4\" 'ff 'ord) 0 30   ; a note of the piece itself, between"
      "print \"the piece:\" (length (score-events piece)) \"events of its own, two of them scores (the section, and section 2 placing it again);\" (fixed (score-duration piece) 1) \"s\""
      "print \"a score in itself:\" (try (event piece 0 0 piece) catch err \"refused\")"
      "out 1 piece"))
  (obj cuc comment "the score in Musil: scores placed in scores (event s at 0 phrase)" (pos 110 133))
  (obj sc score piece 2 @size 640 220 (pos 20 172))
  (obj tr transport 96 4 4 (pos 690 172))
  (obj sp message play (pos 690 207))
  (obj ss message stop (pos 735 207))
  (obj cpl comment "play / stop" (pos 785 208))
  (obj sum +~ (pos 20 417))
  (obj chall comment "the two channels summed, the volume ramped, then a hall (reverb~)" (pos 70 418))
  (obj half *~ 0.35 (pos 20 447))
  (obj lbv loadbang (pos 140 462))
  (obj vol message "0.8 300" (pos 140 492))
  (obj mute message "0 300" (pos 210 492))
  (obj cvol comment "volume up, down" (pos 270 493))
  (obj ramp line~ (pos 140 522))
  (obj vca *~ (pos 20 557))
  (obj rv reverb~ 0.25 2.5 (pos 20 587))
  (obj dac dac~ (pos 20 622))
  (connect dmic 0 c 1)
  (connect dful 0 c 1)
  (connect i1 0 c 0)
  (connect i2 0 c 0)
  (connect i3 0 c 0)
  (connect lb 0 i1 0)
  (connect c 0 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sc 0 sum 0)
  (connect sc 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 vca 0)
  (connect lbv 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 rv 0)
  (connect rv 0 dac 0)
  (connect rv 1 dac 1))
