; spectral-pivots.moritz - spectral pivots after Grisey, from Musil's algorithmic_comp.mu: the
; harmonic series of a low fundamental (harmonic-series, rounded to the tempered scale) is the
; harmony; each of its partials 5 to 12 is the centre of a line that wanders within two semitones of
; it (pivots), each line given to the instrument whose register holds the partial (the cello low,
; then the horn, the oboe, the violin), mezzo-forte over the fundamental held fortissimo an octave
; up on the cello. Another fundamental, another chord: the series is the same shape at another
; height. grisey-partiels.moritz in examples/18-pieces builds a whole opening from a spectrum.
; Try: 1. play; 2. another fundamental: A1, C2, F#1; 3. double-click the score box: the roll, each
; staff a register of the spectrum; 4. double-click the code box: the interval (2), the partials
; taken (drop spectrum 4), the registers, Cmd-S, then a fundamental again.
(patch
  (obj title comment "spectral pivots: lines around the partials of a harmonic series, each in its register" (pos 20 12))
  (obj sub comment "a fundamental writes the score again; play; the Console names the partials and their instruments" (pos 20 34))
  (obj dmic message microsol (pos 20 62))
  (obj dful message fullsol (pos 100 62))
  (obj cds comment "the samples: MicroSOL (comes with Moritz: Ob Hn Vn Vc, C4-G4) or FullSOL (registered in Extras > Datasets...); then compose again" (pos 170 63))
  (obj f1 message E1 (pos 150 97))
  (obj f2 message A1 (pos 190 97))
  (obj f3 message C2 (pos 230 97))
  (obj f4 message F#1 (pos 270 97))
  (obj lb loadbang (pos 325 97))
  (obj cctl comment "the fundamental" (pos 415 98))
  (obj c code 2 1 (pos 20 132)
    (script
      "; spectral pivots after Grisey, from Musil's algorithmic_comp.mu: the harmonic series of a low fundamental is the"
      "; chord, each of its upper partials a centre a line wanders around; the lines given to the instruments whose"
      "; register holds them, the fundamental held under it all. in1 the fundamental (E1...), in2 the dataset"
      "load \"music.mu\""
      "var name (if (equal? in2 nil) \"microsol\" in2)     ; MicroSOL comes with Moritz: Ob Hn Vn Vc, C4-G4 (a sketch)"
      "var db (db-load name)                             ; fullsol: FullSOL where you registered it (Extras > Datasets...)"
      "var fund (if (equal? in1 nil) \"E1\" (str in1))"
      "seed 4"
      "var spectrum (harmonic-series fund 12)              ; partials 1..12, rounded to the tempered scale"
      "var upper (drop spectrum 4)                         ; partials 5..12: the chord above the fundamentals"
      "; a partial to the instrument whose register holds it (the first that does), else the violin"
      "var registers (list (list 'Vc \"C2\" \"B3\") (list 'Hn \"C3\" \"G4\") (list 'Ob \"C4\" \"C6\") (list 'Vn \"G3\" \"C7\"))"
      "function player-of (p) {"
      "    var g (find-first registers (function (g) (and (>= p (pitch->number (getidx g 1))) (<= p (pitch->number (last g))))))"
      "    return (if (equal? g nil) 'Vn (head g))"
      "}"
      "var s (score \"pivots\" 44100)"
      "score-tempo! s 108"
      "var piv (pivots db (map upper player-of) 'mf 'ord upper 2 (beats 108 (rhythm (list 1 1 2 1 1 2 1 1 4))))"
      "add! s 0 (fragment-gain piv 0.5 1)"
      "event-at s 0 (beat->sec s 14) (note db 'Vc (+ (pitch->number fund) 12) 'ff 'ord) 0 0   ; the fundamental an octave up, held"
      "print \"the series of\" fund \":\" (join (map spectrum midi->pitch) \" \")"
      "print \"the lines around\" (join (map upper midi->pitch) \" \") \"on\" (join (map upper (function (p) (str (player-of p)))) \" \")"
      "out 1 s"))
  (obj cuc comment "the score in Musil: harmonic-series, pivots, the fundamental held" (pos 110 133))
  (obj sc score pivots 2 @size 640 220 (pos 20 172))
  (obj tr transport 108 4 4 (pos 690 172))
  (obj sp message play (pos 690 207))
  (obj ss message stop (pos 735 207))
  (obj cpl comment "play / stop" (pos 785 208))
  (obj sum +~ (pos 20 417))
  (obj chall comment "the two channels summed, the volume ramped, then a hall (reverb~)" (pos 70 418))
  (obj half *~ 0.25 (pos 20 447))
  (obj lbv loadbang (pos 140 462))
  (obj vol message "0.8 300" (pos 140 492))
  (obj mute message "0 300" (pos 210 492))
  (obj cvol comment "volume up, down" (pos 270 493))
  (obj ramp line~ (pos 140 522))
  (obj vca *~ (pos 20 557))
  (obj rv reverb~ 0.25 2.5 (pos 20 587))
  (obj dac dac~ (pos 20 622))
  (connect dmic 0 c 1)
  (connect dful 0 c 1)
  (connect f1 0 c 0)
  (connect f2 0 c 0)
  (connect f3 0 c 0)
  (connect f4 0 c 0)
  (connect lb 0 f1 0)
  (connect c 0 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sc 0 sum 0)
  (connect sc 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 vca 0)
  (connect lbv 0 vol 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 rv 0)
  (connect rv 0 dac 0)
  (connect rv 1 dac 1))
