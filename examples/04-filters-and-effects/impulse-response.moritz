; impulse-response.moritz - measuring a hall: the impulse response of the
; Teatro Pedrotti, the concert hall of Pesaro, computed with condec from a
; sweep. A sine sweep (sweep.aif: 30 seconds from low to high) was played in
; the hall and recorded (pedrotti_dump.wav). The recording is the sweep
; convolved with the hall, so dividing its spectrum by the sweep's
; (deconvolution) leaves the hall alone: its impulse response, what a single
; click would sound like in it. Then any sound can be put in the Pedrotti
; with conv~.
(patch
  (obj title comment "The impulse response of a hall: the Teatro Pedrotti (Pesaro), from a sweep" (pos 20 12))
  (obj sub comment "Click 1 to compute the response (the button flashes when it's ready), listen to the three sounds, then put a voice or drums in the hall." (pos 20 34))
  (obj bsw buffer~ pedsweep sweep.aif (pos 20 65))
  (obj bdp buffer~ peddump pedrotti_dump.wav (pos 230 65))
  (obj bir buffer~ pedir (pos 480 65))
  (obj bvx buffer~ pedvox Vox.wav (pos 600 65))
  (obj bdr buffer~ peddrums drums.wav (pos 760 65))
  (obj c1 comment "1. deconvolve: the recording in the hall divided by the sweep" (pos 20 105))
  (obj s1 message "deconv peddump pedsweep pedir 0.05 12" (pos 20 125))
  (obj cd condec (pos 20 160))
  (obj tb t b b (pos 20 190))
  (obj crop message "size 3000" (pos 120 220))
  (obj done button (pos 20 220))
  (obj cdone comment "ready" (pos 50 221))
  (obj ccrop comment "keep the first 3 seconds: after them the hall is silent" (pos 210 221))
  (obj c2 comment "0.05: frequencies where the sweep is weaker than 5% of its peak (below and above its range) are left out, or" (pos 380 125))
  (obj c3 comment "dividing by them would raise the noise (0.001 leaves a floor at -33 dB). 12 brings the response's peak near 1." (pos 380 143))
  (obj wir waveform~ pedir 560 80 (pos 380 170))
  (obj save message "write pedrotti_ir.wav" (pos 20 260))
  (obj csave comment "save the response next to this patch" (pos 190 261))
  (obj c4 comment "2. listen: the sweep, what the hall gave back, and the response (the direct sound, then the reflections and the tail)" (pos 20 300))
  (obj p1 message start (pos 20 320))
  (obj p2 message start (pos 130 320))
  (obj p3 message start (pos 240 320))
  (obj stp message stop (pos 350 320))
  (obj l1 comment "sweep" (pos 20 345))
  (obj l2 comment "in the hall" (pos 130 345))
  (obj l3 comment "response" (pos 240 345))
  (obj pl1 play~ pedsweep (pos 20 370))
  (obj pl2 play~ peddump (pos 130 370))
  (obj pl3 play~ pedir (pos 240 370))
  (obj lst +~ (pos 20 405))
  (obj lst2 +~ (pos 20 430))
  (obj lg *~ 0.5 (pos 20 460))
  (obj c5 comment "3. any sound in the Pedrotti: conv~ with the response" (pos 520 300))
  (obj q1 message start (pos 520 320))
  (obj q2 message start (pos 630 320))
  (obj qs message stop (pos 740 320))
  (obj m1 comment "voice" (pos 520 345))
  (obj m2 comment "drums" (pos 630 345))
  (obj qv play~ pedvox (pos 520 370))
  (obj qd play~ peddrums (pos 630 370))
  (obj src +~ (pos 520 405))
  (obj cv conv~ pedir 2 (pos 520 440))
  (obj w0 message 0 (pos 740 440))
  (obj w5 message 0.5 (pos 780 440))
  (obj w1 message 1 (pos 830 440))
  (obj cw comment "wet/dry" (pos 870 441))
  (obj mix line~ (pos 740 475))
  (obj dry expr~ "1 - $v1" (pos 740 505))
  (obj sc *~ 0.3 (pos 520 475))
  (obj scr *~ 0.3 (pos 620 475))
  (obj wl *~ (pos 520 505))
  (obj wr *~ (pos 620 505))
  (obj dd *~ (pos 840 505))
  (obj ml +~ (pos 520 540))
  (obj mr +~ (pos 620 540))
  (obj sumL +~ (pos 20 575))
  (obj sumR +~ (pos 120 575))
  (obj on message "0.6 50" (pos 240 575))
  (obj off message "0 50" (pos 310 575))
  (obj cvol comment "volume" (pos 370 576))
  (obj ramp line~ (pos 240 605))
  (obj vl *~ (pos 20 605))
  (obj vr *~ (pos 120 605))
  (obj out dac~ (pos 20 640))
  (obj lb loadbang (pos 960 440))
  (obj init message 0.6 (pos 960 470))
  (connect s1 0 cd 0)
  (connect cd 0 tb 0)
  (connect tb 1 crop 0)
  (connect crop 0 bir 0)
  (connect tb 0 done 0)
  (connect save 0 bir 0)
  (connect p1 0 pl1 0)
  (connect p2 0 pl2 0)
  (connect p3 0 pl3 0)
  (connect stp 0 pl1 0)
  (connect stp 0 pl2 0)
  (connect stp 0 pl3 0)
  (connect pl1 0 lst 0)
  (connect pl2 0 lst 1)
  (connect lst 0 lst2 0)
  (connect pl3 0 lst2 1)
  (connect lst2 0 lg 0)
  (connect q1 0 qv 0)
  (connect q2 0 qd 0)
  (connect qs 0 qv 0)
  (connect qs 0 qd 0)
  (connect qv 0 src 0)
  (connect qd 0 src 0)
  (connect src 0 cv 0)
  (connect cv 0 sc 0)
  (connect cv 1 scr 0)
  (connect sc 0 wl 0)
  (connect scr 0 wr 0)
  (connect w0 0 mix 0)
  (connect w5 0 mix 0)
  (connect w1 0 mix 0)
  (connect lb 0 init 0)
  (connect init 0 mix 0)
  (connect mix 0 wl 1)
  (connect mix 0 wr 1)
  (connect mix 0 dry 0)
  (connect src 0 dd 0)
  (connect dry 0 dd 1)
  (connect wl 0 ml 0)
  (connect wr 0 mr 0)
  (connect dd 0 ml 1)
  (connect dd 0 mr 1)
  (connect lg 0 sumL 0)
  (connect lg 0 sumR 0)
  (connect ml 0 sumL 1)
  (connect mr 0 sumR 1)
  (connect sumL 0 vl 0)
  (connect sumR 0 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
