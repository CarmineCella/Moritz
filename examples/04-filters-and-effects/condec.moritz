; condec.moritz - convolution and deconvolution of whole sounds, offline.
; condec computes a buffer~ from two others when it gets a message:
; "conv x h out" convolves x with h (x heard through h); "deconv y h out"
; divides y's spectrum by h's, undoing a convolution by h. Here a voice is
; put in the Concertgebouw and taken out again, and made to ring through a
; gong, whose sound is then recovered from the result.
(patch
  (obj title comment "condec: convolve and deconvolve whole sounds (offline, on demand)" (pos 20 12))
  (obj sub comment "Click 1 to 4 in order: each computes a new buffer~ (the button flashes when it's ready). Then play any of them." (pos 20 34))
  (obj vox buffer~ cdvox Vox.wav (pos 20 65))
  (obj hall buffer~ cdhall hall_concertgebouw.wav (pos 260 65))
  (obj gong buffer~ cdgong gong_c_sharp.wav (pos 470 65))
  (obj wet buffer~ cdwet (pos 20 92))
  (obj dry buffer~ cddry (pos 200 92))
  (obj vg buffer~ cdvoxgong (pos 380 92))
  (obj gb buffer~ cdgongback (pos 580 92))
  (obj s1 message "conv cdvox cdhall cdwet 0.05" (pos 20 135))
  (obj c1 comment "1. the voice in the hall: x convolved with the hall's impulse response" (pos 360 136))
  (obj s2 message "deconv cdwet cdhall cddry 0.001 20" (pos 20 165))
  (obj c2 comment "2. take the hall out again: the reverberant voice divided by the response" (pos 360 166))
  (obj s3 message "conv cdvox cdgong cdvoxgong 0.02" (pos 20 195))
  (obj c3 comment "3. the voice ringing through the gong (any sound can be a response)" (pos 360 196))
  (obj s4 message "deconv cdvoxgong cdvox cdgongback 0.0001 30" (pos 20 225))
  (obj c4 comment "4. divide by the voice: what is left is the gong" (pos 360 226))
  (obj cd condec (pos 20 265))
  (obj done button (pos 20 300))
  (obj cdone comment "ready" (pos 50 301))
  (obj th comment "deconv's threshold (0.001, 0.0001) skips the frequencies where the response is almost silent: dividing by" (pos 20 340))
  (obj th2 comment "them would blow up the noise. The last number scales the result." (pos 20 358))
  (obj p1 message start (pos 20 405))
  (obj p2 message start (pos 140 405))
  (obj p3 message start (pos 260 405))
  (obj p4 message start (pos 380 405))
  (obj p5 message start (pos 500 405))
  (obj stp message stop (pos 620 405))
  (obj lp1 comment "voice" (pos 20 385))
  (obj lp2 comment "in the hall" (pos 140 385))
  (obj lp3 comment "hall removed" (pos 260 385))
  (obj lp4 comment "through gong" (pos 380 385))
  (obj lp5 comment "gong back" (pos 500 385))
  (obj pl1 play~ cdvox (pos 20 445))
  (obj pl2 play~ cdwet (pos 140 445))
  (obj pl3 play~ cddry (pos 260 445))
  (obj pl4 play~ cdvoxgong (pos 380 445))
  (obj pl5 play~ cdgongback (pos 500 445))
  (obj mix +~ (pos 20 495))
  (obj on message "0.5 50" (pos 200 540))
  (obj off message "0 50" (pos 270 540))
  (obj cvol comment "volume" (pos 330 541))
  (obj ramp line~ (pos 200 575))
  (obj vca *~ (pos 20 575))
  (obj out dac~ (pos 20 615))
  (obj sc scope~ (pos 420 495))
  (connect s1 0 cd 0)
  (connect s2 0 cd 0)
  (connect s3 0 cd 0)
  (connect s4 0 cd 0)
  (connect cd 0 done 0)
  (connect p1 0 pl1 0)
  (connect p2 0 pl2 0)
  (connect p3 0 pl3 0)
  (connect p4 0 pl4 0)
  (connect p5 0 pl5 0)
  (connect stp 0 pl1 0)
  (connect stp 0 pl2 0)
  (connect stp 0 pl3 0)
  (connect stp 0 pl4 0)
  (connect stp 0 pl5 0)
  (connect pl1 0 mix 0)
  (connect pl2 0 mix 0)
  (connect pl3 0 mix 0)
  (connect pl4 0 mix 0)
  (connect pl5 0 mix 0)
  (connect mix 0 vca 0)
  (connect mix 0 sc 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
