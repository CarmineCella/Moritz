; harmonizer.moritz - a voice harmonized two ways: in its key (harmonize~ in scale mode), and by the chords played on
; a MIDI keyboard or on the keys below (harmonize~ in midi-chord mode), both into a little reverb.
(patch
  (obj title comment "harmonize~: a voice and its harmony, in its key or from the chords you play" (pos 20 12))
  (obj sub comment "The recorded voice plays in a loop (or turn on the microphone); the faders set the level of each section." (pos 20 34))
  (obj lb loadbang (pos 20 70))
  (obj open message "open ../../data/Vox.wav, loop 1, 1" (pos 20 100))
  (obj sf sfplay~ (pos 20 135))
  (obj inv == 0 (pos 160 135))
  (obj cmic comment "microphone" (pos 300 70))
  (obj mict toggle (pos 300 100))
  (obj adc adc~ 1 (pos 300 135))
  (obj fileg *~ 1 (pos 20 170))
  (obj micg *~ 0 (pos 300 170))
  (obj src +~ (pos 20 205))
  (obj c1 comment "1. in its key (E minor): a third and a fifth of the scale above, a fourth below" (pos 20 245))
  (obj s1 message "mode scale, key E, scale minor, intervals 2 4 -3" (pos 20 270))
  (obj s1b message "voice 1 pan -0.6, voice 2 pan 0.6, voice 3 level 0.8" (pos 20 300))
  (obj s1c message "vibrato 12 5.2 0.4, humanize 6 30, mix 0.8 0.6" (pos 20 330))
  (obj k1 message "scale minor" (pos 20 360))
  (obj k2 message "scale dorian" (pos 110 360))
  (obj k3 message "scale harmonic-minor" (pos 205 360))
  (obj hs harmonize~ 3 (pos 20 400))
  (obj f0 flonum 0 (pos 160 435))
  (obj cf0 comment "the sung f0 (Hz)" (pos 230 436))
  (obj c2 comment "2. from chords: each held note is a voice at its pitch (notein, or click the keys)" (pos 560 245))
  (obj s2 message "mode midi-chord, formant 1.05, humanize 5 20, mix 0 0.9" (pos 560 270))
  (obj s2b message "voice 1 pan -0.7, voice 2 pan -0.25, voice 3 pan 0.25, voice 4 pan 0.7" (pos 560 300))
  (obj ni notein (pos 560 335))
  (obj clr message flush (pos 640 335))
  (obj ks kslider 3 48 1 (pos 700 335))
  (obj hc harmonize~ 4 (pos 560 400))
  (obj cg1 comment "in its key" (pos 20 470))
  (obj g1 gain~ 20 1 (pos 20 490))
  (obj g1r gain~ 20 1 (pos 100 490))
  (obj cg2 comment "from chords" (pos 560 470))
  (obj g2 gain~ 20 1 (pos 560 490))
  (obj g2r gain~ 20 1 (pos 640 490))
  (obj sl +~ (pos 20 650))
  (obj sr +~ (pos 120 650))
  (obj mono +~ (pos 300 650))
  (obj half *~ 0.5 (pos 300 680))
  (obj rv reverb~ 1 2.4 (pos 300 710))
  (obj rl *~ 0.22 (pos 300 745))
  (obj rr *~ 0.22 (pos 400 745))
  (obj ol +~ (pos 20 780))
  (obj or +~ (pos 120 780))
  (obj vl *~ 0.5 (pos 20 810))
  (obj vr *~ 0.5 (pos 120 810))
  (obj out dac~ (pos 20 850))
  (obj ml meter~ (pos 200 830))
  (obj mr meter~ (pos 230 830))
  (connect lb 0 open 0)
  (connect lb 0 s1 0)
  (connect lb 0 s1b 0)
  (connect lb 0 s1c 0)
  (connect lb 0 s2 0)
  (connect lb 0 s2b 0)
  (connect open 0 sf 0)
  (connect mict 0 micg 1)
  (connect mict 0 inv 0)
  (connect inv 0 fileg 1)
  (connect sf 0 fileg 0)
  (connect adc 0 micg 0)
  (connect fileg 0 src 0)
  (connect micg 0 src 1)
  (connect s1 0 hs 0)
  (connect s1b 0 hs 0)
  (connect s1c 0 hs 0)
  (connect k1 0 hs 0)
  (connect k2 0 hs 0)
  (connect k3 0 hs 0)
  (connect src 0 hs 0)
  (connect s2 0 hc 0)
  (connect s2b 0 hc 0)
  (connect src 0 hc 0)
  (connect ni 1 hc 3)
  (connect ni 0 hc 2)
  (connect ks 1 hc 3)
  (connect ks 0 hc 2)
  (connect clr 0 hc 0)
  (connect clr 0 ks 0)
  (connect hs 0 g1 0)
  (connect hs 1 g1r 0)
  (connect hs 2 f0 0)
  (connect hc 0 g2 0)
  (connect hc 1 g2r 0)
  (connect g1 0 sl 0)
  (connect g2 0 sl 1)
  (connect g1r 0 sr 0)
  (connect g2r 0 sr 1)
  (connect sl 0 mono 0)
  (connect sr 0 mono 1)
  (connect mono 0 half 0)
  (connect half 0 rv 0)
  (connect rv 0 rl 0)
  (connect rv 1 rr 0)
  (connect sl 0 ol 0)
  (connect rl 0 ol 1)
  (connect sr 0 or 0)
  (connect rr 0 or 1)
  (connect ol 0 vl 0)
  (connect or 0 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect vl 0 ml 0)
  (connect vr 0 mr 0))
