; freeverb.moritz - the reverb~ abstraction (a stereo Freeverb) on a gong.
; Drag the number boxes in locked mode: mix 0-1 and decay time T60 in seconds.
(patch
  (obj title comment "reverb~ mix T60: stereo Freeverb (see reverb~.moritz, fvcomb~.moritz)" (pos 20 12))
  (obj lb loadbang (pos 20 40))
  (obj tog toggle (pos 20 75))
  (obj open message "open gong_c_sharp.wav" (pos 120 75))
  (obj met metro 4000 (pos 20 115))
  (obj go message 1 (pos 20 150))
  (obj sf sfplay~ (pos 20 190))
  (obj cmix comment "mix" (pos 200 150))
  (obj mix flonum 0.4 (pos 200 190))
  (obj ct60 comment "T60 (s)" (pos 300 150))
  (obj t60 flonum 3 (pos 300 190))
  (obj short message 0.8 (pos 400 150))
  (obj long message 8 (pos 450 150))
  (obj rv reverb~ 0.4 3 (pos 20 240))
  (obj out dac~ (pos 20 300))
  (obj ml meter~ (pos 200 280))
  (obj mr meter~ (pos 230 280))
  (connect lb 0 tog 0)
  (connect lb 0 open 0)
  (connect tog 0 met 0)
  (connect met 0 go 0)
  (connect go 0 sf 0)
  (connect open 0 sf 0)
  (connect short 0 t60 0)
  (connect long 0 t60 0)
  (connect sf 0 rv 0)
  (connect mix 0 rv 1)
  (connect t60 0 rv 2)
  (connect rv 0 out 0)
  (connect rv 1 out 1)
  (connect rv 0 ml 0)
  (connect rv 1 mr 0))
