; convolution.moritz - conv~ with three impulse responses: the Concertgebouw
; (a real hall, stereo), a bell and a gong (any sound can be a response: the
; source then rings like the bell or the gong). "set" switches the response;
; a source played into conv~ ir 2 alone feeds both channels.
(patch
  (obj title comment "conv~: a voice, Beethoven's 7th or drums in the Concertgebouw, or convolved with a bell or a gong" (pos 20 12))
  (obj hall buffer~ convhall hall_concertgebouw.wav (pos 20 40))
  (obj bell buffer~ convbell archeos-bell.wav (pos 220 40))
  (obj gong buffer~ convgong gong_c_sharp.wav (pos 540 40))
  (obj vox buffer~ convvox Vox.wav (pos 20 62))
  (obj beet buffer~ convbeet Beethoven_Symph7.wav (pos 220 62))
  (obj drum buffer~ convdrums drums.wav (pos 540 62))
  (obj pv message start (pos 20 100))
  (obj pb message start (pos 150 100))
  (obj pd message start (pos 300 100))
  (obj st message stop (pos 420 100))
  (obj csrc comment "voice, Beethoven, drums" (pos 470 101))
  (obj v play~ convvox (pos 20 135))
  (obj b play~ convbeet (pos 150 135))
  (obj d play~ convdrums (pos 300 135))
  (obj src +~ (pos 20 175))
  (obj ir1 message "set convhall" (pos 330 175))
  (obj ir2 message "set convbell" (pos 430 175))
  (obj ir3 message "set convgong" (pos 530 175))
  (obj cir comment "response" (pos 630 176))
  (obj cv conv~ convhall 2 (pos 20 215))
  (obj m1 message 0 (pos 380 225))
  (obj m2 message 0.5 (pos 420 225))
  (obj m3 message 1 (pos 470 225))
  (obj cm comment "wet/dry: 0 dry .. 1 wet" (pos 510 226))
  (obj mix line~ (pos 380 260))
  (obj dry expr~ "1 - $v1" (pos 380 295))
  (obj sc *~ 0.25 (pos 20 255))
  (obj scr *~ 0.25 (pos 120 255))
  (obj wl *~ (pos 20 295))
  (obj wr *~ (pos 120 295))
  (obj dd *~ (pos 240 295))
  (obj ml +~ (pos 20 335))
  (obj mr +~ (pos 120 335))
  (obj on message "0.3 50" (pos 240 375))
  (obj off message "0 50" (pos 310 375))
  (obj cvol comment "volume" (pos 370 376))
  (obj ramp line~ (pos 240 410))
  (obj vl *~ (pos 20 410))
  (obj vr *~ (pos 120 410))
  (obj out dac~ (pos 20 450))
  (obj spec spectroscope~ 300 100 (pos 380 410))
  (obj lb loadbang (pos 600 260))
  (obj init message 0.5 (pos 600 290))
  (connect pv 0 v 0)
  (connect pb 0 b 0)
  (connect pd 0 d 0)
  (connect st 0 v 0)
  (connect st 0 b 0)
  (connect st 0 d 0)
  (connect v 0 src 0)
  (connect b 0 src 0)
  (connect d 0 src 0)
  (connect src 0 cv 0)
  (connect ir1 0 cv 0)
  (connect ir2 0 cv 0)
  (connect ir3 0 cv 0)
  (connect cv 0 sc 0)
  (connect cv 1 scr 0)
  (connect sc 0 wl 0)
  (connect scr 0 wr 0)
  (connect m1 0 mix 0)
  (connect m2 0 mix 0)
  (connect m3 0 mix 0)
  (connect lb 0 init 0)
  (connect init 0 mix 0)
  (connect mix 0 wl 1)
  (connect mix 0 wr 1)
  (connect mix 0 dry 0)
  (connect src 0 dd 0)
  (connect dry 0 dd 1)
  (connect wl 0 ml 0)
  (connect wr 0 mr 0)
  (connect dd 0 ml 1)
  (connect dd 0 mr 1)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect ml 0 vl 0)
  (connect mr 0 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect ml 0 spec 0))
