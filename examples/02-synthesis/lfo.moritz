; lfo.moritz - tremolo: a tri~ LFO scaled to 0..1 multiplies a cycle~.
; snapshot~ and peakamp~ turn signals into numbers you can watch.
(patch
  (obj title comment "tremolo, plus snapshot~ and peakamp~ as signal-to-number probes" (pos 20 12))
  (obj rate flonum 4 (pos 160 40))
  (obj rlabel comment "LFO rate (Hz)" (pos 225 41))
  (obj car cycle~ 330 (pos 20 80))
  (obj lfo tri~ 4 (pos 160 80))
  (obj half *~ 0.5 (pos 160 120))
  (obj off +~ 0.5 (pos 160 160))
  (obj trem *~ (pos 20 200))
  (obj vol *~ 0.3 (pos 20 240))
  (obj out dac~ (pos 20 290))
  (obj snap snapshot~ 50 (pos 300 160))
  (obj sv flonum (pos 300 200))
  (obj slabel comment "LFO now" (pos 365 201))
  (obj pk peakamp~ 100 (pos 160 240))
  (obj pv flonum (pos 160 280))
  (obj db atodb (pos 160 320))
  (obj dv flonum (pos 160 360))
  (obj dlabel comment "output peak (dB)" (pos 225 361))
  (obj sc scope~ 2048 (pos 420 240))
  (connect rate 0 lfo 0)
  (connect car 0 trem 0)
  (connect lfo 0 half 0)
  (connect half 0 off 0)
  (connect off 0 trem 1)
  (connect off 0 snap 0)
  (connect snap 0 sv 0)
  (connect trem 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 pk 0)
  (connect pk 0 pv 0)
  (connect pv 0 db 0)
  (connect db 0 dv 0)
  (connect vol 0 sc 0))
