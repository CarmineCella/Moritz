; noise-presets.moritz - white noise through reson~. The message boxes on the
; right are presets: ";" sends each value to the matching receive object.
(patch
  (obj noise noise~ (pos 40 40))
  (obj rcf r cf (pos 140 40))
  (obj rq r q (pos 230 40))
  (obj fcf flonum 800 (pos 140 80))
  (obj fq flonum 20 (pos 230 80))
  (obj filt reson~ 1 800 20 (pos 40 140))
  (obj vol *~ 0.5 (pos 40 200))
  (obj out dac~ (pos 40 260))
  (obj init loadbang (pos 360 40))
  (obj pre1 message "; cf 1200; q 8" (pos 360 90))
  (obj pre2 message "; cf 300; q 40" (pos 440 90))
  (obj pre3 message "; cf 3000; q 80" (pos 520 90))
  (connect noise 0 filt 0)
  (connect rcf 0 fcf 0)
  (connect rq 0 fq 0)
  (connect fcf 0 filt 2)
  (connect fq 0 filt 3)
  (connect filt 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect init 0 pre1 0))
