; binaural.moritz - the scene of ambisonics.moritz on headphones. The two
; sources are encoded and summed into a first-order sound field as there;
; binaural~ decodes it to 17 virtual speakers around, above and below the
; listener and renders each through measured head-related impulse responses
; (the MIT KEMAR dummy head), so the sound seems to come from outside the
; head, from its direction. ambirot~ turns the scene, as a head turning the
; other way would. The drums can also go up and down (elevation).
; topic: Space
(patch
  (obj title comment "Binaural: the same sound field on headphones (binaural~)" (pos 20 12))
  (obj sub comment "Use headphones. The voice circles around your head by itself; place the drums with the sliders, and turn the scene." (pos 20 34))
  (obj b1 buffer~ binvox sounds/Vox.wav (pos 20 65))
  (obj b2 buffer~ bindrums sounds/drums.wav (pos 220 65))
  (obj pl message "loop 1, start" (pos 20 100))
  (obj v groove~ binvox (pos 20 135))
  (obj d groove~ bindrums (pos 330 135))
  (obj rate sig~ 1 (pos 150 100))
  (obj cspd comment "voice: turns per second" (pos 20 175))
  (obj spd flonum 0.1 (pos 20 195))
  (obj ph phasor~ 0.1 (pos 20 230))
  (obj deg *~ 360 (pos 20 265))
  (obj cdaz comment "drums azimuth (0 front, 90 left, -90 right)" (pos 330 175))
  (obj daz slider -180 180 (pos 330 195))
  (obj dazn number (pos 485 195))
  (obj cdel comment "drums elevation (90 above)" (pos 560 175))
  (obj del slider -40 90 (pos 560 195))
  (obj deln number (pos 715 195))
  (obj lb loadbang (pos 600 100))
  (obj zero message 0 (pos 600 130))
  (obj e1 ambienc~ 1 (pos 20 310))
  (obj e2 ambienc~ 1 (pos 330 310))
  (obj w +~ (pos 20 360))
  (obj y +~ (pos 90 360))
  (obj z +~ (pos 160 360))
  (obj x +~ (pos 230 360))
  (obj crot comment "turn the whole scene (degrees)" (pos 330 380))
  (obj rot slider -180 180 (pos 330 400))
  (obj rotn number (pos 485 400))
  (obj r ambirot~ 1 (pos 20 440))
  (obj dec binaural~ 1 (pos 20 490))
  (obj on message "0.25 50" (pos 330 490))
  (obj off message "0 50" (pos 400 490))
  (obj cvol comment "volume" (pos 460 491))
  (obj ramp line~ (pos 330 525))
  (obj gl *~ (pos 20 540))
  (obj gr *~ (pos 120 540))
  (obj out dac~ (pos 20 590))
  (obj ml meter~ (pos 20 630))
  (obj mr meter~ (pos 120 630))
  (obj cm comment "left, right" (pos 190 640))
  (connect pl 0 v 0)
  (connect pl 0 d 0)
  (connect rate 0 v 0)
  (connect rate 0 d 0)
  (connect spd 0 ph 0)
  (connect ph 0 deg 0)
  (connect deg 0 e1 1)
  (connect daz 0 dazn 0)
  (connect dazn 0 e2 1)
  (connect del 0 deln 0)
  (connect deln 0 e2 2)
  (connect v 0 e1 0)
  (connect d 0 e2 0)
  (connect e1 0 w 0)
  (connect e1 1 y 0)
  (connect e1 2 z 0)
  (connect e1 3 x 0)
  (connect e2 0 w 1)
  (connect e2 1 y 1)
  (connect e2 2 z 1)
  (connect e2 3 x 1)
  (connect w 0 r 0)
  (connect y 0 r 1)
  (connect z 0 r 2)
  (connect x 0 r 3)
  (connect rot 0 rotn 0)
  (connect rotn 0 r 4)
  (connect r 0 dec 0)
  (connect r 1 dec 1)
  (connect r 2 dec 2)
  (connect r 3 dec 3)
  (connect dec 0 gl 0)
  (connect dec 1 gr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 gl 1)
  (connect ramp 0 gr 1)
  (connect gl 0 out 0)
  (connect gr 0 out 1)
  (connect gl 0 ml 0)
  (connect gr 0 mr 0)
  (connect lb 0 zero 0)
  (connect zero 0 daz 0)
  (connect zero 0 del 0)
  (connect zero 0 rot 0))
