; pv-play.moritz - phase vocoder resynthesis, run by pfft~ in pvoc.moritz.
; A frame position advances by "speed" frames per frame. Each bin reads its
; amplitude (interpolated between the two nearest frames), its analysed
; phase and its phase difference. pvlock~ advances the phase of every
; spectral peak by its own frequency and locks the bins around each peak to
; it, so a partial's bins stay in step: pitch stays put while time
; stretches, stops or runs backwards, without phasing or buzz. Where the
; position jumps (start, loop) the phases restart from the analysis.
; topic: hidden
(patch
  (obj c0 comment "resynthesis: read frames at any speed, phase-locked" (pos 20 10))
  (obj in fftin~ 1 (pos 20 45))
  (obj c1 comment "third outlet: bin number" (pos 110 46))
  (obj spd inlet (pos 330 45))
  (obj c2 comment "speed (frames per frame)" (pos 380 46))
  (obj s sig~ 0.25 (pos 330 80))
  (obj pos frameaccum~ (pos 330 115))
  (obj fr expr~ "fmod(fmod($v1, 980) + 980, 980)" (pos 330 150))
  (obj c3 comment "frame position, looping over 980 frames" (pos 560 151))
  (obj i1 expr~ "int($v1) * 512 + $v2" (pos 20 195))
  (obj i2 expr~ "(int($v1 + 1) % 980) * 512 + $v2" (pos 200 195))
  (obj a1 index~ pvamp (pos 20 235))
  (obj a2 index~ pvamp (pos 200 235))
  (obj amp expr~ "$v1 + ($v2 - $v1) * ($v3 - int($v3))" (pos 20 275))
  (obj c5 comment "amplitude between frames" (pos 20 300))
  (obj fno expr~ "int($v1)" (pos 470 195))
  (obj jump framedelta~ (pos 470 235))
  (obj trig expr~ "abs($v1) > 1.5 || $v2 == 0" (pos 470 275))
  (obj c4 comment "jumped: restart from the analysis" (pos 470 300))
  (obj ab index~ pvabs (pos 250 330))
  (obj dp index~ pvphase (pos 360 330))
  (obj lk pvlock~ (pos 200 375))
  (obj c6 comment "amplitude, phase, phase difference, reset" (pos 290 376))
  (obj pc poltocar~ (pos 20 420))
  (obj out fftout~ 1 (pos 20 460))
  (connect spd 0 s 0)
  (connect s 0 pos 0)
  (connect pos 0 fr 0)
  (connect fr 0 i1 0)
  (connect fr 0 i2 0)
  (connect fr 0 fno 0)
  (connect fr 0 amp 2)
  (connect in 2 i1 1)
  (connect in 2 i2 1)
  (connect i1 0 a1 0)
  (connect i2 0 a2 0)
  (connect a1 0 amp 0)
  (connect a2 0 amp 1)
  (connect fno 0 jump 0)
  (connect jump 0 trig 0)
  (connect fno 0 trig 1)
  (connect i1 0 ab 0)
  (connect i1 0 dp 0)
  (connect a1 0 lk 0)
  (connect ab 0 lk 1)
  (connect dp 0 lk 2)
  (connect trig 0 lk 3)
  (connect amp 0 pc 0)
  (connect lk 0 pc 1)
  (connect pc 0 out 0)
  (connect pc 1 out 1))
