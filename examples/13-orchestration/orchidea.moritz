; orchidea.moritz - a sound imitated by an orchestra (assisted orchestration,
; after Orchidea). A target is cut into segments (one for the bell and the
; gong, at its onsets for the voice); for each, a genetic search over the
; samples of the orchestra finds the sounds, one per player or a rest, whose
; summed spectrum is nearest the target's. The solution comes out as notes
; (instrument, pitch, dynamics, technique, onset, duration, the sample), as a
; score (a row an instrument, each note playing its sample), seen and edited in
; a score box, and as the sum of the chosen samples, next to the target.
; The same seed gives the same orchestration, here and in Musil
; (orchestrate-mimetic). MicroSOL, which comes with Moritz, has four
; instruments around C4-G4: no pitch filter (partials 0) with it. With a
; real database (read tinysol, after Extras > Datasets... > Download TinySOL,
; or read fullsol once registered there), set partials 0.2: the target's
; partials then choose the pitches. The piano phrase is orchestrated with
; the settings of Musil's dynamic_orchidea.mu. A reverb~ puts the orchestra
; (and the target) in a hall: none, some or more of it.
(patch
  (obj title comment "Orchidea: a bell, a gong, a voice and a piano phrase imitated by an orchestra" (pos 20 12))
  (obj sub comment "Choose a target; the search runs in the background (the progress below). Listen to the target, then to the orchestra; another seed, another orchestration." (pos 20 34))
  (obj b1 buffer~ orbell archeos-bell.wav (pos 20 65))
  (obj b2 buffer~ orgong gong_c_sharp.wav (pos 180 65))
  (obj b3 buffer~ orvox Vox.wav (pos 340 65))
  (obj b4 buffer~ ormix (pos 470 65))
  (obj b5 buffer~ oramin A_minor.wav (pos 600 65))
  (obj c1 comment "1. The orchestra: MicroSOL's oboes, horns, violins and cellos, two players each (the default orchestra, of what the database has)." (pos 20 100))
  (obj band orchestra orband microsol (pos 20 122))
  (obj inf message info (pos 290 122))
  (obj c2 comment "2. The target: click one (the bell is orchestrated when the patch opens)" (pos 20 160))
  (obj lb loadbang (pos 480 160))
  (obj tb message "; orch partials 0, sustain 1, sparsity 0.001, solutions 10, dovetail 0, connection closest, hold, population 300, epochs 300, segmentation none, run orbell ormix; tplay set orbell" (pos 20 201))
  (obj tbl comment "the bell, static: one segment" (pos 20 183))
  (obj tgo message "; orch partials 0, sustain 1, sparsity 0.001, solutions 10, dovetail 0, connection closest, hold, population 300, epochs 300, segmentation none, run orgong ormix; tplay set orgong" (pos 20 247))
  (obj tgl comment "the gong, static" (pos 20 229))
  (obj tvo message "; orch partials 0, sustain 0, segmentation flux, threshold 0.3, timegate 250, sparsity 0.001, solutions 10, dovetail 0, connection closest, hold, population 100, epochs 100, run orvox ormix; tplay set orvox" (pos 20 293))
  (obj tvl comment "the voice: 31 segments, cut at its onsets, each searched (sustain 0: no pitch filter, so nothing is held)" (pos 20 275))
  (obj tam message "; orch population 500, epochs 500, sparsity 0.01, partials 0, solutions 5, sustain 1, hold 4000, dovetail 0.75, connection path, segmentation flux, threshold 0.1, timegate 100, run oramin ormix; tplay set oramin" (pos 20 339))
  (obj taml comment "the piano phrase (A_minor.wav), dynamic: Musil's settings of dynamic_orchidea.mu, cut at every onset (some 180 segments)" (pos 20 321))
  (obj tamc comment "connection path: the solutions with the least melodic movement; dovetail 0.75: the chord before's pitches favoured (pivot notes); sustain 1, hold 4000: a kept pitch held, 4 s at most (with connection closest or best; path skips sustain)." (pos 20 367))
  (obj tamc2 comment "Also try hysteresis 0.5 (each segment leaning in timbre toward the ones before). With FullSOL set partials 0.3; a minute or more of search is normal." (pos 20 385))
  (obj cs comment "seed" (pos 20 427))
  (obj sd number (pos 60 427))
  (obj sdm message "; orch seed $1" (pos 120 427))
  (obj cst comment "then choose a target again;" (pos 230 428))
  (obj stp message "; orch stop" (pos 400 427))
  (obj ro receive orch (pos 20 462))
  (obj oi orchidea orband (pos 20 492))
  (obj prog flonum (pos 20 527))
  (obj cpr comment "progress" (pos 80 528))
  (obj dist flonum (pos 160 527))
  (obj cdi comment "distance" (pos 220 528))
  (obj rp message report (pos 300 527))
  (obj pp prepend set (pos 20 562))
  (obj last message "the notes, one a message: k instrument pitch dynamics technique onset duration (ms) sample cents player" (pos 20 592))
  (obj pr print solution (pos 160 562))
  (obj c3 comment "3. The solution as a score: a row an instrument, a note a sound chosen. Drag notes to change it; double-click it for the roll." (pos 20 632))
  (obj sc score solution 2 @size 600 190 (pos 20 657))
  (obj tr transport 60 4 4 (pos 640 657))
  (obj sp message play (pos 640 692))
  (obj ss message stop (pos 690 692))
  (obj sl message "locate 1" (pos 740 692))
  (obj spl comment "the score plays each note's sample" (pos 640 717))
  (obj c4 comment "4. Listen: the target, then the orchestra (the sum of the chosen samples, the players seated as in Orchidea's mixes)." (pos 20 857))
  (obj rt receive tplay (pos 20 882))
  (obj p0 message start (pos 120 882))
  (obj p0l comment "target" (pos 170 883))
  (obj p1 message start (pos 260 882))
  (obj p1l comment "orchestra" (pos 310 883))
  (obj p2 message stop (pos 400 882))
  (obj a0 play~ orbell 2 (pos 120 912))
  (obj a1 play~ ormix 2 (pos 260 912))
  (obj wf waveform~ ormix 400 60 (pos 400 912))
  (obj vl *~ 0.3 (pos 120 947))
  (obj vr *~ 0.3 (pos 260 947))
  (obj rsum +~ (pos 400 982))
  (obj rhalf *~ 0.5 (pos 400 1012))
  (obj rv reverb~ 1 2.5 (pos 400 1042))
  (obj r0 message "0 100" (pos 560 982))
  (obj r1 message "0.25 100" (pos 610 982))
  (obj r2 message "0.5 100" (pos 690 982))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 1007))
  (obj rln line~ (pos 560 1042))
  (obj wl *~ (pos 400 1077))
  (obj wr *~ (pos 480 1077))
  (obj out dac~ (pos 120 1117))
  (connect lb 0 tb 0)
  (connect inf 0 band 0)
  (connect sd 0 sdm 0)
  (connect ro 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 4 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rp 0 oi 0)
  (connect oi 2 pp 0)
  (connect oi 2 pr 0)
  (connect pp 0 last 0)
  (connect oi 3 dist 0)
  (connect rt 0 a0 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect p2 0 a0 0)
  (connect p2 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 r1 0)
  (connect r0 0 rln 0)
  (connect r1 0 rln 0)
  (connect r2 0 rln 0)
  (connect rv 0 wl 0)
  (connect rv 1 wr 0)
  (connect rln 0 wl 1)
  (connect rln 0 wr 1)
  (connect wl 0 out 0)
  (connect wr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
