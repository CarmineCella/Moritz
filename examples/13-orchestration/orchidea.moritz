; orchidea.moritz - a sound imitated by an orchestra (assisted orchestration,
; after Orchidea). A target is cut into segments (one for the bell and the
; gong, at its onsets for the voice); for each, a genetic search over the
; samples of the orchestra finds the sounds, one per player or a rest, whose
; summed spectrum is nearest the target's. The solution comes out as notes
; (instrument, pitch, dynamics, technique, onset, duration, the sample), drawn
; as a roll, and as the sum of the chosen samples, to hear next to the target.
; The same seed gives the same orchestration, here and in Musil
; (orchestrate-mimetic). MicroSOL, which comes with Moritz, has four
; instruments around C4-G4: no pitch filter (partials 0) with it. With a
; real database (read tinysol, after Extras > Datasets... > Download TinySOL,
; or read fullsol once registered there), set partials 0.2: the target's
; partials then choose the pitches.
(patch
  (obj title comment "Orchidea: a bell, a gong, a voice imitated by an orchestra" (pos 20 12))
  (obj sub comment "Choose a target; the search runs in the background (the progress below). Listen to the target, then to the orchestra; another seed, another orchestration." (pos 20 34))
  (obj b1 buffer~ orbell archeos-bell.wav (pos 20 65))
  (obj b2 buffer~ orgong gong_c_sharp.wav (pos 180 65))
  (obj b3 buffer~ orvox Vox.wav (pos 340 65))
  (obj b4 buffer~ ormix (pos 470 65))
  (obj b5 buffer~ orroll (pos 570 65))
  (obj c1 comment "1. The orchestra: MicroSOL's oboes, horns, violins and cellos, two players each (the default orchestra, of what the database has)." (pos 20 100))
  (obj band orchestra orband microsol (pos 20 122))
  (obj inf message info (pos 290 122))
  (obj c2 comment "2. The target: click one (the bell is orchestrated when the patch opens)" (pos 20 160))
  (obj lb loadbang (pos 480 160))
  (obj tb message "; orch partials 0, sustain 1, population 300, epochs 300, segmentation none, run orbell ormix; tplay set orbell" (pos 20 201))
  (obj tbl comment "the bell, static: one segment" (pos 20 183))
  (obj tgo message "; orch partials 0, sustain 1, population 300, epochs 300, segmentation none, run orgong ormix; tplay set orgong" (pos 20 247))
  (obj tgl comment "the gong, static" (pos 20 229))
  (obj tvo message "; orch partials 0, sustain 0, segmentation flux, threshold 0.3, timegate 250, population 100, epochs 100, run orvox ormix; tplay set orvox" (pos 20 293))
  (obj tvl comment "the voice: 31 segments, cut at its onsets, each searched (sustain 0: no pitch filter, so nothing is held)" (pos 20 275))
  (obj cs comment "seed" (pos 20 335))
  (obj sd number (pos 60 335))
  (obj sdm message "; orch seed $1" (pos 120 335))
  (obj cst comment "then choose a target again;" (pos 230 336))
  (obj stp message "; orch stop" (pos 400 335))
  (obj ro receive orch (pos 20 370))
  (obj oi orchidea orband (pos 20 400))
  (obj prog flonum (pos 20 435))
  (obj cpr comment "progress" (pos 80 436))
  (obj dist flonum (pos 160 435))
  (obj cdi comment "distance" (pos 220 436))
  (obj rp message report (pos 300 435))
  (obj rlm message "roll orroll" (pos 380 435))
  (obj pp prepend set (pos 20 470))
  (obj last message "the notes, one a message: k instrument pitch dynamics technique onset duration (ms) sample cents player" (pos 20 500))
  (obj pr print solution (pos 160 470))
  (obj c3 comment "3. The solution: a dot a note (onset and pitch), a colour a player; the notes also go to the Console (print solution)." (pos 20 540))
  (obj l2 loadbang (pos 640 540))
  (obj ps message "ylog 0, title onset (s) and pitch (MIDI), a colour a player" (pos 640 565))
  (obj pl plot orroll 600 180 scatter (pos 20 565))
  (obj c4 comment "4. Listen: the target, then the orchestra (the sum of the chosen samples, the players seated as in Orchidea's mixes)." (pos 20 765))
  (obj rt receive tplay (pos 20 790))
  (obj p0 message start (pos 120 790))
  (obj p0l comment "target" (pos 170 791))
  (obj p1 message start (pos 260 790))
  (obj p1l comment "orchestra" (pos 310 791))
  (obj p2 message stop (pos 400 790))
  (obj a0 play~ orbell 2 (pos 120 820))
  (obj a1 play~ ormix 2 (pos 260 820))
  (obj wf waveform~ ormix 400 60 (pos 400 820))
  (obj vl *~ 0.4 (pos 120 855))
  (obj vr *~ 0.4 (pos 260 855))
  (obj out dac~ (pos 120 890))
  (connect lb 0 tb 0)
  (connect inf 0 band 0)
  (connect sd 0 sdm 0)
  (connect ro 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 1 rlm 0)
  (connect rlm 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 2 pp 0)
  (connect oi 2 pr 0)
  (connect pp 0 last 0)
  (connect oi 3 dist 0)
  (connect l2 0 ps 0)
  (connect ps 0 pl 0)
  (connect rt 0 a0 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect p2 0 a0 0)
  (connect p2 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
