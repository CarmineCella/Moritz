; connections.moritz - the connections compared: a dynamic orchestration keeps the best solutions of
; each segment, and the connection chooses the one each segment plays: closest (each the nearest in
; timbre to the one before, Orchidea's), best (each the best alone) or path (the sequence with the
; least melodic movement, Musil's dynamic default). The same target, the same seed, three
; orchestras; the distance says how near the target each comes. MicroSOL, which comes with Moritz,
; has four instruments around C4-G4 and no pitch filter is used with it (partials 0); with FullSOL
; (read fullsol, once registered in Extras > Datasets...) or TinySOL (read tinysol, after Download
; TinySOL there) set partials 0.3 so that the target's partials choose the pitches; the search is
; then slower (a minute or more for a long target is normal).
; Try: 1. closest; listen to the orchestra and look at the score; 2. best: nearer the target (a
; smaller distance), more restless; 3. path: the players move least; 4. path with movement 5: they
; hardly move; 5. report after each: the players and their cost, segment by segment.
(patch
  (obj title comment "connections: closest, best or path, the same voice orchestrated three ways" (pos 20 12))
  (obj sub comment "Click a connection; the search runs in the background. Compare the distance and listen to each orchestra." (pos 20 34))
  (obj tb0 buffer~ cnvox Vox.wav (pos 20 65))
  (obj mixb buffer~ cnmix (pos 166 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra cnband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj s1 comment "the voice cut at its onsets; each segment has its ten best solutions: the connection chooses one a segment" (pos 20 160))
  (obj c1 message "; cnorch segmentation flux, threshold 0.3, timegate 250, partials 0, population 100, epochs 100, solutions 10, sustain 0, connection closest, run cnvox cnmix" (pos 20 182))
  (obj c1c comment "closest (Orchidea's): each solution the nearest in timbre to the one before: a smooth orchestra" (pos 20 208))
  (obj c2 message "; cnorch segmentation flux, threshold 0.3, timegate 250, partials 0, population 100, epochs 100, solutions 10, sustain 0, connection best, run cnvox cnmix" (pos 20 230))
  (obj c2c comment "best: the best solution of each segment, alone: the nearest to the target, the most restless" (pos 20 256))
  (obj c3 message "; cnorch segmentation flux, threshold 0.3, timegate 250, partials 0, population 100, epochs 100, solutions 10, sustain 0, connection path, movement 1, run cnvox cnmix" (pos 20 278))
  (obj c3c comment "path: the sequence with the least melodic movement (movement: the cost of a semitone a player moves); try movement 5" (pos 20 304))
  (obj c4 message "; cnorch segmentation flux, threshold 0.3, timegate 250, partials 0, population 100, epochs 100, solutions 10, sustain 0, connection path, movement 5, run cnvox cnmix" (pos 20 326))
  (obj ro receive cnorch (pos 200 366))
  (obj oi orchidea cnband (pos 20 375))
  (obj prog flonum (pos 20 410))
  (obj cpr comment "progress" (pos 80 411))
  (obj dist flonum (pos 160 410))
  (obj cdi comment "distance" (pos 220 411))
  (obj stp message stop (pos 300 410))
  (obj rp message report (pos 345 410))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 411))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 475))
  (obj sc score cnsolution 2 @size 600 170 (pos 20 497))
  (obj tr transport 60 4 4 (pos 640 497))
  (obj sp message play (pos 640 532))
  (obj ss message stop (pos 690 532))
  (obj sl message "locate 1" (pos 740 532))
  (obj csp comment "the score plays each note's sample" (pos 640 557))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 685))
  (obj rt receive cntplay (pos 20 710))
  (obj lt message start (pos 120 710))
  (obj ltl comment target (pos 170 711))
  (obj lo message start (pos 260 710))
  (obj lol comment orchestra (pos 310 711))
  (obj ls message stop (pos 400 710))
  (obj a0 play~ cnvox 2 (pos 120 740))
  (obj a1 play~ cnmix 2 (pos 260 740))
  (obj wf waveform~ cnmix 300 50 (pos 400 740))
  (obj vl *~ 0.3 (pos 120 775))
  (obj vr *~ 0.3 (pos 260 775))
  (obj rsum +~ (pos 400 805))
  (obj rhalf *~ 0.5 (pos 400 835))
  (obj rv reverb~ 1 2.5 (pos 400 865))
  (obj hv0 message "0 100" (pos 560 805))
  (obj hv1 message "0.25 100" (pos 610 805))
  (obj hv2 message "0.5 100" (pos 690 805))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 830))
