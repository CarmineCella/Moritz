; static-dynamic.moritz - static and dynamic orchestration: a target orchestrated as one segment
; (static, one chord) or cut into segments (dynamic, a chord each, joined into a score):
; segmentation none, flux (at the onsets, by threshold and timegate), frames (every block), or
; onsets given by hand. A dynamic segmentation takes Musil's dynamic settings (those of
; dynamic_orchidea.mu) for what no message set. MicroSOL, which comes with Moritz, has four
; instruments around C4-G4 and no pitch filter is used with it (partials 0); with FullSOL (read
; fullsol, once registered in Extras > Datasets...) or TinySOL (read tinysol, after Download TinySOL
; there) set partials 0.3 so that the target's partials choose the pitches; the search is then
; slower (a minute or more for a long target is normal).
; Try: 1. static: the bell as one chord; listen to the target, then the orchestra; 2. the voice,
; coarse: about thirty segments; watch the score; 3. the voice, fine (threshold 0.1, timegate 100):
; more segments, more notes; report prints a line a segment; 4. frames: the gong cut every 46 ms; 5.
; onsets by hand.
(patch
  (obj title comment "static or dynamic: one segment, or cut at the onsets, by frames, by hand" (pos 20 12))
  (obj sub comment "Click a target; the search runs in the background (progress below). Then listen: the target, the orchestra." (pos 20 34))
  (obj tb0 buffer~ sdbell archeos-bell.wav (pos 20 65))
  (obj tb1 buffer~ sdvox Vox.wav (pos 246 65))
  (obj tb2 buffer~ sdgong gong_c_sharp.wav (pos 392 65))
  (obj mixb buffer~ sdmix (pos 618 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra sdband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj s1 comment "1. static: the whole target is one segment, one chord of the orchestra (segmentation none)" (pos 20 160))
  (obj st message "; sdorch segmentation none, partials 0, population 300, epochs 300, run sdbell sdmix; sdtplay set sdbell" (pos 20 182))
  (obj s2 comment "2. dynamic, at the onsets: segmentation flux cuts where the spectrum changes; threshold: the share of the strongest change that counts, timegate: ms at least between two cuts" (pos 20 222))
  (obj fl1 message "; sdorch segmentation flux, threshold 0.3, timegate 250, partials 0, population 100, epochs 100, run sdvox sdmix; sdtplay set sdvox" (pos 20 244))
  (obj fl1c comment "the voice, coarse: about thirty segments" (pos 20 270))
  (obj fl2 message "; sdorch segmentation flux, threshold 0.1, timegate 100, partials 0, population 100, epochs 100, run sdvox sdmix; sdtplay set sdvox" (pos 20 292))
  (obj fl2c comment "the voice, fine: more segments, a faster orchestra" (pos 20 318))
  (obj s3 comment "3. dynamic, by frames: a segment every block of the database (2048 samples): the finest, and the slowest" (pos 20 350))
  (obj fr message "; sdorch segmentation frames, partials 0, population 50, epochs 50, run sdgong sdmix; sdtplay set sdgong" (pos 20 372))
  (obj s4 comment "4. or the cuts where you want them (ms): onsets 0 500 1500 3000" (pos 20 412))
  (obj on message "; sdorch onsets 0 500 1500 3000, partials 0, population 200, epochs 200, run sdbell sdmix; sdtplay set sdbell" (pos 20 434))
  (obj ro receive sdorch (pos 200 474))
  (obj oi orchidea sdband (pos 20 505))
  (obj prog flonum (pos 20 540))
  (obj cpr comment "progress" (pos 80 541))
  (obj dist flonum (pos 160 540))
  (obj cdi comment "distance" (pos 220 541))
  (obj stp message stop (pos 300 540))
  (obj rp message report (pos 345 540))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 541))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 605))
  (obj sc score sdsolution 2 @size 600 170 (pos 20 627))
  (obj tr transport 60 4 4 (pos 640 627))
  (obj sp message play (pos 640 662))
  (obj ss message stop (pos 690 662))
  (obj sl message "locate 1" (pos 740 662))
  (obj csp comment "the score plays each note's sample" (pos 640 687))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 815))
  (obj rt receive sdtplay (pos 20 840))
  (obj lt message start (pos 120 840))
  (obj ltl comment target (pos 170 841))
  (obj lo message start (pos 260 840))
  (obj lol comment orchestra (pos 310 841))
  (obj ls message stop (pos 400 840))
  (obj a0 play~ sdbell 2 (pos 120 870))
  (obj a1 play~ sdmix 2 (pos 260 870))
  (obj wf waveform~ sdmix 300 50 (pos 400 870))
  (obj vl *~ 0.3 (pos 120 905))
  (obj vr *~ 0.3 (pos 260 905))
  (obj rsum +~ (pos 400 935))
  (obj rhalf *~ 0.5 (pos 400 965))
  (obj rv reverb~ 1 2.5 (pos 400 995))
  (obj hv0 message "0 100" (pos 560 935))
  (obj hv1 message "0.25 100" (pos 610 935))
  (obj hv2 message "0.5 100" (pos 690 935))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 960))
  (obj lb loadbang (pos 760 935))
  (obj rln line~ (pos 560 995))
  (obj wetl *~ (pos 400 1030))
  (obj wetr *~ (pos 480 1030))
  (obj out dac~ (pos 120 1070))
  (connect inf 0 band 0)
  (connect rdf 0 band 0)
  (connect rdt 0 band 0)
  (connect ro 0 oi 0)
  (connect stp 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 3 dist 0)
  (connect oi 4 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 hv1 0)
  (connect hv0 0 rln 0)
  (connect hv1 0 rln 0)
  (connect hv2 0 rln 0)
  (connect rv 0 wetl 0)
  (connect rv 1 wetr 0)
  (connect rln 0 wetl 1)
  (connect rln 0 wetr 1)
  (connect wetl 0 out 0)
  (connect wetr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
