; granular-sections.moritz - a piece in three sections on one orchestra, each a granular process of
; its own (an orchidea in mode granular), overlapping in time: with continue 1 the orchestra's
; players carry their bookings from section to section (Musil's 'continue), so that where the
; sections overlap no player is asked for two notes at once: a note is cut where the player's next
; booking begins, and an event finds only the players the other sections left free. start places
; each section in the piece. The first section's score goes to the score object (score), the others
; are added to it (merge): one score, the piece. The orchestra's rest forgets the bookings, for a new
; piece. MicroSOL, which comes with Moritz, has four instruments around C4-G4; with FullSOL (read
; fullsol) give each section a register of its own (3 4, 4 6, 5 6).
; Try: 1. compose: the three sections one after the other (each done starts the next); 2. play; 3.
; report on each section: the events skipped because the others had the players (the saturation).
(patch
  (obj title comment "sections of a piece on one orchestra: continue, start, and one score of them all" (pos 20 12))
  (obj sub comment "Compose: the sections are made one after the other, carrying the players' bookings; then play." (pos 20 34))
  (obj corch comment "the orchestra: MicroSOL, eight players (read fullsol for a real one)" (pos 20 65))
  (obj band orchestra gxband microsol (pos 20 87))
  (obj pl message "players Ob 2 Hn 2 Vn 2 Vc 2" (pos 140 87))
  (obj rdf message "read fullsol" (pos 360 87))
  (obj lb loadbang (pos 480 87))
  (obj s1 comment "1. compose: forget the bookings (rest), then section A; its done starts B, B's starts C" (pos 20 125))
  (obj go message "; gxor rest; gxa run 12" (pos 20 147))
  (obj ror receive gxor (pos 250 147))
  (obj ca comment "A, 0 to 12 s: a sparse cloud, quiet" (pos 20 185))
  (obj pa message "; gxa mode granular, continue 1, start 0, seed 1, density 1 2, register 4 4, duration 1 3, dynamics 0.2" (pos 20 207))
  (obj cb comment "B, 8 to 20 s: dense, a crescendo: where it meets A it has the players A left free, and at its densest every player is busy (saturation)" (pos 20 240))
  (obj pb message "; gxb mode granular, continue 1, start 8, seed 2, density at 0 4 6 at 12 14 16, register 4 4, duration 0.3 0.9, dynamics at 0 0.3 at 12 1" (pos 20 262))
  (obj cc comment "C, 18 to 30 s: slowing into C E G, held" (pos 20 295))
  (obj pc message "; gxc mode granular, continue 1, start 18, seed 3, density at 0 6 at 12 0.5, register 4 4, duration at 0 0.2 0.5 at 12 3 4, chords C4 E4 G4, chord-weight at 0 0.3 at 10 1, dynamics at 0 0.8 at 12 0.3" (pos 20 317))
  (obj ra message "; gxa report" (pos 20 352))
  (obj rb message "; gxb report" (pos 120 352))
  (obj rcc message "; gxc report" (pos 220 352))
  (obj crep comment "3. report: each section's events, the ones skipped (every able player busy) and each player" (pos 330 353))
  (obj ra0 receive gxa (pos 20 390))
  (obj oa orchidea gxband (pos 20 420))
  (obj rb0 receive gxb (pos 240 390))
  (obj ob orchidea gxband (pos 240 420))
  (obj rc0 receive gxc (pos 460 390))
  (obj oc orchidea gxband (pos 460 420))
  (obj nb message "; gxb run 12" (pos 20 455))
  (obj nc message "; gxc run 12" (pos 240 455))
  (obj mb message "merge $2" (pos 240 485))
  (obj mc message "merge $2" (pos 460 485))
  (obj cs comment "the piece: A's score, B's and C's merged into it; double-click it for the roll or its timeline" (pos 20 520))
  (obj sc score gxpiece 2 @size 640 190 (pos 20 542))
  (obj tr transport 60 4 4 (pos 680 542))
  (obj sp message play (pos 680 577))
  (obj ss message stop (pos 730 577))
  (obj cpl comment "2. play" (pos 680 602))
  (obj chall comment "through a hall (reverb~)" (pos 20 750))
  (obj sum +~ (pos 20 775))
  (obj half *~ 0.5 (pos 20 805))
  (obj rv reverb~ 0.3 2.5 (pos 20 835))
  (obj out dac~ (pos 20 875))
  (connect lb 0 pl 0)
  (connect pl 0 band 0)
  (connect lb 0 pa 0)
  (connect lb 0 pb 0)
  (connect lb 0 pc 0)
  (connect rdf 0 band 0)
  (connect ror 0 band 0)
  (connect ra0 0 oa 0)
  (connect rb0 0 ob 0)
  (connect rc0 0 oc 0)
  (connect oa 1 nb 0)
  (connect ob 1 nc 0)
  (connect oa 4 sc 0)
  (connect ob 4 mb 0)
  (connect mb 0 sc 0)
  (connect oc 4 mc 0)
  (connect mc 0 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sc 0 sum 0)
  (connect sc 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 rv 0)
  (connect rv 0 out 0)
  (connect rv 1 out 1))
