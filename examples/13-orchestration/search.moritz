; search.moritz - the search: orchidea's genetic search tries population combinations of sounds, one
; a player or a rest, for at most epochs generations (it stops after patience generations without a
; better one); sparsity is how often a player is left out; the seed makes it repeatable (the same
; seed, the same orchestration, here and in Musil's orchestrate-mimetic). Of each segment the best
; solutions are kept: show lists them, choose puts another in place, report and notes print the
; result. MicroSOL, which comes with Moritz, has four instruments around C4-G4 and no pitch filter
; is used with it (partials 0); with FullSOL (read fullsol, once registered in Extras > Datasets...)
; or TinySOL (read tinysol, after Download TinySOL there) set partials 0.3 so that the target's
; partials choose the pitches; the search is then slower (a minute or more for a long target is
; normal).
; Try: 1. orchestrate the bell; 2. show 1: the solutions kept and their costs; 3. choose 1 2, choose
; 1 3: the second and third best, heard at once (the score and the mix change; two horns swapped are
; listed as two solutions that sound the same); 4. seed 2, orchestrate again: another orchestra; 5.
; population 20 and epochs 5: fast, and further from the target (the distance); 6. sparsity 0.3:
; fewer players.
(patch
  (obj title comment "the search: population, epochs, sparsity, seed; show and choose another solution" (pos 20 12))
  (obj sub comment "Orchestrate, then show the ranked solutions and choose another; a new seed gives another orchestration." (pos 20 34))
  (obj tb0 buffer~ sebell archeos-bell.wav (pos 20 65))
  (obj mixb buffer~ semix (pos 246 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra seband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj s1 comment "1. the genetic search: individuals, generations, how often a player rests (sparsity), the seed" (pos 20 160))
  (obj pn number (pos 20 182))
  (obj pm message "population $1" (pos 80 182))
  (obj en number (pos 200 182))
  (obj em message "epochs $1" (pos 260 182))
  (obj sn flonum (pos 360 182))
  (obj sm message "sparsity $1" (pos 430 182))
  (obj dn number (pos 540 182))
  (obj dm message "seed $1" (pos 600 182))
  (obj init message "300 300 0.001 1" (pos 680 160))
  (obj iu unpack 0 0 0. 0 (pos 680 182))
  (obj go message "partials 0, segmentation none, run sebell semix" (pos 20 217))
  (obj goc comment "2. orchestrate the bell; another seed, another orchestration (the same seed, the same one, here and in Musil)" (pos 330 218))
  (obj s3 comment "3. the best solutions (up to ten) are kept: show lists them (the chosen one starred), choose puts another in place" (pos 20 252))
  (obj sh message "show 1" (pos 20 274))
  (obj ch2 message "choose 1 2" (pos 80 274))
  (obj ch3 message "choose 1 3" (pos 165 274))
  (obj ch1 message "choose 1 1" (pos 250 274))
  (obj nt message notes (pos 335 274))
  (obj ntc comment "show segment, choose segment n, the notes again" (pos 390 275))
  (obj oi orchidea seband (pos 20 315))
  (obj prog flonum (pos 20 350))
  (obj cpr comment "progress" (pos 80 351))
  (obj dist flonum (pos 160 350))
  (obj cdi comment "distance" (pos 220 351))
  (obj stp message stop (pos 300 350))
  (obj rp message report (pos 345 350))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 351))
  (obj pr print note (pos 20 380))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 415))
  (obj sc score sesolution 2 @size 600 170 (pos 20 437))
  (obj tr transport 60 4 4 (pos 640 437))
  (obj sp message play (pos 640 472))
  (obj ss message stop (pos 690 472))
  (obj sl message "locate 1" (pos 740 472))
  (obj csp comment "the score plays each note's sample" (pos 640 497))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 625))
  (obj rt receive setplay (pos 20 650))
  (obj lt message start (pos 120 650))
  (obj ltl comment target (pos 170 651))
  (obj lo message start (pos 260 650))
  (obj lol comment orchestra (pos 310 651))
  (obj ls message stop (pos 400 650))
  (obj a0 play~ sebell 2 (pos 120 680))
  (obj a1 play~ semix 2 (pos 260 680))
  (obj wf waveform~ semix 300 50 (pos 400 680))
  (obj vl *~ 0.3 (pos 120 715))
  (obj vr *~ 0.3 (pos 260 715))
  (obj rsum +~ (pos 400 745))
  (obj rhalf *~ 0.5 (pos 400 775))
  (obj rv reverb~ 1 2.5 (pos 400 805))
  (obj hv0 message "0 100" (pos 560 745))
  (obj hv1 message "0.25 100" (pos 610 745))
  (obj hv2 message "0.5 100" (pos 690 745))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 770))
  (obj lb loadbang (pos 760 745))
  (obj rln line~ (pos 560 805))
  (obj wetl *~ (pos 400 840))
  (obj wetr *~ (pos 480 840))
  (obj out dac~ (pos 120 880))
  (connect inf 0 band 0)
  (connect rdf 0 band 0)
  (connect rdt 0 band 0)
  (connect pm 0 oi 0)
  (connect em 0 oi 0)
  (connect sm 0 oi 0)
  (connect dm 0 oi 0)
  (connect go 0 oi 0)
  (connect sh 0 oi 0)
  (connect ch1 0 oi 0)
  (connect ch2 0 oi 0)
  (connect ch3 0 oi 0)
  (connect nt 0 oi 0)
  (connect pn 0 pm 0)
  (connect en 0 em 0)
  (connect sn 0 sm 0)
  (connect dn 0 dm 0)
  (connect lb 0 init 0)
  (connect init 0 iu 0)
  (connect iu 0 pn 0)
  (connect iu 1 en 0)
  (connect iu 2 sn 0)
  (connect iu 3 dn 0)
  (connect stp 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 3 dist 0)
  (connect oi 4 sc 0)
  (connect oi 2 pr 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 hv1 0)
  (connect hv0 0 rln 0)
  (connect hv1 0 rln 0)
  (connect hv2 0 rln 0)
  (connect rv 0 wetl 0)
  (connect rv 1 wetr 0)
  (connect rln 0 wetl 1)
  (connect rln 0 wetr 1)
  (connect wetl 0 out 0)
  (connect wetr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
