; sound-space.moritz - the space of sounds: which samples an orchestration may use. The orchestra
; object chooses the players (players Vn 2 Vc 2; Ob|Hn is one player who doubles, as a flautist on
; piccolo, Fl|Picc), the range an instrument plays in (range Vn F4 G4), the techniques (techniques
; ord, pizz-lv...) and the dynamics (dynamics pp mf) of the sounds that enter the search; info
; prints the database and what is left in the Console. MicroSOL leaves little to choose (nearly all
; ord and mf, one cello note ff); with TinySOL or FullSOL these filters choose among thousands of
; sounds (techniques pizz-lv, dynamics pp, range Fl C5 C6). A small language of queries (instrument,
; technique, dynamics, pitch, any tag) comes later. MicroSOL, which comes with Moritz, has four
; instruments around C4-G4 and no pitch filter is used with it (partials 0); with FullSOL (read
; fullsol, once registered in Extras > Datasets...) or TinySOL (read tinysol, after Download TinySOL
; there) set partials 0.3 so that the target's partials choose the pitches; the search is then
; slower (a minute or more for a long target is normal).
; Try: 1. orchestrate: the default orchestra; 2. players Vn 2 Vc 2, orchestrate: only strings; 3.
; range Vn F4 G4: the violins may not play their C4 any more; 4. dynamics ff: only the one loud
; cello note is left (info shows it); dynamics alone lets every dynamics in again; 5. players Ob|Hn
; Vn Vc: the first player plays oboe or horn, never both at once.
(patch
  (obj title comment "the space of sounds: players, doublings, ranges, techniques and dynamics" (pos 20 12))
  (obj sub comment "Change the orchestra (info shows it in the Console), then orchestrate the bell with what is left." (pos 20 34))
  (obj tb0 buffer~ spbell archeos-bell.wav (pos 20 65))
  (obj mixb buffer~ spmix (pos 246 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra spband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj s1 comment "1. the players: an instrument a player, a number after one makes that many; A|B is one player who doubles" (pos 20 160))
  (obj p0 message players (pos 20 182))
  (obj p1 message "players Vn 2 Vc 2" (pos 95 182))
  (obj p2 message "players Ob Hn Vc" (pos 225 182))
  (obj p3 message "players Ob|Hn Vn Vc" (pos 345 182))
  (obj p4 message "add Vn 2" (pos 490 182))
  (obj p5 message "remove Vn" (pos 570 182))
  (obj pc comment "players alone: the default (two of each); Ob|Hn: one player, oboe or horn (as Fl|Picc in an orchestra)" (pos 20 207))
  (obj s2 comment "2. the sounds that enter the search" (pos 20 237))
  (obj r1 message "range Vn F4 G4" (pos 20 259))
  (obj r0 message "range Vn" (pos 130 259))
  (obj d1 message "dynamics ff" (pos 205 259))
  (obj d2 message "dynamics mf" (pos 295 259))
  (obj d0 message dynamics (pos 385 259))
  (obj t1 message "techniques ord" (pos 460 259))
  (obj t0 message techniques (pos 570 259))
  (obj rc comment "an instrument between two pitches (alone: all of it); only these dynamics, techniques (alone: all)" (pos 20 284))
  (obj go message "partials 0, population 200, epochs 200, segmentation none, run spbell spmix" (pos 20 314))
  (obj goc comment "3. orchestrate the bell with what is left" (pos 470 315))
  (obj oi orchidea spband (pos 20 350))
  (obj prog flonum (pos 20 385))
  (obj cpr comment "progress" (pos 80 386))
  (obj dist flonum (pos 160 385))
  (obj cdi comment "distance" (pos 220 386))
  (obj stp message stop (pos 300 385))
  (obj rp message report (pos 345 385))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 386))
  (obj pr print note (pos 20 415))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 450))
  (obj sc score spsolution 2 @size 600 170 (pos 20 472))
  (obj tr transport 60 4 4 (pos 640 472))
  (obj sp message play (pos 640 507))
  (obj ss message stop (pos 690 507))
  (obj sl message "locate 1" (pos 740 507))
  (obj csp comment "the score plays each note's sample" (pos 640 532))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 660))
  (obj rt receive sptplay (pos 20 685))
  (obj lt message start (pos 120 685))
  (obj ltl comment target (pos 170 686))
  (obj lo message start (pos 260 685))
  (obj lol comment orchestra (pos 310 686))
  (obj ls message stop (pos 400 685))
  (obj a0 play~ spbell 2 (pos 120 715))
  (obj a1 play~ spmix 2 (pos 260 715))
  (obj wf waveform~ spmix 300 50 (pos 400 715))
  (obj vl *~ 0.3 (pos 120 750))
  (obj vr *~ 0.3 (pos 260 750))
  (obj rsum +~ (pos 400 780))
  (obj rhalf *~ 0.5 (pos 400 810))
  (obj rv reverb~ 1 2.5 (pos 400 840))
  (obj hv0 message "0 100" (pos 560 780))
  (obj hv1 message "0.25 100" (pos 610 780))
  (obj hv2 message "0.5 100" (pos 690 780))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 805))
  (obj lb loadbang (pos 760 780))
  (obj rln line~ (pos 560 840))
  (obj wetl *~ (pos 400 875))
  (obj wetr *~ (pos 480 875))
  (obj out dac~ (pos 120 915))
  (connect inf 0 band 0)
  (connect rdf 0 band 0)
  (connect rdt 0 band 0)
  (connect p0 0 band 0)
  (connect p1 0 band 0)
  (connect p2 0 band 0)
  (connect p3 0 band 0)
  (connect p4 0 band 0)
  (connect p5 0 band 0)
  (connect r1 0 band 0)
  (connect r0 0 band 0)
  (connect d1 0 band 0)
  (connect d2 0 band 0)
  (connect d0 0 band 0)
  (connect t1 0 band 0)
  (connect t0 0 band 0)
  (connect go 0 oi 0)
  (connect stp 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 3 dist 0)
  (connect oi 4 sc 0)
  (connect oi 2 pr 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 hv1 0)
  (connect hv0 0 rln 0)
  (connect hv1 0 rln 0)
  (connect hv2 0 rln 0)
  (connect rv 0 wetl 0)
  (connect rv 1 wetr 0)
  (connect rln 0 wetl 1)
  (connect rln 0 wetr 1)
  (connect wetl 0 out 0)
  (connect wetr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
