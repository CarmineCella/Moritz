; morphological.moritz - a sound orchestrated by its shape (orchidea's mode morphological, Musil's
; orchestrate-morphological): no segmentation; the granular orchestra is driven by curves read off
; the target, its density of attacks (the peaks of its spectral flux), its register (centroid,
; spread, lowest strong partial) and its loudness (the dynamics); at every event a matching pursuit
; over the free players' sounds at the target's spectral peaks, against the target's spectrum less
; what already sounds, picks instrument, pitch and technique, and the note lasts as long as the
; target keeps its sound. decision genetic makes that choice by Orchidea's search instead. The voice
; and the gong: what is held is held, what is struck is short. MicroSOL, which comes with Moritz, has
; four instruments around C4-G4 and few sounds: the orchestration is sketchy but follows the shape;
; with FullSOL (read fullsol) it finds the partials, the techniques and the dynamics.
; Try: 1. the gong; 2. the voice; 3. the voice twice as busy, three notes an event; 4. the genetic
; decision; listen to the target, then the orchestra; the score holds the notes.
(patch
  (obj title comment "morphological: the orchestra follows the shape of a sound" (pos 20 12))
  (obj sub comment "Orchestrate a target; listen to it, then to the orchestra (the sum of the chosen samples); the score holds the notes." (pos 20 34))
  (obj tg buffer~ mgong gong_c_sharp.wav (pos 20 65))
  (obj tv buffer~ mvox Vox.wav (pos 200 65))
  (obj mx buffer~ mmix (pos 380 65))
  (obj corch comment "the orchestra: MicroSOL, ten players (read fullsol for a real one)" (pos 20 100))
  (obj band orchestra mmband microsol (pos 20 122))
  (obj pl message "players Ob 2 Hn 2 Vn 3 Vc 3" (pos 140 122))
  (obj rdf message "read fullsol" (pos 360 122))
  (obj lb loadbang (pos 480 122))
  (obj s1 comment "1. the gong: struck once, its partials held and fading, re-attacked three times a second (min-density 3)" (pos 20 160))
  (obj p1 message "; mmorch mode morphological, seed 1, decision pursuit, density-scale 1, min-density 3, voices 2, persist, run mgong mmix; mmtplay set mgong" (pos 20 182))
  (obj s2 comment "2. the voice: its syllables are events, its vowels held notes" (pos 20 215))
  (obj p2 message "; mmorch mode morphological, seed 2, decision pursuit, density-scale 1, min-density, voices 2, persist, run mvox mmix; mmtplay set mvox" (pos 20 237))
  (obj s3 comment "3. the voice twice as busy (density-scale 2), up to three notes an event (voices 3), short notes kept shorter (persist 0.7)" (pos 20 270))
  (obj p3 message "; mmorch mode morphological, seed 3, decision pursuit, density-scale 2, min-density, voices 3, persist 0.7, run mvox mmix; mmtplay set mvox" (pos 20 292))
  (obj s4 comment "4. the genetic decision: at every event Orchidea's search over the free players' sounds (slower)" (pos 20 325))
  (obj p4 message "; mmorch mode morphological, seed 4, decision genetic, population 60, epochs 40, density-scale 1, min-density 3, voices 2, persist, run mgong mmix; mmtplay set mgong" (pos 20 347))
  (obj rp message "; mmorch report" (pos 20 380))
  (obj rpc comment "report: the events, the players (in the Console)" (pos 140 381))
  (obj rc receive mmorch (pos 20 415))
  (obj oi orchidea mmband (pos 20 445))
  (obj prog flonum (pos 20 480))
  (obj cpr comment "progress" (pos 80 481))
  (obj stp message stop (pos 160 480))
  (obj cs comment "the notes as a score: a row an instrument, the cents of the target's partials by the notes; double-click it for the roll" (pos 20 515))
  (obj sc score mmscore 2 @size 600 170 (pos 20 537))
  (obj tr transport 60 4 4 (pos 640 537))
  (obj sp message play (pos 640 572))
  (obj ss message stop (pos 690 572))
  (obj clisten comment "listen: the target, then the orchestra" (pos 20 725))
  (obj rt receive mmtplay (pos 20 750))
  (obj lt message start (pos 120 750))
  (obj ltl comment target (pos 170 751))
  (obj lo message start (pos 260 750))
  (obj lol comment orchestra (pos 310 751))
  (obj ls message stop (pos 400 750))
  (obj a0 play~ mgong 2 (pos 120 780))
  (obj a1 play~ mmix 2 (pos 260 780))
  (obj chall comment "through a hall (reverb~)" (pos 460 780))
  (obj sum +~ (pos 120 815))
  (obj half *~ 0.3 (pos 120 845))
  (obj rv reverb~ 0.3 2.5 (pos 120 875))
  (obj out dac~ (pos 120 915))
  (connect lb 0 pl 0)
  (connect pl 0 band 0)
  (connect rdf 0 band 0)
  (connect rc 0 oi 0)
  (connect oi 0 prog 0)
  (connect stp 0 oi 0)
  (connect oi 4 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 sum 0)
  (connect a0 1 sum 1)
  (connect a1 0 sum 0)
  (connect a1 1 sum 1)
  (connect sc 0 sum 0)
  (connect sc 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 rv 0)
  (connect rv 0 out 0)
  (connect rv 1 out 1))
