; memory.moritz - the memory of a dynamic orchestration: sustain (a pitch the target keeps is held
; by the same player into the next segment, one longer note) and hold (how long at most), dovetail
; (pivot notes: the pitches of the chord before are favoured) and hysteresis (each segment leans in
; timbre toward the solutions before). Held notes need a pitch filter (partials above 0): with
; MicroSOL the octaves of the voice's partials and MicroSOL's eight pitches are allowed (octaves,
; pitches), so that every segment finds sounds. Sustain and hold act with the connections closest
; and best: path (Musil's dynamic default) makes its own continuity and skips them. Orchidea starts
; with sustain 1, no hold, dovetail 0, hysteresis 0. MicroSOL, which comes with Moritz, has four
; instruments around C4-G4 and no pitch filter is used with it (partials 0); with FullSOL (read
; fullsol, once registered in Extras > Datasets...) or TinySOL (read tinysol, after Download TinySOL
; there) set partials 0.3 so that the target's partials choose the pitches; the search is then
; slower (a minute or more for a long target is normal).
; Try: 1. sustain 0, then orchestrate: about 130 notes, short and long; 2. sustain 1, hold (no
; limit): the players hold their notes through the whole voice, ten notes; report counts the players
; holding on; 3. hold 1000: held again and again, none longer than a second; 4. sustain 0, dovetail
; 0.75: chords that keep pitches of the one before; 5. dovetail 0, hysteresis 0.5: fewer, longer
; notes, an even colour.
(patch
  (obj title comment "memory: held notes (sustain, hold), pivot notes (dovetail), timbre memory (hysteresis)" (pos 20 12))
  (obj sub comment "Set the memory, then orchestrate; compare the scores: long held notes, shared pitches, an even colour." (pos 20 34))
  (obj tb0 buffer~ mmvox Vox.wav (pos 20 65))
  (obj mixb buffer~ mmmix (pos 166 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra mmband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj s1 comment "a dynamic orchestration remembers the segments before: set these, then orchestrate (the voice, at its onsets)" (pos 20 160))
  (obj go message "; mmorch segmentation flux, threshold 0.3, timegate 250, partials 0.3, octaves 0 -1 1, pitches C4 C#4 D4 D#4 E4 F4 F#4 G4, population 100, epochs 100, connection closest, run mmvox mmmix" (pos 20 182))
  (obj goc comment "orchestrate (partials 0.3, octaves 0 -1 1 and pitches C4 ... G4: MicroSOL has only C4-G4; connection closest: path ignores sustain)" (pos 20 208))
  (obj su1 message "sustain 1" (pos 20 240))
  (obj su0 message "sustain 0" (pos 95 240))
  (obj h1 message "hold 1000" (pos 170 240))
  (obj h0 message hold (pos 245 240))
  (obj suc comment "held notes: a player whose pitch the target keeps holds it into the next segment (one longer note); hold: never longer than ms" (pos 320 241))
  (obj d1 message "dovetail 0.75" (pos 20 275))
  (obj d0 message "dovetail 0" (pos 120 275))
  (obj dc comment "pivot notes: a solution that drops the pitches of the chord before costs more" (pos 210 276))
  (obj y1 message "hysteresis 0.5" (pos 20 310))
  (obj y0 message "hysteresis 0" (pos 125 310))
  (obj yc comment "timbre memory: each segment leans toward the solutions chosen before" (pos 220 311))
  (obj ro receive mmorch (pos 200 350))
  (obj oi orchidea mmband (pos 20 380))
  (obj prog flonum (pos 20 415))
  (obj cpr comment "progress" (pos 80 416))
  (obj dist flonum (pos 160 415))
  (obj cdi comment "distance" (pos 220 416))
  (obj stp message stop (pos 300 415))
  (obj rp message report (pos 345 415))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 416))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 480))
  (obj sc score mmsolution 2 @size 600 170 (pos 20 502))
  (obj tr transport 60 4 4 (pos 640 502))
  (obj sp message play (pos 640 537))
  (obj ss message stop (pos 690 537))
  (obj sl message "locate 1" (pos 740 537))
  (obj csp comment "the score plays each note's sample" (pos 640 562))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 690))
  (obj rt receive mmtplay (pos 20 715))
  (obj lt message start (pos 120 715))
  (obj ltl comment target (pos 170 716))
  (obj lo message start (pos 260 715))
  (obj lol comment orchestra (pos 310 716))
  (obj ls message stop (pos 400 715))
  (obj a0 play~ mmvox 2 (pos 120 745))
  (obj a1 play~ mmmix 2 (pos 260 745))
  (obj wf waveform~ mmmix 300 50 (pos 400 745))
  (obj vl *~ 0.3 (pos 120 780))
  (obj vr *~ 0.3 (pos 260 780))
  (obj rsum +~ (pos 400 810))
  (obj rhalf *~ 0.5 (pos 400 840))
  (obj rv reverb~ 1 2.5 (pos 400 870))
  (obj hv0 message "0 100" (pos 560 810))
  (obj hv1 message "0.25 100" (pos 610 810))
  (obj hv2 message "0.5 100" (pos 690 810))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 835))
  (obj lb loadbang (pos 760 810))
  (obj rln line~ (pos 560 870))
  (obj wetl *~ (pos 400 905))
  (obj wetr *~ (pos 480 905))
  (obj out dac~ (pos 120 945))
  (connect inf 0 band 0)
  (connect rdf 0 band 0)
  (connect rdt 0 band 0)
  (connect su1 0 oi 0)
  (connect su0 0 oi 0)
  (connect h1 0 oi 0)
  (connect h0 0 oi 0)
  (connect d1 0 oi 0)
  (connect d0 0 oi 0)
  (connect y1 0 oi 0)
  (connect y0 0 oi 0)
  (connect ro 0 oi 0)
  (connect stp 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 3 dist 0)
  (connect oi 4 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 hv1 0)
  (connect hv0 0 rln 0)
  (connect hv1 0 rln 0)
  (connect hv2 0 rln 0)
  (connect rv 0 wetl 0)
  (connect rv 1 wetr 0)
  (connect rln 0 wetl 1)
  (connect rln 0 wetr 1)
  (connect wetl 0 out 0)
  (connect wetr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
