; output.moritz - what orchidea gives: the solution as a score (its last outlet, for a score box: a
; row an instrument in orchestral order, a note a sample with its dynamics, technique and cents,
; played and edited there), as messages (a note each: instrument, pitch, dynamics, technique, onset,
; duration, sample, cents, player), as the sum of the samples in a buffer~ (run's second name), as
; Orchidea's connection file (write) and as a buffer~ of frames (roll). The cents are how far the
; target's partial is from the sample's pitch: the roll shows them by each note (with MicroSOL and
; no pitch filter they are 0; with FullSOL and partials 0.3 the detuned notes show them). MicroSOL,
; which comes with Moritz, has four instruments around C4-G4 and no pitch filter is used with it
; (partials 0); with FullSOL (read fullsol, once registered in Extras > Datasets...) or TinySOL
; (read tinysol, after Download TinySOL there) set partials 0.3 so that the target's partials choose
; the pitches; the search is then slower (a minute or more for a long target is normal).
; Try: 1. orchestrate; 2. double-click the score box: the roll, a staff an instrument, the cents by
; the detuned notes (Alt+Up, Alt+Down change them); Timeline at the top of its window; 3. notes:
; the last note in the message box, all of them in the Console; 4. write: voice-orchestra.txt next
; to this patch, Orchidea's format; 5. roll oproll: four channels a note, for a plot.
(patch
  (obj title comment "the output: a score, messages, a mix, Orchidea's file, a buffer of notes" (pos 20 12))
  (obj sub comment "Orchestrate the voice, then look at the score (double-click it), the notes and the file write makes." (pos 20 34))
  (obj tb0 buffer~ opvox Vox.wav (pos 20 65))
  (obj mixb buffer~ opmix (pos 166 65))
  (obj corch comment "the orchestra: MicroSOL, which comes with Moritz (oboes, horns, violins, cellos, C4 to G4); read fullsol (registered in Extras > Datasets...) or read tinysol for a real one" (pos 20 100))
  (obj band orchestra opband microsol (pos 20 122))
  (obj inf message info (pos 240 122))
  (obj rdf message "read fullsol" (pos 290 122))
  (obj rdt message "read tinysol" (pos 385 122))
  (obj go message "segmentation flux, threshold 0.3, timegate 250, partials 0, sustain 0, population 100, epochs 100, run opvox opmix" (pos 20 160))
  (obj goc comment "1. orchestrate the voice" (pos 650 161))
  (obj s2 comment "2. the result again, in other forms" (pos 20 195))
  (obj sco message score (pos 20 217))
  (obj nts message notes (pos 75 217))
  (obj wr message "write voice-orchestra.txt" (pos 130 217))
  (obj rl message "roll oproll" (pos 300 217))
  (obj rlb buffer~ oproll (pos 390 217))
  (obj s2c comment "the score again (last outlet); a message a note (third outlet); Orchidea's connection file, next to this patch (Musil's score-load reads it); a buffer~ a frame a note: onset, pitch, player, duration" (pos 20 242))
  (obj pp prepend set (pos 20 272))
  (obj last message "a note: k instrument pitch dynamics technique onset duration (ms) sample cents player" (pos 20 302))
  (obj oi orchidea opband (pos 20 500))
  (obj prog flonum (pos 20 535))
  (obj cpr comment "progress" (pos 80 536))
  (obj dist flonum (pos 160 535))
  (obj cdi comment "distance" (pos 220 536))
  (obj stp message stop (pos 300 535))
  (obj rp message report (pos 345 535))
  (obj crp comment "report: a line a segment, in the Console" (pos 410 536))
  (obj pr print note (pos 20 565))
  (obj cscore comment "the solution as a score: a row an instrument, a note a sample with its dynamics, technique and cents; double-click it for the roll" (pos 20 600))
  (obj sc score opsolution 2 @size 600 170 (pos 20 622))
  (obj tr transport 60 4 4 (pos 640 622))
  (obj sp message play (pos 640 657))
  (obj ss message stop (pos 690 657))
  (obj sl message "locate 1" (pos 740 657))
  (obj csp comment "the score plays each note's sample" (pos 640 682))
  (obj clisten comment "listen: the target, then the orchestra (the sum of the chosen samples), through a hall" (pos 20 810))
  (obj rt receive optplay (pos 20 835))
  (obj lt message start (pos 120 835))
  (obj ltl comment target (pos 170 836))
  (obj lo message start (pos 260 835))
  (obj lol comment orchestra (pos 310 836))
  (obj ls message stop (pos 400 835))
  (obj a0 play~ opvox 2 (pos 120 865))
  (obj a1 play~ opmix 2 (pos 260 865))
  (obj wf waveform~ opmix 300 50 (pos 400 865))
  (obj vl *~ 0.3 (pos 120 900))
  (obj vr *~ 0.3 (pos 260 900))
  (obj rsum +~ (pos 400 930))
  (obj rhalf *~ 0.5 (pos 400 960))
  (obj rv reverb~ 1 2.5 (pos 400 990))
  (obj hv0 message "0 100" (pos 560 930))
  (obj hv1 message "0.25 100" (pos 610 930))
  (obj hv2 message "0.5 100" (pos 690 930))
  (obj crv comment "a hall: none, some, more (reverb~, 2.5 s)" (pos 560 955))
  (obj lb loadbang (pos 760 930))
  (obj rln line~ (pos 560 990))
  (obj wetl *~ (pos 400 1025))
  (obj wetr *~ (pos 480 1025))
  (obj out dac~ (pos 120 1065))
  (connect inf 0 band 0)
  (connect rdf 0 band 0)
  (connect rdt 0 band 0)
  (connect go 0 oi 0)
  (connect sco 0 oi 0)
  (connect nts 0 oi 0)
  (connect wr 0 oi 0)
  (connect rl 0 oi 0)
  (connect oi 2 pp 0)
  (connect pp 0 last 0)
  (connect stp 0 oi 0)
  (connect rp 0 oi 0)
  (connect oi 0 prog 0)
  (connect oi 3 dist 0)
  (connect oi 4 sc 0)
  (connect oi 2 pr 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sl 0 sc 0)
  (connect sc 0 vl 0)
  (connect sc 1 vr 0)
  (connect rt 0 a0 0)
  (connect lt 0 a0 0)
  (connect lo 0 a1 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect a0 0 vl 0)
  (connect a0 1 vr 0)
  (connect a1 0 vl 0)
  (connect a1 1 vr 0)
  (connect vl 0 rsum 0)
  (connect vr 0 rsum 1)
  (connect rsum 0 rhalf 0)
  (connect rhalf 0 rv 0)
  (connect lb 0 hv1 0)
  (connect hv0 0 rln 0)
  (connect hv1 0 rln 0)
  (connect hv2 0 rln 0)
  (connect rv 0 wetl 0)
  (connect rv 1 wetr 0)
  (connect rln 0 wetl 1)
  (connect rln 0 wetr 1)
  (connect wetl 0 out 0)
  (connect wetr 0 out 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
