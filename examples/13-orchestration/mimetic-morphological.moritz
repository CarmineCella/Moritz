; mimetic-morphological.moritz - one target, two ideas of orchestrating it. Mimetic (Orchidea's):
; the target cut into segments (here adaptively, at the peaks of its spectral flux against their
; local median), each searched for the combination of sounds, one per player, whose summed
; spectrum is nearest the segment's: a chord a segment, an imitation of the timbre. Morphological:
; no segments; the orchestra as a granular process whose density, register and dynamics follow the
; target's curves, each event a note pursued against the target's spectrum at that instant, as long
; as the target keeps it: an imitation of the shape. The same orchestra and the same target, two
; scores side by side. MicroSOL, which comes with Moritz, has four instruments around C4-G4; with
; FullSOL (read fullsol) set partials 0.3 for the mimetic search (slower).
; Try: 1. both; 2. listen to the target, the mimetic, the morphological; 3. compare the scores
; (double-click each): chords at the segments, against lines and grains.
(patch
  (obj title comment "mimetic or morphological: the timbre in segments, or the shape in time" (pos 20 12))
  (obj sub comment "Orchestrate the voice both ways (background jobs), then listen to each and open the two scores." (pos 20 34))
  (obj tv buffer~ cmvox Vox.wav (pos 20 65))
  (obj mxa buffer~ cmmixa (pos 200 65))
  (obj mxb buffer~ cmmixb (pos 380 65))
  (obj corch comment "the orchestra: MicroSOL, eight players (read fullsol for a real one)" (pos 20 100))
  (obj band orchestra cmband microsol (pos 20 122))
  (obj pl message "players Ob 2 Hn 2 Vn 2 Vc 2" (pos 140 122))
  (obj rdf message "read fullsol" (pos 360 122))
  (obj lb loadbang (pos 480 122))
  (obj s1 comment "1. both: the mimetic search (adaptive segmentation) and the morphological process, on the same voice" (pos 20 160))
  (obj go message "; cmmim seed 1, segmentation adaptive, ratio 2, timegate 250, partials 0, sustain 1, population 100, epochs 100, run cmvox cmmixa; cmmor mode morphological, seed 1, voices 2, run cmvox cmmixb" (pos 20 182))
  (obj rmim receive cmmim (pos 20 225))
  (obj om orchidea cmband (pos 20 255))
  (obj cma comment "mimetic" (pos 120 256))
  (obj rmor receive cmmor (pos 380 225))
  (obj oo orchidea cmband (pos 380 255))
  (obj cmb comment "morphological" (pos 480 256))
  (obj pa flonum (pos 20 285))
  (obj pb flonum (pos 380 285))
  (obj sca score cmmimetic 2 @size 340 150 (pos 20 320))
  (obj scb score cmmorphological 2 @size 340 150 (pos 380 320))
  (obj tr transport 60 4 4 (pos 740 320))
  (obj cs comment "3. the two scores: double-click each for its roll" (pos 20 480))
  (obj s2 comment "2. listen: the target, the mimetic orchestration, the morphological one (each the sum of its samples)" (pos 20 510))
  (obj lt message start (pos 20 535))
  (obj ltl comment target (pos 70 536))
  (obj la message start (pos 180 535))
  (obj lal comment mimetic (pos 230 536))
  (obj lo message start (pos 340 535))
  (obj lol comment morphological (pos 390 536))
  (obj ls message stop (pos 520 535))
  (obj a0 play~ cmvox 2 (pos 20 565))
  (obj a1 play~ cmmixa 2 (pos 180 565))
  (obj a2 play~ cmmixb 2 (pos 340 565))
  (obj chall comment "through a hall (reverb~)" (pos 520 600))
  (obj sum +~ (pos 20 600))
  (obj half *~ 0.3 (pos 20 630))
  (obj rv reverb~ 0.3 2.5 (pos 20 660))
  (obj out dac~ (pos 20 700))
  (connect lb 0 pl 0)
  (connect pl 0 band 0)
  (connect rdf 0 band 0)
  (connect rmim 0 om 0)
  (connect rmor 0 oo 0)
  (connect om 0 pa 0)
  (connect oo 0 pb 0)
  (connect om 4 sca 0)
  (connect oo 4 scb 0)
  (connect lt 0 a0 0)
  (connect la 0 a1 0)
  (connect lo 0 a2 0)
  (connect ls 0 a0 0)
  (connect ls 0 a1 0)
  (connect ls 0 a2 0)
  (connect a0 0 sum 0)
  (connect a0 1 sum 1)
  (connect a1 0 sum 0)
  (connect a1 1 sum 1)
  (connect a2 0 sum 0)
  (connect a2 1 sum 1)
  (connect sum 0 half 0)
  (connect half 0 rv 0)
  (connect rv 0 out 0)
  (connect rv 1 out 1))
