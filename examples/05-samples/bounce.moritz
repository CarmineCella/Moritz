; bounce.moritz - render renders bounce-source.moritz (FM bells) offline,
; faster than real time, four times with different settings: each render
; loads the patch afresh, applies the sends (seed, pitch, speed) and writes
; six seconds of its output into a buffer~. Render them all, then play and
; compare; edit the messages to make new variations.
(patch
  (obj title comment "render: four variations of a generative patch rendered offline into buffers, then played" (pos 20 12))
  (obj b1 buffer~ var1 (pos 20 40))
  (obj b2 buffer~ var2 (pos 120 40))
  (obj b3 buffer~ var3 (pos 220 40))
  (obj b4 buffer~ var4 (pos 320 40))
  (obj all button (pos 20 75))
  (obj call comment "render all four" (pos 50 78))
  (obj t t b b b b (pos 20 110))
  (obj r1 message "send seed 1, send pitch 60, send speed 250, render var1 6" (pos 20 145))
  (obj r2 message "send seed 2, send pitch 48, send speed 400, render var2 6" (pos 20 175))
  (obj r3 message "send seed 3, send pitch 72, send speed 120, render var3 6" (pos 20 205))
  (obj r4 message "send seed 4, send pitch 36, send speed 700, render var4 6" (pos 20 235))
  (obj mz render bounce-source.moritz (pos 20 275))
  (obj prog flonum (pos 20 310))
  (obj done button (pos 100 310))
  (obj cp comment "progress of each render, and done" (pos 130 313))
  (obj p1 message start (pos 460 145))
  (obj p2 message start (pos 460 175))
  (obj p3 message start (pos 460 205))
  (obj p4 message start (pos 460 235))
  (obj st message stop (pos 520 145))
  (obj cpl comment "play" (pos 520 205))
  (obj pl1 play~ var1 2 (pos 460 275))
  (obj pl2 play~ var2 2 (pos 460 305))
  (obj pl3 play~ var3 2 (pos 460 335))
  (obj pl4 play~ var4 2 (pos 460 365))
  (obj w1 waveform~ var1 200 40 (pos 20 350))
  (obj w2 waveform~ var2 200 40 (pos 230 350))
  (obj w3 waveform~ var3 200 40 (pos 20 400))
  (obj w4 waveform~ var4 200 40 (pos 230 400))
  (obj ml +~ (pos 460 410))
  (obj mr +~ (pos 560 410))
  (obj on message "0.4 50" (pos 460 445))
  (obj off message "0 50" (pos 525 445))
  (obj cv comment "volume" (pos 580 446))
  (obj ramp line~ (pos 460 480))
  (obj vl *~ (pos 360 480))
  (obj vr *~ (pos 560 515))
  (obj out dac~ (pos 360 550))
  (connect all 0 t 0)
  (connect t 3 r1 0)
  (connect t 2 r2 0)
  (connect t 1 r3 0)
  (connect t 0 r4 0)
  (connect r1 0 mz 0)
  (connect r2 0 mz 0)
  (connect r3 0 mz 0)
  (connect r4 0 mz 0)
  (connect mz 0 prog 0)
  (connect mz 1 done 0)
  (connect p1 0 pl1 0)
  (connect p2 0 pl2 0)
  (connect p3 0 pl3 0)
  (connect p4 0 pl4 0)
  (connect st 0 pl1 0)
  (connect st 0 pl2 0)
  (connect st 0 pl3 0)
  (connect st 0 pl4 0)
  (connect pl1 0 ml 0)
  (connect pl2 0 ml 0)
  (connect pl3 0 ml 0)
  (connect pl4 0 ml 0)
  (connect pl1 1 mr 0)
  (connect pl2 1 mr 0)
  (connect pl3 1 mr 0)
  (connect pl4 1 mr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect ml 0 vl 0)
  (connect mr 0 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
