; stretch.moritz - sparkle~ driven by two function curves: draw how fast
; the voice (Vox.wav) is read (speed) and how it is transposed (pitch) over
; fifteen seconds, then play. With envelope 60 the formants stay where they are, so
; the voice keeps its timbre while its pitch moves. Freeze stops time on the
; current sound; the cursor on the waveform shows where sparkle~ reads.
(patch
  (obj title comment "sparkle~ + function: draw the speed and the pitch over 15 s, then play (locked mode: click/drag/Shift-click points)" (pos 20 12))
  (obj buf buffer~ stretchvoice Vox.wav (pos 20 45))
  (obj play button (pos 20 80))
  (obj cplay comment "play" (pos 50 83))
  (obj trig t b b b (pos 20 115))
  (obj cs comment "speed: 0 (frozen) .. 2" (pos 20 145))
  (obj speed function 15000 0 2 0 1 4500 0.15 9000 0.15 12000 1 15000 1 (pos 20 165))
  (obj cp comment "pitch ratio: 0.5 .. 2" (pos 330 145))
  (obj pitch function 15000 0.5 2 0 1 5500 1 8500 1.5 11000 0.75 15000 1 (pos 330 165))
  (obj sline line~ (pos 20 290))
  (obj pline line~ (pos 330 290))
  (obj go message "start, loop 1" (pos 120 290))
  (obj spk sparkle~ stretchvoice (pos 20 330))
  (obj e0 message "envelope 0" (pos 480 330))
  (obj e1 message "envelope 60" (pos 565 330))
  (obj ce comment "formants: free / kept" (pos 480 360))
  (obj fr message 0 (pos 260 290))
  (obj cfr comment "freeze" (pos 295 291))
  (obj snap snapshot~ 30 (pos 200 370))
  (obj ms * 15100. (pos 200 400))
  (obj wf waveform~ stretchvoice 360 60 (pos 330 400))
  (obj on message "0.25 50" (pos 20 370))
  (obj off message "0 50" (pos 90 370))
  (obj cv comment "volume" (pos 150 371))
  (obj ramp line~ (pos 20 430))
  (obj vca *~ (pos 20 465))
  (obj out dac~ (pos 20 500))
  (connect play 0 trig 0)
  (connect trig 2 go 0)
  (connect trig 1 speed 0)
  (connect trig 0 pitch 0)
  (connect speed 1 sline 0)
  (connect pitch 1 pline 0)
  (connect go 0 spk 0)
  (connect sline 0 spk 0)
  (connect pline 0 spk 1)
  (connect fr 0 sline 0)
  (connect e0 0 spk 0)
  (connect e1 0 spk 0)
  (connect spk 1 snap 0)
  (connect snap 0 ms 0)
  (connect ms 0 wf 0)
  (connect spk 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
