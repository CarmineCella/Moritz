; recorder.moritz - record up to 4 s from the audio input into buffer~,
; while groove~ loops the buffer. Use headphones; macOS asks for
; microphone access the first time.
(patch
  (obj title comment "toggle on records into the loop, off stops; headphones!" (pos 20 12))
  (obj buf buffer~ loop 4000 (pos 20 40))
  (obj in adc~ 1 (pos 20 85))
  (obj inlvl meter~ (pos 200 120))
  (obj rtog toggle (pos 90 85))
  (obj rlabel comment "record" (pos 120 87))
  (obj rec record~ loop (pos 20 200))
  (obj save message "write ~/Desktop/my-loop.wav" (pos 20 250))
  (obj lb loadbang (pos 300 45))
  (obj init message "loop 1, 0" (pos 300 85))
  (obj speed flonum 1 (pos 420 85))
  (obj slabel comment "speed" (pos 485 86))
  (obj sp sig~ 1 (pos 420 125))
  (obj gr groove~ loop (pos 300 170))
  (obj vol *~ 0.8 (pos 300 215))
  (obj out dac~ (pos 300 265))
  (connect in 0 rec 0)
  (connect in 0 inlvl 0)
  (connect rtog 0 rec 0)
  (connect save 0 buf 0)
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect speed 0 sp 0)
  (connect sp 0 gr 0)
  (connect gr 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1))
