; tape.moritz - a four-second tape loop. record~ fills the buffer~ from the
; microphone or a voice (Vox.wav); waveform~ shows it; drag across the
; waveform (locked mode) to choose the part groove~ loops. The cursor follows
; the playback. sfrecord~ saves what you hear to ~/Documents/Moritz/moritz-take.wav.
(patch
  (obj title comment "waveform~: record into a buffer~, drag a region to loop it, save the result with sfrecord~" (pos 20 12))
  (obj buf buffer~ tape 4000 (pos 20 45))
  (obj lb loadbang (pos 160 45))
  (obj opn message "open Vox.wav, loop 1, 1" (pos 160 75))
  (obj setup message "loop 1, select 0 4000" (pos 400 75))
  (obj mic adc~ 1 (pos 20 115))
  (obj voice sfplay~ (pos 160 115))
  (obj src1 message 1 (pos 20 150))
  (obj src2 message 2 (pos 60 150))
  (obj csrc comment "source: 1 microphone, 2 a voice (Vox.wav)" (pos 100 151))
  (obj sel selector~ 2 2 (pos 20 185))
  (obj rec record~ tape (pos 20 220))
  (obj r1 message 1 (pos 140 220))
  (obj r0 message 0 (pos 180 220))
  (obj crec comment "record (1) / stop (0): four seconds" (pos 220 221))
  (obj wf waveform~ tape 600 130 (pos 20 260))
  (obj cwf comment "drag here (locked mode) to choose the loop" (pos 20 395))
  (obj cur expr "$f2 + $f1 * (($f3 > $f2 + 1) * $f3 + ($f3 <= $f2 + 1) * 4000 - $f2)" (pos 300 420))
  (obj snap snapshot~ 30 (pos 300 455))
  (obj rate sig~ 1 (pos 20 420))
  (obj gr groove~ tape (pos 20 455))
  (obj on message "0.2 50" (pos 20 495))
  (obj off message "0 50" (pos 85 495))
  (obj cv comment "volume" (pos 140 496))
  (obj ramp line~ (pos 20 530))
  (obj vca *~ (pos 120 565))
  (obj out dac~ (pos 120 600))
  (obj sf sfrecord~ (pos 300 565))
  (obj save message "open ~/Documents/Moritz/moritz-take.wav, 1" (pos 300 500))
  (obj stop message 0 (pos 300 530))
  (obj csave comment "save / stop" (pos 345 531))
  (obj secs number (pos 420 600))
  (obj csecs comment "ms saved" (pos 485 601))
  (connect lb 0 opn 0)
  (connect lb 0 setup 0)
  (connect opn 0 voice 0)
  (connect setup 0 gr 0)
  (connect setup 0 wf 0)
  (connect mic 0 sel 1)
  (connect voice 0 sel 2)
  (connect src1 0 sel 0)
  (connect src2 0 sel 0)
  (connect sel 0 rec 0)
  (connect r1 0 rec 0)
  (connect r0 0 rec 0)
  (connect wf 0 gr 1)
  (connect wf 1 gr 2)
  (connect wf 0 cur 1)
  (connect wf 1 cur 2)
  (connect rate 0 gr 0)
  (connect gr 1 snap 0)
  (connect snap 0 cur 0)
  (connect cur 0 wf 0)
  (connect gr 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect vca 0 sf 0)
  (connect save 0 sf 0)
  (connect stop 0 sf 0)
  (connect sf 0 secs 0))
