; echo.moritz - noise bursts into a feedback delay. tapin~ -> tapout~ is a
; tap link, so the feedback loop through lores~ and *~ back into tapin~
; is allowed. The metro re-triggers every 2 s; click the button too.
; topic: Filters and effects
(patch
  (obj title comment "tapin~ / tapout~ feedback echo" (pos 20 12))
  (obj lb loadbang (pos 20 40))
  (obj tog toggle (pos 20 75))
  (obj met metro 2000 (pos 20 115))
  (obj hit button (pos 20 155))
  (obj env message "1 2 0 60" (pos 20 195))
  (obj line line~ (pos 20 235))
  (obj noise noise~ (pos 120 195))
  (obj burst *~ (pos 120 275))
  (obj tin tapin~ 2000 (pos 120 325))
  (obj tout tapout~ 375 (pos 120 375))
  (obj dark lores~ 2500 0.1 (pos 260 375))
  (obj fb *~ 0.6 (pos 260 415))
  (obj mix +~ (pos 120 465))
  (obj vol *~ 0.5 (pos 120 505))
  (obj out dac~ (pos 120 555))
  (obj lvl meter~ (pos 260 465))
  (obj lb2 loadbang (pos 420 255))
  (obj tinit message 375 (pos 420 290))
  (obj finit message 0.6 (pos 480 290))
  (obj time slider 50 1000 (pos 420 325))
  (obj tlabel comment "delay (ms)" (pos 565 326))
  (obj fbk slider 0 0.9 (pos 420 415))
  (obj flabel comment "feedback" (pos 565 416))
  (connect lb 0 tog 0)
  (connect tog 0 met 0)
  (connect met 0 hit 0)
  (connect hit 0 env 0)
  (connect env 0 line 0)
  (connect noise 0 burst 0)
  (connect line 0 burst 1)
  (connect burst 0 tin 0)
  (connect tin 0 tout 0)
  (connect tout 0 dark 0)
  (connect dark 0 fb 0)
  (connect fb 0 tin 0)
  (connect burst 0 mix 0)
  (connect tout 0 mix 1)
  (connect mix 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 lvl 0)
  (connect lb2 0 tinit 0)
  (connect lb2 0 finit 0)
  (connect tinit 0 time 0)
  (connect finit 0 fbk 0)
  (connect time 0 tout 0)
  (connect fbk 0 fb 1))
