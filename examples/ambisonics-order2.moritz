; ambisonics-order2.moritz - order 1 against order 2. The same voice moves
; around the listener and is encoded twice: at order 1 (4 channels) and at
; order 2 (9 channels). The meters show each field decoded to a ring of eight
; speakers: at order 2 the sound gathers on fewer speakers around its
; direction (energy vector 0.87 instead of 0.71), so it is sharper to
; locate. On headphones, switch between the two binaural renderings.
; topic: Space
(patch
  (obj title comment "Ambisonics, order 1 and order 2: a sharper image with more channels" (pos 20 12))
  (obj sub comment "Audio on and headphones. The voice circles by itself (turns per second; 0 stops it). Compare orders 1 and 2 by ear and on the meters." (pos 20 34))
  (obj b buffer~ ao2vox sounds/Vox.wav (pos 20 65))
  (obj pl message "loop 1, start" (pos 20 100))
  (obj v groove~ ao2vox (pos 20 135))
  (obj rate sig~ 1 (pos 150 100))
  (obj cspd comment "turns per second" (pos 260 85))
  (obj spd flonum 0.1 (pos 260 105))
  (obj ph phasor~ 0.1 (pos 260 140))
  (obj deg *~ 360 (pos 260 175))
  (obj cel comment "elevation" (pos 420 85))
  (obj el slider -40 90 (pos 420 105))
  (obj eln number (pos 575 105))
  (obj vg *~ 0.5 (pos 20 175))
  (obj e1 ambienc~ 1 (pos 20 225))
  (obj e2 ambienc~ 2 (pos 330 225))
  (obj d1 ambidec~ 1 0 45 90 135 180 -135 -90 -45 (pos 20 280))
  (obj d2 ambidec~ 2 0 45 90 135 180 -135 -90 -45 (pos 330 280))
  (obj cd1 comment "order 1: eight speakers, front then leftwards" (pos 20 330))
  (obj md10 meter~ (pos 20 350))
  (obj md11 meter~ (pos 58 350))
  (obj md12 meter~ (pos 96 350))
  (obj md13 meter~ (pos 134 350))
  (obj md14 meter~ (pos 172 350))
  (obj md15 meter~ (pos 210 350))
  (obj md16 meter~ (pos 248 350))
  (obj md17 meter~ (pos 286 350))
  (obj cd2 comment "order 2: the same eight speakers" (pos 330 330))
  (obj md20 meter~ (pos 330 350))
  (obj md21 meter~ (pos 368 350))
  (obj md22 meter~ (pos 406 350))
  (obj md23 meter~ (pos 444 350))
  (obj md24 meter~ (pos 482 350))
  (obj md25 meter~ (pos 520 350))
  (obj md26 meter~ (pos 558 350))
  (obj md27 meter~ (pos 596 350))
  (obj b1 binaural~ 1 (pos 700 225))
  (obj b2 binaural~ 2 (pos 700 280))
  (obj ord1 message 1 (pos 700 335))
  (obj ord2 message 2 (pos 740 335))
  (obj cord comment "headphones: order 1 or 2" (pos 780 336))
  (obj sl selector~ 2 2 (pos 700 375))
  (obj sr selector~ 2 2 (pos 820 375))
  (obj on message "0.8 50" (pos 700 470))
  (obj off message "0 50" (pos 770 470))
  (obj cvol comment "volume" (pos 870 471))
  (obj ramp line~ (pos 700 505))
  (obj gl *~ (pos 700 415))
  (obj gr *~ (pos 820 415))
  (obj out dac~ (pos 820 455))
  (obj lb loadbang (pos 900 85))
  (obj zero message 0 (pos 900 115))
  (connect pl 0 v 0)
  (connect rate 0 v 0)
  (connect spd 0 ph 0)
  (connect ph 0 deg 0)
  (connect deg 0 e1 1)
  (connect deg 0 e2 1)
  (connect el 0 eln 0)
  (connect eln 0 e1 2)
  (connect eln 0 e2 2)
  (connect v 0 vg 0)
  (connect vg 0 e1 0)
  (connect vg 0 e2 0)
  (connect e1 0 d1 0)
  (connect e1 0 b1 0)
  (connect e1 1 d1 1)
  (connect e1 1 b1 1)
  (connect e1 2 d1 2)
  (connect e1 2 b1 2)
  (connect e1 3 d1 3)
  (connect e1 3 b1 3)
  (connect e2 0 d2 0)
  (connect e2 0 b2 0)
  (connect e2 1 d2 1)
  (connect e2 1 b2 1)
  (connect e2 2 d2 2)
  (connect e2 2 b2 2)
  (connect e2 3 d2 3)
  (connect e2 3 b2 3)
  (connect e2 4 d2 4)
  (connect e2 4 b2 4)
  (connect e2 5 d2 5)
  (connect e2 5 b2 5)
  (connect e2 6 d2 6)
  (connect e2 6 b2 6)
  (connect e2 7 d2 7)
  (connect e2 7 b2 7)
  (connect e2 8 d2 8)
  (connect e2 8 b2 8)
  (connect d1 0 md10 0)
  (connect d1 1 md11 0)
  (connect d1 2 md12 0)
  (connect d1 3 md13 0)
  (connect d1 4 md14 0)
  (connect d1 5 md15 0)
  (connect d1 6 md16 0)
  (connect d1 7 md17 0)
  (connect d2 0 md20 0)
  (connect d2 1 md21 0)
  (connect d2 2 md22 0)
  (connect d2 3 md23 0)
  (connect d2 4 md24 0)
  (connect d2 5 md25 0)
  (connect d2 6 md26 0)
  (connect d2 7 md27 0)
  (connect ord1 0 sl 0)
  (connect ord1 0 sr 0)
  (connect ord2 0 sl 0)
  (connect ord2 0 sr 0)
  (connect b1 0 sl 1)
  (connect b2 0 sl 2)
  (connect b1 1 sr 1)
  (connect b2 1 sr 2)
  (connect sl 0 gl 0)
  (connect sr 0 gr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 gl 1)
  (connect ramp 0 gr 1)
  (connect gl 0 out 0)
  (connect gr 0 out 1)
  (connect lb 0 zero 0)
  (connect zero 0 el 0))
