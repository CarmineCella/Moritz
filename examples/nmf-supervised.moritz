; nmf-supervised.moritz - source separation by NMF, with and without
; knowing the sources. Unsupervised ("run"), nmf finds parts in the mix by
; itself, and which part is which sound is left to chance. Supervised
; ("learn", then "separate"), it first learns the spectral parts of each
; source from a recording of it alone, then explains the mix with those
; parts only: each source comes out whole. Here the examples are the very
; recordings that are mixed, which makes it easy; in practice they are other
; recordings of the same voice and the same drums.
; topic: Analysis and learning
(patch
  (obj title comment "NMF source separation: unsupervised (run) and supervised (learn, separate)" (pos 20 12))
  (obj sub comment "Audio on. 1 records a mix of the voice and the drums (4 s). 2 learns each source alone and separates the mix. 3 does it blindly." (pos 20 34))
  (obj b1 buffer~ nsvox sounds/Vox.wav (pos 20 65))
  (obj b2 buffer~ nsdrums sounds/drums.wav (pos 220 65))
  (obj b3 buffer~ nsmix 4000 (pos 440 65))
  (obj b4 buffer~ nssup (pos 580 65))
  (obj b5 buffer~ nsunsup (pos 700 65))
  (obj s1 button (pos 20 105))
  (obj c1 comment "1 record the mix" (pos 50 108))
  (obj t1 t b b (pos 20 140))
  (obj go message "start" (pos 20 175))
  (obj rec1 message 1 (pos 120 175))
  (obj pv play~ nsvox (pos 20 210))
  (obj pd play~ nsdrums (pos 120 210))
  (obj sum +~ (pos 20 250))
  (obj half *~ 0.5 (pos 20 285))
  (obj rec record~ nsmix (pos 20 320))
  (obj s2 message "components 8, learn nsvox, learn nsdrums, separate nsmix nssup" (pos 330 105))
  (obj c2 comment "2 supervised: learn each source alone, then separate the mix" (pos 330 128))
  (obj s3 message "components 2, run nsmix nsunsup" (pos 330 160))
  (obj c3 comment "3 unsupervised: two parts found in the mix alone" (pos 330 183))
  (obj nm nmf 8 80 (pos 330 220))
  (obj prog flonum (pos 330 255))
  (obj done button (pos 410 255))
  (obj cprog comment "progress, done" (pos 440 258))
  (obj listen comment "listen" (pos 20 375))
  (obj l1 message start (pos 20 395))
  (obj l2 message start (pos 130 395))
  (obj l3 message start (pos 240 395))
  (obj l4 message start (pos 370 395))
  (obj l5 message start (pos 490 395))
  (obj cl1 comment "the mix" (pos 20 420))
  (obj cl2 comment "voice (2)" (pos 130 420))
  (obj cl3 comment "drums (2)" (pos 240 420))
  (obj cl4 comment "part 1 (3)" (pos 370 420))
  (obj cl5 comment "part 2 (3)" (pos 490 420))
  (obj q1 play~ nsmix (pos 20 450))
  (obj q2 play~ nssup 2 (pos 130 450))
  (obj q3 play~ nssup 2 (pos 240 450))
  (obj q4 play~ nsunsup 2 (pos 370 450))
  (obj q5 play~ nsunsup 2 (pos 490 450))
  (obj mix +~ (pos 20 500))
  (obj on message "0.6 50" (pos 250 500))
  (obj off message "0 50" (pos 320 500))
  (obj cvol comment "volume" (pos 380 501))
  (obj ramp line~ (pos 250 535))
  (obj vca *~ (pos 20 535))
  (obj out dac~ (pos 20 575))
  (connect s1 0 t1 0)
  (connect t1 1 rec1 0)
  (connect t1 0 go 0)
  (connect go 0 pv 0)
  (connect go 0 pd 0)
  (connect rec1 0 rec 0)
  (connect pv 0 sum 0)
  (connect pd 0 sum 0)
  (connect sum 0 half 0)
  (connect half 0 rec 0)
  (connect s2 0 nm 0)
  (connect s3 0 nm 0)
  (connect nm 0 prog 0)
  (connect nm 1 done 0)
  (connect l1 0 q1 0)
  (connect l2 0 q2 0)
  (connect l3 0 q3 0)
  (connect l4 0 q4 0)
  (connect l5 0 q5 0)
  (connect q1 0 mix 0)
  (connect q2 0 mix 0)
  (connect q3 1 mix 0)
  (connect q4 0 mix 0)
  (connect q5 1 mix 0)
  (connect mix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
