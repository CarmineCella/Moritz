; pvoc.mlsp - a phase vocoder: time-stretch a sung phrase without changing
; its pitch. pv-rec (inside a pfft~) analyses voice.wav into two buffers;
; pv-play (another pfft~) reads them back at any speed. 0 freezes the
; sound, negative speeds play it backwards. Open either pfft~ to see how.
(patch
  (obj title comment "phase vocoder: time stretching and freezing with pfft~" (pos 20 12))
  (obj buf buffer~ voice sounds/voice.wav (pos 20 40))
  (obj amp buffer~ pvamp 5000 (pos 240 40))
  (obj ph buffer~ pvphase 5000 (pos 410 40))
  (obj lb loadbang (pos 20 80))
  (obj rec message "analyse" (pos 110 80))
  (obj go t b b (pos 20 120))
  (obj start message start (pos 110 160))
  (obj src play~ voice (pos 110 200))
  (obj an pfft~ pv-rec 1024 4 (pos 20 245))
  (obj c1 comment "analysis: 400 frames, about 2.3 s" (pos 170 246))
  (obj c2 comment "speed" (pos 380 130))
  (obj s1 message 1 (pos 380 155))
  (obj s2 message 0.25 (pos 420 155))
  (obj s3 message 0.1 (pos 475 155))
  (obj s4 message 0 (pos 525 155))
  (obj s5 message -0.5 (pos 560 155))
  (obj c3 comment "1 = original, 0 = freeze" (pos 600 206))
  (obj spd slider -1 1.5 (pos 380 205))
  (obj snum flonum 0.25 (pos 530 205))
  (obj syn pfft~ pv-play 1024 4 (pos 20 300))
  (obj vol *~ 0.8 (pos 20 345))
  (obj out dac~ (pos 20 390))
  (obj sc scope~ (pos 140 390))
  (obj init message 0.25 (pos 300 80))
  (connect lb 0 go 0)
  (connect lb 0 init 0)
  (connect rec 0 go 0)
  (connect go 1 start 0)
  (connect go 0 an 1)
  (connect start 0 src 0)
  (connect src 0 an 0)
  (connect s1 0 spd 0)
  (connect s2 0 spd 0)
  (connect s3 0 spd 0)
  (connect s4 0 spd 0)
  (connect s5 0 spd 0)
  (connect init 0 spd 0)
  (connect spd 0 snum 0)
  (connect snum 0 syn 1)
  (connect syn 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 sc 0))
