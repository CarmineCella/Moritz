; grainvoice.moritz - one grain, played by poly~ in granulator.moritz.
;   grainvoice <buffer name>
; "start size pitch pan" in: a line~ ramp from 0 to 1 over the grain drives
; both a Hann window and the read position, so every grain is a smooth,
; self-contained window. thispoly~ frees the voice when the window closes.
(patch
  (obj c0 comment "one grain: start ms, size ms, pitch, pan" (pos 20 10))
  (obj in in (pos 20 40))
  (obj up unpack 0 0 0 0 (pos 20 75))
  (obj len * 1 (pos 120 115))
  (obj c1 comment "file ms per grain = size * pitch" (pos 180 116))
  (obj rmsg message "0, 1 $1" (pos 400 115))
  (obj ramp line~ (pos 400 150))
  (obj where expr~ "$v1 * $v2 + $v3" (pos 120 190))
  (obj c2 comment "read position (ms)" (pos 270 191))
  (obj rd play~ #1 (pos 120 230))
  (obj win expr~ "0.5 - 0.5 * cos(2 * pi * $v1)" (pos 400 230))
  (obj vca *~ (pos 120 275))
  (obj tp thispoly~ (pos 400 275))
  (obj gl expr "cos($f1 * pi / 2)" (pos 580 115))
  (obj gr expr "sin($f1 * pi / 2)" (pos 580 150))
  (obj l *~ (pos 120 320))
  (obj r *~ (pos 240 320))
  (obj outl out~ (pos 120 365))
  (obj outr out~ (pos 240 365))
  (connect in 0 up 0)
  (connect up 3 gl 0)
  (connect up 3 gr 0)
  (connect up 2 len 1)
  (connect up 1 len 0)
  (connect up 1 rmsg 0)
  (connect up 0 where 2)
  (connect len 0 where 1)
  (connect rmsg 0 ramp 0)
  (connect ramp 0 where 0)
  (connect ramp 0 win 0)
  (connect where 0 rd 0)
  (connect rd 0 vca 0)
  (connect win 0 vca 1)
  (connect win 0 tp 0)
  (connect vca 0 l 0)
  (connect vca 0 r 0)
  (connect gl 0 l 1)
  (connect gr 0 r 1)
  (connect l 0 outl 0)
  (connect r 0 outr 0))
