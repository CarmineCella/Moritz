; control.moritz - a tour of the control objects. Open Patch > Console
; (Shift+Cmd+M) to see what the print objects print.
(patch
  (obj title comment "open Patch > Console to watch the prints" (pos 20 12))
  (obj c1 comment "dice: random, select" (pos 20 45))
  (obj roll button (pos 20 70))
  (obj rnd random 6 (pos 20 105))
  (obj one + 1 (pos 20 140))
  (obj tr t f f (pos 20 175))
  (obj six sel 6 (pos 20 215))
  (obj pd print die (pos 85 215))
  (obj yay message "six!" (pos 20 250))
  (obj p6 print lucky (pos 20 285))
  (obj c2 comment "route by first word" (pos 250 45))
  (obj m1 message "freq 440" (pos 250 70))
  (obj m2 message "amp 0.5" (pos 330 70))
  (obj m3 message "pan 1" (pos 405 70))
  (obj rt route freq amp (pos 250 120))
  (obj pf print freq (pos 250 170))
  (obj pa print amp (pos 330 170))
  (obj po print other (pos 410 170))
  (obj c3 comment "pack (left inlet is hot) into expr" (pos 540 45))
  (obj a flonum 3 (pos 540 70))
  (obj b flonum 4 (pos 620 70))
  (obj pk pack 0 0 (pos 540 115))
  (obj hyp expr "sqrt($f1 * $f1 + $f2 * $f2)" (pos 540 155))
  (obj ph print hypot (pos 540 195))
  (obj c4 comment "counter through a gate" (pos 250 245))
  (obj tick button (pos 340 270))
  (obj gtog toggle (pos 250 270))
  (obj glabel comment "open" (pos 278 272))
  (obj cn counter 0 3 (pos 340 310))
  (obj gt gate (pos 250 350))
  (obj pc print count (pos 250 390))
  (obj c5 comment "delay, then a line ramp" (pos 540 245))
  (obj go button (pos 540 270))
  (obj dl delay 500 (pos 540 310))
  (obj ramp message "0, 100 1000" (pos 540 350))
  (obj ln line (pos 540 390))
  (obj show flonum (pos 540 430))
  (connect roll 0 rnd 0)
  (connect rnd 0 one 0)
  (connect one 0 tr 0)
  (connect tr 1 pd 0)
  (connect tr 0 six 0)
  (connect six 0 yay 0)
  (connect yay 0 p6 0)
  (connect m1 0 rt 0)
  (connect m2 0 rt 0)
  (connect m3 0 rt 0)
  (connect rt 0 pf 0)
  (connect rt 1 pa 0)
  (connect rt 2 po 0)
  (connect a 0 pk 0)
  (connect b 0 pk 1)
  (connect pk 0 hyp 0)
  (connect hyp 0 ph 0)
  (connect tick 0 cn 0)
  (connect gtog 0 gt 0)
  (connect cn 0 gt 1)
  (connect gt 0 pc 0)
  (connect go 0 dl 0)
  (connect dl 0 ramp 0)
  (connect ramp 0 ln 0)
  (connect ln 0 show 0))
