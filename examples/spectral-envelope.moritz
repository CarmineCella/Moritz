; spectral-envelope.moritz - the spectral envelope (specenv~) as a tool:
; separate the colour of a sound (its formants) from what it plays (its
; harmonics or its noise), then give one sound's colour to another. The
; voice is the modulator; the carrier is noise (a whisper), a chord of saws
; (a vocoder) or Beethoven's 7th (an orchestra that speaks). See
; specenv-fx.moritz for the spectral patch.
(patch
  (obj title comment "Spectral envelope: the colour of one sound on another (specenv~ in pfft~)" (pos 20 12))
  (obj sub comment "Audio on, play the voice, choose a carrier and a mode. The order is the envelope's resolution: low = smooth." (pos 20 34))
  (obj b1 buffer~ sevox sounds/Vox.wav (pos 20 65))
  (obj b2 buffer~ sebeet sounds/Beethoven_Symph7.wav (pos 220 65))
  (obj pv message "loop 1, start" (pos 20 100))
  (obj vox groove~ sevox (pos 20 135))
  (obj ccar comment "carrier" (pos 330 100))
  (obj k1 message 1 (pos 330 120))
  (obj k2 message 2 (pos 370 120))
  (obj k3 message 3 (pos 410 120))
  (obj ck comment "1 noise, 2 saw chord, 3 Beethoven" (pos 450 121))
  (obj nz noise~ (pos 330 160))
  (obj nzg *~ 0.2 (pos 330 200))
  (obj s1 saw~ 110 (pos 430 160))
  (obj s2 saw~ 138.6 (pos 505 160))
  (obj s3 saw~ 164.8 (pos 590 160))
  (obj chord +~ (pos 430 200))
  (obj chg *~ 0.3 (pos 430 235))
  (obj pb message "loop 1, 36000" (pos 700 160))
  (obj beet groove~ sebeet (pos 700 200))
  (obj rate sig~ 1 (pos 830 160))
  (obj car selector~ 3 2 (pos 330 280))
  (obj cmode comment "mode" (pos 20 180))
  (obj m1 message 1 (pos 20 200))
  (obj m2 message 2 (pos 60 200))
  (obj m3 message 3 (pos 100 200))
  (obj cm comment "1 voice   2 voice colour on the carrier   3 carrier colour on the voice" (pos 20 255))
  (obj cord comment "order" (pos 560 280))
  (obj ord slider 5 200 (pos 560 300))
  (obj ordn number (pos 715 300))
  (obj fx pfft~ specenv-fx 1024 4 (pos 20 330))
  (obj on message "0.5 50" (pos 250 380))
  (obj off message "0 50" (pos 320 380))
  (obj cvol comment "volume" (pos 380 381))
  (obj ramp line~ (pos 250 415))
  (obj vca *~ (pos 20 415))
  (obj out dac~ (pos 20 460))
  (obj spec spectroscope~ 400 110 (pos 450 420))
  (obj lb loadbang (pos 900 100))
  (obj init message 2 (pos 900 130))
  (obj oinit message 60 (pos 950 130))
  (connect pv 0 vox 0)
  (connect rate 0 vox 0)
  (connect rate 0 beet 0)
  (connect pb 0 beet 0)
  (connect k1 0 car 0)
  (connect k2 0 car 0)
  (connect k3 0 car 0)
  (connect nz 0 nzg 0)
  (connect nzg 0 car 1)
  (connect s1 0 chord 0)
  (connect s2 0 chord 0)
  (connect s3 0 chord 0)
  (connect chord 0 chg 0)
  (connect chg 0 car 2)
  (connect beet 0 car 3)
  (connect vox 0 fx 0)
  (connect car 0 fx 1)
  (connect m1 0 fx 2)
  (connect m2 0 fx 2)
  (connect m3 0 fx 2)
  (connect ord 0 ordn 0)
  (connect ordn 0 fx 3)
  (connect fx 0 vca 0)
  (connect fx 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 init 0)
  (connect lb 0 oinit 0)
  (connect init 0 fx 2)
  (connect oinit 0 ord 0)
  (connect lb 0 pb 0))
