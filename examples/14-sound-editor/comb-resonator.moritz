; comb-resonator.moritz - a patch for the sound editor's Process > A patch...: the selection rings
; through three comb filters tuned to a chord (A2, E3, C#4: a delay of one period each, fed back
; 0.97), like strings that resonate with it, mixed with what it was. Drums or noise become pitched;
; a voice sounds through a harp. The left channel comes in through the first inlet~, the right
; through the second; what reaches the outlet~s is the result. Change the delays (ms = 1000 / Hz)
; for another chord, the feedback for a longer ring.
(patch
  (obj title comment "Process > A patch...: the selection through three combs tuned to a chord" (pos 20 12))
  (obj inl inlet~ (pos 20 50))
  (obj inr inlet~ (pos 400 50))
  (obj c1 comb~ 20 9.091 0.05 0 0.97 (pos 20 100))
  (obj c2 comb~ 20 6.068 0.05 0 0.97 (pos 130 100))
  (obj c3 comb~ 20 3.608 0.05 0 0.97 (pos 240 100))
  (obj c4 comb~ 20 9.091 0.05 0 0.97 (pos 400 100))
  (obj c5 comb~ 20 6.068 0.05 0 0.97 (pos 510 100))
  (obj c6 comb~ 20 3.608 0.05 0 0.97 (pos 620 100))
  (obj cc comment "comb~ max delay(ms) gain(in) gain(delayed in) feedback: A2 9.091 ms, E3 6.068, C#4 3.608" (pos 20 135))
  (obj ml +~ (pos 20 165))
  (obj ml2 +~ (pos 20 195))
  (obj mr +~ (pos 400 165))
  (obj mr2 +~ (pos 400 195))
  (obj dryl *~ 0.4 (pos 200 195))
  (obj dryr *~ 0.4 (pos 580 195))
  (obj suml +~ (pos 20 230))
  (obj sumr +~ (pos 400 230))
  (obj outl outlet~ (pos 20 270))
  (obj outr outlet~ (pos 400 270))
  (obj cd comment "the rings, and the dry sound at 0.4" (pos 200 231))
  (connect inl 0 c1 0)
  (connect inl 0 c2 0)
  (connect inl 0 c3 0)
  (connect inr 0 c4 0)
  (connect inr 0 c5 0)
  (connect inr 0 c6 0)
  (connect c1 0 ml 0)
  (connect c2 0 ml 1)
  (connect ml 0 ml2 0)
  (connect c3 0 ml2 1)
  (connect c4 0 mr 0)
  (connect c5 0 mr 1)
  (connect mr 0 mr2 0)
  (connect c6 0 mr2 1)
  (connect inl 0 dryl 0)
  (connect inr 0 dryr 0)
  (connect ml2 0 suml 0)
  (connect dryl 0 suml 1)
  (connect mr2 0 sumr 0)
  (connect dryr 0 sumr 1)
  (connect suml 0 outl 0)
  (connect sumr 0 outr 0))
