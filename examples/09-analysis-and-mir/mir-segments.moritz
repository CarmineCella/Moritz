; mir-segments.moritz - a Bach prelude cut at its onsets (Kimiko Ishizaka,
; Well-Tempered Clavier, Prelude in C minor, CC0). onsets finds where every
; note begins; segment k gives the start and end of the k-th piece, ready
; for play~. Played in order, the pieces rebuild the prelude; backwards, the
; music runs in reverse note by note (each note still sounds forwards); at
; random, the notes of the prelude make a new texture.
(patch
  (obj title comment "A prelude cut into notes: onsets and segments" (pos 20 12))
  (obj sub comment "The onsets are found when the patch opens. Choose an order and start: each tick of the metro plays the next segment." (pos 20 34))
  (obj src buffer~ mgsrc sounds/Bach_Prelude_Cminor.flac (pos 20 65))
  (obj lb loadbang (pos 20 100))
  (obj run message "run mgsrc" (pos 20 130))
  (obj on onsets 2 1024 256 (pos 20 165))
  (obj n number (pos 160 200))
  (obj cn comment "segments" (pos 215 201))
  (obj w plot mgsrc 640 110 (pos 330 65))
  (obj cw comment "the prelude with its onsets (double-click to zoom in); the cursor follows the segment playing" (pos 330 180))
  (obj co comment "order:" (pos 20 245))
  (obj o1 message 1 (pos 70 243))
  (obj o2 message 2 (pos 110 243))
  (obj o3 message 3 (pos 150 243))
  (obj co2 comment "1 forwards, 2 backwards, 3 at random" (pos 190 245))
  (obj tg toggle (pos 20 280))
  (obj ct comment "start" (pos 50 282))
  (obj met metro 140 (pos 20 310))
  (obj cspd comment "ms a segment" (pos 180 290))
  (obj spd number 140 (pos 110 290))
  (obj cnt counter 0 100000 (pos 20 345))
  (obj back expr "$i2 - 1 - ($i1 % $i2)" (pos 120 380))
  (obj fwd expr "$i1 % $i2" (pos 20 380))
  (obj rnd random 100 (pos 260 380))
  (obj sw gate 3 (pos 20 415))
  (obj sel message "segment $1" (pos 20 455))
  (obj tl t l l (pos 20 490))
  (obj pl message "start $1 $2" (pos 20 525))
  (obj cur message "cursor $1" (pos 130 525))
  (obj play play~ mgsrc (pos 20 560))
  (obj vca *~ 0.5 (pos 20 595))
  (obj out dac~ (pos 20 630))
  (obj all message start (pos 130 560))
  (obj stp message stop (pos 185 560))
  (obj call comment "the whole prelude" (pos 230 562))
  (connect lb 0 run 0)
  (connect lb 0 o1 0)
  (connect run 0 on 0)
  (connect on 2 w 1)
  (connect on 4 n 0)
  (connect on 4 back 1)
  (connect on 4 fwd 1)
  (connect on 4 rnd 1)
  (connect o1 0 sw 0)
  (connect o2 0 sw 0)
  (connect o3 0 sw 0)
  (connect tg 0 met 0)
  (connect spd 0 met 1)
  (connect met 0 cnt 0)
  (connect cnt 0 sw 1)
  (connect sw 0 fwd 0)
  (connect sw 1 back 0)
  (connect sw 2 rnd 0)
  (connect fwd 0 sel 0)
  (connect back 0 sel 0)
  (connect rnd 0 sel 0)
  (connect sel 0 on 0)
  (connect on 3 tl 0)
  (connect tl 1 cur 0)
  (connect tl 0 pl 0)
  (connect cur 0 w 0)
  (connect pl 0 play 0)
  (connect all 0 play 0)
  (connect stp 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
