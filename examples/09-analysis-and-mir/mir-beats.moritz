; mir-beats.moritz - tempo and beats of a march (Sousa, The Stars and
; Stripes Forever, U.S. Marine Band, public domain). beats finds the onset
; strength (how much the spectrum grows, frame by frame), the tempo whose
; period repeats best in it, and the beats that are strong and regular; the
; click track it writes plays in sync with the march. The tempogram shows how
; periodic the music is at every tempo over time: the march keeps one.
(patch
  (obj title comment "Tempo and beats: a click track for a march" (pos 20 12))
  (obj sub comment "The analysis runs when the patch opens. Play the march with its click track: the clicks fall on the beats the machine found." (pos 20 34))
  (obj src buffer~ mbsrc sounds/Sousa_StarsAndStripes.flac (pos 20 65))
  (obj bfx buffer~ mbflux (pos 330 65))
  (obj bck buffer~ mbclick (pos 440 65))
  (obj btg buffer~ mbtg (pos 560 65))
  (obj lb loadbang (pos 20 100))
  (obj run message "run mbsrc mbflux" (pos 20 130))
  (obj bt beats (pos 20 165))
  (obj bpm flonum (pos 20 205))
  (obj cb comment "beats per minute" (pos 85 206))
  (obj once counter 0 1000 (pos 160 165))
  (obj first sel 0 (pos 160 195))
  (obj ck message "clicks mbclick, tempogram mbsrc mbtg" (pos 160 225))
  (obj cfirst comment "after the first analysis only" (pos 250 166))
  (obj cpl comment "play:" (pos 20 255))
  (obj go message start (pos 65 253))
  (obj st message stop (pos 120 253))
  (obj pm play~ mbsrc (pos 20 285))
  (obj pk play~ mbclick (pos 120 285))
  (obj cv comment "click level" (pos 120 320))
  (obj kl slider 0. 1. (pos 120 340))
  (obj kg *~ (pos 120 380))
  (obj mg *~ 0.4 (pos 20 380))
  (obj mix +~ (pos 20 415))
  (obj out dac~ (pos 20 445))
  (obj l1 loadbang (pos 480 125))
  (obj t1 message "title the first 20 seconds: onset strength and beats, xrange 0 20" (pos 400 155))
  (obj pf plot mbflux 620 100 (pos 330 260))
  (obj l2 loadbang (pos 480 370))
  (obj t2 message "title tempogram (bpm), rows 30 300, range 0 0.5" (pos 330 400))
  (obj pt plot mbtg 620 140 (pos 330 430))
  (obj ct comment "The bright line is the tempo; fainter ones are its multiples and divisions (the eighths, the bars)." (pos 330 575))
  (obj ct2 comment "Double-click the plots to zoom in: the beats (red) sit on the peaks of the onset strength." (pos 330 593))
  (obj half message "0.5" (pos 210 340))
  (connect lb 0 run 0)
  (connect run 0 bt 0)
  (connect bt 1 once 0)
  (connect once 0 first 0)
  (connect first 0 ck 0)
  (connect ck 0 bt 0)
  (connect bt 2 bpm 0)
  (connect bt 3 pf 1)
  (connect go 0 pm 0)
  (connect go 0 pk 0)
  (connect st 0 pm 0)
  (connect st 0 pk 0)
  (connect pm 0 mg 0)
  (connect pk 0 kg 0)
  (connect kl 0 kg 1)
  (connect lb 0 half 0)
  (connect half 0 kl 0)
  (connect kg 0 mix 0)
  (connect mg 0 mix 0)
  (connect mix 0 out 0)
  (connect mix 0 out 1)
  (connect l1 0 t1 0)
  (connect t1 0 pf 0)
  (connect l2 0 t2 0)
  (connect t2 0 pt 0))
