; mir-structure.moritz - the form of a march, found by listening machines.
; Sousa's "The Stars and Stripes Forever" (United States Marine Band, public
; domain): an introduction, two strains each played twice, then the trio in
; a new key, a breakstrain, the trio again. The chromagram (which pitch
; classes sound) of every moment is compared with every other: the
; self-similarity matrix shows repeats as squares and stripes; the novelty
; curve peaks where the music changes, the boundaries of the sections. Play
; a section and keyfind names its key: the trio moves from E-flat to A-flat.
(patch
  (obj title comment "The form of a march: self-similarity, novelty, and the key of each section" (pos 20 12))
  (obj sub comment "Sousa, The Stars and Stripes Forever (U.S. Marine Band). The analyses run when the patch opens; then play a section, or click the matrix." (pos 20 34))
  (obj src buffer~ mssrc sounds/Sousa_StarsAndStripes.flac (pos 20 65))
  (obj bch buffer~ msch (pos 20 95))
  (obj bss buffer~ msssm (pos 120 95))
  (obj bnv buffer~ msnov (pos 20 155))
  (obj blo buffer~ msloud (pos 120 155))
  (obj lb loadbang (pos 20 185))
  (obj r1 message "run mssrc msch" (pos 20 220))
  (obj a1 chromagram (pos 20 250))
  (obj r2 message "run msch msssm" (pos 20 285))
  (obj a2 similarity 800 (pos 20 315))
  (obj r3 message "gap 8000, run msssm msnov" (pos 20 350))
  (obj a3 novelty 48 1.5 (pos 20 380))
  (obj r4 message "smooth 21, loudness mssrc msloud" (pos 120 220))
  (obj a4 curves (pos 120 250))
  (obj nsec number (pos 160 420))
  (obj cns comment "sections" (pos 215 421))
  (obj cpl comment "play section:" (pos 20 462))
  (obj k number (pos 110 460))
  (obj nx message next (pos 170 460))
  (obj cnt counter 0 100 (pos 170 490))
  (obj sec message "section $1" (pos 20 522))
  (obj tl t l l (pos 20 552))
  (obj pl message "start $1 $2" (pos 20 582))
  (obj kr message "run mssrc $1 $2" (pos 130 582))
  (obj kf keyfind (pos 130 612))
  (obj pre prepend set (pos 130 645))
  (obj key message "" (pos 130 675))
  (obj ckey comment "the key of the section" (pos 130 700))
  (obj stop message stop (pos 20 612))
  (obj play play~ mssrc (pos 20 730))
  (obj vca *~ 0.4 (pos 20 760))
  (obj out dac~ (pos 20 790))
  (obj l1 loadbang (pos 230 95))
  (obj lab message "labels chroma, title chromagram" (pos 120 125))
  (obj pch plot msch 640 90 (pos 330 65))
  (obj pss plot msssm 400 400 (pos 330 165))
  (obj css comment "click: play from there" (pos 740 165))
  (obj clk message "start $1" (pos 740 190))
  (obj pnv plot msnov 640 70 (pos 330 575))
  (obj l2 loadbang (pos 740 470))
  (obj t2 message "title novelty" (pos 740 500))
  (obj t3 message "title loudness (dB)" (pos 740 530))
  (obj plo plot msloud 640 70 (pos 330 655))
  (obj cr comment "Squares on the diagonal are sections; the stripes beside it are repeats (the strains are played twice). The trio is the large block in the middle." (pos 330 735))
  (obj cr2 comment "Try novelty with another width (48 frames, about 13 s: shorter finds phrases, longer only the large sections) or similarity on MFCCs (timbre instead of harmony)." (pos 330 753))
  (connect lb 0 r1 0)
  (connect lb 0 r4 0)
  (connect r1 0 a1 0)
  (connect a1 1 r2 0)
  (connect r2 0 a2 0)
  (connect a2 1 r3 0)
  (connect r3 0 a3 0)
  (connect r4 0 a4 0)
  (connect a3 2 pch 1)
  (connect a3 2 pnv 1)
  (connect a3 2 plo 1)
  (connect a3 4 nsec 0)
  (connect k 0 sec 0)
  (connect nx 0 cnt 0)
  (connect cnt 0 sec 0)
  (connect sec 0 a3 0)
  (connect a3 3 tl 0)
  (connect tl 1 kr 0)
  (connect tl 0 pl 0)
  (connect kr 0 kf 0)
  (connect kf 2 pre 0)
  (connect pre 0 key 0)
  (connect pl 0 play 0)
  (connect stop 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect l1 0 lab 0)
  (connect lab 0 pch 0)
  (connect pss 0 clk 0)
  (connect clk 0 play 0)
  (connect l2 0 t2 0)
  (connect l2 0 t3 0)
  (connect t2 0 pnv 0)
  (connect t3 0 plo 0))
