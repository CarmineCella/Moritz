; mir-live.moritz - listening as it happens: onset~, chroma~, mfcc~ and
; melbands~ on the microphone or on a recording, drawn as they arrive. The
; chroma shows the harmony (which pitch classes sound), the MFCCs the
; timbre, the mel bands the spectrum as the ear divides it; onset~ flashes
; at every attack. Play an instrument or sing into the microphone.
(patch
  (obj title comment "Listening as it happens: live onsets, harmony and timbre" (pos 20 12))
  (obj sub comment "Turn audio on and choose a source: the microphone (not played back: no feedback), the D major prelude, or the drums." (pos 20 34))
  (obj b1 buffer~ mlbach Bach_Prelude_Dmajor.flac (pos 20 65))
  (obj b2 buffer~ mldrums drums.wav (pos 330 65))
  (obj cs comment "source:" (pos 20 100))
  (obj s1 message 1 (pos 75 98))
  (obj s2 message 2 (pos 115 98))
  (obj s3 message 3 (pos 155 98))
  (obj cs2 comment "1 microphone, 2 Bach, 3 drums" (pos 195 100))
  (obj lb loadbang (pos 450 98))
  (obj go message "loop 1, start" (pos 450 128))
  (obj rate sig~ 1 (pos 560 128))
  (obj in adc~ (pos 20 160))
  (obj gb groove~ mlbach (pos 120 160))
  (obj gd groove~ mldrums (pos 230 160))
  (obj sel selector~ 3 2 (pos 20 200))
  (obj mon selector~ 3 2 (pos 230 200))
  (obj snd send~ mlsig (pos 20 235))
  (obj vca *~ 0.4 (pos 230 235))
  (obj out dac~ (pos 230 270))
  (obj r1 receive~ mlsig (pos 20 320))
  (obj on onset~ (pos 20 350))
  (obj flash button (pos 20 385))
  (obj cnt counter 0 100000 (pos 60 385))
  (obj n number (pos 60 415))
  (obj cn comment "onsets" (pos 120 416))
  (obj r2 receive~ mlsig (pos 20 460))
  (obj ch chroma~ (pos 20 490))
  (obj l1 loadbang (pos 20 525))
  (obj lab message "labels chroma, title chroma" (pos 20 555))
  (obj pc plot 420 120 image (pos 330 320))
  (obj pcb plot 200 120 bars (pos 770 320))
  (obj r3 receive~ mlsig (pos 20 600))
  (obj mf mfcc~ (pos 20 630))
  (obj l2 loadbang (pos 20 665))
  (obj nm message "normalize 1, title MFCCs" (pos 20 695))
  (obj pm plot 420 100 image (pos 330 455))
  (obj r4 receive~ mlsig (pos 20 740))
  (obj mb melbands~ (pos 20 770))
  (obj l3 loadbang (pos 20 805))
  (obj rg message "range -90 -10, title mel bands" (pos 20 835))
  (obj pb plot 420 100 image (pos 330 570))
  (obj pfx plot 200 100 (pos 770 455))
  (obj cfx comment "onset~'s flux: the bangs are its peaks" (pos 770 560))
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect s1 0 mon 0)
  (connect s2 0 mon 0)
  (connect s3 0 mon 0)
  (connect lb 0 go 0)
  (connect lb 0 s2 0)
  (connect go 0 gb 0)
  (connect go 0 gd 0)
  (connect rate 0 gb 0)
  (connect rate 0 gd 0)
  (connect in 0 sel 1)
  (connect gb 0 sel 2)
  (connect gd 0 sel 3)
  (connect gb 0 mon 2)
  (connect gd 0 mon 3)
  (connect sel 0 snd 0)
  (connect mon 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect r1 0 on 0)
  (connect on 0 flash 0)
  (connect on 0 cnt 0)
  (connect cnt 0 n 0)
  (connect on 1 pfx 0)
  (connect r2 0 ch 0)
  (connect ch 0 pc 0)
  (connect ch 0 pcb 0)
  (connect l1 0 lab 0)
  (connect lab 0 pc 0)
  (connect lab 0 pcb 0)
  (connect r3 0 mf 0)
  (connect mf 0 pm 0)
  (connect l2 0 nm 0)
  (connect nm 0 pm 0)
  (connect r4 0 mb 0)
  (connect mb 0 pb 0)
  (connect l3 0 rg 0)
  (connect rg 0 pb 0))
