; midi-keys.moritz - play from a MIDI keyboard (notein), or click the
; keyboard, or let makenote improvise. Every note goes to poly~ with
; midinote, so note-offs release the right voice, and out to the "Moritz"
; MIDI port with noteout, so another synth can play along. The mod wheel
; (ctlin 1) sets the reverb mix.
; topic: MIDI and patching
(patch
  (obj title comment "MIDI: notein from a keyboard, kslider, makenote improvising; ctlin 1 (mod wheel) sets the reverb" (pos 20 12))
  (obj ni notein (pos 20 45))
  (obj cni comment "your MIDI keyboard (Patch > MIDI Setup)" (pos 110 46))
  (obj tog toggle (pos 420 45))
  (obj ctog comment "improvise" (pos 450 48))
  (obj met metro 180 (pos 420 80))
  (obj deg random 8 (pos 420 110))
  (obj pent expr "48 + 12 * int($i1 / 5) + 2 * ($i1 % 5) + ($i1 % 5 >= 3)" (pos 420 140))
  (obj mk makenote 90 160 (pos 420 175))
  (obj ks kslider 4 36 (pos 20 215))
  (obj cks comment "click or watch: every note lights up" (pos 380 235))
  (obj pk pack 0 0 (pos 20 295))
  (obj mn message "midinote $1 $2" (pos 20 330))
  (obj poly poly~ keyvoice 8 (pos 20 365))
  (obj nout noteout 1 (pos 200 330))
  (obj cnout comment "also to the MIDI port \"Moritz\"" (pos 280 331))
  (obj wheel ctlin 1 (pos 500 295))
  (obj mix scale 0 127 0.1 0.8 (pos 500 330))
  (obj cmix comment "mod wheel -> reverb mix" (pos 500 360))
  (obj verb reverb~ 0.3 2.5 (pos 20 405))
  (obj on message "0.5 50" (pos 300 405))
  (obj off message "0 50" (pos 365 405))
  (obj cv comment "volume" (pos 420 406))
  (obj ramp line~ (pos 300 440))
  (obj vl *~ (pos 20 475))
  (obj vr *~ (pos 120 475))
  (obj out dac~ (pos 20 515))
  (connect ni 1 ks 1)
  (connect ni 0 ks 0)
  (connect tog 0 met 0)
  (connect met 0 deg 0)
  (connect deg 0 pent 0)
  (connect pent 0 mk 0)
  (connect mk 1 ks 1)
  (connect mk 0 ks 0)
  (connect ks 1 pk 1)
  (connect ks 0 pk 0)
  (connect pk 0 mn 0)
  (connect mn 0 poly 0)
  (connect ks 1 nout 1)
  (connect ks 0 nout 0)
  (connect wheel 0 mix 0)
  (connect mix 0 verb 1)
  (connect poly 0 verb 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect verb 0 vl 0)
  (connect verb 1 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
