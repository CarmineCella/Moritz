; transform-pitch.moritz - the transformations of pitch and order on a phrase, by messages to a
; score box: transpose, invert (mirrored around a pitch, or around the middle of the phrase's pitches),
; retrograde (backwards). They change what is selected, or all of it when nothing is: select time 1 2
; picks the notes from 1 s to 2 s, select none all of them again. They are Musil's score-transpose!,
; score-invert! and score-retrograde!, the same as the buttons of the roll's Transform panel. The
; phrase is phrase.score, next to this patch; the transformations change the box, not the file.
; Try: 1. play (two bars, looped); 2. click transpose 7, then invert: watch the box and listen; 3. invert
; twice gives the phrase back, so does retrograde twice; 4. select time 1 2, then transpose 12: only
; the middle moves; 5. select none, read puts the phrase back; Edit > Undo (the box clicked last)
; takes one step back.
(patch
  (obj title comment "transformations of a phrase: transpose, invert, retrograde, on what is selected" (pos 20 12))
  (obj sub comment "play, then click a transformation; select none, read puts the phrase back as it was" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loop message "loop 1 3" (pos 110 70))
  (obj tr transport 120 4 4 (pos 180 70))
  (obj ph message "select none, read" (pos 20 105))
  (obj cph comment "the phrase again: read reads phrase.score, the box's file, again" (pos 150 106))
  (obj t1 message "transpose 7" (pos 20 140))
  (obj t2 message "transpose -12" (pos 115 140))
  (obj i1 message invert (pos 220 140))
  (obj i2 message "invert C5" (pos 280 140))
  (obj r1 message retrograde (pos 360 140))
  (obj s1 message "select time 1 2" (pos 20 175))
  (obj s2 message "select none" (pos 140 175))
  (obj s3 message "transpose 12" (pos 230 175))
  (obj cs comment "the transformations change the selection; none selected: all of it" (pos 330 176))
  (obj sc score phrase phrase.score @size 600 170 (pos 20 205))
  (obj pn prepend note (pos 20 390))
  (obj poly poly~ scorevoice 4 (pos 20 425))
  (obj lb loadbang (pos 300 390))
  (obj vol message "0.8 200" (pos 300 425))
  (obj mute message "0 200" (pos 370 425))
  (obj cv comment "volume" (pos 430 426))
  (obj ramp line~ (pos 300 460))
  (obj vca *~ (pos 20 495))
  (obj out dac~ (pos 20 535))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loop 0 tr 0)
  (connect lb 0 vol 0)
  (connect ph 0 sc 0)
  (connect t1 0 sc 0)
  (connect t2 0 sc 0)
  (connect i1 0 sc 0)
  (connect i2 0 sc 0)
  (connect r1 0 sc 0)
  (connect s1 0 sc 0)
  (connect s2 0 sc 0)
  (connect s3 0 sc 0)
  (connect sc 2 pn 0)
  (connect pn 0 poly 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect poly 0 vca 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
