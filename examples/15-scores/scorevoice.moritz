; scorevoice.moritz - one voice of the scores' examples, run by poly~: "pitch velocity duration" in
; (what a score's notes outlet sends first), a soft tone that holds for the note's duration and then
; fades. Its envelope also feeds thispoly~, so poly~ knows the voice is free once it has faded.
; topic: hidden
(patch
  (obj c0 comment "a poly~ voice: pitch velocity duration-ms -> a tone held for its duration" (pos 20 10))
  (obj in in (pos 20 40))
  (obj up unpack 0. 0. 0. (pos 20 75))
  (obj mt mtof (pos 20 115))
  (obj oct * 2. (pos 120 150))
  (obj o1 tri~ (pos 20 190))
  (obj o2 cycle~ (pos 120 190))
  (obj o2g *~ 0.3 (pos 120 225))
  (obj mix +~ (pos 20 260))
  (obj lp lores~ 2500 0.2 (pos 20 295))
  (obj amp expr "$f1 / 127. * 0.2" (pos 240 115))
  (obj pk pack 0. 0. (pos 240 150))
  (obj env message "$1 10 $1 $2 0 350" (pos 240 185))
  (obj line line~ (pos 240 220))
  (obj vca *~ (pos 20 335))
  (obj out out~ (pos 20 375))
  (obj tp thispoly~ (pos 240 260))
  (obj c1 comment "free when the envelope ends" (pos 330 261))
  (connect in 0 up 0)
  (connect up 2 pk 1)
  (connect up 1 amp 0)
  (connect amp 0 pk 0)
  (connect pk 0 env 0)
  (connect env 0 line 0)
  (connect up 0 mt 0)
  (connect mt 0 o1 0)
  (connect mt 0 oct 0)
  (connect oct 0 o2 0)
  (connect o1 0 mix 0)
  (connect o2 0 o2g 0)
  (connect o2g 0 mix 1)
  (connect mix 0 lp 0)
  (connect lp 0 vca 0)
  (connect line 0 vca 1)
  (connect line 0 tp 0)
  (connect vca 0 out 0))
