; transform-time.moritz - the transformations of time on a line played by hand (played.score, next to
; this patch): quantize moves the onsets and the ends toward a grid (strength 1: onto it, 0.5: half
; way); humanize moves them at random again (ms, dB, seed: the same seed, the same result);
; augment and diminish stretch and squeeze from the first onset; shift moves later; thin keeps each
; note with a probability; density keeps them by a curve along the phrase (1 0 1: thinned in the
; middle). They are Musil's score-quantize-grid!, score-humanize!, score-augment!, score-thin! and
; score-density!, the roll's Transform panel too.
; Try: 1. play (the loop is four bars long, room for augment 2); 2. quantize 0.25: the line is now
; on the eighths; listen, then humanize 25 2 1 to loosen it again; 3. augment 2, then diminish 2;
; 4. thin 0.5 with seed 1, then 2: two different halves; 5. select none, read: the line as played.
(patch
  (obj title comment "transformations in time: quantize, humanize, augment, diminish, shift, thin, density" (pos 20 12))
  (obj sub comment "play, then click a transformation; select none, read puts the line back as it was played" (pos 20 34))
  (obj play message play (pos 20 70))
  (obj stop message stop (pos 65 70))
  (obj loop message "loop 1 5" (pos 110 70))
  (obj tr transport 120 4 4 (pos 180 70))
  (obj ph message "select none, read" (pos 20 105))
  (obj cph comment "the line again, from played.score" (pos 150 106))
  (obj q1 message "quantize 0.25" (pos 20 140))
  (obj q2 message "quantize 0.25 0.5" (pos 125 140))
  (obj h1 message "humanize 25 2 1" (pos 260 140))
  (obj h2 message "humanize 25 2 2" (pos 385 140))
  (obj cq comment "grid (s) strength; ms dB seed" (pos 510 141))
  (obj a1 message "augment 2" (pos 20 175))
  (obj d1 message "diminish 2" (pos 100 175))
  (obj sh message "shift 0.5" (pos 185 175))
  (obj cs comment "from the first onset; later by 0.5 s" (pos 260 176))
  (obj t1 message "thin 0.5 1" (pos 20 210))
  (obj t2 message "thin 0.5 2" (pos 105 210))
  (obj dn message "density 1 0 1" (pos 190 210))
  (obj ct comment "keep half (seed 1 or 2); a curve: full, empty, full" (pos 300 211))
  (obj sc score played played.score @size 600 170 (pos 20 240))
  (obj pn prepend note (pos 20 425))
  (obj poly poly~ scorevoice 6 (pos 20 460))
  (obj lb loadbang (pos 300 425))
  (obj vol message "0.8 200" (pos 300 460))
  (obj mute message "0 200" (pos 370 460))
  (obj cv comment "volume" (pos 430 461))
  (obj ramp line~ (pos 300 495))
  (obj vca *~ (pos 20 530))
  (obj out dac~ (pos 20 570))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loop 0 tr 0)
  (connect lb 0 vol 0)
  (connect ph 0 sc 0)
  (connect q1 0 sc 0)
  (connect q2 0 sc 0)
  (connect h1 0 sc 0)
  (connect h2 0 sc 0)
  (connect a1 0 sc 0)
  (connect d1 0 sc 0)
  (connect sh 0 sc 0)
  (connect t1 0 sc 0)
  (connect t2 0 sc 0)
  (connect dn 0 sc 0)
  (connect sc 2 pn 0)
  (connect pn 0 poly 0)
  (connect vol 0 ramp 0)
  (connect mute 0 ramp 0)
  (connect poly 0 vca 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
