; sampler.moritz - buffer~ loads sounds/bell.wav (relative to this patch).
; groove~ loops it at any rate (negative plays backwards); play~ plays it
; once from the start.
(patch
  (obj title comment "buffer~ with groove~ (looping) and play~ (one shot)" (pos 20 12))
  (obj buf buffer~ bell sounds/bell.wav (pos 20 40))
  (obj lb loadbang (pos 20 80))
  (obj init message "loop 1, 0" (pos 20 115))
  (obj r0 message 2 (pos 180 45))
  (obj r1 message 0.5 (pos 220 45))
  (obj r2 message 1 (pos 268 45))
  (obj r3 message 1.5 (pos 308 45))
  (obj r4 message -1 (pos 358 45))
  (obj rlabel comment "rate" (pos 405 46))
  (obj rate flonum 1 (pos 180 85))
  (obj rsig sig~ 1 (pos 180 125))
  (obj gr groove~ bell (pos 20 170))
  (obj gvol *~ 0.6 (pos 20 215))
  (obj once message start (pos 360 125))
  (obj pl play~ bell (pos 360 170))
  (obj pvol *~ 0.6 (pos 360 215))
  (obj out dac~ (pos 20 270))
  (obj sc scope~ (pos 140 300))
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect r0 0 rate 0)
  (connect r1 0 rate 0)
  (connect r2 0 rate 0)
  (connect r3 0 rate 0)
  (connect r4 0 rate 0)
  (connect rate 0 rsig 0)
  (connect rsig 0 gr 0)
  (connect gr 0 gvol 0)
  (connect once 0 pl 0)
  (connect pl 0 pvol 0)
  (connect gvol 0 out 0)
  (connect gvol 0 out 1)
  (connect pvol 0 out 0)
  (connect pvol 0 out 1)
  (connect gvol 0 sc 0))
