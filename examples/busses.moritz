; busses.moritz - audio busses with send~ and receive~. Two players live in
; subpatchers and send their sound by name; the main patch receives it, mixes
; the dry sound, and gate~ sends each player to a reverb bus or an echo bus,
; also by name. receive~ sums every send~ of its name, so any number of
; sources can share a bus.
; topic: MIDI and patching
(patch
  (obj title comment "send~ / receive~: two players send by name; gate~ routes each one to a reverb or an echo bus" (pos 20 12))
  (obj go toggle (pos 20 45))
  (obj cgo comment "play" (pos 50 48))
  (obj bells p bells (pos 20 85)
    (patch
      (obj c0 comment "random bell strikes -> send~ bells" (pos 20 10))
      (obj in inlet (pos 20 40))
      (obj met metro 450 (pos 20 75))
      (obj pick random 6 (pos 20 110))
      (obj scl expr "880 * pow(2, ($i1 * 2 + ($i1 > 2)) / 12.)" (pos 20 145))
      (obj f sig~ 880 (pos 20 180))
      (obj hit click~ (pos 200 145))
      (obj res reson~ 1 880 60 (pos 200 215))
      (obj g *~ 0.6 (pos 200 250))
      (obj s send~ bells (pos 200 285))
      (connect in 0 met 0)
      (connect met 0 pick 0)
      (connect pick 0 scl 0)
      (connect scl 0 f 0)
      (connect met 0 hit 0)
      (connect hit 0 res 0)
      (connect f 0 res 2)
      (connect res 0 g 0)
      (connect g 0 s 0)))
  (obj drone p drone (pos 160 85)
    (patch
      (obj c0 comment "a slowly filtered saw chord -> send~ drone" (pos 20 10))
      (obj in inlet (pos 20 40))
      (obj a saw~ 110 (pos 20 75))
      (obj b saw~ 164.8 (pos 110 75))
      (obj c saw~ 220.5 (pos 210 75))
      (obj lfo cycle~ 0.1 (pos 310 75))
      (obj depth *~ 600 (pos 310 110))
      (obj base +~ 900 (pos 310 145))
      (obj mix +~ (pos 20 145))
      (obj lp lores~ 900 0.3 (pos 20 185))
      (obj amp *~ (pos 20 225))
      (obj ramp message "$1 2000" (pos 120 40))
      (obj env line~ (pos 120 75))
      (obj g *~ 0.15 (pos 20 260))
      (obj s send~ drone (pos 20 295))
      (connect a 0 mix 0)
      (connect b 0 mix 0)
      (connect c 0 mix 0)
      (connect lfo 0 depth 0)
      (connect depth 0 base 0)
      (connect base 0 lp 1)
      (connect mix 0 lp 0)
      (connect lp 0 amp 0)
      (connect in 0 ramp 0)
      (connect ramp 0 env 0)
      (connect env 0 amp 1)
      (connect amp 0 g 0)
      (connect g 0 s 0)))
  (obj cpl comment "double-click the p boxes to see inside" (pos 260 88))
  (obj rb receive~ bells (pos 20 140))
  (obj rd receive~ drone (pos 260 140))
  (obj b1 message 1 (pos 140 175))
  (obj b2 message 2 (pos 140 205))
  (obj gb gate~ 2 1 (pos 20 205))
  (obj d1 message 1 (pos 380 175))
  (obj d2 message 2 (pos 380 205))
  (obj gd gate~ 2 2 (pos 260 205))
  (obj cg comment "1 = reverb bus, 2 = echo bus" (pos 420 190))
  (obj tv1 send~ toverb (pos 20 245))
  (obj te1 send~ toecho (pos 110 245))
  (obj tv2 send~ toverb (pos 260 245))
  (obj te2 send~ toecho (pos 350 245))
  (obj rv receive~ toverb (pos 20 295))
  (obj verb reverb~ 1 3 (pos 20 330))
  (obj re receive~ toecho (pos 260 295))
  (obj fb +~ (pos 260 330))
  (obj tin tapin~ 1000 (pos 260 365))
  (obj tout tapout~ 375 (pos 260 400))
  (obj fbg *~ 0.45 (pos 380 400))
  (obj cecho comment "echo: 375 ms, feedback 0.45" (pos 440 401))
  (obj dry +~ (pos 500 295))
  (obj dg *~ 0.5 (pos 500 330))
  (obj cdry comment "dry mix" (pos 560 331))
  (obj ml +~ (pos 20 450))
  (obj mr +~ (pos 120 450))
  (obj on message "0.3 50" (pos 300 450))
  (obj off message "0 50" (pos 365 450))
  (obj cv comment "volume" (pos 420 451))
  (obj ramp line~ (pos 300 485))
  (obj vl *~ (pos 20 520))
  (obj vr *~ (pos 120 520))
  (obj out dac~ (pos 20 560))
  (obj sc scope~ (pos 300 520))
  (connect go 0 bells 0)
  (connect go 0 drone 0)
  (connect rb 0 gb 1)
  (connect rd 0 gd 1)
  (connect b1 0 gb 0)
  (connect b2 0 gb 0)
  (connect d1 0 gd 0)
  (connect d2 0 gd 0)
  (connect gb 0 tv1 0)
  (connect gb 1 te1 0)
  (connect gd 0 tv2 0)
  (connect gd 1 te2 0)
  (connect rv 0 verb 0)
  (connect re 0 fb 0)
  (connect fb 0 tin 0)
  (connect tin 0 tout 0)
  (connect tout 0 fbg 0)
  (connect fbg 0 fb 1)
  (connect rb 0 dry 0)
  (connect rd 0 dry 1)
  (connect dry 0 dg 0)
  (connect verb 0 ml 0)
  (connect verb 1 mr 0)
  (connect tout 0 ml 1)
  (connect tout 0 mr 1)
  (connect dg 0 ml 1)
  (connect dg 0 mr 1)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect ml 0 vl 0)
  (connect mr 0 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1)
  (connect ml 0 sc 0))
