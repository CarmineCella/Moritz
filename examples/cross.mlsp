; cross.mlsp - cross synthesis with pfft~: a sawtooth chord (carrier) takes
; on the spectral envelope of a sung phrase (modulator), so the chord
; "sings" the vowels. The spectral work is in xsynth.mlsp: double-click the
; pfft~ box in locked mode to open it.
(patch
  (obj title comment "cross synthesis: a saw chord shaped by the spectrum of a voice" (pos 20 12))
  (obj buf buffer~ voice sounds/voice.wav (pos 20 40))
  (obj lb loadbang (pos 20 75))
  (obj init message "loop 1, 0" (pos 20 110))
  (obj rate sig~ 1 (pos 140 110))
  (obj gr groove~ voice (pos 20 155))
  (obj c1 comment "modulator: voice.wav, looping" (pos 120 156))
  (obj o1 saw~ 98 (pos 300 75))
  (obj o2 saw~ 147 (pos 380 75))
  (obj o3 saw~ 196.5 (pos 460 75))
  (obj o4 saw~ 246.9 (pos 540 75))
  (obj nz noise~ (pos 620 75))
  (obj nzg *~ 0.3 (pos 620 110))
  (obj mix +~ (pos 300 155))
  (obj c2 comment "carrier: chord + a little noise" (pos 360 156))
  (obj xs pfft~ xsynth 1024 4 (pos 20 215))
  (obj gain flonum 0.01 (pos 240 215))
  (obj c3 comment "spectral gain" (pos 310 216))
  (obj vol *~ 0.4 (pos 20 260))
  (obj out dac~ (pos 20 305))
  (obj sc scope~ (pos 140 300))
  (obj c4 comment "chords" (pos 360 260))
  (obj ch1 message "; cr1 98; cr2 147; cr3 196.5; cr4 246.9" (pos 360 280))
  (obj ch2 message "; cr1 87.3; cr2 130.8; cr3 207.7; cr4 261.6" (pos 360 310))
  (obj ch3 message "; cr1 65.4; cr2 98; cr3 164.8; cr4 233.1" (pos 360 340))
  (obj r1 r cr1 (pos 300 40))
  (obj r2 r cr2 (pos 380 40))
  (obj r3 r cr3 (pos 460 40))
  (obj r4 r cr4 (pos 540 40))
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect rate 0 gr 0)
  (connect r1 0 o1 0)
  (connect r2 0 o2 0)
  (connect r3 0 o3 0)
  (connect r4 0 o4 0)
  (connect o1 0 mix 0)
  (connect o2 0 mix 0)
  (connect o3 0 mix 0)
  (connect o4 0 mix 0)
  (connect nz 0 nzg 0)
  (connect nzg 0 mix 0)
  (connect mix 0 xs 0)
  (connect gr 0 xs 1)
  (connect gain 0 xs 2)
  (connect xs 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1)
  (connect vol 0 sc 0))
