; soundtypes-generate.moritz - a Bach prelude recomposed from its own
; sound types (after SoundTypes). The recording is cut at its onsets: each
; note is a unit, typed by its timbre and its pitch classes; phrases and
; sections are found above it. typegen makes new sequences and plays them
; with the recording's own notes: the classic n-grams of SoundTypes, a
; variable-order Markov model, or a factor oracle that follows the original
; (continuity) or jumps where the recent past repeats. At level 2 or 3 it
; recombines whole phrases or sections. Bach, Well-Tempered Clavier I,
; Kimiko Ishizaka (CC0).
(patch
  (obj title comment "A Bach prelude recomposed: n-grams, Markov, oracle, at three levels" (pos 20 12))
  (obj sub comment "The prelude is cut at its onsets (notes) and analysed when the patch opens (a few seconds). Choose a method and a level, then generate." (pos 20 34))
  (obj b1 buffer~ stgbach Bach_Prelude_Cminor.flac (pos 20 65))
  (obj b2 buffer~ stgbach2 Bach_Prelude_Dmajor.flac (pos 330 65))
  (obj out buffer~ stgout (pos 640 65))
  (obj lab buffer~ stglab (pos 740 65))
  (obj olab buffer~ stgolab (pos 840 65))
  (obj c1 comment "1. Analysis: notes (between onsets) clustered by timbre and pitch classes (16 types); phrases where the next type surprises (8 types); sections (4)." (pos 20 100))
  (obj lb loadbang (pos 20 122))
  (obj set message "segment onsets 1.5 80, pitch 1, types 16 8 4, levels 3" (pos 100 122))
  (obj s1 message "analyse stgbach; stgplay set stgbach" (pos 20 150))
  (obj s2 message "analyse stgbach2; stgplay set stgbach2" (pos 300 150))
  (obj cs comment "C minor (Book I); D major" (pos 580 152))
  (obj st soundtypes stgmodel (pos 20 185))
  (obj prog flonum (pos 20 215))
  (obj pre prepend set (pos 90 215))
  (obj units message "" (pos 190 215))
  (obj cu comment "units at levels 1 2 3" (pos 300 217))
  (obj ol message "labels stgolab" (pos 90 245))
  (obj c2 comment "2. Method" (pos 20 285))
  (obj m1 message "classic 2" (pos 20 305))
  (obj m2 message "classic 4" (pos 100 305))
  (obj m3 message "markov 4 2" (pos 180 305))
  (obj cm comment "n-grams of 2 or 4; Markov up to 4" (pos 280 307))
  (obj cco comment "oracle: continuity (1 = the original)" (pos 20 335))
  (obj co slider 0. 1. (pos 20 355))
  (obj m4 message "oracle $1 2" (pos 20 385))
  (obj coo comment "jumps only where the last 2 types repeat" (pos 110 387))
  (obj c3 comment "3. Level" (pos 20 425))
  (obj l1 message "level 1" (pos 20 445))
  (obj l2 message "level 2" (pos 85 445))
  (obj l3 message "level 3" (pos 150 445))
  (obj cl comment "notes, phrases, sections" (pos 220 447))
  (obj gen message "generate 40 stgout stglab" (pos 20 485))
  (obj g typegen stgmodel (pos 20 515))
  (obj gp flonum (pos 20 545))
  (obj cpl comment "4. Listen: the original, the new piece (it starts when ready)" (pos 20 585))
  (obj p0 message start (pos 20 607))
  (obj p1 message start (pos 110 607))
  (obj stp message stop (pos 200 607))
  (obj rp receive stgplay (pos 20 637))
  (obj a0 play~ stgbach (pos 20 667))
  (obj a1 play~ stgout (pos 120 667))
  (obj mix +~ (pos 20 702))
  (obj vca *~ 0.5 (pos 20 732))
  (obj dac dac~ (pos 20 767))
  (obj li loadbang (pos 1100 100))
  (obj ci message "0.6" (pos 1100 130))
  (obj ip message "oracle 0.6 2" (pos 1100 160))
  (obj sp1 message "colors types, title the prelude: types of notes phrases sections" (pos 620 280))
  (obj sp2 message "colors types, title the new piece: the same types in a new order" (pos 620 445))
  (obj po plot stgolab 460 120 (pos 620 305))
  (obj pg plot stglab 460 120 (pos 620 470))
  (obj c9 comment "Level 1 recombines notes where the harmony allows it; level 2 whole phrases; level 3 the sections. Classic 2 wanders, classic 4 copies long stretches." (pos 20 815))
  (obj c10 comment "The oracle at continuity 0.6 plays a few notes of the original, then jumps to another place that continues the last two types: Bach, rewritten." (pos 20 833))
  (connect lb 0 set 0)
  (connect lb 0 s1 0)
  (connect set 0 st 0)
  (connect s1 0 st 0)
  (connect s2 0 st 0)
  (connect st 0 prog 0)
  (connect st 2 pre 0)
  (connect pre 0 units 0)
  (connect st 1 ol 0)
  (connect ol 0 st 0)
  (connect co 0 m4 0)
  (connect m1 0 g 0)
  (connect m2 0 g 0)
  (connect m3 0 g 0)
  (connect m4 0 g 0)
  (connect l1 0 g 0)
  (connect l2 0 g 0)
  (connect l3 0 g 0)
  (connect gen 0 g 0)
  (connect st 1 gen 0)
  (connect g 0 gp 0)
  (connect rp 0 a0 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect stp 0 a0 0)
  (connect stp 0 a1 0)
  (connect g 1 p1 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 dac 0)
  (connect vca 0 dac 1)
  (connect li 0 ci 0)
  (connect ci 0 co 0)
  (connect li 0 ip 0)
  (connect ip 0 g 0)
  (connect li 0 sp1 0)
  (connect li 0 sp2 0)
  (connect sp1 0 po 0)
  (connect sp2 0 pg 0))
