; maple-hybrid.moritz - a sound rebuilt from other sounds (Maple's
; hybridisation). pursuit explains the target, segment by segment, with a
; few atoms of a dictionary: frames or whole notes of a clarinet (TinySOL,
; CC BY 4.0), or kitchen sounds; each atom slides to where it fits best and
; is subtracted, and the next is chosen on what is left. What comes out has
; the target's rhythm and contour, played by the dictionary. A book can
; also be rebuilt with the closest atoms of another dictionary (cross).
(patch
  (obj title comment "Hybridisation: a voice played by a clarinet (matching pursuit)" (pos 20 12))
  (obj sub comment "The dictionaries build when the patch opens (a few seconds). Choose a dictionary, then click a target: it is decomposed, then rebuilt." (pos 20 34))
  (obj t1 buffer~ mhvox sounds/Vox.wav (pos 20 65))
  (obj t2 buffer~ mhcage sounds/cage.wav (pos 230 65))
  (obj t3 buffer~ mhgtr sounds/Gambale_cut.wav (pos 440 65))
  (obj bk buffer~ mhbook (pos 760 65))
  (obj hy buffer~ mhhyb (pos 870 65))
  (obj cx buffer~ mhcross (pos 970 65))
  (obj c1 comment "1. Dictionaries: TinySOL clarinet notes (126: every pitch, pp mf ff) cut into 100 ms frames, or cut at their onsets; and kitchen sounds." (pos 20 100))
  (obj lb loadbang (pos 20 122))
  (obj m1 message "frames sounds/clarinet 100 50" (pos 20 150))
  (obj d1 atoms mhclar (pos 20 180))
  (obj m2 message "onsets sounds/clarinet 2 1500" (pos 260 150))
  (obj d2 atoms mhnotes (pos 260 180))
  (obj m3 message "onsets sounds/kitchen 2 1000" (pos 500 150))
  (obj d3 atoms mhkitchen (pos 500 180))
  (obj n1 number (pos 20 212))
  (obj cn1 comment "atoms" (pos 80 213))
  (obj n2 number (pos 260 212))
  (obj cn2 comment "atoms" (pos 320 213))
  (obj n3 number (pos 500 212))
  (obj cn3 comment "atoms" (pos 560 213))
  (obj cb comment "each atom: one frame or note" (pos 740 182))
  (obj c2 comment "2. Choose a dictionary (it also sets the pursuit for it):" (pos 20 250))
  (obj dm0 message mhclar (pos 20 275))
  (obj dt0 t s b (pos 120 275))
  (obj ds0 message "segments blocks, block 50, components 4, candidates 32" (pos 190 275))
  (obj dl0 comment "clarinet frames: the voice's contour, played by a clarinet" (pos 590 277))
  (obj dm1 message mhnotes (pos 20 305))
  (obj dt1 t s b (pos 120 305))
  (obj ds1 message "segments onsets, threshold 2, components 3, candidates 24" (pos 190 305))
  (obj dl1 comment "whole clarinet notes, a few on each syllable" (pos 590 307))
  (obj dm2 message mhkitchen (pos 20 335))
  (obj dt2 t s b (pos 120 335))
  (obj ds2 message "segments onsets, threshold 2, components 4, candidates 16" (pos 190 335))
  (obj dl2 comment "cups, lids and pans" (pos 590 337))
  (obj c3 comment "3. Click a target: decompose, then rebuild with the atoms found" (pos 20 375))
  (obj tv message mhvox (pos 20 400))
  (obj tc message mhcage (pos 110 400))
  (obj tb message mhgtr (pos 210 400))
  (obj ctg comment "a voice; John Cage speaking; a jazz guitar line (Frank Gambale)" (pos 310 402))
  (obj pk pack s s (pos 20 430))
  (obj run message "run $1 $2 mhbook" (pos 20 460))
  (obj an pursuit (pos 20 490))
  (obj prog flonum (pos 20 522))
  (obj na number (pos 90 522))
  (obj snr flonum (pos 160 522))
  (obj cpo comment "progress, atoms, signal to residual (dB)" (pos 230 523))
  (obj sset message "set synth mhbook $1 mhhyb" (pos 330 460))
  (obj sy message "synth mhbook mhclar mhhyb" (pos 330 490))
  (obj syn pursuit (pos 330 560))
  (obj wt message "set $1" (pos 600 460))
  (obj c4 comment "4. Rebuild differently (then click the synth message above):" (pos 20 600))
  (obj op0 message "keep 0.1" (pos 20 625))
  (obj op1 message "keep 1" (pos 105 625))
  (obj op2 message "tails 0" (pos 190 625))
  (obj op3 message "tails 1" (pos 275 625))
  (obj op4 message "ratio 0.5" (pos 360 625))
  (obj op5 message "ratio 1" (pos 445 625))
  (obj op6 message "stretch 2" (pos 530 625))
  (obj op7 message "stretch 1" (pos 615 625))
  (obj cop comment "only the strongest 10% of the atoms; atoms stopped where they matched; an octave lower; twice as slow" (pos 20 652))
  (obj c5 comment "5. Cross: the same book rebuilt with the closest atoms of another dictionary" (pos 20 690))
  (obj x1s message "set cross mhbook $1 mhkitchen mhcross" (pos 20 715))
  (obj x2s message "set cross mhbook $1 mhnotes mhcross" (pos 330 715))
  (obj x1 message "cross mhbook mhclar mhkitchen mhcross" (pos 20 745))
  (obj x2 message "cross mhbook mhclar mhnotes mhcross" (pos 330 745))
  (obj cl comment "listen: the target, the hybrid, the cross" (pos 20 790))
  (obj p0 message start (pos 20 812))
  (obj p1 message start (pos 110 812))
  (obj p2 message start (pos 200 812))
  (obj stp message stop (pos 290 812))
  (obj a0 play~ mhvox (pos 20 845))
  (obj a1 play~ mhhyb (pos 110 845))
  (obj a2 play~ mhcross (pos 200 845))
  (obj mix +~ (pos 20 880))
  (obj vca *~ 0.5 (pos 20 910))
  (obj out dac~ (pos 20 945))
  (obj l2 loadbang (pos 1000 100))
  (obj sc message "ylog 1, title atoms: time and spectral centroid (colour: level)" (pos 720 250))
  (obj map plot mhbook 420 250 scatter (pos 720 280))
  (obj c9 comment "Each dot is an atom: when, how bright, how loud." (pos 720 540))
  (obj c10 comment "Original Maple, with the same clarinet dictionary, is the reference for these settings." (pos 720 558))
  (connect lb 0 m1 0)
  (connect m1 0 d1 0)
  (connect d1 1 m2 0)
  (connect m2 0 d2 0)
  (connect d2 1 m3 0)
  (connect m3 0 d3 0)
  (connect d1 2 n1 0)
  (connect d2 2 n2 0)
  (connect d3 2 n3 0)
  (connect dm0 0 dt0 0)
  (connect dt0 1 ds0 0)
  (connect dm1 0 dt1 0)
  (connect dt1 1 ds1 0)
  (connect dm2 0 dt2 0)
  (connect dt2 1 ds2 0)
  (connect dt0 0 pk 1)
  (connect dt1 0 pk 1)
  (connect dt2 0 pk 1)
  (connect tv 0 pk 0)
  (connect tc 0 pk 0)
  (connect tb 0 pk 0)
  (connect pk 0 run 0)
  (connect ds0 0 an 0)
  (connect ds1 0 an 0)
  (connect ds2 0 an 0)
  (connect run 0 an 0)
  (connect an 0 prog 0)
  (connect an 2 na 0)
  (connect an 3 snr 0)
  (connect dt0 0 sset 0)
  (connect dt1 0 sset 0)
  (connect dt2 0 sset 0)
  (connect sset 0 sy 0)
  (connect an 1 sy 0)
  (connect sy 0 syn 0)
  (connect tv 0 wt 0)
  (connect tc 0 wt 0)
  (connect tb 0 wt 0)
  (connect op0 0 syn 0)
  (connect op1 0 syn 0)
  (connect op2 0 syn 0)
  (connect op3 0 syn 0)
  (connect op4 0 syn 0)
  (connect op5 0 syn 0)
  (connect op6 0 syn 0)
  (connect op7 0 syn 0)
  (connect dt0 0 x1s 0)
  (connect dt0 0 x2s 0)
  (connect dt1 0 x1s 0)
  (connect dt1 0 x2s 0)
  (connect dt2 0 x1s 0)
  (connect dt2 0 x2s 0)
  (connect x1s 0 x1 0)
  (connect x2s 0 x2 0)
  (connect x1 0 syn 0)
  (connect x2 0 syn 0)
  (connect wt 0 a0 0)
  (connect p0 0 a0 0)
  (connect stp 0 a0 0)
  (connect p1 0 a1 0)
  (connect stp 0 a1 0)
  (connect p2 0 a2 0)
  (connect stp 0 a2 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect a2 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect l2 0 sc 0)
  (connect sc 0 map 0))
