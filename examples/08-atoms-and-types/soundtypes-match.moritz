; soundtypes-match.moritz - one sound played with the sounds of another
; (SoundTypes' rematch). Both sounds are analysed into types; every unit of
; A is replaced by the closest of B, in the closest type, each sound's
; features measured against its own range. At level 0 every frame of A
; becomes a grain of B overlap-added in its place (the original SoundTypes
; rematch); at level 1 unit by unit, at level 2 gesture by gesture. With
; contour, the result takes A's loudness: John Cage's speech, its rhythm
; and phrasing, made of the Beach Boys.
(patch
  (obj title comment "Rematch: John Cage speaking with the sounds of the Beach Boys" (pos 20 12))
  (obj sub comment "The sounds are analysed when the patch opens (a second). Click a pair, then listen to A and to the match; move contour and level." (pos 20 34))
  (obj b1 buffer~ smcage cage.wav (pos 20 65))
  (obj b2 buffer~ smbb beachboys.wav (pos 250 65))
  (obj b3 buffer~ smvox Vox.wav (pos 500 65))
  (obj b4 buffer~ smbach Bach_Prelude_Dmajor.flac (pos 700 65))
  (obj out buffer~ smout (pos 20 95))
  (obj lab buffer~ smlab (pos 130 95))
  (obj c1 comment "1. Each sound becomes a sequence of types: frames of 186 ms every 46 ms, clustered by timbre (MFCCs, brightness, level); runs of a type are units." (pos 20 130))
  (obj lb loadbang (pos 20 152))
  (obj set message "types 32 16, size 8192, hop 2048" (pos 100 152))
  (obj a1 message "analyse smcage" (pos 20 180))
  (obj a2 message "analyse smbb" (pos 170 180))
  (obj a3 message "analyse smvox" (pos 320 180))
  (obj a4 message "analyse smbach" (pos 470 180))
  (obj s1 soundtypes smCage (pos 20 210))
  (obj s2 soundtypes smBB (pos 170 210))
  (obj s3 soundtypes smVox (pos 320 210))
  (obj s4 soundtypes smBach (pos 470 210))
  (obj c2 comment "2. Every frame (or unit) of A is replaced by the closest of B, in the closest type; each sound measured against its own range, so B's brightest stands for A's brightest." (pos 20 255))
  (obj r0 message "run smCage smBB smout smlab" (pos 20 280))
  (obj w0 message "; smA set smcage" (pos 250 280))
  (obj cr0 comment "Cage played with the Beach Boys" (pos 380 282))
  (obj r1 message "run smBB smCage smout smlab" (pos 20 308))
  (obj w1 message "; smA set smbb" (pos 250 308))
  (obj cr1 comment "the Beach Boys played with Cage's voice" (pos 380 310))
  (obj r2 message "run smVox smBach smout smlab" (pos 20 336))
  (obj w2 message "; smA set smvox" (pos 250 336))
  (obj cr2 comment "a voice played with a Bach prelude" (pos 380 338))
  (obj r3 message "run smBach smVox smout smlab" (pos 20 364))
  (obj w3 message "; smA set smbach" (pos 250 364))
  (obj cr3 comment "the prelude played with the voice" (pos 380 366))
  (obj cct comment "contour (A's loudness)" (pos 20 400))
  (obj ct slider 0. 1. (pos 20 420))
  (obj ctm message "contour $1" (pos 20 450))
  (obj clv comment "level" (pos 200 400))
  (obj l0 message "level 0" (pos 200 420))
  (obj l1 message "level 1" (pos 260 420))
  (obj l2 message "level 2" (pos 320 420))
  (obj clv2 comment "0: frame by frame (grains overlapped); 1: unit by unit; 2: gesture by gesture" (pos 200 450))
  (obj f1 message "fit 1" (pos 400 420))
  (obj f0 message "fit 0" (pos 450 420))
  (obj cf comment "units at A's timing, or at B's lengths" (pos 500 422))
  (obj crr comment "(click the pair again after a change)" (pos 20 478))
  (obj tm typematch (pos 20 505))
  (obj prog flonum (pos 20 537))
  (obj li loadbang (pos 700 100))
  (obj ci message "0.5" (pos 700 130))
  (obj il message "level 0" (pos 760 130))
  (obj cl comment "3. Listen: A, the match" (pos 20 580))
  (obj p0 message start (pos 20 602))
  (obj p1 message start (pos 100 602))
  (obj stp message stop (pos 180 602))
  (obj ra receive smA (pos 20 632))
  (obj pa play~ smcage (pos 20 662))
  (obj pb play~ smout (pos 120 662))
  (obj mix +~ (pos 20 697))
  (obj vca *~ 0.6 (pos 20 727))
  (obj dac dac~ (pos 20 762))
  (obj l9 loadbang (pos 1100 280))
  (obj sp message "colors types, title the types of B chosen for A's units" (pos 640 300))
  (obj pl plot smlab 440 60 (pos 640 330))
  (obj pw plot smout 440 110 (pos 640 400))
  (obj c9 comment "The match starts playing when it is ready." (pos 640 520))
  (obj c10 comment "Level 0 is a texture of B following A; levels 1 and 2 splice B's units and gestures." (pos 640 538))
  (connect lb 0 set 0)
  (connect set 0 s1 0)
  (connect set 0 s2 0)
  (connect set 0 s3 0)
  (connect set 0 s4 0)
  (connect lb 0 a1 0)
  (connect a1 0 s1 0)
  (connect s1 1 a2 0)
  (connect a2 0 s2 0)
  (connect s2 1 a3 0)
  (connect a3 0 s3 0)
  (connect s3 1 a4 0)
  (connect a4 0 s4 0)
  (connect r0 0 tm 0)
  (connect r0 0 w0 0)
  (connect r1 0 tm 0)
  (connect r1 0 w1 0)
  (connect r2 0 tm 0)
  (connect r2 0 w2 0)
  (connect r3 0 tm 0)
  (connect r3 0 w3 0)
  (connect ct 0 ctm 0)
  (connect ctm 0 tm 0)
  (connect l0 0 tm 0)
  (connect l1 0 tm 0)
  (connect l2 0 tm 0)
  (connect f1 0 tm 0)
  (connect f0 0 tm 0)
  (connect tm 0 prog 0)
  (connect li 0 ci 0)
  (connect ci 0 ct 0)
  (connect li 0 il 0)
  (connect il 0 tm 0)
  (connect ra 0 pa 0)
  (connect p0 0 pa 0)
  (connect p1 0 pb 0)
  (connect stp 0 pa 0)
  (connect stp 0 pb 0)
  (connect pa 0 mix 0)
  (connect pb 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 dac 0)
  (connect vca 0 dac 1)
  (connect tm 1 p1 0)
  (connect l9 0 sp 0)
  (connect sp 0 pl 0))
