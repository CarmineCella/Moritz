; soundtypes-atoms.moritz - sound types made of atoms: Maple and SoundTypes
; together. A voice is decomposed by pursuit into clarinet atoms;
; soundtypes groups the frames of that book (which atoms sound when) into
; types, and typegen makes a new sequence that is rebuilt from the atoms
; themselves, not cut from a recording. The second chain does the same with
; Gabor atoms of a guitar line. Each step starts when the one before is done.
(patch
  (obj title comment "Types of atoms: pursuit, then sound types, then new sequences rebuilt from atoms" (pos 20 12))
  (obj sub comment "Chain 1 runs when the patch opens (a few seconds); chain 2 when you click it. Listen to the book's types in a new order." (pos 20 34))
  (obj v buffer~ savox sounds/Vox.wav (pos 20 65))
  (obj d buffer~ sagtr sounds/Gambale_cut.wav (pos 230 65))
  (obj bk1 buffer~ sabook1 (pos 470 65))
  (obj bk2 buffer~ sabook2 (pos 580 65))
  (obj o1 buffer~ saout1 (pos 690 65))
  (obj o2 buffer~ saout2 (pos 800 65))
  (obj lab buffer~ salab (pos 910 65))
  (obj c1 comment "1  the voice in clarinet atoms" (pos 20 100))
  (obj lb loadbang (pos 20 120))
  (obj k1 message "frames sounds/clarinet 100 50" (pos 20 150))
  (obj at1 atoms saclar (pos 20 180))
  (obj r1 message "segments blocks, block 50, components 4, candidates 32, run savox saclar sabook1" (pos 20 210))
  (obj pu1 pursuit (pos 20 240))
  (obj a1 message "analyse sabook1 saclar" (pos 20 270))
  (obj st1 soundtypes saA (pos 20 300))
  (obj g1m message "oracle 0.6 1, generate 20 saout1 salab" (pos 20 330))
  (obj g1 typegen saA (pos 20 360))
  (obj c2 comment "2  a guitar line in Gabor atoms" (pos 600 100))
  (obj b2 button (pos 600 120))
  (obj k2 message "gabor 128 4096" (pos 600 150))
  (obj at2 atoms sagabor (pos 600 180))
  (obj r2 message "atoms 2000, run sagtr sagabor sabook2" (pos 600 210))
  (obj pu2 pursuit (pos 600 240))
  (obj a2 message "analyse sabook2 sagabor" (pos 600 270))
  (obj st2 soundtypes saB (pos 600 300))
  (obj g2m message "markov 3 2, generate 12 saout2" (pos 600 330))
  (obj g2 typegen saB (pos 600 360))
  (obj p1 flonum (pos 20 395))
  (obj p2 flonum (pos 600 395))
  (obj cpl comment "listen: the voice, chain 1, the guitar, chain 2" (pos 20 420))
  (obj l0 message start (pos 20 445))
  (obj l1 message start (pos 125 445))
  (obj l2 message start (pos 230 445))
  (obj l3 message start (pos 345 445))
  (obj stp message stop (pos 450 445))
  (obj q0 play~ savox (pos 20 478))
  (obj q1 play~ saout1 (pos 125 478))
  (obj q2 play~ sagtr (pos 230 478))
  (obj q3 play~ saout2 (pos 345 478))
  (obj mix +~ (pos 20 513))
  (obj vca *~ 0.5 (pos 20 543))
  (obj out dac~ (pos 20 578))
  (obj l9 loadbang (pos 1000 100))
  (obj sp message "colors types, title chain 1: the new sequence's types (levels 1 and 2)" (pos 560 450))
  (obj pl plot salab 430 80 (pos 560 480))
  (obj sm message "ylog 1, title chain 1: the book of the voice in clarinet atoms" (pos 560 580))
  (obj pm plot sabook1 430 170 scatter (pos 560 610))
  (obj c9 comment "The units are rebuilt from the atoms of the book (pursuit's synthesis), so the new sequence has no cuts: atoms ring on across units." (pos 20 800))
  (connect lb 0 k1 0)
  (connect k1 0 at1 0)
  (connect at1 1 r1 0)
  (connect r1 0 pu1 0)
  (connect pu1 1 a1 0)
  (connect a1 0 st1 0)
  (connect st1 1 g1m 0)
  (connect g1m 0 g1 0)
  (connect g1 0 p1 0)
  (connect b2 0 k2 0)
  (connect k2 0 at2 0)
  (connect at2 1 r2 0)
  (connect r2 0 pu2 0)
  (connect pu2 1 a2 0)
  (connect a2 0 st2 0)
  (connect st2 1 g2m 0)
  (connect g2m 0 g2 0)
  (connect g2 0 p2 0)
  (connect l0 0 q0 0)
  (connect l1 0 q1 0)
  (connect l2 0 q2 0)
  (connect l3 0 q3 0)
  (connect stp 0 q0 0)
  (connect stp 0 q1 0)
  (connect stp 0 q2 0)
  (connect stp 0 q3 0)
  (connect q0 0 mix 0)
  (connect q1 0 mix 0)
  (connect q2 0 mix 0)
  (connect q3 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect l9 0 sp 0)
  (connect l9 0 sm 0)
  (connect sp 0 pl 0)
  (connect sm 0 pm 0))
