; soundtypes-mixing.moritz - mixing the levels of sound types. typegen
; generates a sequence of units at one level (the form: notes, phrases or
; sections of a Bach prelude); with inner, every unit is then played with
; the level below regenerated: an oracle walk of continuity c from its
; first sub-unit, down to the notes. Six recipes show what each mixture
; does: new surfaces, phrases in a new order, a shuffled form, the form of
; Bach with new detail. Bach, Well-Tempered Clavier I, Kimiko Ishizaka
; (CC0).
; topic: Music information retrieval
(patch
  (obj title comment "Mixing levels: the form of one level, the detail of another" (pos 20 12))
  (obj sub comment "The prelude is analysed when the patch opens. Click a recipe: it generates 40 s and plays it. Compare them, then make your own with the controls." (pos 20 34))
  (obj b1 buffer~ stmbach sounds/Bach_Prelude_Cminor.flac (pos 20 65))
  (obj out buffer~ stmout (pos 330 65))
  (obj lab buffer~ stmlab (pos 430 65))
  (obj olab buffer~ stmolab (pos 530 65))
  (obj lb loadbang (pos 20 100))
  (obj an message "segment onsets 1.5 0.08, pitch 1, types 16 8 4, levels 3, analyse stmbach" (pos 100 100))
  (obj st soundtypes stmmodel (pos 20 130))
  (obj ol message "labels stmolab" (pos 180 130))
  (obj prog flonum (pos 20 160))
  (obj c1 comment "Recipes (all with the oracle; continuity 0.5 at the level generated):" (pos 20 200))
  (obj r0 message "level 1, inner 1, oracle 0.5 2, generate 40 stmout stmlab" (pos 20 225))
  (obj cr0 comment "1. notes recombined: a new surface, no phrasing of its own" (pos 460 227))
  (obj r1 message "level 2, inner 1, oracle 0.5 2, generate 40 stmout stmlab" (pos 20 253))
  (obj cr1 comment "2. whole phrases recombined: Bach's phrases in a new order" (pos 460 255))
  (obj r2 message "level 3, inner 1, oracle 0.5 1, generate 40 stmout stmlab" (pos 20 281))
  (obj cr2 comment "3. sections recombined: the large form shuffled, the inside intact" (pos 460 283))
  (obj r3 message "level 2, inner 0.5 2, oracle 0.5 2, generate 40 stmout stmlab" (pos 20 309))
  (obj cr3 comment "4. the order of phrases from level 2, the notes inside each regenerated" (pos 460 311))
  (obj r4 message "level 3, inner 0.4 2, oracle 0.7 1, generate 40 stmout stmlab" (pos 20 337))
  (obj cr4 comment "5. the form from level 3; phrases and notes below it varied" (pos 460 339))
  (obj r5 message "level 2, inner 0, oracle 1 1, generate 40 stmout stmlab" (pos 20 365))
  (obj cr5 comment "6. the original phrase plan, every phrase rebuilt from scratch" (pos 460 367))
  (obj cyo comment "or your own:" (pos 20 450))
  (obj cl comment "level" (pos 20 472))
  (obj l1 message "level 1" (pos 70 470))
  (obj l2 message "level 2" (pos 135 470))
  (obj l3 message "level 3" (pos 200 470))
  (obj cc comment "continuity at that level" (pos 20 500))
  (obj co slider 0. 1. (pos 20 520))
  (obj com message "oracle $1 2" (pos 20 550))
  (obj ci comment "continuity of the levels below (inner)" (pos 200 500))
  (obj ic slider 0. 1. (pos 200 520))
  (obj icm message "inner $1 2" (pos 200 550))
  (obj gmy message "generate 40 stmout stmlab" (pos 400 550))
  (obj g typegen stmmodel (pos 20 590))
  (obj gp flonum (pos 20 620))
  (obj seed message "seed $1" (pos 200 590))
  (obj sn number (pos 200 620))
  (obj csn comment "another seed: another piece from the same recipe" (pos 260 621))
  (obj cpl comment "Listen: the original, the new piece (it starts when ready)" (pos 20 660))
  (obj p0 message start (pos 20 682))
  (obj p1 message start (pos 110 682))
  (obj stp message stop (pos 200 682))
  (obj a0 play~ stmbach (pos 20 712))
  (obj a1 play~ stmout (pos 120 712))
  (obj mix +~ (pos 20 747))
  (obj vca *~ 0.5 (pos 20 777))
  (obj dac dac~ (pos 20 812))
  (obj li loadbang (pos 700 100))
  (obj iv1 message 0.5 (pos 700 130))
  (obj iv2 message 1 (pos 780 130))
  (obj sp1 message "colors types, title the prelude: notes phrases sections" (pos 420 660))
  (obj sp2 message "colors types, title the new piece" (pos 860 660))
  (obj po plot stmolab 420 140 (pos 420 690))
  (obj pg plot stmlab 420 140 (pos 860 690))
  (obj c9 comment "In the plots, read the top band (sections) against the bottom one (notes): recipe 3 keeps the bottom bands of the original in long blocks;" (pos 20 850))
  (obj c10 comment "recipe 5 keeps the top band's order but changes everything beneath. inner 1 leaves the units as they are; 0 rebuilds them freely." (pos 20 868))
  (obj c11 comment "A unit keeps its first sub-unit and its number of sub-units, so phrases still begin as Bach's did and last about as long." (pos 20 886))
  (connect lb 0 an 0)
  (connect an 0 st 0)
  (connect st 1 ol 0)
  (connect ol 0 st 0)
  (connect st 0 prog 0)
  (connect r0 0 g 0)
  (connect r1 0 g 0)
  (connect r2 0 g 0)
  (connect r3 0 g 0)
  (connect r4 0 g 0)
  (connect r5 0 g 0)
  (connect co 0 com 0)
  (connect ic 0 icm 0)
  (connect l1 0 g 0)
  (connect l2 0 g 0)
  (connect l3 0 g 0)
  (connect com 0 g 0)
  (connect icm 0 g 0)
  (connect gmy 0 g 0)
  (connect g 0 gp 0)
  (connect sn 0 seed 0)
  (connect seed 0 g 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect stp 0 a0 0)
  (connect stp 0 a1 0)
  (connect g 1 p1 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 dac 0)
  (connect vca 0 dac 1)
  (connect li 0 iv1 0)
  (connect li 0 iv2 0)
  (connect iv1 0 co 0)
  (connect iv2 0 ic 0)
  (connect li 0 sp1 0)
  (connect li 0 sp2 0)
  (connect sp1 0 po 0)
  (connect sp2 0 pg 0))
