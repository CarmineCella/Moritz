; soundtypes-match.moritz - one sound played with the types of another
; (SoundTypes' rematch). Both sounds are analysed into types; every unit of
; the first is replaced by a unit of the second of the closest type, the
; one closest in length. At level 1 the replacement goes sound by sound;
; at level 2 gesture by gesture: the first sound's phrasing made of the
; second's gestures. With fit 1 the result keeps the first sound's timing.
; topic: Music information retrieval
(patch
  (obj title comment "Rematch: a voice played with the sounds of drums, of a march, of a prelude" (pos 20 12))
  (obj sub comment "The sounds are analysed when the patch opens (a few seconds). Choose the pair and the level, then listen to A and to the match." (pos 20 34))
  (obj b1 buffer~ smvox sounds/Vox.wav (pos 20 65))
  (obj b2 buffer~ smdrums sounds/drums.wav (pos 230 65))
  (obj b3 buffer~ smmarch sounds/Sousa_StarsAndStripes.flac (pos 440 65))
  (obj b4 buffer~ smbach sounds/Bach_Prelude_Dmajor.flac (pos 740 65))
  (obj out buffer~ smout (pos 740 95))
  (obj lab buffer~ smlab (pos 840 95))
  (obj lb loadbang (pos 20 100))
  (obj a1 message "analyse smvox" (pos 20 165))
  (obj a2 message "analyse smdrums" (pos 165 165))
  (obj a3 message "analyse smmarch" (pos 320 165))
  (obj a4 message "analyse smbach" (pos 470 165))
  (obj s1 soundtypes smVox (pos 20 195))
  (obj s2 soundtypes smDrums (pos 165 195))
  (obj s3 soundtypes smMarch (pos 320 195))
  (obj s4 soundtypes smBach (pos 470 195))
  (obj cp comment "A with B:" (pos 20 245))
  (obj r1 message "run smVox smDrums smout smlab" (pos 20 330))
  (obj r2 message "run smVox smMarch smout smlab" (pos 20 357))
  (obj r3 message "run smVox smBach smout smlab" (pos 20 384))
  (obj r4 message "run smBach smVox smout smlab" (pos 20 411))
  (obj cr comment "the voice with drums, the march, the prelude; the prelude with the voice" (pos 290 357))
  (obj cl comment "level:" (pos 20 270))
  (obj lv number 1 (pos 70 268))
  (obj lvm message "level $1" (pos 70 298))
  (obj clv comment "1 sounds, 2 gestures (then click a pair)" (pos 130 270))
  (obj f1 message "fit 1" (pos 20 445))
  (obj f0 message "fit 0" (pos 70 445))
  (obj cf comment "at A's timing, or at B's own lengths" (pos 120 446))
  (obj tm typematch (pos 20 480))
  (obj prog flonum (pos 20 515))
  (obj done button (pos 90 515))
  (obj cpl comment "listen:" (pos 20 555))
  (obj p0 message start (pos 75 553))
  (obj p1 message start (pos 155 553))
  (obj stp message stop (pos 235 553))
  (obj cpl2 comment "A, the match" (pos 290 555))
  (obj ra receive smA (pos 75 583))
  (obj pa play~ smvox (pos 75 613))
  (obj pb play~ smout (pos 155 613))
  (obj mix +~ (pos 75 648))
  (obj vca *~ 0.5 (pos 75 678))
  (obj o dac~ (pos 75 713))
  (obj w1 message "; smA set smvox" (pos 20 790))
  (obj w2 message "; smA set smbach" (pos 140 790))
  (obj l9 loadbang (pos 900 130))
  (obj sp message "colors types, title B's types over A's units" (pos 620 160))
  (obj pl plot smlab 400 60 (pos 620 230))
  (obj pw plot smout 400 100 (pos 620 300))
  (obj c9 comment "Level 2 keeps longer stretches of B (whole gestures) where A's gestures resemble them: B speaks A's phrasing." (pos 20 755))
  (connect lb 0 a1 0)
  (connect s1 1 a2 0)
  (connect s2 1 a3 0)
  (connect s3 1 a4 0)
  (connect a1 0 s1 0)
  (connect a2 0 s2 0)
  (connect a3 0 s3 0)
  (connect a4 0 s4 0)
  (connect lv 0 lvm 0)
  (connect lvm 0 tm 0)
  (connect r1 0 tm 0)
  (connect r2 0 tm 0)
  (connect r3 0 tm 0)
  (connect r4 0 tm 0)
  (connect r1 0 w1 0)
  (connect r2 0 w1 0)
  (connect r3 0 w1 0)
  (connect r4 0 w2 0)
  (connect s4 1 r1 0)
  (connect f1 0 tm 0)
  (connect f0 0 tm 0)
  (connect tm 0 prog 0)
  (connect tm 1 done 0)
  (connect p0 0 pa 0)
  (connect p1 0 pb 0)
  (connect stp 0 pa 0)
  (connect stp 0 pb 0)
  (connect ra 0 pa 0)
  (connect pa 0 mix 0)
  (connect pb 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 o 0)
  (connect vca 0 o 1)
  (connect l9 0 sp 0)
  (connect sp 0 pl 0))
