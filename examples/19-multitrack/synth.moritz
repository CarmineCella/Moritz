; synth.moritz - an instrument patch (the synth track's, in session.score): each note of its track comes into its inlet
; as "note pitch velocity duration-ms"; what it plays goes out of outlet~ 1 and 2 into the track (its strip, its sends).
; One voice here; for chords, put the voice in an abstraction and play it with poly~ (the note message is poly~'s).
(patch
  (obj title comment "instrument: a note in (note pitch velocity ms), a sound out" (pos 20 12))
  (obj in inlet (pos 20 50))
  (obj r route note (pos 20 85))
  (obj u unpack 0 0 0 (pos 20 120))
  (obj t t b f (pos 20 155))
  (obj m mtof (pos 140 190))
  (obj o cycle~ (pos 140 225))
  (obj o2 cycle~ (pos 260 225))
  (obj x2 * 2.01 (pos 260 190))
  (obj g *~ 0.3 (pos 260 260))
  (obj e message "0.25 8, 0.12 120, 0 600" (pos 20 190))
  (obj l line~ (pos 20 225))
  (obj s +~ (pos 140 300))
  (obj v *~ (pos 20 340))
  (obj ol outlet~ 1 (pos 20 390))
  (obj or outlet~ 2 (pos 140 390))
  (connect in 0 r 0)
  (connect r 0 u 0)
  (connect u 0 t 0)
  (connect t 1 m 0)
  (connect m 0 o 0)
  (connect m 0 x2 0)
  (connect x2 0 o2 0)
  (connect o2 0 g 0)
  (connect o 0 s 0)
  (connect g 0 s 1)
  (connect t 0 e 0)
  (connect e 0 l 0)
  (connect l 0 v 0)
  (connect s 0 v 1)
  (connect v 0 ol 0)
  (connect v 0 or 0))
