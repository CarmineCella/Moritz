; clusters.moritz - kmeans learns the sounds of a drum loop by itself, then
; plays the loop back with new drums. Every 6 ms descriptors~ measures the
; frame's level (rms), brightness (centroid), noisiness (flatness) and zero
; crossings. For the first two passes (8 s) the frames are added to kmeans;
; then it trains 4 clusters (the console shows their sizes): kicks, hats,
; silence and the decays, though nobody told it so. From then on, at every
; hit (a jump in level) the sound 12 ms later is classified (at the hit
; itself every drum starts with the same bright click), and the brightness
; of its cluster's centroid picks the new sound: dark = kick, middle =
; snare, bright = hat. This loop has one snare per bar: too few frames for
; a cluster of its own, so kmeans counts it with the kicks. Mix the original
; and the replacement to compare.
(patch
  (obj title comment "kmeans: a drum loop classified into clusters it learnt by itself, then replayed with synthesized drums" (pos 20 12))
  (obj buf buffer~ cldrums sounds/drums.wav (pos 20 40))
  (obj lb loadbang (pos 240 40))
  (obj lp message "loop 1, 0" (pos 220 75))
  (obj one sig~ 1 (pos 320 75))
  (obj gr groove~ cldrums (pos 20 75))
  (obj d descriptors~ 1024 256 rms centroid flatness zcr (pos 20 115))
  (obj pk pack 0 0 0 0 (pos 20 150))
  (obj mode gate 2 1 (pos 20 185))
  (obj cmode comment "1 learning, 2 playing" (pos 110 186))
  (obj add message "add $1 $2 $3 $4" (pos 20 220))
  (obj km kmeans (pos 250 290))
  (obj both t l l (pos 250 220))
  (obj again button (pos 470 40))
  (obj cagain comment "learn again" (pos 500 43))
  (obj t1 t b b b (pos 470 75))
  (obj clr message clear (pos 470 110))
  (obj lm message 1 (pos 535 110))
  (obj wait delay 8100 (pos 580 110))
  (obj t2 t b b (pos 580 145))
  (obj play message 2 (pos 580 185))
  (obj tr message "train 4" (pos 640 185))
  (obj cls number (pos 250 325))
  (obj ccls comment "cluster of the frame" (pos 310 326))
  (obj cent unpack 0 0 0 0 (pos 450 325))
  (obj kind expr "($f2 > 1500) + ($f2 > 4000)" (pos 450 360))
  (obj ckind comment "its brightness: 0 kick, 1 snare, 2 hat" (pos 450 390))
  (obj store i (pos 250 465))
  (obj late delay 12 (pos 250 430))
  (obj clate comment "12 ms after the hit" (pos 330 431))
  (obj level unpack 0 0 0 0 (pos 20 290))
  (obj rt t f f (pos 20 325))
  (obj onset expr "$f1 > 1.6 * $f2 && $f1 > 0.03" (pos 20 360))
  (obj hit sel 1 (pos 20 395))
  (obj open gate 1 1 (pos 20 430))
  (obj lock t b b (pos 20 465))
  (obj shut message 0 (pos 110 500))
  (obj rest delay 80 (pos 180 465))
  (obj reopen message 1 (pos 180 500))
  (obj which sel 0 1 2 (pos 250 500))
  (obj lk button (pos 250 540))
  (obj ls button (pos 300 540))
  (obj lh button (pos 350 540))
  (obj cl comment "kick snare hat" (pos 250 570))
  (obj ke1 message "1, 0 180" (pos 450 470))
  (obj ke2 message "130, 45 60" (pos 530 470))
  (obj kenv line~ (pos 450 505))
  (obj kf line~ (pos 530 505))
  (obj kosc cycle~ (pos 530 540))
  (obj kick *~ (pos 450 575))
  (obj se message "1, 0 120" (pos 620 470))
  (obj senv line~ (pos 620 505))
  (obj noise noise~ (pos 700 505))
  (obj sn *~ (pos 620 575))
  (obj he message "1, 0 35" (pos 760 470))
  (obj henv line~ (pos 760 505))
  (obj hpf svf~ 8000 0.3 (pos 700 540))
  (obj ht *~ (pos 760 575))
  (obj new +~ (pos 450 615))
  (obj nlev *~ 0.5 (pos 450 650))
  (obj m1 message 0 (pos 20 615))
  (obj m2 message 0.5 (pos 60 615))
  (obj m3 message 1 (pos 110 615))
  (obj cm comment "0 original .. 1 replacement" (pos 150 616))
  (obj mix line~ (pos 20 650))
  (obj inv expr~ "1 - $v1" (pos 20 685))
  (obj orig *~ (pos 160 685))
  (obj rep *~ (pos 450 685))
  (obj sum +~ (pos 160 720))
  (obj on message "0.5 50" (pos 20 760))
  (obj off message "0 50" (pos 85 760))
  (obj cv comment "volume" (pos 140 761))
  (obj ramp line~ (pos 20 795))
  (obj vca *~ (pos 160 795))
  (obj out dac~ (pos 160 830))
  (obj init message 0.5 (pos 330 40))
  (connect lb 0 lp 0)
  (connect lb 0 t1 0)
  (connect lb 0 init 0)
  (connect init 0 mix 0)
  (connect lp 0 gr 0)
  (connect one 0 gr 0)
  (connect gr 0 d 0)
  (connect d 0 pk 0)
  (connect d 1 pk 1)
  (connect d 2 pk 2)
  (connect d 3 pk 3)
  (connect pk 0 mode 1)
  (connect mode 0 add 0)
  (connect add 0 km 0)
  (connect mode 1 both 0)
  (connect both 1 km 0)
  (connect both 0 level 0)
  (connect again 0 t1 0)
  (connect t1 2 clr 0)
  (connect t1 1 lm 0)
  (connect t1 0 wait 0)
  (connect clr 0 km 0)
  (connect lm 0 mode 0)
  (connect wait 0 t2 0)
  (connect t2 1 tr 0)
  (connect t2 0 play 0)
  (connect tr 0 km 0)
  (connect play 0 mode 0)
  (connect km 0 cls 0)
  (connect km 1 cent 0)
  (connect cent 1 kind 1)
  (connect cent 0 kind 0)
  (connect kind 0 store 1)
  (connect level 0 rt 0)
  (connect rt 1 onset 0)
  (connect rt 0 onset 1)
  (connect onset 0 hit 0)
  (connect hit 0 open 1)
  (connect open 0 lock 0)
  (connect lock 1 late 0)
  (connect late 0 store 0)
  (connect lock 0 shut 0)
  (connect lock 0 rest 0)
  (connect shut 0 open 0)
  (connect rest 0 reopen 0)
  (connect reopen 0 open 0)
  (connect store 0 which 0)
  (connect which 0 lk 0)
  (connect which 1 ls 0)
  (connect which 2 lh 0)
  (connect lk 0 ke1 0)
  (connect lk 0 ke2 0)
  (connect ke1 0 kenv 0)
  (connect ke2 0 kf 0)
  (connect kf 0 kosc 0)
  (connect kosc 0 kick 0)
  (connect kenv 0 kick 1)
  (connect ls 0 se 0)
  (connect se 0 senv 0)
  (connect noise 0 sn 0)
  (connect senv 0 sn 1)
  (connect lh 0 he 0)
  (connect he 0 henv 0)
  (connect noise 0 hpf 0)
  (connect hpf 1 ht 0)
  (connect henv 0 ht 1)
  (connect kick 0 new 0)
  (connect sn 0 new 0)
  (connect ht 0 new 0)
  (connect new 0 nlev 0)
  (connect nlev 0 rep 0)
  (connect m1 0 mix 0)
  (connect m2 0 mix 0)
  (connect m3 0 mix 0)
  (connect mix 0 rep 1)
  (connect mix 0 inv 0)
  (connect inv 0 orig 1)
  (connect gr 0 orig 0)
  (connect orig 0 sum 0)
  (connect rep 0 sum 1)
  (connect sum 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
