; grain.mlsp - an abstraction: one grain voice for granulator.mlsp.
;   grain <phase 0..1> <buffer name>
; A phasor~ (offset by #1) drives a Hann window and the read position.
; sah~ picks a new random position each time the phasor wraps.
; Shared settings arrive by receive: grain-rate, grain-pitch, grain-pos,
; grain-spread.
(patch
  (obj c0 comment "grain #1 #2: phase offset, buffer~ name" (pos 20 10))
  (obj rrate r grain-rate (pos 20 40))
  (obj rpitch r grain-pitch (pos 160 40))
  (obj rpos r grain-pos (pos 300 40))
  (obj rspread r grain-spread (pos 440 40))
  (obj ph phasor~ 10 (pos 20 85))
  (obj off expr~ "fmod($v1 + #1, 1)" (pos 20 125))
  (obj c1 comment "this voice's grain clock, 0..1" (pos 200 112))
  (obj win expr~ "0.5 - 0.5 * cos(2 * pi * $v1)" (pos 20 375))
  (obj trig expr~ "1 - $v1" (pos 200 175))
  (obj nz noise~ (pos 340 175))
  (obj hold sah~ 0.5 (pos 340 215))
  (obj c2 comment "new random offset per grain" (pos 420 216))
  (obj where expr~ "max(0, $v1 * 1000 / max($v2, 0.1) * $v3 + $v4 + $v5 * $v6)" (pos 180 265))
  (obj c3 comment "ms = clock * grain length * pitch + position + offset * spread" (pos 180 293))
  (obj rd play~ #2 (pos 180 330))
  (obj vca *~ (pos 20 420))
  (obj out outlet~ (pos 20 460))
  (connect rrate 0 ph 0)
  (connect rrate 0 where 1)
  (connect rpitch 0 where 2)
  (connect rpos 0 where 3)
  (connect rspread 0 where 5)
  (connect ph 0 off 0)
  (connect off 0 win 0)
  (connect off 0 trig 0)
  (connect off 0 where 0)
  (connect nz 0 hold 0)
  (connect trig 0 hold 1)
  (connect hold 0 where 4)
  (connect where 0 rd 0)
  (connect rd 0 vca 1)
  (connect win 0 vca 0)
  (connect vca 0 out 0))
