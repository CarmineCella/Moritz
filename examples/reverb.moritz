; reverb.moritz - a Schroeder reverb: four comb~ filters in parallel, then
; two allpass~ in series. sfplay~ plays the drums every 4.5 seconds.
; topic: Filters and effects
(patch
  (obj title comment "Schroeder reverb: 4 x comb~ in parallel -> 2 x allpass~" (pos 20 12))
  (obj lb loadbang (pos 20 40))
  (obj tog toggle (pos 20 75))
  (obj open message "open sounds/drums.wav" (pos 120 75))
  (obj met metro 4500 (pos 20 115))
  (obj go message 1 (pos 20 150))
  (obj sf sfplay~ (pos 20 190))
  (obj cb1 comb~ 50 29.7 1 0 0.84 (pos 20 240))
  (obj cb2 comb~ 50 37.1 1 0 0.83 (pos 180 240))
  (obj cb3 comb~ 50 41.1 1 0 0.82 (pos 340 240))
  (obj cb4 comb~ 50 43.7 1 0 0.81 (pos 500 240))
  (obj sum *~ 0.25 (pos 20 290))
  (obj ap1 allpass~ 20 5 0.7 (pos 20 330))
  (obj ap2 allpass~ 20 1.7 0.7 (pos 20 370))
  (obj wet *~ 0.5 (pos 20 410))
  (obj dry *~ 0.4 (pos 200 410))
  (obj out dac~ (pos 20 460))
  (obj lvl meter~ (pos 250 450))
  (connect lb 0 tog 0)
  (connect lb 0 open 0)
  (connect tog 0 met 0)
  (connect met 0 go 0)
  (connect go 0 sf 0)
  (connect open 0 sf 0)
  (connect sf 0 cb1 0)
  (connect sf 0 cb2 0)
  (connect sf 0 cb3 0)
  (connect sf 0 cb4 0)
  (connect cb1 0 sum 0)
  (connect cb2 0 sum 0)
  (connect cb3 0 sum 0)
  (connect cb4 0 sum 0)
  (connect sum 0 ap1 0)
  (connect ap1 0 ap2 0)
  (connect ap2 0 wet 0)
  (connect sf 0 dry 0)
  (connect wet 0 out 0)
  (connect wet 0 out 1)
  (connect dry 0 out 0)
  (connect dry 0 out 1)
  (connect wet 0 lvl 0))
