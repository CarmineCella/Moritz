; cycle~.help.moritz - help for cycle~
(patch
  (obj title comment "cycle~ [freq]: cosine oscillator (512-point table, interpolated)" (pos 20 12))
  (obj sub comment "Left inlet: frequency in Hz, a float or a signal. Right inlet: phase 0-1, restarts the cycle there." (pos 20 34))
  (obj f220 message 220 (pos 20 70))
  (obj f440 message 440 (pos 70 70))
  (obj f880 message 880 (pos 120 70))
  (obj freq flonum 440 (pos 20 105))
  (obj cf comment "frequency (Hz): drag or click a message" (pos 110 106))
  (obj osc cycle~ 440 (pos 20 145))
  (obj ph message 0 (pos 120 145))
  (obj cph comment "restart the phase at 0" (pos 160 146))
  (obj sc scope~ (pos 380 70))
  (obj on message "0.15 50" (pos 20 195))
  (obj off message "0 50" (pos 90 195))
  (obj cv comment "volume on / off" (pos 150 196))
  (obj ramp line~ (pos 20 230))
  (obj vca *~ (pos 20 265))
  (obj out dac~ (pos 20 305))
  (obj lfo comment "A slow cycle~ is an LFO: cycle~ 2 -> *~ 100 -> +~ 440 -> cycle~ gives vibrato." (pos 20 345))
  (connect f220 0 freq 0)
  (connect f440 0 freq 0)
  (connect f880 0 freq 0)
  (connect freq 0 osc 0)
  (connect ph 0 osc 1)
  (connect osc 0 sc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
