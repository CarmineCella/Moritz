; snapshot~.help.moritz - help for snapshot~ and peakamp~
(patch
  (obj title comment "snapshot~ [ms]: a signal's value as a number.   peakamp~ [ms]: its peak level since the last report" (pos 20 12))
  (obj sub comment "Bang reports now. A number (in either inlet, or interval ms) reports every ms while audio runs; 0 = only on bang." (pos 20 34))
  (obj sub2 comment "snapshot~ gives the last sample of the latest 64-sample vector; peakamp~ the largest absolute value since it last reported." (pos 20 52))
  (obj lfo cycle~ 0.5 (pos 20 80))
  (obj clfo comment "a slow LFO, -1 to 1" (pos 100 81))
  (obj bng button (pos 120 115))
  (obj cbng comment "now" (pos 145 116))
  (obj i0 message 0 (pos 200 115))
  (obj i100 message 100 (pos 240 115))
  (obj i500 message 500 (pos 288 115))
  (obj snap snapshot~ 100 (pos 20 160))
  (obj ci comment "every ms" (pos 334 116))
  (obj val flonum (pos 20 195))
  (obj cval comment "the LFO's value" (pos 112 196))
  (obj pluck message "1 5 0 800" (pos 400 80))
  (obj cpl comment "strike" (pos 480 81))
  (obj env line~ (pos 400 115))
  (obj osc cycle~ 330 (pos 480 115))
  (obj vco *~ (pos 400 150))
  (obj peak peakamp~ 100 (pos 500 185))
  (obj pk flonum (pos 500 220))
  (obj cpk comment "peak of each 100 ms" (pos 590 221))
  (obj on message "0.15 50" (pos 400 265))
  (obj off message "0 50" (pos 470 265))
  (obj cv comment "volume on / off" (pos 530 266))
  (obj ramp line~ (pos 400 300))
  (obj vca *~ (pos 400 335))
  (obj out dac~ (pos 400 375))
  (obj e1 comment "Reports every ms happen only while audio is on." (pos 20 265))
  (obj e2 comment "A bang works any time: with audio off it" (pos 20 283))
  (obj e3 comment "repeats the last value." (pos 20 301))
  (obj e4 comment "peakamp~ restarts from 0 after each report, so" (pos 20 330))
  (obj e5 comment "it shows the envelope falling, 100 ms at a time." (pos 20 348))
  (connect lfo 0 snap 0)
  (connect bng 0 snap 0)
  (connect i0 0 snap 1)
  (connect i100 0 snap 1)
  (connect i500 0 snap 1)
  (connect snap 0 val 0)
  (connect pluck 0 env 0)
  (connect env 0 vco 0)
  (connect osc 0 vco 1)
  (connect vco 0 peak 0)
  (connect peak 0 pk 0)
  (connect vco 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
