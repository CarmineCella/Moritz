; metro.help.moritz - help for metro
(patch
  (obj title comment "metro [ms]: repeating bang, every ms milliseconds (500 by default)" (pos 20 12))
  (obj sub comment "Left inlet: 1, bang or start starts it (the first bang comes at once); 0 or stop stops it." (pos 20 34))
  (obj sub2 comment "Right inlet: the interval in ms. Ticks are scheduled at absolute times, so they don't drift." (pos 20 52))
  (obj tog toggle (pos 20 85))
  (obj ctog comment "on / off" (pos 50 87))
  (obj stop message stop (pos 120 85))
  (obj i100 message 100 (pos 260 85))
  (obj i250 message 250 (pos 305 85))
  (obj i1000 message 1000 (pos 350 85))
  (obj ival number 250 (pos 260 120))
  (obj cival comment "interval (ms): used from the next tick on" (pos 325 121))
  (obj met metro 250 (pos 20 160))
  (obj flash button (pos 20 205))
  (obj cnt counter (pos 110 205))
  (obj ticks number (pos 110 240))
  (obj cticks comment "counts the ticks: 0, 1, 2 ..." (pos 175 241))
  (obj clk click~ (pos 340 205))
  (obj on message "0.15 50" (pos 450 205))
  (obj off message "0 50" (pos 520 205))
  (obj cv comment "volume on / off" (pos 575 206))
  (obj ramp line~ (pos 450 240))
  (obj vca *~ (pos 340 280))
  (obj out dac~ (pos 340 320))
  (obj cclk comment "each tick plays a click" (pos 390 321))
  (obj tip comment "A new interval does not cut the current tick short: the bang already scheduled comes first." (pos 20 365))
  (connect tog 0 met 0)
  (connect stop 0 met 0)
  (connect i100 0 ival 0)
  (connect i250 0 ival 0)
  (connect i1000 0 ival 0)
  (connect ival 0 met 1)
  (connect met 0 flash 0)
  (connect met 0 cnt 0)
  (connect cnt 0 ticks 0)
  (connect met 0 clk 0)
  (connect clk 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
