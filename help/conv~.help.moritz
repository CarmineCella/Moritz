; conv~.help.moritz - help for conv~ and condec
(patch
  (obj title comment "conv~ buffer [channels]: convolution with an impulse response, no latency.   condec: (de)convolution of buffers" (pos 20 12))
  (obj sub comment "Channel c uses the response's channel c (or its last); an unconnected inlet takes the channel before. Normalised to unit energy." (pos 20 34))
  (obj sub2 comment "condec: conv x h out [scale mix] or deconv y h out [threshold scale] writes into the buffer~ out, then bangs." (pos 20 52))
  (obj hall buffer~ helphall hall_concertgebouw.wav (pos 20 85))
  (obj fl buffer~ helpfl ../data/Beethoven_Symph7.wav (pos 290 85))
  (obj vx buffer~ helpvx ../data/Vox.wav (pos 420 125))
  (obj play message start (pos 20 125))
  (obj stp message stop (pos 80 125))
  (obj pl play~ helpfl (pos 20 160))
  (obj cv conv~ helphall 2 (pos 20 200))
  (obj cc comment "Beethoven in the hall" (pos 150 201))
  (obj wet *~ 0.3 (pos 20 240))
  (obj wetr *~ 0.3 (pos 120 240))
  (obj ml +~ (pos 20 280))
  (obj mr +~ (pos 120 280))
  (obj on message "0.2 50" (pos 20 320))
  (obj off message "0 50" (pos 85 320))
  (obj cv2 comment "volume" (pos 140 321))
  (obj ramp line~ (pos 20 355))
  (obj vl *~ (pos 20 390))
  (obj vr *~ (pos 120 390))
  (obj out dac~ (pos 20 430))
  (obj w buffer~ helpwet (pos 420 160))
  (obj d buffer~ helpdry (pos 560 160))
  (obj c1 message "conv helpvx helphall helpwet 0.05" (pos 420 200))
  (obj c2 message "deconv helpwet helphall helpdry 0.001 20" (pos 420 235))
  (obj cd condec (pos 420 275))
  (obj done button (pos 420 310))
  (obj ccd comment "1: reverberate the voice offline; 2: take the hall out again" (pos 420 345))
  (obj pw message start (pos 420 380))
  (obj pd message start (pos 560 380))
  (obj pww play~ helpwet 2 (pos 420 415))
  (obj pdd play~ helpdry (pos 560 415))
  (obj cpl comment "hear the wet result, then the recovered dry voice" (pos 420 450))
  (connect play 0 pl 0)
  (connect stp 0 pl 0)
  (connect pl 0 cv 0)
  (connect cv 0 wet 0)
  (connect cv 1 wetr 0)
  (connect wet 0 ml 0)
  (connect wetr 0 mr 0)
  (connect c1 0 cd 0)
  (connect c2 0 cd 0)
  (connect cd 0 done 0)
  (connect pw 0 pww 0)
  (connect pd 0 pdd 0)
  (connect pww 0 ml 1)
  (connect pww 1 mr 1)
  (connect pdd 0 ml 1)
  (connect pdd 0 mr 1)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect ml 0 vl 0)
  (connect mr 0 vr 0)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
