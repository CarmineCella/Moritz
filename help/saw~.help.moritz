; saw~.help.moritz - help for saw~, rect~ and tri~
(patch
  (obj title comment "saw~ [freq], rect~ [freq duty], tri~ [freq slope]: sawtooth, pulse and triangle, from -1 to 1" (pos 20 12))
  (obj sub comment "Left inlet: frequency in Hz, a float or a signal. Right inlet of rect~: duty cycle 0-1; of tri~: slope 0-1." (pos 20 34))
  (obj sub2 comment "Duty and slope default to 0.5 and are kept within 0.01-0.99. saw~ and rect~ are band-limited (PolyBLEP); tri~ is not." (pos 20 52))
  (obj f1 message 55 (pos 20 85))
  (obj f2 message 110 (pos 60 85))
  (obj f3 message 220 (pos 100 85))
  (obj cduty comment "rect~ duty" (pos 270 86))
  (obj cslope comment "tri~ slope" (pos 400 86))
  (obj freq flonum 110 (pos 20 120))
  (obj cf comment "frequency (Hz)" (pos 82 121))
  (obj duty flonum 0.5 (pos 270 120))
  (obj slope flonum 0.5 (pos 400 120))
  (obj s1 message 1 (pos 20 160))
  (obj s2 message 2 (pos 60 160))
  (obj s3 message 3 (pos 100 160))
  (obj saw saw~ 110 (pos 150 160))
  (obj rect rect~ 110 0.5 (pos 230 160))
  (obj tri tri~ 110 0.5 (pos 360 160))
  (obj sel selector~ 3 1 (pos 20 205))
  (obj csel comment "1 = saw~, 2 = rect~, 3 = tri~" (pos 130 209))
  (obj sc scope~ (pos 480 240))
  (obj on message "0.15 50" (pos 200 270))
  (obj off message "0 50" (pos 270 270))
  (obj cv comment "volume on / off" (pos 330 271))
  (obj ramp line~ (pos 200 305))
  (obj vca *~ (pos 20 340))
  (obj out dac~ (pos 20 380))
  (obj tip comment "tri~ slope 0.01 or 0.99 turns the triangle into a falling or rising ramp." (pos 20 420))
  (connect f1 0 freq 0)
  (connect f2 0 freq 0)
  (connect f3 0 freq 0)
  (connect freq 0 saw 0)
  (connect freq 0 rect 0)
  (connect freq 0 tri 0)
  (connect duty 0 rect 1)
  (connect slope 0 tri 1)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect saw 0 sel 1)
  (connect rect 0 sel 2)
  (connect tri 0 sel 3)
  (connect sel 0 sc 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
