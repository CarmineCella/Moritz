; count~.help.moritz - help for count~
(patch
  (obj title comment "count~ [min max loop]: sample counter" (pos 20 12))
  (obj sub comment "bang counts from min, a number counts from that value, stop stops (the output holds). It adds 1 every sample." (pos 20 34))
  (obj sub2 comment "At max it wraps to min (loop 1, default) or stops there (loop 0); with no max it never wraps. It feeds index~ and poke~." (pos 20 52))
  (obj b1 message bang (pos 20 80))
  (obj f1 message 22050 (pos 70 80))
  (obj x1 message stop (pos 130 80))
  (obj c1 count~ 0 44100 0 (pos 20 115))
  (obj cc1 comment "counts from 0 to 44100 (one second at 44.1 kHz), then stops" (pos 150 116))
  (obj sn1 snapshot~ 50 (pos 20 150))
  (obj n1 number (pos 20 185))
  (obj cn1 comment "the count" (pos 85 186))
  (obj b2 message bang (pos 20 240))
  (obj x2 message stop (pos 70 240))
  (obj c2 count~ 0 44100 (pos 20 275))
  (obj cc2 comment "loops 0 to 44099: a one-second ramp, again and again" (pos 130 276))
  (obj div /~ 44100 (pos 20 310))
  (obj sn2 snapshot~ 50 (pos 130 345))
  (obj n2 flonum (pos 130 380))
  (obj cn2 comment "ramp, 0 to 1" (pos 215 381))
  (obj mul *~ 400 (pos 20 345))
  (obj add +~ 200 (pos 20 380))
  (obj osc cycle~ (pos 20 415))
  (obj cosc comment "as a pitch sweep, 200 to 600 Hz" (pos 85 416))
  (obj on message "0.15 50" (pos 330 415))
  (obj off message "0 50" (pos 400 415))
  (obj cv comment "volume on / off" (pos 460 416))
  (obj ramp line~ (pos 330 450))
  (obj vca *~ (pos 20 455))
  (obj out dac~ (pos 20 490))
  (connect b1 0 c1 0)
  (connect f1 0 c1 0)
  (connect x1 0 c1 0)
  (connect c1 0 sn1 0)
  (connect sn1 0 n1 0)
  (connect b2 0 c2 0)
  (connect x2 0 c2 0)
  (connect c2 0 div 0)
  (connect div 0 mul 0)
  (connect div 0 sn2 0)
  (connect sn2 0 n2 0)
  (connect mul 0 add 0)
  (connect add 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
