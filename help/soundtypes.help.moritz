; soundtypes.help.moritz - help for soundtypes
(patch
  (obj title comment "soundtypes name: a sound as a sequence of types, at several levels (after SoundTypes)" (pos 20 12))
  (obj sub comment "Level 1: the frames (MFCCs, centroid, level) clustered into types; runs of one type are units. Level 2: units grouped into gestures where" (pos 20 34))
  (obj sub2 comment "the next type is surprising, then clustered; level 3 the same over gestures. typegen makes new sequences, typematch rematches sounds." (pos 20 52))
  (obj src buffer~ hstdrums ../examples/sounds/drums.wav (pos 20 85))
  (obj lab buffer~ hstlab (pos 280 85))
  (obj tr buffer~ hsttr (pos 400 85))
  (obj bach buffer~ hstbach ../examples/sounds/Bach_Prelude_Dmajor.flac (pos 510 85))
  (obj lb loadbang (pos 20 115))
  (obj an message "types 8 4 3, levels 3, analyse hstdrums" (pos 20 145))
  (obj st soundtypes hstdrums (pos 20 180))
  (obj prog flonum (pos 20 215))
  (obj done button (pos 90 215))
  (obj units message "" (pos 130 215))
  (obj cu comment "units per level" (pos 230 216))
  (obj t1 t b b (pos 20 250))
  (obj w1 message "labels hstlab" (pos 20 280))
  (obj w2 message "transitions 1 hsttr" (pos 130 280))
  (obj pre prepend set (pos 130 250))
  (obj l1 loadbang (pos 560 115))
  (obj s1 message "colors types, labels 1 2 3, title types at three levels (a colour a type)" (pos 330 145))
  (obj strips plot hstlab 600 110 (pos 330 175))
  (obj w plot hstdrums 600 60 (pos 330 290))
  (obj l2 loadbang (pos 20 330))
  (obj s2 message "title level 1 transitions: from (rows) to (columns)" (pos 20 360))
  (obj tm plot hsttr 220 220 (pos 20 395))
  (obj cp comment "a unit of type k at a level: start end (ms)" (pos 330 375))
  (obj lv number 1 (pos 330 395))
  (obj ty number 0 (pos 390 395))
  (obj clv comment "level, type" (pos 450 396))
  (obj tt t b f (pos 390 425))
  (obj pk pack 1 0 (pos 330 455))
  (obj pm message "play $1 $2" (pos 330 485))
  (obj pl message "start $1 $2" (pos 330 520))
  (obj play play~ hstdrums 2 (pos 330 550))
  (obj vca *~ 0.5 (pos 330 585))
  (obj out dac~ (pos 330 620))
  (obj c5 comment "segment onsets [threshold gap]: level 1 is made of the notes between onsets (as in SoundTypes), not of runs of frames; pitch 1 adds the pitch classes:" (pos 20 655))
  (obj on message "segment onsets, pitch 1, types 12 6 4, levels 3, analyse hstbach" (pos 20 680))
  (obj ps message "set hstbach" (pos 480 680))
  (obj fr message "segment frames, pitch 0, types 8 4 3, analyse hstdrums" (pos 20 710))
  (obj pd message "set hstdrums" (pos 420 710))
  (obj c6 comment "a Bach prelude by notes, phrases and sections; back to the drums by frames" (pos 560 696))
  (obj c3 comment "Other messages: threshold z (how surprising a boundary: 1), smooth n (frames, 5), size n, hop n, seed n," (pos 20 745))
  (obj c4 comment "analyse book dictionary (types of atoms: see pursuit), write file (the units as text: tokens for later models), info." (pos 20 763))
  (connect lb 0 an 0)
  (connect on 0 st 0)
  (connect fr 0 st 0)
  (connect on 0 ps 0)
  (connect fr 0 pd 0)
  (connect ps 0 play 0)
  (connect pd 0 play 0)
  (connect an 0 st 0)
  (connect st 0 prog 0)
  (connect st 1 done 0)
  (connect st 2 pre 0)
  (connect pre 0 units 0)
  (connect st 1 t1 0)
  (connect t1 1 w1 0)
  (connect t1 0 w2 0)
  (connect w1 0 st 0)
  (connect w2 0 st 0)
  (connect l1 0 s1 0)
  (connect s1 0 strips 0)
  (connect l2 0 s2 0)
  (connect s2 0 tm 0)
  (connect lv 0 pk 0)
  (connect ty 0 tt 0)
  (connect tt 1 pk 1)
  (connect tt 0 lv 0)
  (connect pk 0 pm 0)
  (connect pm 0 st 0)
  (connect st 3 pl 0)
  (connect pl 0 play 0)
  (connect play 0 vca 0)
  (connect play 1 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
