; cartopol~.help.moritz - help for cartopol~ and poltocar~
(patch
  (obj title comment "cartopol~: real and imaginary to amplitude and phase.   poltocar~: amplitude and phase back to real and imaginary" (pos 20 12))
  (obj sub comment "They convert sample by sample, so in a pfft~ they convert every bin. The phase is in radians, -pi to pi." (pos 20 34))
  (obj sub2 comment "Their inlets need signals: a number sent to them is ignored, so use sig~." (pos 20 52))
  (obj lb loadbang (pos 20 80))
  (obj buf buffer~ helpcp ../examples/sounds/Vox.wav (pos 100 80))
  (obj init message "loop 1, 0" (pos 20 115))
  (obj rate sig~ 1 (pos 110 115))
  (obj gr groove~ helpcp (pos 20 150))
  (obj cgr comment "Vox.wav, looping" (pos 120 151))
  (obj m0 message 0 (pos 330 110))
  (obj c0 comment "original phases: the voice" (pos 365 111))
  (obj m1 message 1 (pos 330 137))
  (obj c1 comment "fixed phases: a robot at the frame rate (44100 / 256 = 172 Hz)" (pos 365 138))
  (obj m2 message 2 (pos 330 164))
  (obj c2 comment "random phases: a whisper" (pos 365 165))
  (obj pf pfft~ help-cartopol 1024 4 (pos 20 210))
  (obj cpf comment "cartopol~ -> new phase -> poltocar~ inside" (pos 190 211))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj cm comment "On plain signals: 3 + 4i has amplitude 5 and phase 0.927 (53 degrees)." (pos 300 280))
  (obj re flonum 3 (pos 300 305))
  (obj im flonum 4 (pos 390 305))
  (obj cri comment "real, imaginary" (pos 460 306))
  (obj sre sig~ 3 (pos 300 340))
  (obj sim sig~ 4 (pos 390 340))
  (obj cp cartopol~ (pos 300 375))
  (obj sa snapshot~ 100 (pos 300 410))
  (obj sp snapshot~ 100 (pos 410 410))
  (obj amp flonum (pos 300 445))
  (obj pha flonum (pos 410 445))
  (obj cap comment "amplitude, phase" (pos 495 446))
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect rate 0 gr 0)
  (connect gr 0 pf 0)
  (connect m0 0 pf 1)
  (connect m1 0 pf 1)
  (connect m2 0 pf 1)
  (connect pf 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect re 0 sre 0)
  (connect im 0 sim 0)
  (connect sre 0 cp 0)
  (connect sim 0 cp 1)
  (connect cp 0 sa 0)
  (connect cp 1 sp 0)
  (connect sa 0 amp 0)
  (connect sp 0 pha 0))
