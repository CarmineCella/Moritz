; hpss.help.moritz - help for hpss
(patch
  (obj title comment "hpss [kernel] [size]: harmonic/percussive separation of a buffer~" (pos 20 12))
  (obj sub comment "Median filters on the spectrogram: along time keeps sustained (harmonic) sounds, along frequency keeps attacks (percussive)." (pos 20 34))
  (obj sub2 comment "run source harmonic percussive writes two buffer~s that add up to the source. kernel: filter length (odd, 17). Outlets: progress, bang." (pos 20 52))
  (obj src buffer~ helphpsrc ../examples/sounds/hpss_demo.wav (pos 20 85))
  (obj hb buffer~ helpharm (pos 340 85))
  (obj pb buffer~ helpperc (pos 460 85))
  (obj run message "run helphpsrc helpharm helpperc" (pos 20 120))
  (obj k1 message "kernel 9" (pos 250 120))
  (obj k2 message "kernel 31" (pos 320 120))
  (obj ck comment "longer kernels separate more" (pos 400 121))
  (obj hp hpss (pos 20 155))
  (obj prog flonum (pos 20 195))
  (obj done button (pos 100 195))
  (obj cp comment "progress, done" (pos 130 198))
  (obj w1 waveform~ helpharm 300 60 (pos 390 160))
  (obj w2 waveform~ helpperc 300 60 (pos 390 230))
  (obj p0 message start (pos 20 240))
  (obj p1 message start (pos 140 240))
  (obj p2 message start (pos 260 240))
  (obj cpl comment "original, harmonic, percussive" (pos 390 300))
  (obj o play~ helphpsrc (pos 20 270))
  (obj h play~ helpharm (pos 140 270))
  (obj p play~ helpperc (pos 260 270))
  (obj mix +~ (pos 20 330))
  (obj on message "0.3 50" (pos 20 370))
  (obj off message "0 50" (pos 85 370))
  (obj cv comment "volume" (pos 140 371))
  (obj ramp line~ (pos 20 405))
  (obj vca *~ (pos 160 405))
  (obj out dac~ (pos 160 440))
  (connect run 0 hp 0)
  (connect k1 0 hp 0)
  (connect k2 0 hp 0)
  (connect hp 0 prog 0)
  (connect hp 1 done 0)
  (connect p0 0 o 0)
  (connect p1 0 h 0)
  (connect p2 0 p 0)
  (connect o 0 mix 0)
  (connect h 0 mix 0)
  (connect p 0 mix 0)
  (connect mix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
