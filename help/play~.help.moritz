; play~.help.moritz - help for play~
(patch
  (obj title comment "play~ name [channels]: play a buffer~" (pos 20 12))
  (obj sub comment "start plays it once; start from, or start from to (ms), plays a part. bang = start, stop stops, set name changes the buffer~." (pos 20 34))
  (obj sub2 comment "With a signal in its inlet it does not play by itself: it reads the buffer~ at that position in ms, e.g. a line~ ramp." (pos 20 52))
  (obj buf buffer~ helpplay ../examples/sounds/voice.wav (pos 20 80))
  (obj m1 message start (pos 20 120))
  (obj m2 message "start 1500" (pos 72 120))
  (obj m3 message "start 500 1500" (pos 152 120))
  (obj m4 message stop (pos 262 120))
  (obj pl1 play~ helpplay (pos 20 160))
  (obj c1 comment "plays once" (pos 120 161))
  (obj cr comment "position ramps (ms): normal, half speed, backwards" (pos 400 86))
  (obj r1 message "0, 4000 4000" (pos 400 120))
  (obj r2 message "0, 4000 8000" (pos 495 120))
  (obj r3 message "4000, 0 4000" (pos 590 120))
  (obj ln line~ (pos 400 160))
  (obj pl2 play~ helpplay (pos 400 200))
  (obj snap snapshot~ 50 (pos 520 200))
  (obj pos flonum (pos 520 240))
  (obj cpos comment "position (ms)" (pos 585 241))
  (obj on message "0.15 50" (pos 150 210))
  (obj off message "0 50" (pos 220 210))
  (obj cv comment "volume on / off" (pos 280 211))
  (obj ramp line~ (pos 150 245))
  (obj vl *~ (pos 20 285))
  (obj vr *~ (pos 400 285))
  (obj out dac~ (pos 20 330))
  (obj note comment "play~ interpolates and follows the file's own sample rate, so it plays at the right pitch." (pos 20 375))
  (connect m1 0 pl1 0)
  (connect m2 0 pl1 0)
  (connect m3 0 pl1 0)
  (connect m4 0 pl1 0)
  (connect r1 0 ln 0)
  (connect r2 0 ln 0)
  (connect r3 0 ln 0)
  (connect ln 0 pl2 0)
  (connect ln 0 snap 0)
  (connect snap 0 pos 0)
  (connect pl1 0 vl 0)
  (connect pl2 0 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vl 0 out 1)
  (connect vr 0 out 0)
  (connect vr 0 out 1))
