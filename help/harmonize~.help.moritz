; harmonize~.help.moritz - help for harmonize~
(patch
  (obj title comment "harmonize~ [voices] [latency-ms] [separate]: a vocal harmonizer (reVoice's), the engine of Musil's harmonize" (pos 20 12))
  (obj sub comment "Copies of the voice at other pitches, made of grains of its own periods (PSOLA): the formants stay, each copy keeps the voice's level." (pos 20 34))
  (obj sub2 comment "Modes: intervals (semitones), scale (steps of key and scale from the sung note), midi-chord (held notes), midi-root (the last note is the root)." (pos 20 52))
  (obj lb loadbang (pos 20 85))
  (obj open message "open ../data/Vox.wav, loop 1, 1" (pos 20 115))
  (obj stop message 0 (pos 230 115))
  (obj sf sfplay~ (pos 20 150))
  (obj cin comment "or a microphone: adc~ into the left inlet" (pos 120 151))
  (obj m1 message "mode intervals, intervals 4 7 12 -12" (pos 20 195))
  (obj m2 message "mode scale, key C, scale major, intervals 2 4 -3" (pos 20 225))
  (obj m3 message "mode midi-chord" (pos 20 255))
  (obj m4 message "mode midi-root, intervals 0 4 7 12" (pos 140 255))
  (obj ck comment "midi modes: play chords on the keys" (pos 400 256))
  (obj ks kslider 3 48 1 (pos 400 280))
  (obj v1 message "vibrato 18 5.5 0.4, humanize 8 25" (pos 20 290))
  (obj v0 message "vibrato 0, humanize 0 0" (pos 255 290))
  (obj f1 message "formant 1.15" (pos 20 320))
  (obj f0m message "formant 1" (pos 120 320))
  (obj tr message "transpose -12" (pos 200 320))
  (obj t0 message "transpose 0" (pos 300 320))
  (obj mx message "mix 1 0.7" (pos 20 350))
  (obj mx2 message "mix 0 1" (pos 100 350))
  (obj cmx comment "dry and harmony levels" (pos 170 351))
  (obj hz harmonize~ 4 (pos 20 400))
  (obj f0 flonum 0 (pos 300 440))
  (obj cf0 comment "f0 detected (Hz)" (pos 370 441))
  (obj gl *~ 0.4 (pos 20 440))
  (obj gr *~ 0.4 (pos 120 440))
  (obj out dac~ (pos 20 480))
  (obj more comment "Also: voice k level|pan|formant|interval|vibrato ..., range lo hi, latency ms, threshold t, gate db, cycles n|auto, window w, unvoiced dry, seed n." (pos 20 520))
  (connect lb 0 open 0)
  (connect open 0 sf 0)
  (connect stop 0 sf 0)
  (connect sf 0 hz 0)
  (connect m1 0 hz 0)
  (connect m2 0 hz 0)
  (connect m3 0 hz 0)
  (connect m4 0 hz 0)
  (connect v1 0 hz 0)
  (connect v0 0 hz 0)
  (connect f1 0 hz 0)
  (connect f0m 0 hz 0)
  (connect tr 0 hz 0)
  (connect t0 0 hz 0)
  (connect mx 0 hz 0)
  (connect mx2 0 hz 0)
  (connect ks 1 hz 3)
  (connect ks 0 hz 2)
  (connect hz 0 gl 0)
  (connect hz 1 gr 0)
  (connect hz 2 f0 0)
  (connect gl 0 out 0)
  (connect gr 0 out 1))
