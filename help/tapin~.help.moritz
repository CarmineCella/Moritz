; tapin~.help.moritz - help for tapin~ and tapout~
(patch
  (obj title comment "tapin~ [max ms], tapout~ [ms ...]: a delay line, and taps that read it" (pos 20 12))
  (obj sub comment "tapin~ writes its input into a delay line (default 1000 ms, at most 60000); clear empties it. Connect it to tapout~'s left inlet." (pos 20 34))
  (obj sub2 comment "tapout~ has one tap per argument: each inlet sets the delay of its tap in ms (signal or float), and each outlet plays that tap." (pos 20 52))
  (obj lb loadbang (pos 20 82))
  (obj open message "open ../examples/sounds/drums.wav" (pos 20 120))
  (obj play message 1 (pos 290 120))
  (obj cplay comment "play the drums" (pos 332 124))
  (obj sf sfplay~ (pos 20 165))
  (obj tin tapin~ 2000 (pos 200 205))
  (obj cd comment "tap delays (ms)" (pos 100 220))
  (obj d1 flonum 250 (pos 100 240))
  (obj d2 flonum 375 (pos 320 240))
  (obj tout tapout~ 250 375 (pos 200 285))
  (obj fbk flonum 0.4 (pos 520 290))
  (obj cfbk comment "feedback" (pos 582 291))
  (obj fb *~ 0.4 (pos 450 330))
  (obj cfb comment "echoes repeat, quieter" (pos 500 334))
  (obj on message "0.2 50" (pos 300 380))
  (obj off message "0 50" (pos 365 380))
  (obj cv comment "volume on / off" (pos 425 381))
  (obj ramp line~ (pos 300 415))
  (obj vca *~ (pos 20 450))
  (obj out dac~ (pos 20 490))
  (obj tip comment "In a feedback loop the shortest delay is 64 samples. Keep the feedback below 1." (pos 90 494))
  (connect lb 0 open 0)
  (connect open 0 sf 0)
  (connect play 0 sf 0)
  (connect sf 0 tin 0)
  (connect tin 0 tout 0)
  (connect d1 0 tout 0)
  (connect d2 0 tout 1)
  (connect tout 0 fb 0)
  (connect fbk 0 fb 1)
  (connect fb 0 tin 0)
  (connect sf 0 vca 0)
  (connect tout 0 vca 0)
  (connect tout 1 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
