; comb~.help.moritz - help for comb~
(patch
  (obj title comment "comb~ [max delay a b c]: comb filter" (pos 20 12))
  (obj sub comment "y[n] = a x[n] + b x[n-D] + c y[n-D], where D is the delay in ms. Inlets: signal, delay, a, b, c (signals or floats)." (pos 20 34))
  (obj sub2 comment "Defaults: max 50 ms (up to 10000), delay max / 2, a 1, b 0, c 0.5. Keep c between -1 and 1. clear empties the filter." (pos 20 52))
  (obj btn button (pos 20 85))
  (obj cbtn comment "strike it" (pos 50 89))
  (obj d1 message 10 (pos 150 85))
  (obj d2 message 5 (pos 190 85))
  (obj d3 message 2.5 (pos 230 85))
  (obj c1 message 0.5 (pos 380 85))
  (obj c2 message 0.95 (pos 422 85))
  (obj c3 message 0.99 (pos 470 85))
  (obj c4 message -0.95 (pos 518 85))
  (obj del flonum 5 (pos 150 120))
  (obj cdel comment "delay (ms): pitch = 1000 / delay" (pos 212 121))
  (obj fb flonum 0.95 (pos 380 160))
  (obj cfb comment "c (feedback): higher rings longer" (pos 442 161))
  (obj clk click~ (pos 20 160))
  (obj f comb~ 50 5 1 0 0.95 (pos 20 210))
  (obj cf comment "-0.95 sounds an octave lower: only odd harmonics" (pos 200 214))
  (obj sc scope~ (pos 480 250))
  (obj on message "0.15 50" (pos 200 265))
  (obj off message "0 50" (pos 270 265))
  (obj cv comment "volume on / off" (pos 330 266))
  (obj ramp line~ (pos 200 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj tip comment "With b instead of c (no feedback) the comb~ adds one echo: a 1 b 1 c 0 notches out every odd multiple of 500 / delay Hz." (pos 20 415))
  (connect btn 0 clk 0)
  (connect d1 0 del 0)
  (connect d2 0 del 0)
  (connect d3 0 del 0)
  (connect c1 0 fb 0)
  (connect c2 0 fb 0)
  (connect c3 0 fb 0)
  (connect c4 0 fb 0)
  (connect clk 0 f 0)
  (connect del 0 f 1)
  (connect fb 0 f 4)
  (connect f 0 sc 0)
  (connect f 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
