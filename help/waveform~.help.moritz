; waveform~.help.moritz - help for waveform~
(patch
  (obj title comment "waveform~ name [width height]: show a buffer~ and select a region" (pos 20 12))
  (obj sub comment "In locked mode, drag across it to select; the outlets give the start and end in ms. Each channel gets its own lane." (pos 20 34))
  (obj sub2 comment "Inlet: a number draws a cursor there (ms); select start end sets the selection and outputs it; set name shows another buffer~." (pos 20 52))
  (obj bv buffer~ helpwave ../examples/sounds/voice.wav (pos 20 80))
  (obj bf buffer~ helpwave2 ../examples/sounds/flute.wav (pos 330 80))
  (obj sel message "select 1000 2000" (pos 20 120))
  (obj cur flonum (pos 150 120))
  (obj ccur comment "cursor (ms)" (pos 215 121))
  (obj s1 message "set helpwave" (pos 470 120))
  (obj s2 message "set helpwave2" (pos 570 120))
  (obj wf waveform~ helpwave 420 100 (pos 20 160))
  (obj ws flonum (pos 20 275))
  (obj cws comment "start / end (ms)" (pos 85 276))
  (obj we flonum (pos 380 275))
  (obj pk pack 0. 0. (pos 20 310))
  (obj setm message "set start $1 $2" (pos 20 345))
  (obj cset comment "writes them into the box below" (pos 135 346))
  (obj go message "start 0 0" (pos 20 380))
  (obj cgo comment "click: play the selection" (pos 140 381))
  (obj on message "0.15 50" (pos 590 380))
  (obj off message "0 50" (pos 655 380))
  (obj cv comment "volume on / off" (pos 590 352))
  (obj ramp line~ (pos 590 415))
  (obj pl play~ helpwave (pos 470 415))
  (obj cpl comment "set goes to play~ too" (pos 530 300))
  (obj vca *~ (pos 470 450))
  (obj out dac~ (pos 470 485))
  (connect s1 0 wf 0)
  (connect s2 0 wf 0)
  (connect s1 0 pl 0)
  (connect s2 0 pl 0)
  (connect sel 0 wf 0)
  (connect cur 0 wf 0)
  (connect wf 0 ws 0)
  (connect wf 1 we 0)
  (connect wf 1 pk 1)
  (connect wf 0 pk 0)
  (connect pk 0 setm 0)
  (connect setm 0 go 0)
  (connect go 0 pl 0)
  (connect pl 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
