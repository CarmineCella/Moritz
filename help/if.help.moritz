; if.help.moritz - help for if
(patch
  (obj title comment "if <condition> then <message> [else <message>]: choose a message by a condition, as in Max" (pos 20 12))
  (obj sub comment "The condition is written as in expr, over $i1..$i9 (integers) and $f1..$f9 (decimals): one inlet each, the left one hot." (pos 20 34))
  (obj sub2 comment "The messages are written like message boxes and use the same variables ($s1 is a word arriving at the left inlet)." (pos 20 52))
  (obj n number 3 (pos 20 90))
  (obj cn comment "drag me past 5" (pos 85 91))
  (obj i1 if $i1 > 5 then big $i1 else small (pos 20 130))
  (obj p1 print if (pos 20 170))
  (obj cp1 comment "the console shows big 6, big 7 ... or small" (pos 90 171))
  (obj s3 comment "out2 before a message sends it from a second outlet; send name sends it to receive name instead:" (pos 20 220))
  (obj a number 2 (pos 20 250))
  (obj b number 10 (pos 120 250))
  (obj cab comment "a, b (cold)" (pos 185 251))
  (obj i2 if $i1 < $i2 then $i1 else out2 $i2 (pos 20 290))
  (obj lo number (pos 20 330))
  (obj hi number (pos 200 330))
  (obj clo comment "a if a < b              else b, on the right" (pos 20 360))
  (obj f flonum 0.3 (pos 20 400))
  (obj i3 if $f1 >= 0.5 then send ifhelp loud else send ifhelp soft (pos 20 435))
  (obj r receive ifhelp (pos 20 475))
  (obj show message "-" (pos 20 510))
  (obj set message "set $1" (pos 130 475))
  (obj s4 comment "set 1 2 stores values without evaluating; bang evaluates again with the stored values." (pos 20 550))
  (connect n 0 i1 0)
  (connect i1 0 p1 0)
  (connect a 0 i2 0)
  (connect b 0 i2 1)
  (connect i2 0 lo 0)
  (connect i2 1 hi 0)
  (connect f 0 i3 0)
  (connect r 0 set 0)
  (connect set 0 show 0))
