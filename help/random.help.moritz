; random.help.moritz - help for random
(patch
  (obj title comment "random [n]: a random integer from 0 to n-1 (n is 2 by default)" (pos 20 12))
  (obj sub comment "Left inlet: bang outputs a new number; seed x restarts a repeatable sequence. Right inlet: n (stored)." (pos 20 34))
  (obj go button (pos 20 70))
  (obj cgo comment "roll" (pos 48 73))
  (obj seed message "seed 42" (pos 100 70))
  (obj cseed comment "after seed 42, the bangs give the same numbers every time" (pos 165 71))
  (obj n6 message 6 (pos 300 105))
  (obj n100 message 100 (pos 345 105))
  (obj range number 10 (pos 300 140))
  (obj crange comment "n (stored for the next bang)" (pos 365 141))
  (obj rnd random 10 (pos 20 180))
  (obj out number (pos 20 220))
  (obj cout comment "0 to n-1" (pos 85 221))
  (obj c2 comment "A die: random 6 gives 0..5, + 1 makes it 1..6." (pos 20 270))
  (obj go2 button (pos 20 295))
  (obj die random 6 (pos 20 330))
  (obj add + 1 (pos 20 365))
  (obj face number (pos 20 400))
  (obj cface comment "1 to 6" (pos 85 401))
  (connect go 0 rnd 0)
  (connect seed 0 rnd 0)
  (connect n6 0 range 0)
  (connect n100 0 range 0)
  (connect range 0 rnd 1)
  (connect rnd 0 out 0)
  (connect go2 0 die 0)
  (connect die 0 add 0)
  (connect add 0 face 0))
