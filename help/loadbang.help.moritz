; loadbang.help.moritz - help for loadbang
(patch
  (obj title comment "loadbang: sends a bang when the patch opens" (pos 20 12))
  (obj sub comment "Use it to set starting values. A bang in its inlet, or a double-click on it in locked mode, fires it again." (pos 20 34))
  (obj again button (pos 20 70))
  (obj cagain comment "fire it again" (pos 50 72))
  (obj lb loadbang (pos 20 110))
  (obj m1 message 0.5 (pos 20 155))
  (obj m2 message 1 (pos 130 155))
  (obj cnt counter 1 1000 (pos 230 155))
  (obj v1 flonum (pos 20 195))
  (obj v2 toggle (pos 130 195))
  (obj v3 number (pos 230 195))
  (obj c1 comment "a starting value" (pos 20 230))
  (obj c2 comment "switched on" (pos 130 230))
  (obj c3 comment "times it fired" (pos 230 230))
  (connect again 0 lb 0)
  (connect lb 0 m1 0)
  (connect lb 0 m2 0)
  (connect lb 0 cnt 0)
  (connect m1 0 v1 0)
  (connect m2 0 v2 0)
  (connect cnt 0 v3 0))
