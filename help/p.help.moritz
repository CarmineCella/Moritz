; p.help.moritz - help for p
(patch
  (obj title comment "p [name]: subpatcher, a patch inside a box, saved inside the parent's file" (pos 20 12))
  (obj sub comment "Its ports are the inlet and outlet boxes inside, left to right. Double-click it in locked mode to open it." (pos 20 34))
  (obj sub2 comment "The name is only a label: two p boxes with the same name are separate patches." (pos 20 52))
  (obj nin number 5 (pos 20 85))
  (obj cin comment "drag" (pos 85 86))
  (obj dbl p double (pos 20 125)
    (patch
      (obj c0 comment "the number arrives here, is doubled and leaves" (pos 20 10))
      (obj in inlet (pos 20 40))
      (obj mul * 2 (pos 20 80))
      (obj out outlet (pos 20 120))
      (connect in 0 mul 0)
      (connect mul 0 out 0)))
  (obj cdbl comment "inlet -> * 2 -> outlet" (pos 100 126))
  (obj nout number (pos 20 165))
  (obj src saw~ 220 (pos 330 85))
  (obj rate flonum 4 (pos 440 85))
  (obj crate comment "LFO rate (Hz)" (pos 510 86))
  (obj trem p tremolo (pos 330 135)
    (patch
      (obj c0 comment "the left inlet~ brings the signal, the right inlet the LFO rate" (pos 20 10))
      (obj in1 inlet~ (pos 20 40))
      (obj in2 inlet (pos 200 40))
      (obj lfo cycle~ 4 (pos 200 80))
      (obj half *~ 0.5 (pos 200 120))
      (obj ofs +~ 0.5 (pos 200 160))
      (obj c1 comment "LFO from 0 to 1" (pos 260 161))
      (obj vca *~ (pos 20 200))
      (obj out outlet~ (pos 20 240))
      (connect in2 0 lfo 0)
      (connect lfo 0 half 0)
      (connect half 0 ofs 0)
      (connect in1 0 vca 0)
      (connect ofs 0 vca 1)
      (connect vca 0 out 0)))
  (obj ctrem comment "signal in, rate in, signal out" (pos 420 136))
  (obj on message "0.15 50" (pos 420 185))
  (obj off message "0 50" (pos 490 185))
  (obj cv comment "volume on / off" (pos 550 186))
  (obj ramp line~ (pos 420 220))
  (obj vca *~ (pos 330 260))
  (obj out dac~ (pos 330 300))
  (obj tip comment "A patch you want in many places can be saved as name.moritz and typed as name: an abstraction." (pos 20 350))
  (connect nin 0 dbl 0)
  (connect dbl 0 nout 0)
  (connect src 0 trem 0)
  (connect rate 0 trem 1)
  (connect trem 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
