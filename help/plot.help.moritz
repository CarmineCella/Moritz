; plot.help.moritz - help for plot
(patch
  (obj title comment "plot [buffer] [width height] [mode]: curves, bars, scatter plots and matrices" (pos 20 12))
  (obj sub comment "Shows a buffer~ (followed as it changes: its channels are rows, its sample rate gives the time axis) or the lists and numbers it receives." (pos 20 34))
  (obj sub2 comment "Double-click it (locked) for a window: wheel zooms (Shift: vertically), drag moves, r resets, e exports a PNG. A click outputs x and y." (pos 20 52))
  (obj c1 comment "a list: one curve, or bars" (pos 20 85))
  (obj l1 message "3 1 4 1 5 9 2 6 5 3 5 8 9 7 9" (pos 20 105))
  (obj l2 message "mode line" (pos 20 135))
  (obj l3 message "mode bars" (pos 95 135))
  (obj p1 plot 300 120 (pos 20 165))
  (obj c2 comment "numbers: a scrolling curve" (pos 340 85))
  (obj tg toggle (pos 340 105))
  (obj met metro 50 (pos 370 105))
  (obj lfo cycle~ 0.3 (pos 460 105))
  (obj sn snapshot~ (pos 370 135))
  (obj hist message "history 100" (pos 470 135))
  (obj p2 plot 300 120 (pos 340 165))
  (obj c3 comment "x y pairs: a scatter plot" (pos 660 85))
  (obj l4 message "0 0 1 1 2 4 3 9 4 16 5 25 6 36" (pos 660 105))
  (obj p3 plot 220 120 scatter (pos 660 165))
  (obj c4 comment "a buffer~: a sound is a curve; a matrix (many channels) an image" (pos 20 305))
  (obj src buffer~ hplsrc ../examples/sounds/Vox.wav (pos 20 325))
  (obj p4 plot hplsrc 420 100 (pos 20 360))
  (obj cur message "cursor 6000" (pos 20 470))
  (obj cur0 message "cursor -1" (pos 20 500))
  (obj pl message start (pos 120 470))
  (obj st message stop (pos 175 470))
  (obj play play~ hplsrc (pos 120 500))
  (obj vca *~ 0.3 (pos 120 530))
  (obj out dac~ (pos 120 560))
  (obj c5 comment "click the voice: plays from there" (pos 270 470))
  (obj clk message "start $1" (pos 460 470))
  (obj mk message "marks 2000 4000 8000" (pos 460 360))
  (obj mk0 message "marks" (pos 460 390))
  (obj rng message "range -0.5 0.5" (pos 460 420))
  (obj rng0 message "range auto" (pos 560 420))
  (obj sp buffer~ hplspec (pos 660 325))
  (obj an spectrogram (pos 660 355))
  (obj lb loadbang (pos 760 325))
  (obj ra message "maxfreq 4000, run hplsrc hplspec" (pos 760 355))
  (obj p5 plot hplspec 300 120 (pos 660 390))
  (obj cg message "colors gray" (pos 660 520))
  (obj cv message "colors viridis" (pos 750 520))
  (obj op message open (pos 860 520))
  (obj ex message "export /tmp/moritz-plot.png 900 400" (pos 660 550))
  (connect l1 0 p1 0)
  (connect l2 0 p1 0)
  (connect l3 0 p1 0)
  (connect tg 0 met 0)
  (connect met 0 sn 0)
  (connect lfo 0 sn 0)
  (connect sn 0 p2 0)
  (connect hist 0 p2 0)
  (connect l4 0 p3 0)
  (connect p4 0 clk 0)
  (connect clk 0 play 0)
  (connect pl 0 play 0)
  (connect st 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect cur 0 p4 0)
  (connect cur0 0 p4 0)
  (connect mk 0 p4 0)
  (connect mk0 0 p4 0)
  (connect rng 0 p4 0)
  (connect rng0 0 p4 0)
  (connect lb 0 ra 0)
  (connect ra 0 an 0)
  (connect cg 0 p5 0)
  (connect cv 0 p5 0)
  (connect op 0 p5 0)
  (connect ex 0 p5 0))
