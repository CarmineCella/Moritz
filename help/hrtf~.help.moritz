; hrtf~.help.moritz - help for hrtf~
(patch
  (obj title comment "hrtf~ [azimuth] [elevation]: a mono sound at a direction on headphones, through measured head responses" (pos 20 12))
  (obj sub comment "The MIT KEMAR dummy head (Gardner and Martin, 1994): 710 measured directions, elevation -40 to 90; between them, the four around are mixed." (pos 20 34))
  (obj sub2 comment "Inlets: the signal, azimuth (0 front, 90 left, 180 behind), elevation (up), numbers or signals. Outlets: left, right. Use headphones." (pos 20 52))
  (obj sub3 comment "Height comes from the outer ear's notches, so it is clearer here than with binaural~ (which blends responses), and on broadband sounds." (pos 20 70))
  (obj tog toggle (pos 20 105))
  (obj ctog comment "noise bursts" (pos 50 108))
  (obj met metro 200 (pos 20 140))
  (obj burst message "0.5, 0 100" (pos 20 175))
  (obj env line~ (pos 20 210))
  (obj nz noise~ (pos 130 175))
  (obj nb *~ (pos 130 210))
  (obj caz comment "azimuth" (pos 260 90))
  (obj az slider -180 180 (pos 260 110))
  (obj azn number (pos 415 110))
  (obj cel comment "elevation" (pos 500 90))
  (obj el slider -40 90 (pos 500 110))
  (obj eln number (pos 655 110))
  (obj h hrtf~ 0 0 (pos 130 255))
  (obj gl *~ 0.5 (pos 130 295))
  (obj gr *~ 0.5 (pos 230 295))
  (obj out dac~ (pos 130 335))
  (obj lb loadbang (pos 740 90))
  (obj z message 0 (pos 740 120))
  (obj see comment "examples/07-space/hrtf.moritz: a flying source, and a comparison with ambisonics (binaural~)." (pos 20 380))
  (connect tog 0 met 0)
  (connect met 0 burst 0)
  (connect burst 0 env 0)
  (connect nz 0 nb 0)
  (connect env 0 nb 1)
  (connect nb 0 h 0)
  (connect az 0 azn 0)
  (connect azn 0 h 1)
  (connect el 0 eln 0)
  (connect eln 0 h 2)
  (connect h 0 gl 0)
  (connect h 1 gr 0)
  (connect gl 0 out 0)
  (connect gr 0 out 1)
  (connect lb 0 z 0)
  (connect z 0 az 0)
  (connect z 0 el 0))
