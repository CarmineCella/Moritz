; lores~.help.moritz - help for lores~
(patch
  (obj title comment "lores~ [cf res]: resonant low-pass filter" (pos 20 12))
  (obj sub comment "Inlets: signal, cutoff frequency in Hz (default 1000), and resonance 0-1 (default 0; other values are clipped to 0-1)." (pos 20 34))
  (obj sub2 comment "Resonance 0 is a plain two-pole low-pass; 1 gives a Q of about 25, a strong peak at the cutoff. clear resets the filter." (pos 20 52))
  (obj c1 message 300 (pos 150 80))
  (obj c2 message 800 (pos 192 80))
  (obj c3 message 3000 (pos 234 80))
  (obj r1 message 0 (pos 330 80))
  (obj r2 message 0.5 (pos 372 80))
  (obj r3 message 0.9 (pos 414 80))
  (obj cf flonum 800 (pos 150 115))
  (obj ccf comment "cutoff (Hz)" (pos 210 116))
  (obj res flonum 0.5 (pos 330 115))
  (obj cres comment "resonance" (pos 390 116))
  (obj src saw~ 110 (pos 20 115))
  (obj f lores~ 800 0.5 (pos 20 160))
  (obj sc scope~ (pos 480 160))
  (obj on message "0.08 50" (pos 200 210))
  (obj off message "0 50" (pos 272 210))
  (obj cv comment "volume on / off" (pos 332 211))
  (obj ramp line~ (pos 200 245))
  (obj vca *~ (pos 20 280))
  (obj out dac~ (pos 20 320))
  (obj tip comment "Signals in the right inlets are read once per 64-sample block, so an LFO there can sweep the cutoff." (pos 20 360))
  (connect c1 0 cf 0)
  (connect c2 0 cf 0)
  (connect c3 0 cf 0)
  (connect r1 0 res 0)
  (connect r2 0 res 0)
  (connect r3 0 res 0)
  (connect src 0 f 0)
  (connect cf 0 f 1)
  (connect res 0 f 2)
  (connect f 0 sc 0)
  (connect f 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
