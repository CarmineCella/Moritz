; spectroscope~.help.moritz - help for spectroscope~
(patch
  (obj title comment "spectroscope~ [width height]: the live spectrum of a signal" (pos 20 12))
  (obj sub comment "A 2048-point FFT (Hann window): frequency on a log scale from 20 Hz to half the sample rate, level from 0 dB to -90 dB." (pos 20 34))
  (obj sub2 comment "0 dB is a full-scale sine. Grid lines mark 100 Hz, 1 kHz, 10 kHz, -30 dB and -60 dB. The size is 300 x 130 by default." (pos 20 52))
  (obj f220 message 220 (pos 100 80))
  (obj f440 message 440 (pos 144 80))
  (obj f2000 message 2000 (pos 188 80))
  (obj freq flonum 440 (pos 100 115))
  (obj cfreq comment "frequency (Hz)" (pos 175 116))
  (obj osc cycle~ 440 (pos 100 150))
  (obj saw saw~ 440 (pos 190 150))
  (obj nz noise~ (pos 270 150))
  (obj s1 message 1 (pos 370 150))
  (obj s2 message 2 (pos 408 150))
  (obj s3 message 3 (pos 446 150))
  (obj csel comment "1 sine, 2 sawtooth, 3 white noise" (pos 485 151))
  (obj sel selector~ 3 1 (pos 20 205))
  (obj sp spectroscope~ 440 170 (pos 240 250))
  (obj on message "0.1 50" (pos 20 265))
  (obj off message "0 50" (pos 80 265))
  (obj cv comment "volume on / off" (pos 135 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj e1 comment "The sine (amplitude 1) peaks at 0 dB; the sawtooth's harmonics fall 6 dB per octave; white noise is flat." (pos 20 440))
  (obj e2 comment "Peaks fall back slowly, so short sounds stay visible for a moment. It shows the signal before the volume." (pos 20 458))
  (connect f220 0 freq 0)
  (connect f440 0 freq 0)
  (connect f2000 0 freq 0)
  (connect freq 0 osc 0)
  (connect freq 0 saw 0)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect osc 0 sel 1)
  (connect saw 0 sel 2)
  (connect nz 0 sel 3)
  (connect sel 0 sp 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
