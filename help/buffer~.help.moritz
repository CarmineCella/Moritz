; buffer~.help.moritz - help for buffer~
(patch
  (obj title comment "buffer~ name [file] [ms] [channels]: named sample memory" (pos 20 12))
  (obj sub comment "play~, groove~, record~, index~, poke~ and waveform~ find it by its name. With a file it loads it; otherwise it holds ms of silence." (pos 20 34))
  (obj sub2 comment "Messages: read file (WAV, FLAC, MP3, relative to the patch), write file.wav (16-bit), size ms, clear. It has no outlets." (pos 20 52))
  (obj rv message "read ../examples/sounds/voice.wav" (pos 20 80))
  (obj rf message "read ../examples/sounds/flute.wav" (pos 250 80))
  (obj wr message "write ~/Desktop/buffer-copy.wav" (pos 480 80))
  (obj sz message "size 2000" (pos 480 115))
  (obj cl message clear (pos 560 115))
  (obj buf buffer~ helpbuf ../examples/sounds/voice.wav (pos 20 155))
  (obj cbuf comment "size keeps the start; clear fills it with silence" (pos 300 156))
  (obj wf waveform~ helpbuf 420 110 (pos 20 195))
  (obj cwf comment "waveform~ shows the buffer" (pos 450 196))
  (obj st message start (pos 20 325))
  (obj cst comment "play it once" (pos 75 326))
  (obj pl play~ helpbuf (pos 20 360))
  (obj on message "0.15 50" (pos 180 360))
  (obj off message "0 50" (pos 250 360))
  (obj cv comment "volume on / off" (pos 310 361))
  (obj ramp line~ (pos 180 395))
  (obj vca *~ (pos 20 430))
  (obj out dac~ (pos 20 470))
  (connect rv 0 buf 0)
  (connect rf 0 buf 0)
  (connect wr 0 buf 0)
  (connect sz 0 buf 0)
  (connect cl 0 buf 0)
  (connect st 0 pl 0)
  (connect pl 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
