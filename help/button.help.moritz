; button.help.moritz - help for button and toggle
(patch
  (obj title comment "button, toggle: a bang you can click, and an on/off switch" (pos 20 12))
  (obj sub comment "button: click it, or send it any message, and it flashes and sends bang." (pos 20 34))
  (obj sub2 comment "toggle: a click or a bang flips it and sends 1 or 0; a number sets it (anything but 0 is 1); set 1 / set 0 change it silently." (pos 20 52))
  (obj hello message hello (pos 20 85))
  (obj n number 5 (pos 90 85))
  (obj but button (pos 20 125))
  (obj cbut comment "click it, or send it anything" (pos 60 128))
  (obj cnt counter (pos 20 165))
  (obj ccnt comment "counts the bangs, from 0" (pos 90 166))
  (obj ncnt number (pos 20 205))
  (obj tb message bang (pos 330 85))
  (obj t5 message 5 (pos 385 85))
  (obj t0 message 0 (pos 425 85))
  (obj ts message "set 1" (pos 465 85))
  (obj cts comment "set: no output" (pos 525 86))
  (obj tog toggle (pos 330 125))
  (obj ctog comment "click it" (pos 365 128))
  (obj met metro 250 (pos 330 165))
  (obj tnum number (pos 430 165))
  (obj ctnum comment "1 or 0" (pos 495 166))
  (obj flash button (pos 330 205))
  (obj cflash comment "metro 250 bangs this button while the toggle is on" (pos 365 208))
  (connect hello 0 but 0)
  (connect n 0 but 0)
  (connect but 0 cnt 0)
  (connect cnt 0 ncnt 0)
  (connect tb 0 tog 0)
  (connect t5 0 tog 0)
  (connect t0 0 tog 0)
  (connect ts 0 tog 0)
  (connect tog 0 met 0)
  (connect tog 0 tnum 0)
  (connect met 0 flash 0))
