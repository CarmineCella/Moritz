; onset~.help.moritz - help for onset~
(patch
  (obj title comment "onset~ [threshold] [size] [hop]: a bang when a note or a hit begins" (pos 20 12))
  (obj sub comment "The live onsets: the spectral flux of each frame against threshold times its median over the last 21 frames, at least gap ms apart," (pos 20 34))
  (obj sub2 comment "while the level is above gate dB. Messages: threshold x (2), gap ms (50), gate dB (-50). Turn audio on: each onset rings a bell." (pos 20 52))
  (obj src buffer~ hoosrc ../data/drums.wav (pos 20 85))
  (obj lb loadbang (pos 20 115))
  (obj go message "loop 1, start" (pos 20 145))
  (obj rate sig~ 1 (pos 130 145))
  (obj gr groove~ hoosrc 2 (pos 20 175))
  (obj on onset~ 2 1024 256 (pos 20 230))
  (obj t1 message "threshold 1.5" (pos 150 200))
  (obj t2 message "threshold 4" (pos 255 200))
  (obj gp message "gap 200" (pos 350 200))
  (obj b button (pos 20 275))
  (obj cnt counter 0 100000 (pos 60 275))
  (obj n number (pos 60 305))
  (obj cc comment "onsets so far" (pos 120 306))
  (obj f plot 420 100 (pos 330 240))
  (obj cf comment "the flux (right outlet), the last 256 frames" (pos 330 345))
  (obj env message "1, 0 120" (pos 20 345))
  (obj line line~ (pos 20 375))
  (obj bell cycle~ 1760 (pos 120 375))
  (obj ring *~ (pos 20 410))
  (obj rv *~ 0.15 (pos 20 440))
  (obj dr *~ 0.3 (pos 150 440))
  (obj mix +~ (pos 20 475))
  (obj on1 message "1 50" (pos 200 475))
  (obj off message "0 50" (pos 255 475))
  (obj cv comment "volume" (pos 310 476))
  (obj ramp line~ (pos 200 505))
  (obj vca *~ (pos 20 535))
  (obj out dac~ (pos 20 570))
  (connect lb 0 go 0)
  (connect go 0 gr 0)
  (connect rate 0 gr 0)
  (connect gr 0 on 0)
  (connect t1 0 on 0)
  (connect t2 0 on 0)
  (connect gp 0 on 0)
  (connect on 0 b 0)
  (connect on 0 cnt 0)
  (connect cnt 0 n 0)
  (connect on 1 f 0)
  (connect b 0 env 0)
  (connect env 0 line 0)
  (connect line 0 ring 0)
  (connect bell 0 ring 1)
  (connect ring 0 rv 0)
  (connect gr 0 dr 0)
  (connect rv 0 mix 0)
  (connect dr 0 mix 0)
  (connect mix 0 vca 0)
  (connect on1 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
