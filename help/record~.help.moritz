; record~.help.moritz - help for record~
(patch
  (obj title comment "record~ name [channels]: record signals into a buffer~" (pos 20 12))
  (obj sub comment "1 starts recording at the beginning, 0 stops. At the end it stops, or wraps around with loop 1. Each inlet records one channel." (pos 20 34))
  (obj sub2 comment "The buffer~ keeps its length, so give it one (buffer~ name 3000). The outlet is the record position, 0 to 1. For the mic, use adc~." (pos 20 52))
  (obj n1 message 220 (pos 20 80))
  (obj n2 message 277 (pos 60 80))
  (obj n3 message 330 (pos 100 80))
  (obj n4 message 440 (pos 140 80))
  (obj cn comment "play notes" (pos 185 81))
  (obj trig t b f (pos 20 115))
  (obj env message "1 5 0 400" (pos 20 150))
  (obj osc tri~ 220 (pos 110 150))
  (obj eg line~ (pos 20 185))
  (obj src *~ (pos 20 220))
  (obj tog toggle (pos 150 255))
  (obj ctog comment "record on / off" (pos 175 257))
  (obj lp1 message "loop 1" (pos 280 255))
  (obj lp0 message "loop 0" (pos 340 255))
  (obj rec record~ helprec (pos 150 300))
  (obj snap snapshot~ 50 (pos 150 340))
  (obj where flonum (pos 150 375))
  (obj cw comment "record position, 0 to 1" (pos 240 376))
  (obj buf buffer~ helprec 3000 (pos 400 80))
  (obj wf waveform~ helprec 300 100 (pos 400 115))
  (obj st message start (pos 400 235))
  (obj cst comment "play the recording" (pos 455 236))
  (obj pl play~ helprec (pos 400 270))
  (obj on message "0.15 50" (pos 480 350))
  (obj off message "0 50" (pos 550 350))
  (obj cv comment "volume on / off" (pos 610 351))
  (obj ramp line~ (pos 480 385))
  (obj vm *~ (pos 20 430))
  (obj vp *~ (pos 400 430))
  (obj out dac~ (pos 20 470))
  (connect n1 0 trig 0)
  (connect n2 0 trig 0)
  (connect n3 0 trig 0)
  (connect n4 0 trig 0)
  (connect trig 0 env 0)
  (connect trig 1 osc 0)
  (connect env 0 eg 0)
  (connect eg 0 src 0)
  (connect osc 0 src 1)
  (connect src 0 rec 0)
  (connect tog 0 rec 0)
  (connect lp1 0 rec 0)
  (connect lp0 0 rec 0)
  (connect rec 0 snap 0)
  (connect snap 0 where 0)
  (connect st 0 pl 0)
  (connect src 0 vm 0)
  (connect pl 0 vp 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vm 1)
  (connect ramp 0 vp 1)
  (connect vm 0 out 0)
  (connect vm 0 out 1)
  (connect vp 0 out 0)
  (connect vp 0 out 1))
