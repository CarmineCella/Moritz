; nebula~.help.moritz - help for nebula~
(patch
  (obj title comment "nebula~ [proto1] [proto2]: granular synthesis (sound_math's nebula)" (pos 20 12))
  (obj sub comment "Grains of two prototypes (sine triangle square noise, or a buffer~), mixed by morph. Inlets: 1/0, density, length (ms), freq, morph." (pos 20 34))
  (obj sub2 comment "Messages: density d [r], length ms [r], freq f [r] (Hz; for a buffer~ a speed ratio), morph m, amp a, gliss g, jitter j [r] (pan)," (pos 20 52))
  (obj sub3 comment "speed s (through a buffer~), grainlets n (grains of n periods), window hann|hamming|blackman, poly n, proto1 x, proto2 x, seed n;" (pos 20 70))
  (obj sub4 comment "pitch1 hz, pitch2 hz: a sound prototype's pitch, so freq is in Hz for it too. The number after a value is its randomness, as a ratio." (pos 20 88))
  (obj tog toggle (pos 20 120))
  (obj ctog comment "on / off" (pos 50 123))
  (obj d number 20 (pos 20 160))
  (obj l number 80 (pos 100 160))
  (obj f number 440 (pos 180 160))
  (obj m flonum 0 (pos 260 160))
  (obj cpar comment "density   length    freq      morph" (pos 20 185))
  (obj r1 message "freq 440 0.5, gliss 0.3" (pos 350 120))
  (obj r2 message "freq 440 0, gliss 0" (pos 350 150))
  (obj cr comment "random frequency and glides, or none" (pos 520 136))
  (obj neb nebula~ sine square (pos 20 220))
  (obj gl *~ 0.5 (pos 20 260))
  (obj gr *~ 0.5 (pos 120 260))
  (obj out dac~ (pos 20 300))
  (connect tog 0 neb 0)
  (connect d 0 neb 1)
  (connect l 0 neb 2)
  (connect f 0 neb 3)
  (connect m 0 neb 4)
  (connect r1 0 neb 0)
  (connect r2 0 neb 0)
  (connect neb 0 gl 0)
  (connect neb 1 gr 0)
  (connect gl 0 out 0)
  (connect gr 0 out 1))
