; slide~.help.moritz - help for slide~
(patch
  (obj title comment "slide~ [up down]: smooths a signal" (pos 20 12))
  (obj sub comment "Each sample, y += (x - y) / slide, where slide is the up value while the input is above the output, and down while it is below." (pos 20 34))
  (obj sub2 comment "Inlets: signal, slide up, slide down, in samples (signals or floats; 1 = no smoothing, the default). reset jumps to the input." (pos 20 52))
  (obj f1 message 220 (pos 20 85))
  (obj f2 message 440 (pos 64 85))
  (obj f3 message 880 (pos 108 85))
  (obj cup comment "up" (pos 160 89))
  (obj cdown comment "down" (pos 250 89))
  (obj sig sig~ 220 (pos 20 120))
  (obj rst message reset (pos 90 120))
  (obj up flonum 2000 (pos 160 120))
  (obj down flonum 2000 (pos 250 120))
  (obj sl slide~ 2000 2000 (pos 20 165))
  (obj csl comment "2000 samples (45 ms at 44.1 kHz) to cover 63% of a jump" (pos 160 169))
  (obj osc cycle~ (pos 20 205))
  (obj snap snapshot~ 50 (pos 150 205))
  (obj val flonum 0 (pos 150 240))
  (obj cval comment "the gliding frequency (Hz)" (pos 240 241))
  (obj on message "0.15 50" (pos 200 280))
  (obj off message "0 50" (pos 270 280))
  (obj cv comment "volume on / off" (pos 330 281))
  (obj ramp line~ (pos 200 315))
  (obj vca *~ (pos 20 350))
  (obj out dac~ (pos 20 390))
  (obj tip comment "Different up and down values make an envelope follower: abs~ -> slide~ 10 4000 rises fast and falls slowly." (pos 20 430))
  (connect f1 0 sig 0)
  (connect f2 0 sig 0)
  (connect f3 0 sig 0)
  (connect sig 0 sl 0)
  (connect rst 0 sl 0)
  (connect up 0 sl 1)
  (connect down 0 sl 2)
  (connect sl 0 osc 0)
  (connect sl 0 snap 0)
  (connect snap 0 val 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
