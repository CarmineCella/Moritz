; prepend.help.moritz - help for prepend and append
(patch
  (obj title comment "prepend args..., append args...: words before or after a message" (pos 20 12))
  (obj sub comment "prepend set shows a list in a message box (set replaces its contents without sending them). The right inlet replaces the words." (pos 20 34))
  (obj l1 message "1 2 3" (pos 20 70))
  (obj l2 message "hello world" (pos 80 70))
  (obj pre prepend set (pos 20 105))
  (obj box message "" (pos 20 140))
  (obj app append is here (pos 220 105))
  (obj pr print appended (pos 220 140))
  (obj nw message "seconds" (pos 320 70))
  (obj c comment "new words for append" (pos 390 71))
  (connect l1 0 pre 0)
  (connect l2 0 pre 0)
  (connect l1 0 app 0)
  (connect l2 0 app 0)
  (connect pre 0 box 0)
  (connect app 0 pr 0)
  (connect nw 0 app 1))
