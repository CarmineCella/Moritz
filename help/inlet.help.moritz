; inlet.help.moritz - help for inlet, inlet~, outlet, outlet~ (in, in~, out, out~)
(patch
  (obj title comment "inlet, inlet~, outlet, outlet~: the ports of a p, an abstraction or a poly~ voice" (pos 20 12))
  (obj sub comment "Each one inside adds a port to the box outside, numbered left to right by its x position." (pos 20 34))
  (obj sub2 comment "inlet~ and outlet~ carry signals; a number sent to a signal port becomes a constant signal." (pos 20 52))
  (obj lb loadbang (pos 150 80))
  (obj src cycle~ 220 (pos 20 115))
  (obj gain flonum 0.5 (pos 150 115))
  (obj cgain comment "amplitude 0-1: drag" (pos 220 116))
  (obj ports p ports (pos 20 160)
    (patch
      (obj c0 comment "ports are numbered by x position: move a box and its port moves" (pos 20 10))
      (obj a inlet~ (pos 20 40))
      (obj ca comment "inlet 1 (signal)" (pos 85 41))
      (obj b inlet (pos 240 40))
      (obj cb comment "inlet 2 (messages)" (pos 300 41))
      (obj vca *~ (pos 20 100))
      (obj db atodb (pos 240 100))
      (obj o1 outlet~ (pos 20 160))
      (obj c1 comment "outlet 1 (signal)" (pos 90 161))
      (obj o2 outlet (pos 240 160))
      (obj c2 comment "outlet 2 (messages)" (pos 305 161))
      (connect a 0 vca 0)
      (connect b 0 vca 1)
      (connect b 0 db 0)
      (connect db 0 o2 0)
      (connect vca 0 o1 0)))
  (obj cports comment "double-click (locked) to see the inlets and outlets inside" (pos 100 161))
  (obj db flonum (pos 150 205))
  (obj cdb comment "outlet 2: the amplitude in dB" (pos 220 206))
  (obj on message "0.15 50" (pos 110 245))
  (obj off message "0 50" (pos 180 245))
  (obj cv comment "volume on / off" (pos 240 246))
  (obj ramp line~ (pos 110 280))
  (obj vca *~ (pos 20 315))
  (obj out dac~ (pos 20 355))
  (obj short comment "in, in~, out and out~ are short names for the same objects." (pos 20 400))
  (obj sigmsg comment "Only numbers reach a signal port; other messages sent to it are ignored." (pos 20 420))
  (connect lb 0 gain 0)
  (connect src 0 ports 0)
  (connect gain 0 ports 1)
  (connect ports 0 vca 0)
  (connect ports 1 db 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
