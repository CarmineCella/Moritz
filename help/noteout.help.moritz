; noteout.help.moritz - help for noteout and ctlout
(patch
  (obj title comment "noteout [channel], ctlout [controller] [channel]: MIDI out" (pos 20 12))
  (obj sub comment "They send to the output chosen in Patch > MIDI Setup: by default the virtual port \"Moritz\", which" (pos 20 34))
  (obj sub2 comment "a synth or DAW can listen to. noteout inlets: pitch (sends), velocity (0 = note-off), channel." (pos 20 52))
  (obj ks kslider 3 48 (pos 20 85))
  (obj cks comment "play keys: note-on when pressed, note-off on release" (pos 300 105))
  (obj no noteout 1 (pos 20 160))
  (obj ch1 message 1 (pos 120 160))
  (obj ch2 message 2 (pos 160 160))
  (obj cch comment "channel" (pos 200 161))
  (obj sl slider 0 127 (pos 20 210))
  (obj csl comment "ctlout 1: the mod wheel, value 0-127" (pos 175 211))
  (obj co ctlout 1 1 (pos 20 250))
  (obj cc message 74 (pos 120 250))
  (obj ccc comment "another controller (74: brightness)" (pos 160 251))
  (connect ks 0 no 0)
  (connect ks 1 no 1)
  (connect ch1 0 no 2)
  (connect ch2 0 no 2)
  (connect sl 0 co 0)
  (connect cc 0 co 1))
