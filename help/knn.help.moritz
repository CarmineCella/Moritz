; knn.help.moritz - help for knn
(patch
  (obj title comment "knn [k]: k nearest neighbours: learns from examples (add inputs -> outputs), then predicts for new inputs" (pos 20 12))
  (obj sub comment "Regression: the mean of the k nearest outputs; weighted 1 weights them by inverse distance (smooth, like Wekinator)." (pos 20 34))
  (obj sub2 comment "Classification: words as outputs, or classify 1: the most frequent. k n, normalize 0/1, clear, write/read file. Outlets: prediction, nearest index." (pos 20 52))
  (obj ex message "add 0 0 -> 110 300, add 100 0 -> 220 4000, add 0 100 -> 330 800, add 100 100 -> 165 9000, weighted 1, k 4" (pos 20 85))
  (obj cex comment "four corners: (x y) -> (frequency, cutoff)" (pos 20 110))
  (obj lb loadbang (pos 620 85))
  (obj cx comment "x" (pos 20 140))
  (obj sx slider 0 100 (pos 40 140))
  (obj cy comment "y" (pos 20 170))
  (obj sy slider 0 100 (pos 40 170))
  (obj ty t b f (pos 200 200))
  (obj pk pack 0. 0. (pos 20 235))
  (obj kn knn 4 (pos 20 270))
  (obj split unpack 0. 0. (pos 20 305))
  (obj fr flonum (pos 20 340))
  (obj cu flonum (pos 110 340))
  (obj cfc comment "frequency, cutoff: move x and y to glide between the corners" (pos 200 341))
  (obj osc saw~ 110 (pos 20 380))
  (obj lp lores~ 1000 0.4 (pos 20 415))
  (obj on message "0.1 50" (pos 20 455))
  (obj off message "0 50" (pos 85 455))
  (obj cv comment "volume" (pos 140 456))
  (obj ramp line~ (pos 20 490))
  (obj vca *~ (pos 160 490))
  (obj out dac~ (pos 160 525))
  (obj cl comment "classification: words as outputs" (pos 440 140))
  (obj ex2 message "add 0 -> low, add 30 -> low, add 60 -> high, add 100 -> high" (pos 440 165))
  (obj kc knn 3 (pos 440 235))
  (obj nb number (pos 440 200))
  (obj show message "set $1" (pos 440 270))
  (obj lab message (pos 440 305))
  (obj clab comment "<- the class of the number above" (pos 510 306))
  (connect lb 0 ex 0)
  (connect lb 0 ex2 0)
  (connect ex 0 kn 0)
  (connect sx 0 pk 0)
  (connect sy 0 ty 0)
  (connect ty 1 pk 1)
  (connect ty 0 pk 0)
  (connect pk 0 kn 0)
  (connect kn 0 split 0)
  (connect split 0 fr 0)
  (connect split 1 cu 0)
  (connect fr 0 osc 0)
  (connect cu 0 lp 1)
  (connect osc 0 lp 0)
  (connect lp 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect ex2 0 kc 0)
  (connect nb 0 kc 0)
  (connect kc 0 show 0)
  (connect show 0 lab 0))
