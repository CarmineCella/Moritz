; binaural~.help.moritz - help for binaural~
(patch
  (obj title comment "binaural~ [order]: a sound field on headphones" (pos 20 12))
  (obj sub comment "The field ((order+1)^2 channels, from ambienc~) is decoded to 17 virtual speakers around, above and below," (pos 20 34))
  (obj sub2 comment "each heard through the measured head-related impulse responses of its direction (MIT KEMAR, Gardner and Martin 1994). Use headphones." (pos 20 52))
  (obj tog toggle (pos 20 90))
  (obj ctog comment "noise bursts" (pos 50 93))
  (obj met metro 250 (pos 20 125))
  (obj burst message "0.5, 0 80" (pos 20 160))
  (obj env line~ (pos 20 195))
  (obj nz noise~ (pos 110 160))
  (obj rs *~ (pos 110 195))
  (obj caz comment "azimuth (90 left, -90 right, 180 behind)" (pos 180 105))
  (obj az slider -180 180 (pos 180 125))
  (obj azn number (pos 335 125))
  (obj cel comment "elevation" (pos 420 105))
  (obj el slider -40 90 (pos 420 125))
  (obj eln number (pos 575 125))
  (obj enc ambienc~ 1 (pos 110 240))
  (obj bin binaural~ 1 (pos 110 280))
  (obj out dac~ (pos 110 320))
  (obj lb loadbang (pos 650 90))
  (obj z message 0 (pos 650 125))
  (connect tog 0 met 0)
  (connect met 0 burst 0)
  (connect burst 0 env 0)
  (connect env 0 rs 1)
  (connect nz 0 rs 0)
  (connect rs 0 enc 0)
  (connect az 0 azn 0)
  (connect azn 0 enc 1)
  (connect el 0 eln 0)
  (connect eln 0 enc 2)
  (connect enc 0 bin 0)
  (connect enc 1 bin 1)
  (connect enc 2 bin 2)
  (connect enc 3 bin 3)
  (connect bin 0 out 0)
  (connect bin 1 out 1)
  (connect lb 0 z 0)
  (connect z 0 az 0)
  (connect z 0 el 0))
