; linreg.help.moritz - help for linreg
(patch
  (obj title comment "linreg: linear regression: learns y = b0 + b1 x1 + b2 x2 ... from examples, then predicts" (pos 20 12))
  (obj sub comment "add x1 x2 ... -> y1 y2 ... adds an example; train fits the weights by least squares (one set per output); a list then gives" (pos 20 34))
  (obj sub2 comment "the predicted outputs. weights outputs them (intercept first). clear, write/read file." (pos 20 52))
  (obj pts message "add 0 0 -> 1, add 1 0 -> 3.1, add 0 1 -> 3.9, add 1 1 -> 6, add 2 1 -> 8.1" (pos 20 85))
  (obj cpts comment "about y = 1 + 2 x1 + 3 x2" (pos 20 110))
  (obj tr message train (pos 20 135))
  (obj w message weights (pos 80 135))
  (obj x1 flonum 3 (pos 20 175))
  (obj x2 flonum 2 (pos 100 175))
  (obj tq t b f (pos 100 205))
  (obj pk pack 3. 2. (pos 20 235))
  (obj cq comment "x1, x2" (pos 180 176))
  (obj lr linreg (pos 20 270))
  (obj y flonum (pos 20 310))
  (obj cy comment "predicted y (13 for 3, 2)" (pos 90 311))
  (obj ws message "set $1 $2 $3" (pos 240 310))
  (obj wd message (pos 240 345))
  (obj cw comment "<- b0 b1 b2" (pos 330 346))
  (obj lb loadbang (pos 420 85))
  (obj t t b b (pos 420 115))
  (connect lb 0 t 0)
  (connect t 1 pts 0)
  (connect t 0 tr 0)
  (connect pts 0 lr 0)
  (connect tr 0 lr 0)
  (connect w 0 lr 0)
  (connect x1 0 pk 0)
  (connect x2 0 tq 0)
  (connect tq 1 pk 1)
  (connect tq 0 pk 0)
  (connect pk 0 lr 0)
  (connect lr 0 y 0)
  (connect lr 1 ws 0)
  (connect ws 0 wd 0))
