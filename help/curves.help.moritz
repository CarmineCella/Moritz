; curves.help.moritz - help for curves
(patch
  (obj title comment "curves [size] [hop]: how a sound evolves: loudness, register, polyphony" (pos 20 12))
  (obj sub comment "Curves over time, written to a buffer~ (a frame every hop samples). loudness: the level in dB, roughly as the ear weighs it. register: 3 channels," (pos 20 34))
  (obj sub2 comment "the centroid (MIDI pitch), the spread around it (octaves), the lowest strong partial (MIDI pitch). polyphony: how many voices seem to sound (rough)." (pos 20 52))
  (obj bee buffer~ hcvbee ../examples/sounds/Beethoven_Symph7.wav (pos 20 85))
  (obj ld buffer~ hcvloud (pos 380 85))
  (obj rg buffer~ hcvreg (pos 490 85))
  (obj pp buffer~ hcvpoly (pos 590 85))
  (obj lb loadbang (pos 20 120))
  (obj r1 message "smooth 21, loudness hcvbee hcvloud" (pos 20 150))
  (obj r2 message "register hcvbee hcvreg" (pos 20 180))
  (obj r3 message "polyphony hcvbee hcvpoly" (pos 20 210))
  (obj cv curves 2048 512 (pos 20 245))
  (obj c1 comment "the Allegretto grows from a" (pos 20 290))
  (obj c2 comment "whisper of low strings to the" (pos 20 306))
  (obj c3 comment "whole orchestra: louder, higher," (pos 20 322))
  (obj c4 comment "wider, more voices" (pos 20 338))
  (obj l1 loadbang (pos 20 380))
  (obj t1 message "title loudness (dB)" (pos 20 410))
  (obj p1 plot hcvloud 520 100 (pos 260 120))
  (obj t2 message "title register (MIDI pitch)" (pos 20 440))
  (obj p2 plot hcvreg 520 120 (pos 260 235))
  (obj t3 message "title polyphony" (pos 20 470))
  (obj p3 plot hcvpoly 520 80 (pos 260 370))
  (obj cs comment "smooth 21: a moving median over 21 frames (a quarter of a second). Register: blue the centroid, green the lowest strong partial;" (pos 260 465))
  (obj cs2 comment "orange the spread in octaves (other units: a plot in image mode with normalize 1 compares the shapes)." (pos 260 483))
  (connect lb 0 r1 0)
  (connect lb 0 r2 0)
  (connect lb 0 r3 0)
  (connect r1 0 cv 0)
  (connect r2 0 cv 0)
  (connect r3 0 cv 0)
  (connect l1 0 t1 0)
  (connect l1 0 t2 0)
  (connect l1 0 t3 0)
  (connect t1 0 p1 0)
  (connect t2 0 p2 0)
  (connect t3 0 p3 0))
