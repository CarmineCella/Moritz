; sig~.help.moritz - help for sig~
(patch
  (obj title comment "sig~ [value]: turns a number into a signal" (pos 20 12))
  (obj sub comment "Left inlet: a float sets the value; the argument is the starting value. A signal connected there passes through unchanged." (pos 20 34))
  (obj sub2 comment "Signals connected to the same inlet are added, and floats sent to an inlet with a signal connected are ignored." (pos 20 52))
  (obj f1 message 220 (pos 20 85))
  (obj f2 message 330 (pos 64 85))
  (obj f3 message 440 (pos 108 85))
  (obj freq flonum 220 (pos 20 120))
  (obj cf comment "pitch (Hz)" (pos 82 121))
  (obj lfo cycle~ 5 (pos 230 85))
  (obj dep flonum 10 (pos 330 85))
  (obj cdep comment "vibrato depth (Hz)" (pos 392 86))
  (obj depth *~ 10 (pos 230 120))
  (obj sig sig~ 220 (pos 20 160))
  (obj osc cycle~ (pos 20 205))
  (obj cosc comment "sig~ and the vibrato both go into this inlet: they are added" (pos 90 209))
  (obj sc scope~ (pos 480 260))
  (obj on message "0.15 50" (pos 200 275))
  (obj off message "0 50" (pos 270 275))
  (obj cv comment "volume on / off" (pos 330 276))
  (obj ramp line~ (pos 200 310))
  (obj vca *~ (pos 20 345))
  (obj out dac~ (pos 20 385))
  (obj tip comment "A float sent straight to this cycle~ would be ignored, because a signal is connected: sig~ turns it into one." (pos 20 425))
  (connect f1 0 freq 0)
  (connect f2 0 freq 0)
  (connect f3 0 freq 0)
  (connect freq 0 sig 0)
  (connect lfo 0 depth 0)
  (connect dep 0 depth 1)
  (connect sig 0 osc 0)
  (connect depth 0 osc 0)
  (connect osc 0 sc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
