; moritz.help.moritz - help for moritz
(patch
  (obj title comment "moritz [patch] [channels]: renders another patch offline into a buffer~, faster than real time" (pos 20 12))
  (obj sub comment "open patch.moritz; send name value (kept for every render, until clear); input buffer (feeds its adc~); render buffer seconds; stop." (pos 20 34))
  (obj sub2 comment "Each render starts the patch afresh. It has its own send/receive and buffer~ names. Outlets: progress 0..1, bang when ready." (pos 20 52))
  (obj buf buffer~ helpbounce (pos 20 85))
  (obj r1 message "send pitch 48, send speed 200, render helpbounce 4" (pos 20 120))
  (obj r2 message "send pitch 60, send speed 90, render helpbounce 4" (pos 20 150))
  (obj r3 message "send pitch 36, send speed 400, render helpbounce 4" (pos 20 180))
  (obj cr comment "three versions of help-render.moritz (open it to see it)" (pos 370 151))
  (obj mz moritz help-render.moritz (pos 20 220))
  (obj prog flonum (pos 20 260))
  (obj done button (pos 100 260))
  (obj cp comment "progress, done" (pos 130 263))
  (obj wf waveform~ helpbounce 360 80 (pos 300 210))
  (obj go message start (pos 20 305))
  (obj st message stop (pos 75 305))
  (obj pl play~ helpbounce 2 (pos 20 340))
  (obj on message "0.3 50" (pos 20 380))
  (obj off message "0 50" (pos 85 380))
  (obj cv comment "volume" (pos 140 381))
  (obj ramp line~ (pos 20 415))
  (obj vl *~ (pos 20 450))
  (obj vr *~ (pos 120 450))
  (obj out dac~ (pos 20 490))
  (connect r1 0 mz 0)
  (connect r2 0 mz 0)
  (connect r3 0 mz 0)
  (connect mz 0 prog 0)
  (connect mz 1 done 0)
  (connect done 0 go 0)
  (connect go 0 pl 0)
  (connect st 0 pl 0)
  (connect pl 0 vl 0)
  (connect pl 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
