; meter~.help.moritz - help for meter~ and scope~
(patch
  (obj title comment "meter~: a peak level meter.   scope~ [samples]: an oscilloscope" (pos 20 12))
  (obj sub comment "meter~ shows the peak level from -60 dB to 0 dB: green, yellow above -12 dB, red above -3 dB, falling back smoothly." (pos 20 34))
  (obj sub2 comment "scope~ draws [samples] samples (32 to 1024, default 512) from a rising zero crossing; its height is -1 to 1, beyond is clipped." (pos 20 52))
  (obj f110 message 110 (pos 20 80))
  (obj f440 message 440 (pos 64 80))
  (obj f1000 message 1000 (pos 108 80))
  (obj freq flonum 440 (pos 20 115))
  (obj cfreq comment "frequency (Hz)" (pos 95 116))
  (obj osc cycle~ 440 (pos 20 150))
  (obj a1 message 0.01 (pos 200 150))
  (obj a2 message 0.1 (pos 250 150))
  (obj a3 message 0.5 (pos 292 150))
  (obj a4 message 1 (pos 334 150))
  (obj ca comment "amplitude: 0.01 = -40 dB, 0.1 = -20 dB, 0.5 = -6 dB, 1 = 0 dB" (pos 200 125))
  (obj amp *~ 0.5 (pos 20 205))
  (obj met meter~ (pos 250 240))
  (obj sc1 scope~ 128 (pos 300 240))
  (obj sc2 scope~ 1024 (pos 500 240))
  (obj cm comment "meter~" (pos 240 345))
  (obj c1 comment "scope~ 128" (pos 300 345))
  (obj c2 comment "scope~ 1024" (pos 500 345))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj e1 comment "Try 1000 Hz: scope~ 128 shows about 3 cycles, scope~ 1024 about 23." (pos 20 415))
  (obj e2 comment "The meter and the scopes show the signal before the volume, so they work with the volume off." (pos 20 433))
  (connect f110 0 freq 0)
  (connect f440 0 freq 0)
  (connect f1000 0 freq 0)
  (connect freq 0 osc 0)
  (connect osc 0 amp 0)
  (connect a1 0 amp 1)
  (connect a2 0 amp 1)
  (connect a3 0 amp 1)
  (connect a4 0 amp 1)
  (connect amp 0 met 0)
  (connect amp 0 sc1 0)
  (connect amp 0 sc2 0)
  (connect amp 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
