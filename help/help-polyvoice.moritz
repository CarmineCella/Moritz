; help-polyvoice.moritz - a poly~ voice for poly~.help.moritz.
; "pitch velocity" in. A velocity above 0 starts a triangle tone that fades
; out over 2.5 s; velocity 0 releases it in 300 ms. thispoly~ watches the
; envelope, so the voice is free again once it reaches 0. On each note the
; voice sends its number out of its control outlet.
(patch
  (obj c0 comment "help-polyvoice: one voice of poly~.help.moritz. In: pitch velocity" (pos 20 10))
  (obj in inlet (pos 20 40))
  (obj split unpack 0 0 (pos 20 75))
  (obj m2f mtof (pos 20 115))
  (obj osc tri~ (pos 20 155))
  (obj off sel 0 (pos 200 115))
  (obj rel message "0 300" (pos 200 155))
  (obj on t b f (pos 290 155))
  (obj amp expr "$f1 / 127 * 0.3" (pos 380 195))
  (obj atk message "$1 10 0 2500" (pos 380 235))
  (obj env line~ (pos 200 275))
  (obj vca *~ (pos 20 315))
  (obj out outlet~ (pos 20 355))
  (obj tp thispoly~ (pos 290 315))
  (obj c1 comment "busy until the envelope is back at 0" (pos 370 316))
  (obj num outlet (pos 290 355))
  (obj c2 comment "this voice's number, on each note" (pos 350 356))
  (connect in 0 split 0)
  (connect split 0 m2f 0)
  (connect m2f 0 osc 0)
  (connect split 1 off 0)
  (connect off 0 rel 0)
  (connect off 1 on 0)
  (connect on 1 amp 0)
  (connect amp 0 atk 0)
  (connect on 0 tp 0)
  (connect rel 0 env 0)
  (connect atk 0 env 0)
  (connect osc 0 vca 0)
  (connect env 0 vca 1)
  (connect env 0 tp 0)
  (connect vca 0 out 0)
  (connect tp 0 num 0))
