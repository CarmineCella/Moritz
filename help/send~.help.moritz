; send~.help.moritz - help for send~ and receive~
(patch
  (obj title comment "send~ name, receive~ name: signal connections without cables" (pos 20 12))
  (obj sub comment "receive~ outputs the sum of every send~ with its name, anywhere in the patch, its subpatchers and abstractions." (pos 20 34))
  (obj sub2 comment "set name changes the name of either one. There is no delay, except around a feedback loop (see below)." (pos 20 52))
  (obj a cycle~ 220 (pos 20 85))
  (obj ga *~ 0.5 (pos 20 120))
  (obj sa send~ helpsig (pos 20 155))
  (obj other p other (pos 200 85)
    (patch
      (obj c0 comment "a second send~ helpsig, inside a subpatcher" (pos 20 10))
      (obj b cycle~ 330 (pos 20 40))
      (obj gb *~ 0.5 (pos 20 80))
      (obj sb send~ helpsig (pos 20 120))
      (connect b 0 gb 0)
      (connect gb 0 sb 0)))
  (obj cother comment "330 Hz into send~ helpsig, inside" (pos 200 112))
  (obj n noise~ (pos 460 85))
  (obj gn *~ 0.3 (pos 460 120))
  (obj sn send~ helpnoise (pos 460 155))
  (obj s1 message "set helpsig" (pos 20 205))
  (obj s2 message "set helpnoise" (pos 120 205))
  (obj cs comment "choose what to receive" (pos 230 206))
  (obj r receive~ helpsig (pos 20 245))
  (obj cr comment "helpsig: the sum of 220 Hz and 330 Hz" (pos 140 266))
  (obj on message "0.15 50" (pos 110 300))
  (obj off message "0 50" (pos 180 300))
  (obj cv comment "volume on / off" (pos 240 301))
  (obj ramp line~ (pos 110 330))
  (obj vca *~ (pos 20 365))
  (obj out dac~ (pos 20 400))
  (obj sc scope~ (pos 380 255))
  (obj fb comment "A loop through send~ and receive~ is allowed: the receive~ in the loop gets the signal one block (64 samples) late." (pos 20 435))
  (obj glob comment "Names are global: a help patch like this one shares them with the patch you have open." (pos 20 455))
  (connect a 0 ga 0)
  (connect ga 0 sa 0)
  (connect n 0 gn 0)
  (connect gn 0 sn 0)
  (connect s1 0 r 0)
  (connect s2 0 r 0)
  (connect r 0 vca 0)
  (connect r 0 sc 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
