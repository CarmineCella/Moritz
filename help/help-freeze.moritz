; help-freeze.moritz - spectral patch for framedelta~.help.moritz, run by pfft~
; once per FFT frame. A spectral freeze: while frozen, each bin keeps its
; amplitude and its frequency (phase change per frame, from framedelta~),
; and frameaccum~ 1 keeps advancing its phase by that frequency.
(patch
  (obj c0 comment "spectral freeze: hold each bin's amplitude and frequency, keep turning its phase" (pos 20 10))
  (obj in fftin~ 1 (pos 20 45))
  (obj fz inlet (pos 450 45))
  (obj cfz comment "1 freeze, 0 live" (pos 495 46))
  (obj cp cartopol~ (pos 20 90))
  (obj rs expr~ "$v1 == 0" (pos 450 90))
  (obj c4 comment "reset: 1 while live" (pos 560 91))
  (obj fd framedelta~ (pos 200 140))
  (obj pw phasewrap~ (pos 200 180))
  (obj ha frameaccum~ (pos 20 230))
  (obj hd frameaccum~ (pos 200 230))
  (obj acc frameaccum~ 1 (pos 200 280))
  (obj pc poltocar~ (pos 20 320))
  (obj out fftout~ 1 (pos 20 360))
  (obj n1 comment "framedelta~ -> phasewrap~: each bin's frequency, as its phase change per frame (radians)." (pos 20 400))
  (obj n2 comment "The plain frameaccum~ add nothing: they hold the amplitude and the frequency, and restart from them while live." (pos 20 418))
  (obj n3 comment "frameaccum~ 1 adds the frequency to the phase every frame, wrapped; while live it restarts from the analysed phase." (pos 20 436))
  (connect in 0 cp 0)
  (connect in 1 cp 1)
  (connect fz 0 rs 0)
  (connect cp 0 ha 1)
  (connect rs 0 ha 2)
  (connect cp 1 fd 0)
  (connect fd 0 pw 0)
  (connect pw 0 hd 1)
  (connect rs 0 hd 2)
  (connect hd 0 acc 0)
  (connect cp 1 acc 1)
  (connect rs 0 acc 2)
  (connect ha 0 pc 0)
  (connect acc 0 pc 1)
  (connect pc 0 out 0)
  (connect pc 1 out 1))
