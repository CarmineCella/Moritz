; select.help.moritz - help for select (sel)
(patch
  (obj title comment "select (or sel) a b ...: bangs the outlet whose argument equals the input" (pos 20 12))
  (obj sub comment "Anything else goes out of the last outlet unchanged. Only the first word is compared; numbers and words both work." (pos 20 34))
  (obj sub2 comment "With a single argument there is a right inlet, which changes the value to match. sel alone matches 0." (pos 20 52))
  (obj in number (pos 20 85))
  (obj cin comment "drag from 0 to 6" (pos 85 86))
  (obj sl sel 1 3 5 (pos 20 130))
  (obj b1 button (pos 20 175))
  (obj b3 button (pos 70 175))
  (obj b5 button (pos 120 175))
  (obj rest number (pos 170 175))
  (obj c1 comment "1" (pos 26 205))
  (obj c3 comment "3" (pos 76 205))
  (obj c5 comment "5" (pos 126 205))
  (obj crest comment "anything else" (pos 170 205))
  (obj in2 number (pos 20 255))
  (obj cin2 comment "input" (pos 85 256))
  (obj key number 60 (pos 150 255))
  (obj ckey comment "value to match" (pos 215 256))
  (obj s1 sel 60 (pos 20 300))
  (obj hit button (pos 20 340))
  (obj miss number (pos 100 340))
  (obj chit comment "match" (pos 20 370))
  (obj cmiss comment "no match" (pos 100 370))
  (obj w1 message start (pos 380 85))
  (obj w2 message stop (pos 430 85))
  (obj w3 message pause (pos 485 85))
  (obj sw sel start stop (pos 380 130))
  (obj go toggle (pos 380 215))
  (obj ss message "set $1" (pos 470 175))
  (obj show message "-" (pos 470 215))
  (obj m1 message 1 (pos 380 175))
  (obj m0 message 0 (pos 420 175))
  (obj cw comment "start: 1, stop: 0, other words: shown" (pos 380 255))
  (connect in 0 sl 0)
  (connect sl 0 b1 0)
  (connect sl 1 b3 0)
  (connect sl 2 b5 0)
  (connect sl 3 rest 0)
  (connect in2 0 s1 0)
  (connect key 0 s1 1)
  (connect s1 0 hit 0)
  (connect s1 1 miss 0)
  (connect w1 0 sw 0)
  (connect w2 0 sw 0)
  (connect w3 0 sw 0)
  (connect sw 0 m1 0)
  (connect sw 1 m0 0)
  (connect sw 2 ss 0)
  (connect ss 0 show 0)
  (connect m1 0 go 0)
  (connect m0 0 go 0))
