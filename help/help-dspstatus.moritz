; help-dspstatus.moritz - for dspstatus~.help.moritz: a dspstatus~ inside a
; pfft~, where the signal vector is one frame (size / 2 bins).
(patch
  (obj c0 comment "dspstatus~ inside a pfft~: the vector size is the frame's bin count" (pos 20 10))
  (obj in inlet (pos 20 45))
  (obj st dspstatus~ (pos 20 85))
  (obj out outlet (pos 140 130))
  (obj c1 comment "signal vector size" (pos 200 131))
  (connect in 0 st 0)
  (connect st 4 out 0))
