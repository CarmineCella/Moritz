; orchidea.help.moritz - help for orchidea
(patch
  (obj title comment "orchidea: a target sound orchestrated, after Orchidea, by the players of an orchestra" (pos 20 12))
  (obj sub comment "A genetic search finds the sounds, one per player or a rest, whose summed spectrum is nearest the target's (a background job; the same seed, the same notes)." (pos 20 34))
  (obj sub2 comment "Out: progress, done, a message a note (k instrument pitch dynamics technique onset duration path cents player; ms), the distance, the solution as a score. The mix goes to out." (pos 20 52))
  (obj tg buffer~ ohbell archeos-bell.wav (pos 20 85))
  (obj mx buffer~ ohmix (pos 200 85))
  (obj or orchestra ohband microsol (pos 440 85))
  (obj lb loadbang (pos 20 120))
  (obj run message "partials 0, run ohbell ohmix" (pos 20 150))
  (obj cpart comment "MicroSOL has no sound at the bell's pitches: no pitch filter (partials 0). With TinySOL, leave it on." (pos 230 151))
  (obj cs comment "seed" (pos 20 185))
  (obj sd number (pos 60 185))
  (obj rs message "seed $1, run ohbell ohmix" (pos 120 185))
  (obj st message stop (pos 330 185))
  (obj rp message report (pos 380 185))
  (obj sh message "show 1" (pos 440 185))
  (obj cc comment "choose another solution:" (pos 510 185))
  (obj ch number (pos 670 185))
  (obj chm message "choose 1 $1" (pos 720 185))
  (obj oi orchidea ohband (pos 20 220))
  (obj prog flonum (pos 20 255))
  (obj dist flonum (pos 330 255))
  (obj cdist comment "distance" (pos 390 256))
  (obj sco message score (pos 100 255))
  (obj pp prepend set (pos 200 290))
  (obj last message "the last note" (pos 200 320))
  (obj pr print orchidea (pos 20 290))
  (obj csc comment "the solution as a score (after each run and choose; score sends it again): a row an instrument, each note its sample" (pos 20 340))
  (obj sc score solution 2 @size 440 170 (pos 20 360))
  (obj tr transport 60 (pos 760 290))
  (obj sp message play (pos 760 320))
  (obj ss message stop (pos 810 320))
  (obj cpl comment "listen:" (pos 480 365))
  (obj p0 message start (pos 535 363))
  (obj p1 message start (pos 620 363))
  (obj cpl2 comment "the bell, the orchestra (or play: the score)" (pos 680 365))
  (obj a0 play~ ohbell 2 (pos 535 395))
  (obj a1 play~ ohmix 2 (pos 620 395))
  (obj vca *~ 0.4 (pos 535 430))
  (obj vcb *~ 0.4 (pos 620 430))
  (obj out dac~ (pos 535 465))
  (obj c9 comment "Static by default: one segment. segmentation flux (and threshold, timegate) or onsets ms... cut a target that changes; each segment" (pos 20 540))
  (obj c10 comment "is searched, then a solution chosen per segment (connection closest, best or path), notes the target keeps held on. See the reference for the rest." (pos 20 558))
  (connect lb 0 run 0)
  (connect run 0 oi 0)
  (connect sd 0 rs 0)
  (connect rs 0 oi 0)
  (connect st 0 oi 0)
  (connect rp 0 oi 0)
  (connect sh 0 oi 0)
  (connect ch 0 chm 0)
  (connect chm 0 oi 0)
  (connect oi 0 prog 0)
  (connect sco 0 oi 0)
  (connect oi 4 sc 0)
  (connect sp 0 sc 0)
  (connect ss 0 sc 0)
  (connect sc 0 vca 0)
  (connect sc 1 vcb 0)
  (connect oi 2 pr 0)
  (connect oi 2 pp 0)
  (connect pp 0 last 0)
  (connect oi 3 dist 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect a0 0 vca 0)
  (connect a0 1 vcb 0)
  (connect a1 0 vca 0)
  (connect a1 1 vcb 0)
  (connect vca 0 out 0)
  (connect vcb 0 out 1))
