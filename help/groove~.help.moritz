; groove~.help.moritz - help for groove~
(patch
  (obj title comment "groove~ name [channels]: variable-speed, looping playback of a buffer~" (pos 20 12))
  (obj sub comment "Left inlet: the rate as a signal (1 = normal, 0.5 = half, -1 = backwards); a float there jumps to that position (ms)." (pos 20 34))
  (obj sub2 comment "loop 1/0 turns looping on/off. Middle/right inlets: loop start and end (ms, 0 = buffer end). Drag on the waveform to set them." (pos 20 52))
  (obj buf buffer~ helpgroove ../examples/sounds/flute.wav (pos 20 80))
  (obj wf waveform~ helpgroove 290 100 (pos 410 80))
  (obj r1 message 1 (pos 210 120))
  (obj r2 message 0.5 (pos 245 120))
  (obj r3 message 2 (pos 290 120))
  (obj r4 message -1 (pos 325 120))
  (obj r5 message 0 (pos 365 120))
  (obj rate flonum 1 (pos 210 155))
  (obj crate comment "rate" (pos 275 156))
  (obj rsig sig~ 1 (pos 210 190))
  (obj lp1 message "loop 1" (pos 20 250))
  (obj lp0 message "loop 0" (pos 80 250))
  (obj clp comment "looping on / off" (pos 20 228))
  (obj j0 message 0 (pos 20 150))
  (obj j1 message 2000 (pos 55 150))
  (obj j2 message startloop (pos 110 150))
  (obj cj comment "jump to ms / loop start" (pos 20 128))
  (obj gr groove~ helpgroove (pos 400 330))
  (obj snap snapshot~ 50 (pos 520 370))
  (obj sync flonum (pos 520 405))
  (obj csync comment "sync: 0-1 through the loop" (pos 520 432))
  (obj cv comment "volume on / off" (pos 150 371))
  (obj on message "0.15 50" (pos 250 370))
  (obj off message "0 50" (pos 320 370))
  (obj ramp line~ (pos 250 405))
  (obj vca *~ (pos 400 440))
  (obj out dac~ (pos 400 480))
  (connect r1 0 rate 0)
  (connect r2 0 rate 0)
  (connect r3 0 rate 0)
  (connect r4 0 rate 0)
  (connect r5 0 rate 0)
  (connect rate 0 rsig 0)
  (connect rsig 0 gr 0)
  (connect lp1 0 gr 0)
  (connect lp0 0 gr 0)
  (connect j0 0 gr 0)
  (connect j1 0 gr 0)
  (connect j2 0 gr 0)
  (connect wf 0 gr 1)
  (connect wf 1 gr 2)
  (connect gr 1 snap 0)
  (connect snap 0 sync 0)
  (connect gr 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
