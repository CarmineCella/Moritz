; function.help.moritz - help for function
(patch
  (obj title comment "function [domain ms] [lo] [hi]: a breakpoint editor" (pos 20 12))
  (obj sub comment "Locked mode: click to add a point, drag to move it, Shift-click to delete it. The points are saved with the patch." (pos 20 34))
  (obj sub2 comment "bang: the curve for line~ (first value, then value-time pairs). A number (ms): the value there. domain, range, clear, set." (pos 20 52))
  (obj go button (pos 20 85))
  (obj cgo comment "play the curve: an envelope over 2 s" (pos 50 88))
  (obj fn function 2000 0 1 0 0 100 1 400 0.5 1500 0.4 2000 0 (pos 20 120))
  (obj env line~ (pos 20 250))
  (obj osc cycle~ 330 (pos 120 250))
  (obj amp *~ (pos 20 285))
  (obj sc scope~ 2048 (pos 330 120))
  (obj at flonum (pos 330 250))
  (obj cat comment "<- time (ms): the value there" (pos 400 251))
  (obj val flonum (pos 330 285))
  (obj d1 message "domain 4000" (pos 20 330))
  (obj d2 message "domain 2000" (pos 115 330))
  (obj cl message clear (pos 210 330))
  (obj ad message "set 0 0 50 1 1000 0.2 2000 0" (pos 265 330))
  (obj on message "0.2 50" (pos 20 375))
  (obj off message "0 50" (pos 85 375))
  (obj cv comment "volume" (pos 140 376))
  (obj ramp line~ (pos 20 410))
  (obj vca *~ (pos 20 445))
  (obj out dac~ (pos 20 480))
  (connect go 0 fn 0)
  (connect fn 1 env 0)
  (connect env 0 amp 1)
  (connect osc 0 amp 0)
  (connect amp 0 sc 0)
  (connect at 0 fn 0)
  (connect fn 0 val 0)
  (connect d1 0 fn 0)
  (connect d2 0 fn 0)
  (connect cl 0 fn 0)
  (connect ad 0 fn 0)
  (connect amp 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
