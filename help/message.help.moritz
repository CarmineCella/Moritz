; message.help.moritz - help for message
(patch
  (obj title comment "message: a box that sends its contents when clicked, or when anything arrives" (pos 20 12))
  (obj sub comment "$1..$9 are replaced by the values that arrive (0 if missing). A comma separates messages." (pos 20 34))
  (obj sub2 comment "After a semicolon, the first word names a receive and the rest is sent there. set ... replaces the contents silently." (pos 20 52))
  (obj n1 number 3 (pos 20 85))
  (obj n2 number 4 (pos 90 85))
  (obj cn comment "drag the left one" (pos 155 86))
  (obj pk pack 3 4 (pos 20 120))
  (obj sw message "$2 $1" (pos 20 155))
  (obj csw comment "$1 is the first value, $2 the second" (pos 80 156))
  (obj up unpack 0 0 (pos 20 190))
  (obj r1 number 4 (pos 20 225))
  (obj r2 number 3 (pos 90 225))
  (obj cr comment "swapped" (pos 155 226))
  (obj two message "100, 200" (pos 20 280))
  (obj ctwo comment "two messages, one after the other:" (pos 100 281))
  (obj last number (pos 20 315))
  (obj clast comment "the number keeps the last, 200" (pos 85 316))
  (obj remote message "; helpma 5; helpmb 9" (pos 400 85))
  (obj cremote comment "sends 5 to helpma" (pos 480 86))
  (obj cremote2 comment "and 9 to helpmb; on screen a new" (pos 480 104))
  (obj cremote3 comment "line starts after each semicolon" (pos 480 122))
  (obj ra receive helpma (pos 400 155))
  (obj rb receive helpmb (pos 510 155))
  (obj va number (pos 400 190))
  (obj vb number (pos 510 190))
  (obj s42 message "set 42" (pos 400 250))
  (obj s7 message "set 7" (pos 470 250))
  (obj cset comment "change the box below" (pos 530 251))
  (obj tgt message 7 (pos 400 285))
  (obj ctgt comment "click it: it sends what it shows" (pos 450 286))
  (obj shown number (pos 400 320))
  (obj edit comment "When editing a box, Return finishes and Shift+Return adds a line break (line breaks count as spaces)." (pos 20 375))
  (connect n1 0 pk 0)
  (connect n2 0 pk 1)
  (connect pk 0 sw 0)
  (connect sw 0 up 0)
  (connect up 0 r1 0)
  (connect up 1 r2 0)
  (connect two 0 last 0)
  (connect ra 0 va 0)
  (connect rb 0 vb 0)
  (connect s42 0 tgt 0)
  (connect s7 0 tgt 0)
  (connect tgt 0 shown 0))
