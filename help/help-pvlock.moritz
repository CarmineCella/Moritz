; help-pvlock.moritz - spectral patch for pvlock~.help.moritz, run by pfft~
; once per FFT frame. A spectral freeze that holds each bin's amplitude,
; phase and phase difference, then makes the resynthesis phase either with
; pvlock~ (peaks advance, the bins around them follow) or with a plain
; frameaccum~ 1 (every bin advances on its own), to compare the two.
(patch
  (obj c0 comment "freeze, with the phase from pvlock~ or from a plain phase accumulator" (pos 20 10))
  (obj in fftin~ 1 (pos 20 45))
  (obj fz inlet (pos 450 45))
  (obj cfz comment "1 freeze, 0 live" (pos 490 46))
  (obj lk inlet (pos 600 45))
  (obj clk comment "0 pvlock~, 1 plain" (pos 640 46))
  (obj cp cartopol~ (pos 20 90))
  (obj rs expr~ "$v1 == 0" (pos 450 90))
  (obj c4 comment "reset: 1 while live" (pos 345 91))
  (obj fd framedelta~ (pos 280 130))
  (obj pw phasewrap~ (pos 280 165))
  (obj ha frameaccum~ (pos 20 215))
  (obj hp frameaccum~ (pos 140 215))
  (obj hd frameaccum~ (pos 280 215))
  (obj lock pvlock~ (pos 20 275))
  (obj plain frameaccum~ 1 (pos 280 275))
  (obj ch expr~ "$v1 * (1 - $v3) + $v2 * $v3" (pos 140 320))
  (obj pc poltocar~ (pos 20 365))
  (obj out fftout~ 1 (pos 20 405))
  (obj n1 comment "The three plain frameaccum~ hold amplitude, phase and phase difference while frozen (they restart from them while live)." (pos 20 445))
  (obj n2 comment "pvlock~ and frameaccum~ 1 both output the analysed phase while reset is 1, and advance the phases while frozen." (pos 20 463))
  (connect in 0 cp 0)
  (connect in 1 cp 1)
  (connect fz 0 rs 0)
  (connect cp 0 ha 1)
  (connect cp 1 hp 1)
  (connect cp 1 fd 0)
  (connect fd 0 pw 0)
  (connect pw 0 hd 1)
  (connect rs 0 ha 2)
  (connect rs 0 hp 2)
  (connect rs 0 hd 2)
  (connect ha 0 lock 0)
  (connect hp 0 lock 1)
  (connect hd 0 lock 2)
  (connect rs 0 lock 3)
  (connect hd 0 plain 0)
  (connect hp 0 plain 1)
  (connect rs 0 plain 2)
  (connect lock 0 ch 0)
  (connect plain 0 ch 1)
  (connect lk 0 ch 2)
  (connect ha 0 pc 0)
  (connect ch 0 pc 1)
  (connect pc 0 out 0)
  (connect pc 1 out 1))
