; arith~.help.moritz - help for +~ -~ *~ /~
(patch
  (obj title comment "+~ -~ *~ /~ [arg]: signal arithmetic" (pos 20 12))
  (obj sub comment "Each inlet takes a signal, or a float when nothing is connected to it. The argument is the starting value of the right inlet." (pos 20 34))
  (obj sub2 comment "With no argument the right value is 0, so a lone *~ outputs silence. /~ outputs 0 where it would divide by 0." (pos 20 52))
  (obj a flonum 3 (pos 20 115))
  (obj ca comment "left" (pos 82 116))
  (obj b flonum 2 (pos 230 115))
  (obj cb comment "right" (pos 292 116))
  (obj lb loadbang (pos 120 78))
  (obj add +~ 2 (pos 20 160))
  (obj sub_ -~ 2 (pos 130 160))
  (obj mul *~ 2 (pos 240 160))
  (obj div /~ 2 (pos 350 160))
  (obj s1 snapshot~ 100 (pos 20 195))
  (obj s2 snapshot~ 100 (pos 130 195))
  (obj s3 snapshot~ 100 (pos 240 195))
  (obj s4 snapshot~ 100 (pos 350 195))
  (obj r1 flonum 0 (pos 20 230))
  (obj r2 flonum 0 (pos 130 230))
  (obj r3 flonum 0 (pos 240 230))
  (obj r4 flonum 0 (pos 350 230))
  (obj cr comment "results, while audio is on" (pos 460 231))
  (obj ring comment "*~ with two signals: ring modulation. Its sound has the sum and difference of the two frequencies." (pos 20 275))
  (obj car cycle~ 440 (pos 20 300))
  (obj mf flonum 30 (pos 130 300))
  (obj cmf comment "modulator (Hz)" (pos 192 301))
  (obj mod cycle~ 30 (pos 130 335))
  (obj rm *~ (pos 20 370))
  (obj on message "0.15 50" (pos 250 370))
  (obj off message "0 50" (pos 320 370))
  (obj cv comment "volume on / off" (pos 380 371))
  (obj ramp line~ (pos 250 405))
  (obj vca *~ (pos 20 440))
  (obj out dac~ (pos 20 480))
  (connect lb 0 a 0)
  (connect lb 0 b 0)
  (connect a 0 add 0)
  (connect a 0 sub_ 0)
  (connect a 0 mul 0)
  (connect a 0 div 0)
  (connect b 0 add 1)
  (connect b 0 sub_ 1)
  (connect b 0 mul 1)
  (connect b 0 div 1)
  (connect add 0 s1 0)
  (connect sub_ 0 s2 0)
  (connect mul 0 s3 0)
  (connect div 0 s4 0)
  (connect s1 0 r1 0)
  (connect s2 0 r2 0)
  (connect s3 0 r3 0)
  (connect s4 0 r4 0)
  (connect car 0 rm 0)
  (connect mf 0 mod 0)
  (connect mod 0 rm 1)
  (connect rm 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
