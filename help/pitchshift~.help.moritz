; pitchshift~.help.moritz - help for pitchshift~ (an abstraction in the library)
(patch
  (obj title comment "pitchshift~ [semitones]: transposes a live signal, keeping its formants" (pos 20 12))
  (obj sub comment "Inlets: the signal, semitones (decimals allowed), formant preservation 1/0 (on at the start). One window (2048 samples) of latency." (pos 20 34))
  (obj sub2 comment "An abstraction: sparkle~ without a buffer~, pitch ratio 2^(semitones/12), envelope 60. Double-click it to see inside." (pos 20 52))
  (obj b buffer~ helppsvox ../examples/sounds/Vox.wav (pos 20 85))
  (obj pl message "loop 1, start" (pos 20 120))
  (obj v sparkle~ helppsvox (pos 20 155))
  (obj cst comment "semitones" (pos 200 100))
  (obj st slider -12 12 (pos 200 120))
  (obj stn number (pos 355 120))
  (obj kf toggle (pos 440 120))
  (obj ckf comment "keep the formants" (pos 470 123))
  (obj ps pitchshift~ 0 (pos 20 200))
  (obj on message "0.5 50" (pos 250 240))
  (obj off message "0 50" (pos 320 240))
  (obj ramp line~ (pos 250 275))
  (obj vca *~ (pos 20 275))
  (obj out dac~ (pos 20 315))
  (obj lb loadbang (pos 600 100))
  (obj one message 1 (pos 600 130))
  (connect pl 0 v 0)
  (connect v 0 ps 0)
  (connect st 0 stn 0)
  (connect stn 0 ps 1)
  (connect kf 0 ps 2)
  (connect ps 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 one 0)
  (connect one 0 kf 0))
