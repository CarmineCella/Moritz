; kmeans.help.moritz - help for kmeans
(patch
  (obj title comment "kmeans: groups points into k clusters; then tells which cluster a new point belongs to" (pos 20 12))
  (obj sub comment "add x y ... adds a point; train k [iterations] finds the clusters (the console shows their sizes); a list then gives its cluster" (pos 20 34))
  (obj sub2 comment "(0..k-1) and that cluster's centroid. centroid i, seed n, normalize 0/1, clear, write/read file. Points are standardised first." (pos 20 52))
  (obj pts message "add 1 1, add 1.5 2, add 2 1, add 8 8, add 9 7.5, add 8.5 9, add 1 9, add 2 8.5, add 1.5 7.8" (pos 20 85))
  (obj cpts comment "three groups of points (click, then train)" (pos 20 110))
  (obj tr message "train 3" (pos 20 135))
  (obj tr2 message "train 2" (pos 85 135))
  (obj qx flonum 1.2 (pos 20 175))
  (obj qy flonum 1.5 (pos 100 175))
  (obj tq t b f (pos 100 205))
  (obj pk pack 1.2 1.5 (pos 20 235))
  (obj cq comment "a new point (drag x or y)" (pos 180 176))
  (obj km kmeans (pos 20 270))
  (obj cn number (pos 20 310))
  (obj ccn comment "its cluster" (pos 80 311))
  (obj cen unpack 0. 0. (pos 180 310))
  (obj c0 flonum (pos 180 345))
  (obj c1 flonum (pos 260 345))
  (obj ccen comment "the cluster's centroid" (pos 340 346))
  (obj ce message "centroid 0" (pos 180 270))
  (obj lb loadbang (pos 420 85))
  (connect lb 0 pts 0)
  (connect pts 0 km 0)
  (connect tr 0 km 0)
  (connect tr2 0 km 0)
  (connect qx 0 pk 0)
  (connect qy 0 tq 0)
  (connect tq 1 pk 1)
  (connect tq 0 pk 0)
  (connect pk 0 km 0)
  (connect ce 0 km 0)
  (connect km 0 cn 0)
  (connect km 1 cen 0)
  (connect cen 0 c0 0)
  (connect cen 1 c1 0))
