; gain~.help.moritz - help for gain~
(patch
  (obj title comment "gain~ [ramp amplitude]: a fader that scales a signal without clicks" (pos 20 12))
  (obj sub comment "The fader runs in dB from silence to +6 dB; the side marks are 0 dB. A number in the left inlet sets the amplitude, 0 to 2." (pos 20 34))
  (obj sub2 comment "Each change ramps over the ramp time in ms (default 20, right inlet). The right outlet sends the amplitude on drag or bang." (pos 20 52))
  (obj src saw~ 220 (pos 20 98))
  (obj ca comment "amplitude (1 = unity); bang reports it" (pos 100 78))
  (obj a1 message 1 (pos 100 98))
  (obj a2 message 0.5 (pos 140 98))
  (obj a3 message 0.1 (pos 184 98))
  (obj a4 message 0 (pos 228 98))
  (obj bng message bang (pos 270 98))
  (obj cr comment "ramp time (ms)" (pos 380 78))
  (obj r1 message 20 (pos 380 98))
  (obj r2 message 2000 (pos 420 98))
  (obj g gain~ 20 1 (pos 20 170))
  (obj on message "0.15 50" (pos 250 200))
  (obj off message "0 50" (pos 320 200))
  (obj cv comment "volume on / off" (pos 380 201))
  (obj ramp line~ (pos 250 235))
  (obj amp flonum 1 (pos 110 330))
  (obj camp comment "amplitude: sent when you drag the fader, or on bang" (pos 180 331))
  (obj todb atodb (pos 110 365))
  (obj db flonum 0 (pos 110 400))
  (obj cdb comment "in dB" (pos 180 401))
  (obj vca *~ (pos 20 345))
  (obj out dac~ (pos 20 385))
  (connect src 0 g 0)
  (connect a1 0 g 0)
  (connect a2 0 g 0)
  (connect a3 0 g 0)
  (connect a4 0 g 0)
  (connect bng 0 g 0)
  (connect r1 0 g 1)
  (connect r2 0 g 1)
  (connect g 0 vca 0)
  (connect g 1 amp 0)
  (connect amp 0 todb 0)
  (connect todb 0 db 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
