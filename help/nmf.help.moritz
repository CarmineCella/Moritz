; nmf.help.moritz - help for nmf
(patch
  (obj title comment "nmf [components] [iterations]: separates a buffer~ into parts by non-negative matrix factorisation" (pos 20 12))
  (obj sub comment "The magnitude spectrogram V ~ W H: W a spectrum per part, H when it sounds. run source dest writes one part per channel of dest;" (pos 20 34))
  (obj sub2 comment "the parts add up to the source (mixed to mono). components k, iterations n, size n (FFT), seed n, stop. Outlets: progress, bang." (pos 20 52))
  (obj src buffer~ helpnmfsrc ../examples/sounds/stems_demo.wav (pos 20 85))
  (obj dst buffer~ helpparts (pos 345 85))
  (obj k3 message "components 2" (pos 20 120))
  (obj k5 message "components 4" (pos 125 120))
  (obj run message "run helpnmfsrc helpparts" (pos 20 155))
  (obj nm nmf 4 100 (pos 20 190))
  (obj prog flonum (pos 20 230))
  (obj done button (pos 100 230))
  (obj cp comment "progress, done: then play the parts" (pos 130 233))
  (obj wf waveform~ helpparts 320 120 (pos 320 120))
  (obj go message "start, loop 1" (pos 20 270))
  (obj pl play~ helpparts 5 (pos 20 305))
  (obj s1 message 1 (pos 20 345))
  (obj s2 message 2 (pos 55 345))
  (obj s3 message 3 (pos 90 345))
  (obj s4 message 4 (pos 125 345))
  (obj s5 message 5 (pos 160 345))
  (obj cs comment "hear part 1..5 (a mix of drums, bass, chords and melody; parts beyond k are silent)" (pos 200 346))
  (obj sel selector~ 5 1 (pos 20 380))
  (obj on message "0.3 50" (pos 20 420))
  (obj off message "0 50" (pos 85 420))
  (obj cv comment "volume" (pos 140 421))
  (obj ramp line~ (pos 20 455))
  (obj vca *~ (pos 160 455))
  (obj out dac~ (pos 160 490))
  (connect k3 0 nm 0)
  (connect k5 0 nm 0)
  (connect run 0 nm 0)
  (connect nm 0 prog 0)
  (connect nm 1 done 0)
  (connect go 0 pl 0)
  (connect pl 0 sel 1)
  (connect pl 1 sel 2)
  (connect pl 2 sel 3)
  (connect pl 3 sel 4)
  (connect pl 4 sel 5)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect s4 0 sel 0)
  (connect s5 0 sel 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
