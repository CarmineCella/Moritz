; send.help.moritz - help for send and receive (s, r)
(patch
  (obj title comment "send name, receive name (or s, r): messages without cables, to every receive with the same name" (pos 20 12))
  (obj sub comment "send has one inlet and no outlet; receive has one outlet and no inlet. The names are shared by every open patch and" (pos 20 34))
  (obj sub2 comment "subpatcher, so choose names that won't clash. A message box sends too: \"; name 99\" sends 99 to receive name." (pos 20 52))
  (obj num flonum (pos 20 85))
  (obj cnum comment "drag me" (pos 85 86))
  (obj snd s helpsend (pos 20 125))
  (obj remote message "; helpsend 99" (pos 260 85))
  (obj cremote comment "click: sends 99 to helpsend" (pos 360 86))
  (obj c1 comment "Far away, or in another patch:" (pos 20 175))
  (obj r1 r helpsend (pos 20 200))
  (obj r2 receive helpsend (pos 260 200))
  (obj o1 flonum (pos 20 240))
  (obj o2 flonum (pos 260 240))
  (obj co comment "every receive gets it" (pos 330 241))
  (obj c2 comment "Any message works, a bang too:" (pos 20 290))
  (obj b1 button (pos 20 315))
  (obj sb send helpbang (pos 20 350))
  (obj rb receive helpbang (pos 260 315))
  (obj b2 button (pos 260 350))
  (connect num 0 snd 0)
  (connect r1 0 o1 0)
  (connect r2 0 o2 0)
  (connect b1 0 sb 0)
  (connect rb 0 b2 0))
