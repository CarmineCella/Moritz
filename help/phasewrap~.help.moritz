; phasewrap~.help.moritz - help for phasewrap~
(patch
  (obj title comment "phasewrap~: wrap a phase into -pi..pi" (pos 20 12))
  (obj sub comment "Adds or subtracts whole turns (2 pi) until the value lies between -pi and pi. It needs a signal: use sig~ for a number." (pos 20 34))
  (obj sub2 comment "In a pfft~ it follows framedelta~, so each bin's phase difference reads as its frequency (see the framedelta~ help)." (pos 20 52))
  (obj m1 message 1 (pos 20 80))
  (obj m2 message 3.5 (pos 55 80))
  (obj m3 message 7 (pos 105 80))
  (obj m4 message -4 (pos 140 80))
  (obj m5 message 10 (pos 180 80))
  (obj in flonum 7 (pos 20 115))
  (obj cin comment "a phase in radians" (pos 90 116))
  (obj sg sig~ 7 (pos 20 150))
  (obj pw phasewrap~ (pos 20 185))
  (obj snap snapshot~ 50 (pos 20 220))
  (obj outn flonum (pos 20 255))
  (obj cout comment "wrapped: 7 -> 0.717, -4 -> 2.283" (pos 112 256))
  (obj ph phasor~ 110 (pos 330 80))
  (obj cph comment "ramp 0 to 1" (pos 425 81))
  (obj turns *~ 18.85 (pos 330 115))
  (obj cturns comment "0 to 6 pi: three turns" (pos 425 116))
  (obj pw2 phasewrap~ (pos 330 150))
  (obj norm *~ 0.3183 (pos 330 185))
  (obj cnorm comment "divide by pi" (pos 425 186))
  (obj sc scope~ (pos 535 215))
  (obj csc comment "a 330 Hz sawtooth, -1 to 1" (pos 535 320))
  (obj on message "0.15 50" (pos 330 235))
  (obj off message "0 50" (pos 400 235))
  (obj cv comment "volume on / off" (pos 445 236))
  (obj ramp line~ (pos 330 270))
  (obj vca *~ (pos 330 305))
  (obj out dac~ (pos 330 345))
  (connect m1 0 in 0)
  (connect m2 0 in 0)
  (connect m3 0 in 0)
  (connect m4 0 in 0)
  (connect m5 0 in 0)
  (connect in 0 sg 0)
  (connect sg 0 pw 0)
  (connect pw 0 snap 0)
  (connect snap 0 outn 0)
  (connect ph 0 turns 0)
  (connect turns 0 pw2 0)
  (connect pw2 0 norm 0)
  (connect norm 0 sc 0)
  (connect norm 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
