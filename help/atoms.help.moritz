; atoms.help.moritz - help for atoms
(patch
  (obj title comment "atoms name: a dictionary for pursuit (matching pursuit, after Maple)" (pos 20 12))
  (obj sub comment "pursuit explains a sound as a sum of atoms from a dictionary. Parametric atoms are windowed cosines at every scale and frequency;" (pos 20 34))
  (obj sub2 comment "atoms of sounds are cut from recordings: a sound rebuilt from them is a hybrid. Outlets: progress, bang when ready, number of atoms." (pos 20 52))
  (obj c1 comment "parametric: window lengths min max (samples, powers of 2), highest frequency" (pos 20 85))
  (obj g1 message "gabor 256 8192 16000" (pos 20 105))
  (obj g2 message "gammatone 128 4096" (pos 175 105))
  (obj cg comment "Gaussian windows; or a gammatone envelope: sharp attack, slow decay" (pos 320 106))
  (obj c2 comment "sounds: every file of a folder, cut into frames (ms, hop), at the onsets (threshold, longest ms), or whole (longest ms)" (pos 20 140))
  (obj f1 message "frames ../data/kitchen 100 100" (pos 20 160))
  (obj f2 message "onsets ../data/kitchen 2 1000" (pos 20 190))
  (obj f3 message "files ../data/people 1500" (pos 20 220))
  (obj c3 comment "or from a buffer~: add buffer [frames ms hop | onsets threshold | whole]" (pos 20 255))
  (obj b buffer~ hatdrums ../data/drums.wav (pos 20 275))
  (obj f4 message "clear, add hatdrums onsets 2" (pos 290 275))
  (obj d atoms hatdict (pos 20 320))
  (obj prog flonum (pos 20 360))
  (obj done button (pos 90 360))
  (obj n number (pos 130 360))
  (obj cn comment "progress, ready, atoms" (pos 190 361))
  (obj c4 comment "listen to atom k:" (pos 20 405))
  (obj k number (pos 135 403))
  (obj get message "get $1 hatone" (pos 20 435))
  (obj one buffer~ hatone (pos 140 435))
  (obj pl message start (pos 20 465))
  (obj play play~ hatone (pos 20 495))
  (obj vca *~ 0.5 (pos 20 525))
  (obj out dac~ (pos 20 555))
  (obj c5 comment "info prints what it holds; write file and read file keep a large dictionary on disk (no need to cut the sounds again)." (pos 20 595))
  (obj info message info (pos 20 615))
  (obj w message "write /tmp/kitchen.atoms" (pos 70 615))
  (obj r message "read /tmp/kitchen.atoms" (pos 240 615))
  (obj see comment "See pursuit, and examples/maple-atoms and maple-hybrid." (pos 20 650))
  (connect g1 0 d 0)
  (connect g2 0 d 0)
  (connect f1 0 d 0)
  (connect f2 0 d 0)
  (connect f3 0 d 0)
  (connect f4 0 d 0)
  (connect d 0 prog 0)
  (connect d 1 done 0)
  (connect d 2 n 0)
  (connect k 0 get 0)
  (connect get 0 d 0)
  (connect get 0 pl 0)
  (connect pl 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect info 0 d 0)
  (connect w 0 d 0)
  (connect r 0 d 0))
