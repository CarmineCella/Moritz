; expr~.help.moritz - help for expr~
(patch
  (obj title comment "expr~ expression: an expression computed for every sample" (pos 20 12))
  (obj sub comment "$v1 to $v9 are the inlets, which take signals or floats; the highest one used sets the number of inlets. $i1..$i9 truncate." (pos 20 34))
  (obj sub2 comment "Operators: + - * / %, the comparisons == != < > <= >= (they give 1 or 0), && || ! and the constant pi." (pos 20 52))
  (obj saw saw~ 220 (pos 20 85))
  (obj osc cycle~ 330 (pos 125 85))
  (obj m0 message 0 (pos 250 85))
  (obj m5 message 0.5 (pos 290 85))
  (obj m1 message 1 (pos 334 85))
  (obj mix flonum 0 (pos 250 120))
  (obj cmix comment "mix: 0 = saw~, 1 = cycle~ (a float into $v3)" (pos 312 121))
  (obj e expr~ "$v1 * (1 - $v3) + $v2 * $v3" (pos 20 165))
  (obj sc scope~ (pos 480 210))
  (obj on message "0.15 50" (pos 200 250))
  (obj off message "0 50" (pos 270 250))
  (obj cv comment "volume on / off" (pos 330 251))
  (obj ramp line~ (pos 200 285))
  (obj vca *~ (pos 20 320))
  (obj out dac~ (pos 20 360))
  (obj t1 comment "Functions: sin cos tan asin acos atan sinh cosh tanh exp log log10 sqrt abs floor ceil int round," (pos 20 400))
  (obj t2 comment "and with two arguments pow atan2 min max fmod random(lo, hi). Errors are shown in the console." (pos 20 418))
  (obj t3 comment "Dividing by 0 gives 0, and so does any result that is not a finite number." (pos 20 436))
  (connect m0 0 mix 0)
  (connect m5 0 mix 0)
  (connect m1 0 mix 0)
  (connect saw 0 e 0)
  (connect osc 0 e 1)
  (connect mix 0 e 2)
  (connect e 0 sc 0)
  (connect e 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
