; convert.help.moritz - help for mtof, ftom, dbtoa, atodb
(patch
  (obj title comment "mtof  ftom  dbtoa  atodb: MIDI note <-> frequency in Hz, decibels <-> amplitude" (pos 20 12))
  (obj sub comment "One inlet: a number is converted and output; bang outputs the last result again. MIDI note 69 is 440 Hz, 0 dB is 1." (pos 20 34))
  (obj sub2 comment "ftom of 0 Hz or less gives 0, and atodb of 0 or less gives -999. Nothing is rounded: ftom 450 is 69.39." (pos 20 52))
  (obj n60 message 60 (pos 20 85))
  (obj n69 message 69 (pos 60 85))
  (obj n72 message 72 (pos 100 85))
  (obj note number 60 (pos 20 120))
  (obj cnote comment "MIDI note" (pos 85 121))
  (obj m2f mtof (pos 20 160))
  (obj hz flonum 261.626 (pos 20 200))
  (obj chz comment "Hz" (pos 100 201))
  (obj osc cycle~ 261.626 (pos 20 240))
  (obj on message "0.15 50" (pos 130 240))
  (obj off message "0 50" (pos 200 240))
  (obj cv comment "volume on / off" (pos 250 241))
  (obj ramp line~ (pos 130 275))
  (obj vca *~ (pos 20 310))
  (obj out dac~ (pos 20 350))
  (obj fin flonum 450 (pos 380 85))
  (obj cfin comment "Hz" (pos 445 86))
  (obj f2m ftom (pos 380 120))
  (obj fout flonum (pos 380 155))
  (obj cfout comment "MIDI note" (pos 460 156))
  (obj dbin flonum -6 (pos 380 205))
  (obj cdbin comment "dB" (pos 445 206))
  (obj d2a dbtoa (pos 380 240))
  (obj dbout flonum (pos 380 275))
  (obj cdbout comment "amplitude" (pos 460 276))
  (obj ain flonum 0.5 (pos 380 325))
  (obj cain comment "amplitude" (pos 445 326))
  (obj a2d atodb (pos 380 360))
  (obj aout flonum (pos 380 395))
  (obj caout comment "dB" (pos 460 396))
  (connect n60 0 note 0)
  (connect n69 0 note 0)
  (connect n72 0 note 0)
  (connect note 0 m2f 0)
  (connect m2f 0 hz 0)
  (connect hz 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect fin 0 f2m 0)
  (connect f2m 0 fout 0)
  (connect dbin 0 d2a 0)
  (connect d2a 0 dbout 0)
  (connect ain 0 a2d 0)
  (connect a2d 0 aout 0))
