; poly~.help.moritz - help for poly~ and thispoly~
(patch
  (obj title comment "poly~ name voices [args]: copies of the abstraction name.moritz, with voice allocation" (pos 20 12))
  (obj sub comment "Its ports are the in / out boxes of the voice; the voices' signal outlets are summed. args become #1..#9 in each voice." (pos 20 34))
  (obj sub2 comment "thispoly~, inside a voice, outputs the voice number (from 1); the voice stays busy while the signal into it is not 0." (pos 20 52))
  (obj keys kslider 2 60 (pos 20 80))
  (obj pk pack 0 0 (pos 20 150))
  (obj ckeys comment "hold a key" (pos 100 151))
  (obj mn message "midinote $1 $2" (pos 20 180))
  (obj on1 message "midinote 64 100" (pos 240 80))
  (obj con1 comment "starts pitch 64 on a free voice" (pos 370 81))
  (obj off1 message "midinote 64 0" (pos 240 106))
  (obj coff1 comment "velocity 0: releases the voice playing 64" (pos 370 107))
  (obj nt message "note 72 100" (pos 240 136))
  (obj cnt comment "note ...: to a free voice, or steals the oldest" (pos 370 137))
  (obj tg2 message "target 2" (pos 240 162))
  (obj ctg2 comment "later messages go to voice 2 only" (pos 370 163))
  (obj other message "79 100" (pos 240 188))
  (obj cother comment "other messages: to the target voice" (pos 370 189))
  (obj tg0 message "target 0" (pos 240 214))
  (obj ctg0 comment "target 0: other messages go to every voice" (pos 370 215))
  (obj mu1 message "mute 1 1" (pos 240 244))
  (obj cmu1 comment "stops voice 1, even its new notes (0 = all voices)" (pos 370 245))
  (obj mu0 message "mute 1 0" (pos 240 270))
  (obj cmu0 comment "restarts it" (pos 370 271))
  (obj poly poly~ help-polyvoice 4 (pos 20 310))
  (obj vnum number (pos 260 350))
  (obj cvnum comment "voice that took the last note" (pos 325 351))
  (obj on message "0.15 50" (pos 90 350))
  (obj off message "0 50" (pos 160 350))
  (obj ramp line~ (pos 90 385))
  (obj cv comment "volume on / off" (pos 150 386))
  (obj vca *~ (pos 20 420))
  (obj out dac~ (pos 20 460))
  (obj open comment "Double-click poly~ (locked) to open its first voice, help-polyvoice.moritz." (pos 20 495))
  (connect keys 0 pk 0)
  (connect keys 1 pk 1)
  (connect pk 0 mn 0)
  (connect mn 0 poly 0)
  (connect on1 0 poly 0)
  (connect off1 0 poly 0)
  (connect nt 0 poly 0)
  (connect tg2 0 poly 0)
  (connect other 0 poly 0)
  (connect tg0 0 poly 0)
  (connect mu1 0 poly 0)
  (connect mu0 0 poly 0)
  (connect poly 0 vca 0)
  (connect poly 1 vnum 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
