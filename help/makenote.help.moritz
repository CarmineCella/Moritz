; makenote.help.moritz - help for makenote
(patch
  (obj title comment "makenote [velocity] [duration ms]: a note-on now and its note-off later" (pos 20 12))
  (obj sub comment "A pitch in the left inlet goes out at once with the velocity, and again with velocity 0 after the duration." (pos 20 34))
  (obj sub2 comment "Inlets: pitch, velocity, duration. stop sends the pending note-offs now; clear forgets them." (pos 20 52))
  (obj tog toggle (pos 20 85))
  (obj ct comment "play random notes" (pos 50 88))
  (obj met metro 250 (pos 20 120))
  (obj rnd random 24 (pos 20 155))
  (obj base + 48 (pos 20 190))
  (obj d1 message 100 (pos 200 155))
  (obj d2 message 600 (pos 245 155))
  (obj cd comment "duration (ms)" (pos 290 156))
  (obj mk makenote 100 100 (pos 20 230))
  (obj stop message stop (pos 200 230))
  (obj ks kslider 2 48 (pos 20 270))
  (obj cks comment "the held notes" (pos 330 290))
  (obj pk pack 0 0 (pos 20 345))
  (obj mn message "midinote $1 $2" (pos 20 380))
  (obj poly poly~ keyvoice 8 (pos 20 415))
  (obj on message "0.15 50" (pos 200 380))
  (obj off message "0 50" (pos 270 380))
  (obj cv comment "volume on / off" (pos 330 381))
  (obj ramp line~ (pos 200 415))
  (obj vca *~ (pos 20 455))
  (obj out dac~ (pos 20 495))
  (connect tog 0 met 0)
  (connect met 0 rnd 0)
  (connect rnd 0 base 0)
  (connect base 0 mk 0)
  (connect d1 0 mk 2)
  (connect d2 0 mk 2)
  (connect stop 0 mk 0)
  (connect mk 1 ks 1)
  (connect mk 0 ks 0)
  (connect mk 1 pk 1)
  (connect mk 0 pk 0)
  (connect pk 0 mn 0)
  (connect mn 0 poly 0)
  (connect poly 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
