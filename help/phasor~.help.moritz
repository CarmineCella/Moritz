; phasor~.help.moritz - help for phasor~
(patch
  (obj title comment "phasor~ [freq]: ramp from 0 to 1, for LFOs and as a position signal" (pos 20 12))
  (obj sub comment "Left inlet: frequency in Hz, a float or a signal. A negative frequency ramps down, from 1 to 0." (pos 20 34))
  (obj sub2 comment "Right inlet: phase 0-1, restarts the ramp there. phasor~ is not band-limited: for a sawtooth sound, use saw~." (pos 20 52))
  (obj f1 message 0.5 (pos 20 80))
  (obj f2 message 2 (pos 62 80))
  (obj f3 message 100 (pos 104 80))
  (obj f4 message -2 (pos 146 80))
  (obj freq flonum 0.5 (pos 20 115))
  (obj cf comment "frequency (Hz)" (pos 84 116))
  (obj p0 message 0 (pos 200 115))
  (obj p5 message 0.5 (pos 242 115))
  (obj cph comment "phase: restart the ramp there" (pos 284 116))
  (obj ph phasor~ 0.5 (pos 20 155))
  (obj snap snapshot~ 50 (pos 20 200))
  (obj val flonum 0 (pos 20 235))
  (obj cval comment "value, every 50 ms" (pos 20 262))
  (obj centre -~ 0.5 (pos 150 200))
  (obj sc scope~ (pos 150 240))
  (obj csc comment "-~ 0.5 centres the ramp for scope~: try 100 Hz" (pos 20 350))
  (obj depth *~ 400 (pos 360 200))
  (obj base +~ 200 (pos 360 235))
  (obj cbase comment "a siren from 200 to 600 Hz" (pos 425 236))
  (obj osc cycle~ (pos 360 270))
  (obj on message "0.15 50" (pos 450 290))
  (obj off message "0 50" (pos 520 290))
  (obj cv comment "volume on / off" (pos 580 291))
  (obj ramp line~ (pos 450 325))
  (obj vca *~ (pos 360 360))
  (obj out dac~ (pos 360 400))
  (connect f1 0 freq 0)
  (connect f2 0 freq 0)
  (connect f3 0 freq 0)
  (connect f4 0 freq 0)
  (connect freq 0 ph 0)
  (connect p0 0 ph 1)
  (connect p5 0 ph 1)
  (connect ph 0 snap 0)
  (connect snap 0 val 0)
  (connect ph 0 centre 0)
  (connect centre 0 sc 0)
  (connect ph 0 depth 0)
  (connect depth 0 base 0)
  (connect base 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
