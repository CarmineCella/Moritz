; typegen.help.moritz - help for typegen
(patch
  (obj title comment "typegen [model]: new sequences of the types of a soundtypes model" (pos 20 12))
  (obj sub comment "classic n: SoundTypes' n-grams. markov order count: the longest context seen often enough. oracle continuity context: a factor oracle" (pos 20 34))
  (obj sub2 comment "that follows the original (continuity 1: the original itself) or jumps where the recent past repeats. Units of level n, joined by crossfades." (pos 20 52))
  (obj src buffer~ htgsrc ../data/drums.wav (pos 20 85))
  (obj out buffer~ htgout (pos 280 85))
  (obj lab buffer~ htglab (pos 400 85))
  (obj lb loadbang (pos 20 115))
  (obj an message "analyse htgsrc" (pos 20 145))
  (obj st soundtypes htgdrums (pos 20 175))
  (obj g typegen htgdrums (pos 20 340))
  (obj cm comment "method:" (pos 20 210))
  (obj m1 message "classic 2" (pos 80 208))
  (obj m2 message "markov 3 2" (pos 155 208))
  (obj m3 message "oracle 0.8 1" (pos 240 208))
  (obj m4 message "oracle 0.3 2" (pos 335 208))
  (obj cl comment "level:" (pos 20 240))
  (obj l1 message "level 1" (pos 80 238))
  (obj l2 message "level 2" (pos 140 238))
  (obj i1 message "inner 1" (pos 210 238))
  (obj i5 message "inner 0.3 1" (pos 270 238))
  (obj gen message "generate 12 htgout htglab" (pos 20 275))
  (obj cgen comment "12 s of a new sound, and its types" (pos 200 276))
  (obj seed message "seed 7" (pos 20 305))
  (obj prog flonum (pos 20 375))
  (obj done button (pos 90 375))
  (obj pl message start (pos 130 375))
  (obj play play~ htgout (pos 130 405))
  (obj l3 loadbang (pos 560 115))
  (obj s3 message "colors types, title the new sound's types (level 1 below)" (pos 400 145))
  (obj gs plot htglab 520 80 (pos 400 175))
  (obj gw plot htgout 520 70 (pos 400 265))
  (obj clive comment "live: next gives the next unit of an endless sequence (start end, ms, in the original): play it, then ask again" (pos 20 455))
  (obj tg toggle (pos 20 480))
  (obj met metro 250 (pos 20 510))
  (obj nx message next (pos 20 540))
  (obj ty number (pos 120 575))
  (obj cty comment "type" (pos 180 576))
  (obj pl2 message "start $1 $2" (pos 20 605))
  (obj play2 play~ htgsrc 2 (pos 20 635))
  (obj mix +~ (pos 130 670))
  (obj vca *~ 0.5 (pos 130 700))
  (obj o dac~ (pos 130 735))
  (obj cin comment "inner c: levels mixed: units of level 2 or 3 played with the level below regenerated (an oracle walk of continuity c from each one's first sub-unit); 1: as they are" (pos 20 775))
  (connect i1 0 g 0)
  (connect i5 0 g 0)
  (connect lb 0 an 0)
  (connect an 0 st 0)
  (connect m1 0 g 0)
  (connect m2 0 g 0)
  (connect m3 0 g 0)
  (connect m4 0 g 0)
  (connect l1 0 g 0)
  (connect l2 0 g 0)
  (connect gen 0 g 0)
  (connect seed 0 g 0)
  (connect st 1 gen 0)
  (connect g 0 prog 0)
  (connect g 1 done 0)
  (connect done 0 pl 0)
  (connect pl 0 play 0)
  (connect l3 0 s3 0)
  (connect s3 0 gs 0)
  (connect tg 0 met 0)
  (connect met 0 nx 0)
  (connect nx 0 g 0)
  (connect g 2 ty 0)
  (connect g 3 pl2 0)
  (connect pl2 0 play2 0)
  (connect play 0 mix 0)
  (connect play2 0 mix 0)
  (connect play2 1 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 o 0)
  (connect vca 0 o 1))
