; scale.help.moritz - help for scale
(patch
  (obj title comment "scale inlo inhi outlo outhi [exp]: maps a number from one range to another" (pos 20 12))
  (obj sub comment "Left inlet (hot): the number to map; bang maps it again. Inlets 2 to 6 (cold) replace the arguments, in order." (pos 20 34))
  (obj sub2 comment "Defaults: 0 127 0 1. With exp 1 (or none) the map is a straight line; other values bend it. Nothing is clipped. As in Max," (pos 20 52))
  (obj sub3 comment "four integer arguments make it output integers (scale 0 127 0 10 gives 0 to 10 in steps of 1); write 0. 1. for decimals." (pos 20 70))
  (obj sl slider 0 127 (pos 20 105))
  (obj csl comment "drag: 0 to 127" (pos 175 108))
  (obj in number (pos 20 140))
  (obj hi flonum 1 (pos 150 140))
  (obj chi comment "out high of the first scale (cold)" (pos 215 141))
  (obj s1 scale 0 127 0. 1. (pos 20 190))
  (obj s2 scale 0 127 20 2000 2 (pos 200 190))
  (obj s3 scale 0 127 1. 0. (pos 420 190))
  (obj r1 flonum (pos 20 230))
  (obj r2 flonum (pos 200 230))
  (obj r3 flonum (pos 420 230))
  (obj c1 comment "0 to 1" (pos 20 265))
  (obj c2 comment "20 to 2000, curved: exp 2" (pos 200 265))
  (obj c3 comment "1 to 0: reversed" (pos 420 265))
  (obj c4 comment "exp above 1 starts slowly and speeds up (good for frequencies and times); below 1 the opposite." (pos 20 305))
  (obj c5 comment "After changing a cold inlet, drag the slider again to see the new result." (pos 20 325))
  (connect sl 0 in 0)
  (connect in 0 s1 0)
  (connect in 0 s2 0)
  (connect in 0 s3 0)
  (connect hi 0 s1 4)
  (connect s1 0 r1 0)
  (connect s2 0 r2 0)
  (connect s3 0 r3 0))
