; reverb~.help.moritz - help for reverb~ (the abstraction library/reverb~.moritz)
(patch
  (obj title comment "reverb~ [mix] [T60]: a stereo Freeverb (an abstraction, library/reverb~.moritz)" (pos 20 12))
  (obj sub comment "Inlets: the signal; wet/dry mix 0-1 (0.3 by default); decay time T60 in seconds, 0.1-100 (2 by default)." (pos 20 34))
  (obj sub2 comment "Outlets: left and right. The mix changes over 20 ms; T60 is how long the tail takes to fall by 60 dB." (pos 20 52))
  (obj osc cycle~ 660 (pos 20 85))
  (obj blip message "1 5 0 250" (pos 120 85))
  (obj cblip comment "click: a short blip" (pos 200 86))
  (obj env line~ (pos 120 120))
  (obj vblip *~ (pos 20 155))
  (obj mix flonum 0.3 (pos 150 160))
  (obj cmix comment "mix: 0 dry, 1 wet" (pos 215 161))
  (obj t60 flonum 2 (pos 360 160))
  (obj ct60 comment "T60 (seconds)" (pos 425 161))
  (obj rv reverb~ 0.3 2 (pos 20 210))
  (obj crv comment "left and right outlets" (pos 165 213))
  (obj on message "0.15 50" (pos 220 255))
  (obj off message "0 50" (pos 290 255))
  (obj cv comment "volume on / off" (pos 350 256))
  (obj ramp line~ (pos 220 285))
  (obj vl *~ (pos 20 320))
  (obj vr *~ (pos 120 320))
  (obj out dac~ (pos 20 360))
  (obj how comment "Per channel: eight damped comb filters in parallel, then four allpass~ in series; the right one's delays are a little longer." (pos 20 405))
  (obj zero comment "An argument of 0 counts as missing (reverb~ 0 starts at mix 0.3): send 0 to the mix inlet for a dry signal." (pos 20 425))
  (obj open comment "Double-click reverb~ (locked) to open the abstraction." (pos 20 445))
  (connect osc 0 vblip 0)
  (connect blip 0 env 0)
  (connect env 0 vblip 1)
  (connect vblip 0 rv 0)
  (connect mix 0 rv 1)
  (connect t60 0 rv 2)
  (connect rv 0 vl 0)
  (connect rv 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
