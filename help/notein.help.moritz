; notein.help.moritz - help for notein
(patch
  (obj title comment "notein [channel]: notes from a MIDI keyboard or controller" (pos 20 12))
  (obj sub comment "Outlets: pitch, velocity (0 = note-off) and, without a channel argument, the channel (1-16)." (pos 20 34))
  (obj sub2 comment "Pick the device in Patch > MIDI Setup (all inputs by default); devices plugged in later are found." (pos 20 52))
  (obj ni notein (pos 20 85))
  (obj np number (pos 20 125))
  (obj nv number (pos 85 125))
  (obj nc number (pos 150 125))
  (obj cn comment "pitch, velocity, channel" (pos 215 126))
  (obj n1 notein 1 (pos 420 85))
  (obj n1p number (pos 420 125))
  (obj n1v number (pos 485 125))
  (obj c1 comment "notein 1: channel 1 only" (pos 420 155))
  (obj ks kslider 4 36 (pos 20 170))
  (obj cks comment "shows the keys that are down" (pos 380 200))
  (obj pk pack 0 0 (pos 20 245))
  (obj mn message "midinote $1 $2" (pos 20 280))
  (obj poly poly~ keyvoice 8 (pos 20 315))
  (obj cp comment "play it: poly~ with midinote sends each note-off to its voice" (pos 170 316))
  (obj on message "0.15 50" (pos 20 355))
  (obj off message "0 50" (pos 90 355))
  (obj cv comment "volume on / off" (pos 150 356))
  (obj ramp line~ (pos 20 390))
  (obj vca *~ (pos 20 425))
  (obj out dac~ (pos 20 465))
  (connect ni 0 np 0)
  (connect ni 1 nv 0)
  (connect ni 2 nc 0)
  (connect n1 0 n1p 0)
  (connect n1 1 n1v 0)
  (connect ni 1 ks 1)
  (connect ni 0 ks 0)
  (connect ni 1 pk 1)
  (connect ni 0 pk 0)
  (connect pk 0 mn 0)
  (connect mn 0 poly 0)
  (connect poly 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
