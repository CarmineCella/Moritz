; counter.help.moritz - help for counter
(patch
  (obj title comment "counter [max] or counter min max: counts from min (0 by default) up to max, then starts again" (pos 20 12))
  (obj sub comment "Left inlet: bang (or any number) outputs the count, then steps it. reset goes back to min; set n makes n the next output." (pos 20 34))
  (obj sub2 comment "Right inlet: the next output, like set. max is included: counter 3 counts 0 1 2 3 0 1 ... With no arguments it just keeps counting." (pos 20 52))
  (obj go button (pos 20 85))
  (obj cgo comment "count" (pos 48 88))
  (obj reset message reset (pos 120 85))
  (obj set2 message "set 2" (pos 175 85))
  (obj nxt number 0 (pos 300 120))
  (obj cnxt comment "next output (right inlet)" (pos 365 121))
  (obj c1 counter 3 (pos 20 165))
  (obj r1 number (pos 20 205))
  (obj cr1 comment "0 1 2 3 0 1 ..." (pos 85 206))
  (obj tip comment "With min and max:" (pos 20 255))
  (obj go2 button (pos 20 280))
  (obj c2 counter 5 8 (pos 20 320))
  (obj r2 number (pos 20 360))
  (obj cr2 comment "5 6 7 8 5 6 ..." (pos 85 361))
  (connect go 0 c1 0)
  (connect go2 0 c2 0)
  (connect reset 0 c1 0)
  (connect set2 0 c1 0)
  (connect nxt 0 c1 1)
  (connect c1 0 r1 0)
  (connect c2 0 r2 0))
