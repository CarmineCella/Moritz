; filterdesign.help.moritz - help for filterdesign and filterplot
(patch
  (obj title comment "filterdesign [type] [freq] [q] [gain]: biquad~ coefficients.   filterplot [w h]: a filter's frequency response" (pos 20 12))
  (obj sub comment "Types: lowpass highpass bandpass notch peak lowshelf highshelf allpass (Robert Bristow-Johnson's cookbook, as in Musil)." (pos 20 34))
  (obj sub2 comment "A type, a frequency (left), a Q (middle) or a gain in dB (right; peak and shelves) outputs a0 a1 a2 b1 b2, for biquad~." (pos 20 52))
  (obj sub3 comment "filterplot draws the response of the coefficients it receives (10, 15 ... numbers: biquads in series). Drag in it: frequency, gain." (pos 20 70))
  (obj t1 message lowpass (pos 20 105))
  (obj t2 message highpass (pos 90 105))
  (obj t3 message bandpass (pos 165 105))
  (obj t4 message peak (pos 245 105))
  (obj t5 message lowshelf (pos 295 105))
  (obj f flonum 1000 (pos 20 145))
  (obj cf comment "Hz" (pos 85 146))
  (obj q flonum 0.707 (pos 130 145))
  (obj cq comment "Q" (pos 195 146))
  (obj g flonum 6 (pos 240 145))
  (obj cg comment "dB" (pos 305 146))
  (obj fd filterdesign lowpass 1000 0.707 6 (pos 20 185))
  (obj show message "-" (pos 20 260))
  (obj set message "set $1 $2 $3 $4 $5" (pos 20 225))
  (obj plot filterplot 360 150 (pos 400 105))
  (obj drag print filterplot (pos 400 265))
  (obj cdrag comment "drag in the plot: the console shows frequency and gain" (pos 500 266))
  (obj nz noise~ (pos 20 300))
  (obj bq biquad~ (pos 20 335))
  (obj on message "0.2 50" (pos 150 300))
  (obj off message "0 50" (pos 215 300))
  (obj ramp line~ (pos 150 335))
  (obj vca *~ (pos 20 370))
  (obj out dac~ (pos 20 410))
  (obj spec spectroscope~ 360 100 (pos 400 310))
  (obj lb loadbang (pos 300 185))
  (connect t1 0 fd 0)
  (connect t2 0 fd 0)
  (connect t3 0 fd 0)
  (connect t4 0 fd 0)
  (connect t5 0 fd 0)
  (connect f 0 fd 0)
  (connect q 0 fd 1)
  (connect g 0 fd 2)
  (connect fd 0 set 0)
  (connect set 0 show 0)
  (connect fd 0 plot 0)
  (connect fd 0 bq 0)
  (connect plot 0 drag 0)
  (connect nz 0 bq 0)
  (connect bq 0 vca 0)
  (connect bq 0 spec 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 fd 0))
