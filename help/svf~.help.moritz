; svf~.help.moritz - help for svf~
(patch
  (obj title comment "svf~ [freq q]: state-variable filter with low-pass, high-pass, band-pass and notch outlets" (pos 20 12))
  (obj sub comment "Inlets: signal, frequency in Hz (default 1000), and q 0-1 (default 0.5): q 0 is well damped (Q 0.5), q 1 rings strongly (Q 50)." (pos 20 34))
  (obj sub2 comment "Outlets, left to right: low, high, band, notch, all from the same filter. Signals in the right inlets are read once per block." (pos 20 52))
  (obj c1 message 300 (pos 150 80))
  (obj c2 message 800 (pos 192 80))
  (obj c3 message 3000 (pos 234 80))
  (obj r1 message 0 (pos 330 80))
  (obj r2 message 0.5 (pos 372 80))
  (obj r3 message 0.9 (pos 414 80))
  (obj freq flonum 800 (pos 150 115))
  (obj cfreq comment "frequency (Hz)" (pos 210 116))
  (obj q flonum 0.5 (pos 330 115))
  (obj cq comment "q" (pos 390 116))
  (obj src saw~ 110 (pos 20 115))
  (obj f svf~ 800 0.5 (pos 20 160))
  (obj s1 message 1 (pos 200 200))
  (obj s2 message 2 (pos 240 200))
  (obj s3 message 3 (pos 280 200))
  (obj s4 message 4 (pos 320 200))
  (obj csel comment "1 = low, 2 = high, 3 = band, 4 = notch" (pos 365 204))
  (obj sel selector~ 4 1 (pos 20 245))
  (obj sc scope~ (pos 480 245))
  (obj on message "0.1 50" (pos 200 290))
  (obj off message "0 50" (pos 265 290))
  (obj cv comment "volume on / off" (pos 325 291))
  (obj ramp line~ (pos 200 325))
  (obj vca *~ (pos 20 360))
  (obj out dac~ (pos 20 400))
  (connect c1 0 freq 0)
  (connect c2 0 freq 0)
  (connect c3 0 freq 0)
  (connect r1 0 q 0)
  (connect r2 0 q 0)
  (connect r3 0 q 0)
  (connect src 0 f 0)
  (connect freq 0 f 1)
  (connect q 0 f 2)
  (connect f 0 sel 1)
  (connect f 1 sel 2)
  (connect f 2 sel 3)
  (connect f 3 sel 4)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect s4 0 sel 0)
  (connect sel 0 sc 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
