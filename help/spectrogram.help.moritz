; spectrogram.help.moritz - help for spectrogram, melgram, mfccgram and chromagram
(patch
  (obj title comment "spectrogram, melgram, mfccgram, chromagram: pictures of a sound, as matrices" (pos 20 12))
  (obj sub comment "run sound matrix analyses a buffer~ in the background and writes a matrix into another buffer~: a channel a row, a sample a frame." (pos 20 34))
  (obj sub2 comment "The matrix's sample rate is its frames per second, so plot shows time. Double-click a plot to explore it (zoom, values, export)." (pos 20 52))
  (obj src buffer~ hspsrc ../data/Gambale_cut.wav (pos 20 85))
  (obj b1 buffer~ hspspec (pos 490 85))
  (obj b2 buffer~ hspmel (pos 610 85))
  (obj b3 buffer~ hspmfcc (pos 720 85))
  (obj b4 buffer~ hspchroma (pos 840 85))
  (obj lr1 loadbang (pos 20 150))
  (obj r1 message "maxfreq 5000, run hspsrc hspspec" (pos 95 150))
  (obj a1 spectrogram 2048 512 (pos 20 180))
  (obj c1 comment "[size] [hop]: magnitudes in dB" (pos 20 207))
  (obj c1b comment "(0 dB: a full-scale sine), a row a bin" (pos 20 223))
  (obj c1c comment "up to maxfreq Hz (all bins without)" (pos 20 239))
  (obj ls1 loadbang (pos 340 175))
  (obj s1 message "range -90 -10" (pos 340 205))
  (obj cs1 comment "the colours' range" (pos 340 230))
  (obj p1 plot hspspec 440 110 (pos 490 145))
  (obj lr2 loadbang (pos 20 275))
  (obj r2 message "run hspsrc hspmel" (pos 95 275))
  (obj a2 melgram 40 2048 512 (pos 20 305))
  (obj c2 comment "[bands] [size] [hop]: the energy (dB)" (pos 20 332))
  (obj c2b comment "in bands on the mel scale, spaced" (pos 20 348))
  (obj c2c comment "as the ear resolves pitch" (pos 20 364))
  (obj ls2 loadbang (pos 340 300))
  (obj s2 message "range -90 -10" (pos 340 330))
  (obj p2 plot hspmel 440 110 (pos 490 270))
  (obj lr3 loadbang (pos 20 400))
  (obj r3 message "run hspsrc hspmfcc" (pos 95 400))
  (obj a3 mfccgram 13 40 2048 512 (pos 20 430))
  (obj c3 comment "[coeffs] [bands] [size] [hop]: the" (pos 20 457))
  (obj c3b comment "cosine transform of the mel bands: the" (pos 20 473))
  (obj c3c comment "timbre in a few numbers (0: the level)" (pos 20 489))
  (obj ls3 loadbang (pos 340 425))
  (obj s3 message "normalize 1" (pos 340 455))
  (obj cs3 comment "each row on its" (pos 340 480))
  (obj cs3b comment "own scale" (pos 340 496))
  (obj p3 plot hspmfcc 440 110 (pos 490 395))
  (obj lr4 loadbang (pos 20 525))
  (obj r4 message "run hspsrc hspchroma" (pos 95 525))
  (obj a4 chromagram 4096 1024 (pos 20 555))
  (obj c4 comment "[size] [hop]: the spectrum folded onto" (pos 20 582))
  (obj c4b comment "the 12 pitch classes (C at the bottom)," (pos 20 598))
  (obj c4c comment "each frame scaled to a maximum of 1" (pos 20 614))
  (obj ls4 loadbang (pos 340 550))
  (obj s4 message "labels chroma" (pos 340 580))
  (obj p4 plot hspchroma 440 110 (pos 490 520))
  (obj cpl comment "listen:" (pos 20 660))
  (obj pl message start (pos 75 658))
  (obj st message stop (pos 125 658))
  (obj play play~ hspsrc (pos 20 690))
  (obj vol *~ 0.3 (pos 20 725))
  (obj out dac~ (pos 20 760))
  (obj see comment "See also: melbands~ (live), plot, similarity, tutorial 9." (pos 490 660))
  (connect lr1 0 r1 0)
  (connect lr2 0 r2 0)
  (connect lr3 0 r3 0)
  (connect lr4 0 r4 0)
  (connect ls1 0 s1 0)
  (connect ls2 0 s2 0)
  (connect ls3 0 s3 0)
  (connect ls4 0 s4 0)
  (connect r1 0 a1 0)
  (connect r2 0 a2 0)
  (connect r3 0 a3 0)
  (connect r4 0 a4 0)
  (connect s1 0 p1 0)
  (connect s2 0 p2 0)
  (connect s3 0 p3 0)
  (connect s4 0 p4 0)
  (connect pl 0 play 0)
  (connect st 0 play 0)
  (connect play 0 vol 0)
  (connect vol 0 out 0)
  (connect vol 0 out 1))
