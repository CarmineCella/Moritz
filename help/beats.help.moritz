; beats.help.moritz - help for beats
(patch
  (obj title comment "beats [size] [hop]: the tempo and the beats of a buffer~" (pos 20 12))
  (obj sub comment "run sound [curve]: the onset strength (spectral flux), its autocorrelation read at 30-300 bpm and weighted by a prior on the tempo" (pos 20 34))
  (obj sub2 comment "people tap (prior bpm octaves: 100 0.6), then the beats that are strong and regular (tightness 100; Ellis 2007). Out: bpm, beat times (ms)." (pos 20 52))
  (obj src buffer~ hbtsrc ../examples/sounds/drums.wav (pos 20 85))
  (obj bee buffer~ hbtbee ../examples/sounds/Beethoven_Symph7.wav (pos 280 85))
  (obj fx buffer~ hbtflux (pos 640 85))
  (obj tg buffer~ hbttg (pos 760 85))
  (obj lb loadbang (pos 20 115))
  (obj run message "run hbtsrc hbtflux" (pos 20 145))
  (obj rtg message "tempogram hbtsrc hbttg" (pos 160 145))
  (obj bt beats 1024 256 (pos 20 180))
  (obj bpm flonum (pos 20 220))
  (obj cb comment "bpm" (pos 85 221))
  (obj w plot hbtsrc 560 100 (pos 330 120))
  (obj fp plot hbtflux 560 60 (pos 330 225))
  (obj cw comment "the drums, their beats; the onset strength below" (pos 330 290))
  (obj tp plot hbttg 560 110 (pos 330 315))
  (obj ct comment "the tempogram: how periodic the onsets are at each tempo (30 bpm at the bottom, 300 at the top)" (pos 330 430))
  (obj cplay comment "play the drums with a click on the beats" (pos 20 285))
  (obj go message bang (pos 20 310))
  (obj tb t b b (pos 20 340))
  (obj first unpack 0. (pos 150 220))
  (obj per expr "60000. / $f1" (pos 150 250))
  (obj del delay (pos 20 370))
  (obj one message 1 (pos 20 400))
  (obj met metro 500 (pos 20 430))
  (obj stop delay 4000 (pos 110 370))
  (obj zero message 0 (pos 110 400))
  (obj pl message start (pos 110 340))
  (obj play play~ hbtsrc 2 (pos 200 460))
  (obj clk message "1, 0 30" (pos 20 460))
  (obj cl line~ (pos 20 490))
  (obj tone cycle~ 2000 (pos 100 490))
  (obj ck *~ (pos 20 520))
  (obj mix +~ (pos 20 555))
  (obj vca *~ 0.3 (pos 20 585))
  (obj out dac~ (pos 20 620))
  (obj cbee comment "A Beethoven Allegretto, marked 76 to the quarter note:" (pos 330 470))
  (obj rb1 message "prior 100 0.6, run hbtbee" (pos 330 495))
  (obj rb2 message "prior 76 0.6, run hbtbee" (pos 520 495))
  (obj bt2 beats 1024 256 (pos 330 530))
  (obj bpm2 flonum (pos 330 565))
  (obj cb2 comment "the default prior finds 102 (4:3, the dactyl's pulse); centred on 76 it finds 76.5" (pos 400 566))
  (connect lb 0 run 0)
  (connect lb 0 rtg 0)
  (connect run 0 bt 0)
  (connect rtg 0 bt 0)
  (connect bt 2 bpm 0)
  (connect bt 3 w 1)
  (connect bt 3 fp 1)
  (connect bt 3 first 0)
  (connect bpm 0 per 0)
  (connect per 0 met 1)
  (connect first 0 del 1)
  (connect go 0 tb 0)
  (connect tb 1 pl 0)
  (connect tb 0 del 0)
  (connect tb 0 stop 0)
  (connect del 0 one 0)
  (connect one 0 met 0)
  (connect stop 0 zero 0)
  (connect zero 0 met 0)
  (connect pl 0 play 0)
  (connect met 0 clk 0)
  (connect clk 0 cl 0)
  (connect cl 0 ck 0)
  (connect tone 0 ck 1)
  (connect ck 0 mix 0)
  (connect play 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect rb1 0 bt2 0)
  (connect rb2 0 bt2 0)
  (connect bt2 2 bpm2 0))
