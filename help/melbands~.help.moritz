; melbands~.help.moritz - help for melbands~, mfcc~ and chroma~
(patch
  (obj title comment "melbands~, mfcc~, chroma~: live analysis of a signal, a list every hop" (pos 20 12))
  (obj sub comment "The same analyses as melgram, mfccgram and chromagram, on the signal as it plays: plot in image mode adds each list as a column." (pos 20 34))
  (obj sub2 comment "Turn audio on. Arguments: melbands~ [bands] [size] [hop], mfcc~ [coeffs] [bands] [size] [hop], chroma~ [size] [hop]; bang analyses at once." (pos 20 52))
  (obj src buffer~ hmbsrc ../data/Gambale_cut.wav (pos 20 85))
  (obj lb loadbang (pos 20 115))
  (obj go message "loop 1, start" (pos 20 145))
  (obj rate sig~ 1 (pos 130 145))
  (obj gr groove~ hmbsrc (pos 20 175))
  (obj snd send~ hmbsig (pos 20 205))
  (obj on message "0.3 50" (pos 220 175))
  (obj off message "0 50" (pos 285 175))
  (obj cv comment "volume" (pos 340 176))
  (obj ramp line~ (pos 220 205))
  (obj vca *~ (pos 130 235))
  (obj out dac~ (pos 130 265))
  (obj r1 receive~ hmbsig (pos 20 310))
  (obj m1 melbands~ 40 2048 512 (pos 20 340))
  (obj l1 loadbang (pos 20 375))
  (obj s1 message "range -90 -10, title 40 mel bands (dB)" (pos 20 405))
  (obj p1 plot 460 110 image (pos 290 305))
  (obj r2 receive~ hmbsig (pos 20 440))
  (obj m2 mfcc~ 13 40 2048 512 (pos 20 470))
  (obj l2 loadbang (pos 20 505))
  (obj s2 message "normalize 1, title 13 MFCCs" (pos 20 535))
  (obj p2 plot 460 110 image (pos 290 435))
  (obj r3 receive~ hmbsig (pos 20 590))
  (obj m3 chroma~ 4096 1024 (pos 20 620))
  (obj l3 loadbang (pos 20 655))
  (obj s3 message "labels chroma" (pos 20 685))
  (obj p3 plot 460 110 image (pos 290 585))
  (obj p4 plot 220 110 bars (pos 770 585))
  (obj c4 comment "the last frame, as bars" (pos 770 700))
  (obj c5 comment "history n sets how many columns stay (256); a plot in line or bars mode shows the last list only." (pos 290 730))
  (connect lb 0 go 0)
  (connect go 0 gr 0)
  (connect rate 0 gr 0)
  (connect gr 0 snd 0)
  (connect gr 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect r1 0 m1 0)
  (connect m1 0 p1 0)
  (connect l1 0 s1 0)
  (connect s1 0 p1 0)
  (connect r2 0 m2 0)
  (connect m2 0 p2 0)
  (connect l2 0 s2 0)
  (connect s2 0 p2 0)
  (connect r3 0 m3 0)
  (connect m3 0 p3 0)
  (connect m3 0 p4 0)
  (connect l3 0 s3 0)
  (connect s3 0 p3 0)
  (connect s3 0 p4 0))
