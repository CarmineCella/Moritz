; poke~.help.moritz - help for poke~
(patch
  (obj title comment "poke~ name [channel]: write into a buffer~ at a sample index" (pos 20 12))
  (obj sub comment "Left inlet: the value to write (signal). Right inlet: the sample index (signal, e.g. count~), written every sample." (pos 20 34))
  (obj sub2 comment "Indices outside the buffer are ignored. channel counts from 1 (default 1). set name writes another buffer~." (pos 20 52))
  (obj freq flonum 330 (pos 20 80))
  (obj cfreq comment "pitch" (pos 85 81))
  (obj osc cycle~ 330 (pos 20 115))
  (obj lfo cycle~ 3 (pos 120 115))
  (obj clfo comment "3 Hz wobble" (pos 185 116))
  (obj mul *~ (pos 20 150))
  (obj w message bang (pos 250 150))
  (obj cw comment "write one second" (pos 300 151))
  (obj cnt count~ 0 44100 0 (pos 250 185))
  (obj ccnt comment "stops at 44100, outside the buffer" (pos 380 186))
  (obj pk poke~ helppoke (pos 20 225))
  (obj cl message clear (pos 20 270))
  (obj buf buffer~ helppoke 1000 (pos 20 305))
  (obj cbuf comment "1000 ms of silence to write into" (pos 160 306))
  (obj wf waveform~ helppoke 300 90 (pos 400 225))
  (obj st message start (pos 400 335))
  (obj cst comment "listen" (pos 455 336))
  (obj pl play~ helppoke (pos 400 370))
  (obj cv comment "volume on / off" (pos 520 348))
  (obj on message "0.15 50" (pos 520 370))
  (obj off message "0 50" (pos 590 370))
  (obj ramp line~ (pos 520 405))
  (obj vca *~ (pos 400 440))
  (obj out dac~ (pos 400 480))
  (connect freq 0 osc 0)
  (connect osc 0 mul 0)
  (connect lfo 0 mul 1)
  (connect mul 0 pk 0)
  (connect w 0 cnt 0)
  (connect cnt 0 pk 1)
  (connect cl 0 buf 0)
  (connect st 0 pl 0)
  (connect pl 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
