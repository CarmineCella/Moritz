; stripnote.help.moritz - help for stripnote
(patch
  (obj title comment "stripnote: passes note-ons, drops note-offs" (pos 20 12))
  (obj sub comment "Inlets: pitch (hot) and velocity; \"pitch velocity\" in the left inlet works too. Notes with velocity 0 stop here." (pos 20 34))
  (obj ks kslider 2 48 (pos 20 70))
  (obj cks comment "click keys: each sends a note-on, then a note-off on release" (pos 330 90))
  (obj ap number (pos 20 145))
  (obj av number (pos 85 145))
  (obj ca comment "everything: velocity goes back to 0" (pos 150 146))
  (obj sn stripnote (pos 20 185))
  (obj sp number (pos 20 225))
  (obj sv number (pos 85 225))
  (obj cs comment "after stripnote: the last note-on stays" (pos 150 226))
  (connect ks 0 ap 0)
  (connect ks 1 av 0)
  (connect ks 1 sn 1)
  (connect ks 0 sn 0)
  (connect sn 0 sp 0)
  (connect sn 1 sv 0))
