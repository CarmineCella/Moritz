; pursuit.help.moritz - help for pursuit
(patch
  (obj title comment "pursuit: matching pursuit, after Maple: a sound as a sum of atoms" (pos 20 12))
  (obj sub comment "run sound dictionary book [residual]: the strongest atom first, subtracted, then the next, until atoms n are found or the residual" (pos 20 34))
  (obj sub2 comment "is snr dB under the sound. The book (a buffer~, an atom a frame) draws as an atom map. synth book dictionary out rebuilds the sound." (pos 20 52))
  (obj src buffer~ hpubell ../data/archeos-bell.wav (pos 20 85))
  (obj bk buffer~ hpubook (pos 330 85))
  (obj rs buffer~ hpures (pos 450 85))
  (obj sy buffer~ hpusyn (pos 560 85))
  (obj lb loadbang (pos 20 115))
  (obj mk message "gabor 128 8192" (pos 20 145))
  (obj d atoms hpudict (pos 20 175))
  (obj run message "atoms 1000, snr 40, run hpubell hpudict hpubook hpures" (pos 20 210))
  (obj pu pursuit (pos 20 245))
  (obj prog flonum (pos 20 280))
  (obj na number (pos 90 280))
  (obj snr flonum (pos 160 280))
  (obj cpo comment "progress, atoms, signal/residual (dB)" (pos 230 281))
  (obj l2 loadbang (pos 760 115))
  (obj sc message "ylog 1, title atom map: time and frequency (colour: level)" (pos 450 145))
  (obj map plot hpubook 500 200 scatter (pos 450 175))
  (obj cs comment "rebuild, transposed (ratio) and stretched, with only the strongest atoms (keep):" (pos 20 330))
  (obj cr comment "ratio" (pos 20 355))
  (obj ra slider 0.25 4. (pos 20 375))
  (obj cst comment "stretch" (pos 180 355))
  (obj st slider 0.25 4. (pos 180 375))
  (obj ck comment "keep (share of atoms)" (pos 340 355))
  (obj ke slider 0.01 1. (pos 340 375))
  (obj rm message "ratio $1" (pos 20 435))
  (obj sm message "stretch $1" (pos 180 435))
  (obj km message "keep $1" (pos 340 435))
  (obj l3 loadbang (pos 500 375))
  (obj init message "set 1" (pos 500 405))
  (obj once counter 0 1000 (pos 100 245))
  (obj first sel 0 (pos 210 245))
  (obj tr t b f (pos 20 405))
  (obj ts t b f (pos 180 405))
  (obj tk t b f (pos 340 405))
  (obj sy1 message "synth hpubook hpudict hpusyn" (pos 20 465))
  (obj cpl comment "listen:" (pos 20 505))
  (obj p0 message start (pos 75 503))
  (obj p1 message start (pos 160 503))
  (obj p2 message start (pos 245 503))
  (obj cpl2 comment "the bell, rebuilt, residual" (pos 300 505))
  (obj a0 play~ hpubell (pos 75 535))
  (obj a1 play~ hpusyn (pos 160 535))
  (obj a2 play~ hpures (pos 245 535))
  (obj mix +~ (pos 75 570))
  (obj vca *~ 0.4 (pos 75 600))
  (obj out dac~ (pos 75 630))
  (obj c9 comment "With a dictionary of sounds, run explains each segment of the sound (onsets, or blocks of block ms) with components n atoms," (pos 20 665))
  (obj c10 comment "each slid to its best place (FFT cross-correlation) among the candidates n closest in spectrum: see examples/maple-hybrid." (pos 20 683))
  (obj c11 comment "cross book from to out rebuilds a book with the closest atoms of another dictionary; tails 0 stops sound atoms where they matched." (pos 20 701))
  (connect lb 0 mk 0)
  (connect mk 0 d 0)
  (connect d 1 run 0)
  (connect run 0 pu 0)
  (connect pu 0 prog 0)
  (connect pu 2 na 0)
  (connect pu 3 snr 0)
  (connect pu 1 once 0)
  (connect once 0 first 0)
  (connect first 0 sy1 0)
  (connect l2 0 sc 0)
  (connect sc 0 map 0)
  (connect ra 0 tr 0)
  (connect st 0 ts 0)
  (connect ke 0 tk 0)
  (connect tr 1 rm 0)
  (connect ts 1 sm 0)
  (connect tk 1 km 0)
  (connect tr 0 sy1 0)
  (connect ts 0 sy1 0)
  (connect tk 0 sy1 0)
  (connect rm 0 pu 0)
  (connect sm 0 pu 0)
  (connect km 0 pu 0)
  (connect l3 0 init 0)
  (connect init 0 ra 0)
  (connect init 0 st 0)
  (connect init 0 ke 0)
  (connect sy1 0 pu 0)
  (connect p0 0 a0 0)
  (connect p1 0 a1 0)
  (connect p2 0 a2 0)
  (connect a0 0 mix 0)
  (connect a1 0 mix 0)
  (connect a2 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
