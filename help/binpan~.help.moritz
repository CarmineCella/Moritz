; binpan~.help.moritz - help for binpan~ (an abstraction in the library)
(patch
  (obj title comment "binpan~ [azimuth] [elevation]: a mono sound placed around the listener, on headphones" (pos 20 12))
  (obj sub comment "Inlets: the signal, the azimuth (0 front, 90 left, -90 right, 180 behind), the elevation (up). Outlets: left, right." (pos 20 34))
  (obj sub2 comment "An abstraction: ambienc~ 2 into binaural~ 2. For many sources, sum their fields and use one binaural~ (see binaural.moritz)." (pos 20 52))
  (obj b buffer~ helpbpvox ../examples/sounds/Vox.wav (pos 20 85))
  (obj pl message "loop 1, start" (pos 20 120))
  (obj v sparkle~ helpbpvox (pos 20 155))
  (obj caz comment "azimuth" (pos 200 100))
  (obj az slider -180 180 (pos 200 120))
  (obj azn number (pos 355 120))
  (obj cel comment "elevation" (pos 440 100))
  (obj el slider -40 90 (pos 440 120))
  (obj eln number (pos 595 120))
  (obj bp binpan~ 0 0 (pos 20 200))
  (obj on message "0.35 50" (pos 250 240))
  (obj off message "0 50" (pos 320 240))
  (obj ramp line~ (pos 250 275))
  (obj gl *~ (pos 20 275))
  (obj gr *~ (pos 120 275))
  (obj out dac~ (pos 20 315))
  (obj lb loadbang (pos 680 100))
  (obj z message 0 (pos 680 130))
  (connect pl 0 v 0)
  (connect v 0 bp 0)
  (connect az 0 azn 0)
  (connect azn 0 bp 1)
  (connect el 0 eln 0)
  (connect eln 0 bp 2)
  (connect bp 0 gl 0)
  (connect bp 1 gr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 gl 1)
  (connect ramp 0 gr 1)
  (connect gl 0 out 0)
  (connect gr 0 out 1)
  (connect lb 0 z 0)
  (connect z 0 az 0)
  (connect z 0 el 0))
