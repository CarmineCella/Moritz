; biquad~.help.moritz - help for biquad~
(patch
  (obj title comment "biquad~ [a0 a1 a2 b1 b2]: raw two-pole, two-zero filter" (pos 20 12))
  (obj sub comment "y[n] = a0 x[n] + a1 x[n-1] + a2 x[n-2] - b1 y[n-1] - b2 y[n-2]. The default 1 0 0 0 0 passes the signal through." (pos 20 34))
  (obj sub2 comment "A list of five numbers in the left inlet sets all the coefficients; inlets 2-6 each take one, as a float (not a signal)." (pos 20 52))
  (obj src noise~ (pos 20 85))
  (obj m1 message "1 0 0 0 0" (pos 100 85))
  (obj c1 comment "pass-through" (pos 450 89))
  (obj m2 message "0.0012074 0.00241479 0.0012074 -1.89932 0.904149" (pos 125 115))
  (obj c2 comment "low-pass, 500 Hz" (pos 450 119))
  (obj m3 message "0.817345 -1.63469 0.817345 -1.60105 0.668327" (pos 150 145))
  (obj c3 comment "high-pass, 2000 Hz" (pos 450 149))
  (obj m4 message "0.0140006 0 -0.0140006 -1.95202 0.971999" (pos 175 175))
  (obj c4 comment "band-pass, 1000 Hz, Q 5" (pos 450 179))
  (obj m5 message "0.1 0 0 -0.9 0" (pos 200 205))
  (obj c5 comment "one-pole low-pass: y = 0.1 x + 0.9 y[n-1]" (pos 310 209))
  (obj f biquad~ (pos 20 250))
  (obj sc scope~ (pos 480 260))
  (obj on message "0.12 50" (pos 200 300))
  (obj off message "0 50" (pos 272 300))
  (obj cv comment "volume on / off" (pos 332 301))
  (obj ramp line~ (pos 200 335))
  (obj vca *~ (pos 20 370))
  (obj out dac~ (pos 20 410))
  (obj tip comment "These coefficients are for a sample rate of 44.1 kHz; at another rate the frequencies move with it." (pos 20 450))
  (connect src 0 f 0)
  (connect m1 0 f 0)
  (connect m2 0 f 0)
  (connect m3 0 f 0)
  (connect m4 0 f 0)
  (connect m5 0 f 0)
  (connect f 0 sc 0)
  (connect f 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
