; index~.help.moritz - help for index~
(patch
  (obj title comment "index~ name [channel]: read a buffer~ at a sample index" (pos 20 12))
  (obj sub comment "The inlet is the sample index, a signal such as count~ (or a float). There is no interpolation; outside the buffer it gives 0." (pos 20 34))
  (obj sub2 comment "channel counts from 1 (default 1). set name reads another buffer~." (pos 20 52))
  (obj buf buffer~ helpindex ../examples/sounds/voice.wav (pos 20 80))
  (obj go message bang (pos 20 120))
  (obj mid message 88200 (pos 70 120))
  (obj st message stop (pos 130 120))
  (obj cgo comment "play from the start, from 2 s, stop" (pos 175 121))
  (obj cnt count~ 0 176400 (pos 20 160))
  (obj ccnt comment "176400 samples = the 4-second phrase, looped" (pos 140 161))
  (obj ix index~ helpindex (pos 20 200))
  (obj snap snapshot~ 50 (pos 250 200))
  (obj idx number (pos 330 235))
  (obj cidx comment "sample index" (pos 395 236))
  (obj ms / 44.1 (pos 250 235))
  (obj cms comment "/ 44.1 turns samples into ms (the file is 44.1 kHz) for the cursor" (pos 250 372))
  (obj wf waveform~ helpindex 320 90 (pos 250 275))
  (obj cv comment "volume on / off" (pos 100 255))
  (obj on message "0.15 50" (pos 100 280))
  (obj off message "0 50" (pos 170 280))
  (obj ramp line~ (pos 100 315))
  (obj vca *~ (pos 20 350))
  (obj out dac~ (pos 20 390))
  (connect go 0 cnt 0)
  (connect mid 0 cnt 0)
  (connect st 0 cnt 0)
  (connect cnt 0 ix 0)
  (connect cnt 0 snap 0)
  (connect snap 0 idx 0)
  (connect snap 0 ms 0)
  (connect ms 0 wf 0)
  (connect ix 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
