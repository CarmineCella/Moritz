; ctlin.help.moritz - help for ctlin, bendin and pgmin
(patch
  (obj title comment "ctlin [controller] [channel], bendin [channel], pgmin [channel]: MIDI controls in" (pos 20 12))
  (obj sub comment "ctlin outlets: value 0-127, then the controller number (without a controller argument) and the channel." (pos 20 34))
  (obj sub2 comment "bendin gives pitch bend as 0-127 (64 = centre); pgmin gives programs as 1-128." (pos 20 52))
  (obj ca ctlin (pos 20 85))
  (obj cav number (pos 20 125))
  (obj can number (pos 85 125))
  (obj cac number (pos 150 125))
  (obj cca comment "any controller: value, number, channel" (pos 215 126))
  (obj mw ctlin 1 (pos 20 165))
  (obj mwv number (pos 20 205))
  (obj mwc number (pos 85 205))
  (obj cmw comment "ctlin 1: the mod wheel (value, channel)" (pos 150 206))
  (obj bi bendin (pos 420 165))
  (obj biv number (pos 420 205))
  (obj cbi comment "bendin: 0-127" (pos 420 235))
  (obj pg pgmin (pos 560 165))
  (obj pgv number (pos 560 205))
  (obj cpg comment "pgmin: 1-128" (pos 560 235))
  (obj sc scale 0 127 200 3000 (pos 120 250))
  (obj csc comment "the mod wheel sweeps a filter: 200 to 3000 Hz" (pos 280 251))
  (obj saw saw~ 110 (pos 20 250))
  (obj lp lores~ 1000 0.5 (pos 20 290))
  (obj on message "0.06 50" (pos 20 330))
  (obj off message "0 50" (pos 85 330))
  (obj cv comment "volume on / off" (pos 145 331))
  (obj ramp line~ (pos 20 365))
  (obj vca *~ (pos 20 400))
  (obj out dac~ (pos 20 440))
  (connect ca 0 cav 0)
  (connect ca 1 can 0)
  (connect ca 2 cac 0)
  (connect mw 0 mwv 0)
  (connect mw 1 mwc 0)
  (connect bi 0 biv 0)
  (connect pg 0 pgv 0)
  (connect mwv 0 sc 0)
  (connect sc 0 lp 1)
  (connect saw 0 lp 0)
  (connect lp 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
