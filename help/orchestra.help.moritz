; orchestra.help.moritz - help for orchestra
(patch
  (obj title comment "orchestra: a database of instrumental samples and its players, for orchidea" (pos 20 12))
  (obj sub comment "The database is a feature file of the *SOL layout (TinySOL, OrchideaSOL, FullSOL; MicroSOL comes with Moritz: four instruments around C4-G4)." (pos 20 34))
  (obj sub2 comment "It is read as a background job; then the number of sounds and the players come out. Right-click the box for Info." (pos 20 52))
  (obj rd message "read microsol/microsol.spectrum.db" (pos 20 85))
  (obj rd2 comment "or your own: read ~/TinySOL/TinySOL.spectrum.db" (pos 270 86))
  (obj c1 comment "the players: an instrument a player, a number after one makes it that many; no instrument: Orchidea's default, of what the database has" (pos 20 120))
  (obj p1 message "players Vn 2 Vc 2" (pos 20 142))
  (obj p2 message "players Ob Hn Vn Vc" (pos 160 142))
  (obj p3 message players (pos 310 142))
  (obj p4 message "add Hn" (pos 390 142))
  (obj p5 message "remove Hn" (pos 460 142))
  (obj c2 comment "what they may play: a range per instrument (names or MIDI numbers), techniques, dynamics (none: all)" (pos 20 177))
  (obj r1 message "range Vn D4 F4" (pos 20 199))
  (obj r2 message "range Vn" (pos 140 199))
  (obj r3 message "techniques ord" (pos 220 199))
  (obj r4 message techniques (pos 340 199))
  (obj r5 message "dynamics mf ff" (pos 430 199))
  (obj r6 message dynamics (pos 550 199))
  (obj inf message info (pos 640 199))
  (obj or orchestra hpband microsol/microsol.spectrum.db (pos 20 240))
  (obj prog flonum (pos 20 275))
  (obj ns number (pos 160 275))
  (obj cns comment "sounds" (pos 215 276))
  (obj pp prepend set (pos 280 275))
  (obj pl message "the players" (pos 280 305))
  (obj c3 comment "orchidea hpband orchestrates a target with these players: see its help" (pos 20 345))
  (connect rd 0 or 0)
  (connect p1 0 or 0)
  (connect p2 0 or 0)
  (connect p3 0 or 0)
  (connect p4 0 or 0)
  (connect p5 0 or 0)
  (connect r1 0 or 0)
  (connect r2 0 or 0)
  (connect r3 0 or 0)
  (connect r4 0 or 0)
  (connect r5 0 or 0)
  (connect r6 0 or 0)
  (connect inf 0 or 0)
  (connect or 0 prog 0)
  (connect or 2 ns 0)
  (connect or 3 pp 0)
  (connect pp 0 pl 0))
