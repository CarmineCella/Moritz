; orchestra.help.moritz - help for orchestra
(patch
  (obj title comment "orchestra: a database of instrumental samples and its players, for orchidea" (pos 20 12))
  (obj sub comment "The database is a feature file of the *SOL layout (TinySOL, OrchideaSOL, FullSOL; MicroSOL comes with Moritz: four instruments around C4-G4), or its name." (pos 20 34))
  (obj sub2 comment "It is read as a background job; then the number of sounds and the players come out. Right-click the box for Info." (pos 20 52))
  (obj rd message "read microsol" (pos 20 85))
  (obj rd2 comment "or read tinysol, read fullsol (Extras > Datasets... downloads or registers them), read path/to/X.spectrum.db" (pos 130 86))
  (obj an comment "analyse folder: a feature file made of a folder of sounds named as in the *SOL databases (Orchidea's dbgen), then read" (pos 20 102))
  (obj c1 comment "the players: an instrument a player, a number after one makes it that many; no instrument: Orchidea's default, of what the database has" (pos 20 120))
  (obj p1 message "players Vn 2 Vc 2" (pos 20 142))
  (obj p2 message "players Ob Hn Vn Vc" (pos 160 142))
  (obj p3 message players (pos 310 142))
  (obj p4 message "add Hn" (pos 390 142))
  (obj p5 message "remove Hn" (pos 460 142))
  (obj c2 comment "what they may play: a range per instrument (names or MIDI numbers), techniques, dynamics (none: all)" (pos 20 177))
  (obj r1 message "range Vn D4 F4" (pos 20 199))
  (obj r2 message "range Vn" (pos 140 199))
  (obj r3 message "techniques ord" (pos 220 199))
  (obj r4 message techniques (pos 340 199))
  (obj r5 message "dynamics mf ff" (pos 430 199))
  (obj r6 message dynamics (pos 550 199))
  (obj inf message info (pos 640 199))
  (obj or orchestra hpband microsol (pos 20 240))
  (obj prog flonum (pos 20 275))
  (obj ns number (pos 160 275))
  (obj cns comment "sounds" (pos 215 276))
  (obj pp prepend set (pos 280 275))
  (obj pl message "the players" (pos 280 305))
  (obj c3 comment "orchidea hpband orchestrates a target with these players: see its help" (pos 20 345))
  (obj ex1 comment "Examples (Help > Examples, Orchestration): sound-space (players, doublings such as Fl|Picc, range, techniques," (pos 20 370))
  (obj ex2 comment "dynamics), and the others for orchidea: static-dynamic, connections, memory, search, output, orchidea." (pos 20 388))
  (obj gp0 comment "Vn+Vc: two players paired, a group orchidea's granular mode makes sound together; rest: the players' bookings forgotten (granular runs that continue)" (pos 20 410))
  (obj gp1 message "players Ob Hn Vn|Vc Vn+Vc" (pos 20 435))
  (obj gp2 message rest (pos 230 435))
  (obj sq0 comment "select: only the sounds a query chooses (Musil's db-select): fields and values joined by and, or, not, ( ); each select says how many sounds remain" (pos 20 470))
  (obj sq1 comment "fields: instrument family technique dynamics pitch midi string mute tag file; values: pizz* (a pattern), /sul_?pont/ (a regular expression), C4..G5 or p..f (a range), Vn|Va (any of them)" (pos 20 488))
  (obj sq2 message "select technique ord and dynamics mf..ff and pitch C4..F4" (pos 20 512))
  (obj sq3 message "select family strings or instrument Ob" (pos 380 512))
  (obj sq4 message "select Vn string 3" (pos 20 540))
  (obj sq5 message "select Vc pitch ..D4|/F#/" (pos 150 540))
  (obj sq6 message "select Vn" (pos 330 540))
  (obj sq7 message select (pos 410 540))
  (obj sq8 comment "select instrument query: that instrument's sounds only; select instrument: its query cleared; select: every sound" (pos 20 566))
  (connect rd 0 or 0)
  (connect p1 0 or 0)
  (connect p2 0 or 0)
  (connect p3 0 or 0)
  (connect p4 0 or 0)
  (connect p5 0 or 0)
  (connect r1 0 or 0)
  (connect r2 0 or 0)
  (connect r3 0 or 0)
  (connect r4 0 or 0)
  (connect r5 0 or 0)
  (connect r6 0 or 0)
  (connect inf 0 or 0)
  (connect or 0 prog 0)
  (connect or 2 ns 0)
  (connect or 3 pp 0)
  (connect pp 0 pl 0)
  (connect gp1 0 or 0)
  (connect gp2 0 or 0)
  (connect sq2 0 or 0)
  (connect sq3 0 or 0)
  (connect sq4 0 or 0)
  (connect sq5 0 or 0)
  (connect sq6 0 or 0)
  (connect sq7 0 or 0)
)
