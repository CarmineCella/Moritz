; click~.help.moritz - help for click~
(patch
  (obj title comment "click~ [shape...]: outputs an impulse on bang" (pos 20 12))
  (obj sub comment "bang plays the impulse once. A list of numbers (set in front is optional) sets its shape, one value per sample." (pos 20 34))
  (obj sub2 comment "The default shape, and the one after an empty set, is a single sample of 1. Arguments set the shape too." (pos 20 52))
  (obj btn button (pos 20 80))
  (obj cbtn comment "bang: one click" (pos 50 84))
  (obj tg toggle (pos 180 80))
  (obj ctg comment "a click every 250 ms" (pos 210 84))
  (obj met metro 250 (pos 180 115))
  (obj sh1 message 1 (pos 380 85))
  (obj csh1 comment "one sample of 1 (the default)" (pos 425 89))
  (obj sh2 message "1 -1" (pos 380 115))
  (obj csh2 comment "thinner" (pos 435 119))
  (obj sh3 message "1 0.7 0.4 0.2 0.1" (pos 380 145))
  (obj csh3 comment "softer" (pos 510 149))
  (obj clk click~ (pos 160 175))
  (obj s1 message 1 (pos 20 215))
  (obj s2 message 2 (pos 60 215))
  (obj res reson~ 100 1000 30 (pos 230 215))
  (obj cres comment "rings at 1000 Hz when struck" (pos 375 219))
  (obj sel selector~ 2 2 (pos 20 260))
  (obj csel comment "1 = the click alone, 2 = through reson~" (pos 130 264))
  (obj on message "0.15 50" (pos 150 300))
  (obj off message "0 50" (pos 220 300))
  (obj cv comment "volume on / off" (pos 280 301))
  (obj ramp line~ (pos 150 335))
  (obj vca *~ (pos 20 370))
  (obj out dac~ (pos 20 410))
  (connect btn 0 clk 0)
  (connect tg 0 met 0)
  (connect met 0 clk 0)
  (connect sh1 0 clk 0)
  (connect sh2 0 clk 0)
  (connect sh3 0 clk 0)
  (connect clk 0 sel 1)
  (connect clk 0 res 0)
  (connect res 0 sel 2)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
