; expr.help.moritz - help for expr
(patch
  (obj title comment "expr ...: evaluates a C-like expression of its inlets, $f1..$f9 (floats) and $i1..$i9 (truncated to integers)" (pos 20 12))
  (obj sub comment "There is one inlet per variable, up to the highest number used. The left one is hot: a number sets $f1 and outputs," (pos 20 34))
  (obj sub2 comment "a list sets $f1, $f2 ... in order and outputs, bang outputs again. The others are cold. Errors go to the console. As in Max," (pos 20 52))
  (obj sub3 comment "$i, integer constants and comparisons are integers: 7 / 2 is 3, while 7. / 2 or $f1 / 2 is 3.5. Write 12. to divide in decimals." (pos 20 70))
  (obj a flonum 3 (pos 20 105))
  (obj ca comment "$f1" (pos 85 106))
  (obj e1 expr "$f1 * 2 + 1" (pos 20 145))
  (obj r1 flonum (pos 20 180))
  (obj x flonum 3 (pos 300 105))
  (obj y flonum 4 (pos 390 105))
  (obj cxy comment "x: hot, y: cold" (pos 460 106))
  (obj e2 expr "sqrt($f1 * $f1 + $f2 * $f2)" (pos 300 145))
  (obj r2 flonum (pos 300 180))
  (obj cr2 comment "length of (x, y)" (pos 380 181))
  (obj b flonum 14.7 (pos 20 235))
  (obj e3 expr "$i1 % 12" (pos 20 275))
  (obj r3 flonum (pos 20 310))
  (obj cr3 comment "$i1 drops the fraction first: 14.7 -> 14 -> 2" (pos 85 311))
  (obj go button (pos 380 235))
  (obj cgo comment "bang" (pos 410 238))
  (obj e4 expr "random(0, 10)" (pos 380 275))
  (obj r4 flonum (pos 380 310))
  (obj cr4 comment "a float from 0 to 10" (pos 450 311))
  (obj ops comment "Operators: + - * / % (0 when dividing by 0)   == != < > <= >= (1 or 0)   && || !   and ( ) for grouping." (pos 20 360))
  (obj fns comment "Functions: sin cos tan asin acos atan sinh cosh tanh exp log log10 sqrt abs floor ceil int round," (pos 20 380))
  (obj fns2 comment "pow(x, y) atan2(y, x) min(a, b) max(a, b) fmod(a, b) random(lo, hi). The constant pi." (pos 20 398))
  (obj sig comment "expr~ is the signal version: the same language, evaluated for every sample, with $v1..$v9 for its inlets." (pos 20 425))
  (connect a 0 e1 0)
  (connect e1 0 r1 0)
  (connect x 0 e2 0)
  (connect y 0 e2 1)
  (connect e2 0 r2 0)
  (connect b 0 e3 0)
  (connect e3 0 r3 0)
  (connect go 0 e4 0)
  (connect e4 0 r4 0))
