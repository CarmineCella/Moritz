; line.help.moritz - help for line
(patch
  (obj title comment "line [start grain]: control-rate ramps, a number every grain ms (20 by default)" (pos 20 12))
  (obj sub comment "Left inlet: \"target time\" ramps from the current value to target in time ms; \"target time grain\" also sets the grain." (pos 20 34))
  (obj sub2 comment "A number alone jumps there. Middle inlet: a ramp time for the next number alone (then back to 0). Right inlet: the grain." (pos 20 52))
  (obj r1 message "100 1000" (pos 20 95))
  (obj r2 message "0 2000" (pos 100 95))
  (obj r3 message "50 1000 250" (pos 165 95))
  (obj j0 message 0 (pos 265 95))
  (obj stop message stop (pos 302 95))
  (obj setm message "set 25" (pos 355 95))
  (obj cr comment "click: ramp, ramp, ramp in 250 ms steps, jump, stop, set (changes the value without output)" (pos 20 72))
  (obj nt message 3000 (pos 450 145))
  (obj cnt comment "then a number alone (0) ramps over 3 s" (pos 500 146))
  (obj gr number 20 (pos 450 180))
  (obj cgr comment "grain (ms)" (pos 515 181))
  (obj ln line (pos 20 220))
  (obj out flonum (pos 20 260))
  (obj cout comment "the ramp" (pos 110 261))
  (obj sl slider 0 100 (pos 20 300))
  (obj tip comment "To ramp a signal (an amplitude, a frequency) without steps, use line~ instead." (pos 20 345))
  (connect r1 0 ln 0)
  (connect r2 0 ln 0)
  (connect r3 0 ln 0)
  (connect j0 0 ln 0)
  (connect stop 0 ln 0)
  (connect setm 0 ln 0)
  (connect nt 0 ln 1)
  (connect gr 0 ln 2)
  (connect ln 0 out 0)
  (connect ln 0 sl 0))
