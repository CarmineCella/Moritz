; pfft~.help.moritz - help for pfft~, fftin~ and fftout~
(patch
  (obj title comment "pfft~ name [size overlap]: run a patch on the spectrum, once per FFT frame" (pos 20 12))
  (obj sub comment "Loads name.moritz (here help-pfft-filter.moritz). Hann window; size 512, overlap 4 by default; the size is rounded up to a power of 2." (pos 20 34))
  (obj sub2 comment "Inside, fftin~ n gives signal inlet n as real part, imaginary part and bin number; fftout~ n takes real and imaginary for outlet n." (pos 20 52))
  (obj src saw~ 110 (pos 20 80))
  (obj csrc comment "a sawtooth: harmonics every 110 Hz" (pos 85 81))
  (obj lb loadbang (pos 330 80))
  (obj m3 message 3 (pos 330 115))
  (obj m10 message 10 (pos 365 115))
  (obj m40 message 40 (pos 408 115))
  (obj m512 message 512 (pos 451 115))
  (obj cut flonum 40 (pos 330 150))
  (obj ccut comment "cutoff in bins (0 to 511)" (pos 405 151))
  (obj cbin comment "a bin is 44100 / 1024 = 43 Hz wide: 3 keeps the fundamental only" (pos 330 175))
  (obj pf pfft~ help-pfft-filter 1024 4 (pos 20 205))
  (obj sp spectroscope~ 360 130 (pos 240 255))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj copen comment "Inlets: one signal inlet per fftin~, then the inner inlet boxes. Double-click the pfft~ (locked mode) to open it." (pos 20 430))
  (obj copen2 comment "Inside, a signal vector is one whole frame: one bin per sample, bins 0 to size/2 - 1 (here 0 to 511)." (pos 20 448))
  (obj clat comment "The output is resynthesised by overlap-add and comes one frame (1024 samples) late." (pos 20 466))
  (connect lb 0 m40 0)
  (connect m3 0 cut 0)
  (connect m10 0 cut 0)
  (connect m40 0 cut 0)
  (connect m512 0 cut 0)
  (connect src 0 pf 0)
  (connect cut 0 pf 1)
  (connect pf 0 sp 0)
  (connect pf 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
