; slider.help.moritz - help for slider
(patch
  (obj title comment "slider [min max]: a horizontal slider, 0 to 127 by default" (pos 20 12))
  (obj sub comment "Click or drag it (locked). It sends whole numbers when both limits are whole numbers, decimals otherwise." (pos 20 34))
  (obj sub2 comment "A number moves it and sends it (only if the value changed); bang sends it again; set x moves it silently. Values are clipped." (pos 20 52))
  (obj m64 message 64 (pos 20 85))
  (obj m200 message 200 (pos 60 85))
  (obj mb message bang (pos 108 85))
  (obj ms message "set 20" (pos 160 85))
  (obj sl slider (pos 20 125))
  (obj csl comment "slider: 0 to 127" (pos 175 126))
  (obj nsl number (pos 20 165))
  (obj cnsl comment "200 is clipped to 127" (pos 85 166))
  (obj sl01 slider 0 0.5 (pos 380 125))
  (obj csl01 comment "slider 0 0.5" (pos 535 126))
  (obj nsl01 flonum (pos 380 165))
  (obj cnsl01 comment "decimals (slider 0 1 sends only 0 or 1)" (pos 445 166))
  (obj fsl slider 200 1000 (pos 20 225))
  (obj cfsl comment "slider 200 1000: frequency in Hz" (pos 175 226))
  (obj osc cycle~ 200 (pos 20 260))
  (obj on message "0.15 50" (pos 110 295))
  (obj off message "0 50" (pos 180 295))
  (obj cv comment "volume on / off" (pos 240 296))
  (obj ramp line~ (pos 110 325))
  (obj vca *~ (pos 20 360))
  (obj out dac~ (pos 20 400))
  (connect m64 0 sl 0)
  (connect m200 0 sl 0)
  (connect mb 0 sl 0)
  (connect ms 0 sl 0)
  (connect sl 0 nsl 0)
  (connect sl01 0 nsl01 0)
  (connect fsl 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
