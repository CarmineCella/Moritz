; arith.help.moritz - help for + - * / %
(patch
  (obj title comment "+  -  *  /  % [arg]: add, subtract, multiply, divide, remainder" (pos 20 12))
  (obj sub comment "Left inlet (hot): a number sets the left operand and outputs the result; bang outputs again. Right inlet (cold): stores" (pos 20 34))
  (obj sub2 comment "the right operand (the argument, 0 by default). All math is in floats, so / 2 of 7 is 3.5. Dividing by 0 gives 0." (pos 20 52))
  (obj a flonum 7 (pos 20 85))
  (obj ca comment "left operand: drag me" (pos 85 86))
  (obj b flonum 2 (pos 300 85))
  (obj cb comment "right operand: stored only" (pos 365 86))
  (obj add + 2 (pos 20 150))
  (obj sub_ - 2 (pos 100 150))
  (obj mul * 2 (pos 180 150))
  (obj div / 2 (pos 260 150))
  (obj mod % 2 (pos 340 150))
  (obj radd flonum (pos 20 190))
  (obj rsub flonum (pos 100 190))
  (obj rmul flonum (pos 180 190))
  (obj rdiv flonum (pos 260 190))
  (obj rmod flonum (pos 340 190))
  (obj cold comment "After changing the right operand, drag the left one again to see the new results." (pos 20 225))
  (obj c2 comment "A list in the left inlet sets both operands, then outputs:" (pos 20 270))
  (obj l1 message "10 3" (pos 20 295))
  (obj l2 message "-7 3" (pos 70 295))
  (obj m2 % (pos 20 335))
  (obj rm2 flonum (pos 20 370))
  (obj cm2 comment "% keeps the sign of the left operand: -7 % 3 is -1" (pos 90 371))
  (connect a 0 add 0)
  (connect a 0 sub_ 0)
  (connect a 0 mul 0)
  (connect a 0 div 0)
  (connect a 0 mod 0)
  (connect b 0 add 1)
  (connect b 0 sub_ 1)
  (connect b 0 mul 1)
  (connect b 0 div 1)
  (connect b 0 mod 1)
  (connect add 0 radd 0)
  (connect sub_ 0 rsub 0)
  (connect mul 0 rmul 0)
  (connect div 0 rdiv 0)
  (connect mod 0 rmod 0)
  (connect l1 0 m2 0)
  (connect l2 0 m2 0)
  (connect m2 0 rm2 0))
