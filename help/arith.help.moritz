; arith.help.moritz - help for + - * / %
(patch
  (obj title comment "+  -  *  /  % [arg]: add, subtract, multiply, divide, remainder" (pos 20 12))
  (obj sub comment "Left inlet (hot): a number sets the left operand and outputs the result; bang outputs again. Right inlet (cold): stores" (pos 20 34))
  (obj sub2 comment "the right operand (the argument, 0 by default). Dividing by 0 gives 0. A list \"a b\" in the left inlet sets both." (pos 20 52))
  (obj ti comment "As in Max, the argument sets the type. Integer argument (or none): integers. The inputs are truncated, so 7.5 / 2 is 3." (pos 20 82))
  (obj a flonum 7.5 (pos 20 110))
  (obj ca comment "left operand: drag me" (pos 85 111))
  (obj b flonum 2 (pos 300 110))
  (obj cb comment "right operand: stored only" (pos 365 111))
  (obj add + 2 (pos 20 165))
  (obj sub_ - 2 (pos 100 165))
  (obj mul * 2 (pos 180 165))
  (obj div / 2 (pos 260 165))
  (obj mod % 2 (pos 340 165))
  (obj radd flonum (pos 20 200))
  (obj rsub flonum (pos 100 200))
  (obj rmul flonum (pos 180 200))
  (obj rdiv flonum (pos 260 200))
  (obj rmod flonum (pos 340 200))
  (obj ci comment "integers" (pos 420 201))
  (obj fadd + 2. (pos 20 245))
  (obj fsub - 2. (pos 100 245))
  (obj fmul * 2. (pos 180 245))
  (obj fdiv / 2. (pos 260 245))
  (obj fmod % 2. (pos 340 245))
  (obj rfadd flonum (pos 20 280))
  (obj rfsub flonum (pos 100 280))
  (obj rfmul flonum (pos 180 280))
  (obj rfdiv flonum (pos 260 280))
  (obj rfmod flonum (pos 340 280))
  (obj cf comment "decimals: the argument has a point (2. or 0.5)" (pos 420 281))
  (obj cold comment "After changing the right operand, drag the left one again to see the new results." (pos 20 315))
  (obj tip comment "Typical mistake: [* 0.5] works, but [* 1] on a slider from 0 to 1 gives only 0 or 1. Write [* 1.] to keep the decimals." (pos 20 340))
  (obj c2 comment "% keeps the sign of the left operand: -7 % 3 is -1." (pos 20 375))
  (obj l1 message "10 3" (pos 20 400))
  (obj l2 message "-7 3" (pos 70 400))
  (obj m2 % (pos 20 440))
  (obj rm2 number (pos 20 475))
  (connect a 0 add 0)
  (connect a 0 sub_ 0)
  (connect a 0 mul 0)
  (connect a 0 div 0)
  (connect a 0 mod 0)
  (connect a 0 fadd 0)
  (connect a 0 fsub 0)
  (connect a 0 fmul 0)
  (connect a 0 fdiv 0)
  (connect a 0 fmod 0)
  (connect b 0 add 1)
  (connect b 0 sub_ 1)
  (connect b 0 mul 1)
  (connect b 0 div 1)
  (connect b 0 mod 1)
  (connect b 0 fadd 1)
  (connect b 0 fsub 1)
  (connect b 0 fmul 1)
  (connect b 0 fdiv 1)
  (connect b 0 fmod 1)
  (connect add 0 radd 0)
  (connect sub_ 0 rsub 0)
  (connect mul 0 rmul 0)
  (connect div 0 rdiv 0)
  (connect mod 0 rmod 0)
  (connect fadd 0 rfadd 0)
  (connect fsub 0 rfsub 0)
  (connect fmul 0 rfmul 0)
  (connect fdiv 0 rfdiv 0)
  (connect fmod 0 rfmod 0)
  (connect l1 0 m2 0)
  (connect l2 0 m2 0)
  (connect m2 0 rm2 0))
