; clip~.help.moritz - help for clip~, abs~ and tanh~
(patch
  (obj title comment "clip~ [min max], abs~, tanh~: limiting, rectifying and soft saturation" (pos 20 12))
  (obj sub comment "clip~ keeps the signal between min and max (default -1 and 1), set by inlets 2 and 3 (signals or floats)." (pos 20 34))
  (obj sub2 comment "abs~ outputs the absolute value. tanh~ bends the signal smoothly towards -1 and 1. They have one inlet and no arguments." (pos 20 52))
  (obj osc cycle~ 220 (pos 20 85))
  (obj lo flonum -0.5 (pos 150 85))
  (obj hi flonum 0.5 (pos 215 85))
  (obj clh comment "clip~ min, max" (pos 277 86))
  (obj drive flonum 1 (pos 430 85))
  (obj cdrive comment "drive into tanh~" (pos 492 86))
  (obj ab abs~ (pos 20 150))
  (obj cl clip~ -0.5 0.5 (pos 100 150))
  (obj gain *~ 1 (pos 330 150))
  (obj th tanh~ (pos 330 185))
  (obj s1 message 1 (pos 150 195))
  (obj s2 message 2 (pos 190 195))
  (obj s3 message 3 (pos 230 195))
  (obj sel selector~ 3 1 (pos 20 260))
  (obj csel comment "1 = abs~, 2 = clip~, 3 = tanh~" (pos 130 264))
  (obj sc scope~ (pos 480 290))
  (obj on message "0.15 50" (pos 200 315))
  (obj off message "0 50" (pos 270 315))
  (obj cv comment "volume on / off" (pos 330 316))
  (obj ramp line~ (pos 200 350))
  (obj vca *~ (pos 20 385))
  (obj out dac~ (pos 20 425))
  (obj tip comment "However hard you drive it, tanh~ stays within -1 and 1, and rounds the peaks off; clip~ cuts them flat." (pos 20 465))
  (connect osc 0 ab 0)
  (connect osc 0 cl 0)
  (connect osc 0 gain 0)
  (connect lo 0 cl 1)
  (connect hi 0 cl 2)
  (connect drive 0 gain 1)
  (connect gain 0 th 0)
  (connect ab 0 sel 1)
  (connect cl 0 sel 2)
  (connect th 0 sel 3)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect sel 0 sc 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
