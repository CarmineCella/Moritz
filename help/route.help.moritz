; route.help.moritz - help for route
(patch
  (obj title comment "route a b ...: sends a message out of the outlet whose argument matches its first word" (pos 20 12))
  (obj sub comment "The matched word is removed; if nothing is left, the outlet sends a bang. A message that matches nothing goes out of" (pos 20 34))
  (obj sub2 comment "the last outlet, unchanged. The arguments can be words or numbers: route 1 2 sends \"2 64\" out of its second outlet as 64." (pos 20 52))
  (obj m1 message "freq 440" (pos 20 85))
  (obj m2 message "amp 0.5" (pos 95 85))
  (obj m3 message go (pos 165 85))
  (obj m4 message "pan 1 2" (pos 210 85))
  (obj cm comment "click a message" (pos 285 86))
  (obj rt route freq amp go (pos 20 130))
  (obj ofreq flonum (pos 20 185))
  (obj oamp flonum (pos 100 185))
  (obj ogo button (pos 180 185))
  (obj ss message "set $1 $2 $3" (pos 240 185))
  (obj show message "-" (pos 240 220))
  (obj cfreq comment "freq" (pos 20 220))
  (obj camp comment "amp" (pos 100 220))
  (obj cgo comment "go" (pos 180 220))
  (obj cshow comment "no match: the whole message" (pos 345 186))
  (connect m1 0 rt 0)
  (connect m2 0 rt 0)
  (connect m3 0 rt 0)
  (connect m4 0 rt 0)
  (connect rt 0 ofreq 0)
  (connect rt 1 oamp 0)
  (connect rt 2 ogo 0)
  (connect rt 3 ss 0)
  (connect ss 0 show 0))
