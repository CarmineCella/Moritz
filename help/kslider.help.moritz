; kslider.help.moritz - help for kslider
(patch
  (obj title comment "kslider [octaves] [lowest note] [mode]: a piano keyboard (4 octaves from note 36 by default)" (pos 20 12))
  (obj sub comment "Outlets: pitch and velocity (velocity is sent first). Mode 0 plays while the mouse is down; mode 1 toggles keys on and off." (pos 20 34))
  (obj sub2 comment "Left inlet: a pitch (or pitch velocity) lights its key and passes through. Right inlet: the velocity for pitches alone (100)." (pos 20 52))
  (obj m60 message 60 (pos 20 75))
  (obj m60off message "60 0" (pos 58 75))
  (obj mset message "set 67 100" (pos 112 75))
  (obj munset message "set 67 0" (pos 205 75))
  (obj mclear message clear (pos 285 75))
  (obj vel number 100 (pos 350 75))
  (obj cvel comment "velocity for pitches sent alone" (pos 415 76))
  (obj play kslider 4 36 (pos 20 110))
  (obj c1 comment "click (locked): lower on a key is louder" (pos 385 108))
  (obj c2 comment "letting go sends velocity 0; drag to glide" (pos 385 126))
  (obj c3 comment "set p v only lights a key; clear unlights all" (pos 385 144))
  (obj npitch number (pos 20 180))
  (obj cpitch comment "pitch" (pos 85 181))
  (obj nvel number (pos 250 180))
  (obj cnvel comment "velocity" (pos 315 181))
  (obj flush message flush (pos 400 185))
  (obj cflush comment "releases every held key, sending note-offs" (pos 455 186))
  (obj chord kslider 2 60 1 (pos 400 215))
  (obj cchord comment "kslider 2 60 1: toggle mode, click to hold a chord" (pos 400 300))
  (obj pk pack 0 0 (pos 20 290))
  (obj mn message "midinote $1 $2" (pos 20 322))
  (obj poly poly~ keyvoice 8 (pos 20 354))
  (obj cpoly comment "each note sounds until its note-off (examples/11-midi-and-patching/keyvoice.moritz)" (pos 160 355))
  (obj on message "0.15 50" (pos 110 386))
  (obj off message "0 50" (pos 180 386))
  (obj cv comment "volume on / off" (pos 240 387))
  (obj ramp line~ (pos 110 416))
  (obj vca *~ (pos 20 446))
  (obj out dac~ (pos 20 480))
  (connect m60 0 play 0)
  (connect m60off 0 play 0)
  (connect mset 0 play 0)
  (connect munset 0 play 0)
  (connect mclear 0 play 0)
  (connect vel 0 play 1)
  (connect play 0 npitch 0)
  (connect play 1 nvel 0)
  (connect npitch 0 pk 0)
  (connect nvel 0 pk 1)
  (connect flush 0 chord 0)
  (connect chord 0 pk 0)
  (connect chord 1 pk 1)
  (connect pk 0 mn 0)
  (connect mn 0 poly 0)
  (connect poly 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
