; sparkle~.help.moritz - help for sparkle~
(patch
  (obj title comment "sparkle~ [buffer] [channels] [window] [overlap]: phase vocoder with formant preservation and phase locking" (pos 20 12))
  (obj sub comment "With a buffer~ it plays it: the left inlet is the speed (0 freezes, negative plays backwards). Without one it transforms its input." (pos 20 34))
  (obj sub2 comment "Inlets 2-3: pitch and formant ratios. envelope C keeps the formants (C = 30-80 for voices); threshold x drops weak bins." (pos 20 52))
  (obj buf buffer~ helpspk ../data/Vox.wav (pos 20 85))
  (obj go message "start, loop 1" (pos 20 120))
  (obj st message stop (pos 120 120))
  (obj s1 message 1 (pos 20 160))
  (obj s2 message 0.5 (pos 55 160))
  (obj s3 message 0.25 (pos 100 160))
  (obj s4 message 0 (pos 150 160))
  (obj s5 message -1 (pos 185 160))
  (obj cs comment "speed: normal, 1/2, 1/4, frozen, backwards" (pos 225 161))
  (obj p1 message 1 (pos 20 195))
  (obj p2 message 1.5 (pos 55 195))
  (obj p3 message 0.75 (pos 100 195))
  (obj p4 message 2 (pos 150 195))
  (obj cp comment "pitch ratio" (pos 190 196))
  (obj e0 message "envelope 0" (pos 20 230))
  (obj e1 message "envelope 60" (pos 105 230))
  (obj ce comment "keep the formants: compare 2 with and without" (pos 200 231))
  (obj fm flonum 1 (pos 470 195))
  (obj cf comment "formant ratio" (pos 530 196))
  (obj r1 message "robot 1" (pos 20 265))
  (obj r2 message "whisper 1" (pos 85 265))
  (obj r0 message "robot 0" (pos 165 265))
  (obj cr comment "phase effects" (pos 230 266))
  (obj spk sparkle~ helpspk (pos 20 305))
  (obj wf waveform~ helpspk 300 70 (pos 350 290))
  (obj snap snapshot~ 30 (pos 230 330))
  (obj ms * 15100. (pos 230 360))
  (obj cwf comment "the read position" (pos 350 365))
  (obj on message "0.2 50" (pos 20 345))
  (obj off message "0 50" (pos 85 345))
  (obj cv comment "volume" (pos 140 346))
  (obj ramp line~ (pos 20 380))
  (obj vca *~ (pos 20 415))
  (obj out dac~ (pos 20 450))
  (obj live comment "Without a buffer~ name (sparkle~ alone), the left inlet is a live input, transformed with one window of latency." (pos 20 490))
  (obj xt comment "Cross-synthesis with a second sound: cross mode [buffer] (1 multiplicative, 2 spectral flattener, 3 morph, 0 off); amount in inlet 4." (pos 20 520))
  (obj xb buffer~ helpspkdrums ../data/drums.wav (pos 20 545))
  (obj x1 message "cross 1 helpspkdrums" (pos 20 575))
  (obj x2 message "cross 2 helpspkdrums, envelope 60" (pos 190 575))
  (obj x3 message "cross 3 helpspkdrums" (pos 450 575))
  (obj x0 message "cross 0" (pos 620 575))
  (obj xa flonum 0.5 (pos 20 610))
  (obj cxa comment "amount, 0 to 1 (mode 1: whose phases; 2: how much envelope; 3: from one sound to the other)" (pos 85 611))
  (obj xs comment "Without a buffer, the second sound is the signal in inlet 5. See examples/06-spectral/sparkle-cross.moritz and pitch-shift.moritz." (pos 20 640))
  (connect go 0 spk 0)
  (connect st 0 spk 0)
  (connect s1 0 spk 0)
  (connect s2 0 spk 0)
  (connect s3 0 spk 0)
  (connect s4 0 spk 0)
  (connect s5 0 spk 0)
  (connect p1 0 spk 1)
  (connect p2 0 spk 1)
  (connect p3 0 spk 1)
  (connect p4 0 spk 1)
  (connect fm 0 spk 2)
  (connect e0 0 spk 0)
  (connect e1 0 spk 0)
  (connect r1 0 spk 0)
  (connect r2 0 spk 0)
  (connect r0 0 spk 0)
  (connect spk 1 snap 0)
  (connect snap 0 ms 0)
  (connect ms 0 wf 0)
  (connect spk 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect x1 0 spk 0)
  (connect x2 0 spk 0)
  (connect x3 0 spk 0)
  (connect x0 0 spk 0)
  (connect xa 0 spk 3))
