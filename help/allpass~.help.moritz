; allpass~.help.moritz - help for allpass~
(patch
  (obj title comment "allpass~ [max delay gain]: allpass filter, for reverbs" (pos 20 12))
  (obj sub comment "y[n] = -g x[n] + x[n-D] + g y[n-D], where D is the delay in ms and g the gain. Inlets: signal, delay, gain (signals or floats)." (pos 20 34))
  (obj sub2 comment "Defaults: max 50 ms (up to 10000), delay max / 2, gain 0.7. All frequencies pass at the same level; only their timing changes." (pos 20 52))
  (obj btn button (pos 20 85))
  (obj cbtn comment "a click" (pos 50 89))
  (obj d1 message 5 (pos 150 85))
  (obj d2 message 30 (pos 190 85))
  (obj d3 message 80 (pos 230 85))
  (obj g1 message 0.5 (pos 380 85))
  (obj g2 message 0.7 (pos 422 85))
  (obj g3 message 0.9 (pos 464 85))
  (obj del flonum 30 (pos 150 120))
  (obj cdel comment "delay (ms)" (pos 212 121))
  (obj gain flonum 0.7 (pos 380 160))
  (obj cgain comment "gain: higher, longer" (pos 442 161))
  (obj clk click~ (pos 20 160))
  (obj f allpass~ 100 30 0.7 (pos 20 210))
  (obj cf comment "the click comes out as -g, then echoes every D ms that die away" (pos 180 214))
  (obj sc meter~ (pos 480 250))
  (obj on message "0.15 50" (pos 200 265))
  (obj off message "0 50" (pos 270 265))
  (obj cv comment "volume on / off" (pos 330 266))
  (obj ramp line~ (pos 200 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj tip comment "With delays of a few ms the echoes merge and smear the sound without colouring it: reverb~ chains four per channel." (pos 20 415))
  (connect btn 0 clk 0)
  (connect d1 0 del 0)
  (connect d2 0 del 0)
  (connect d3 0 del 0)
  (connect g1 0 gain 0)
  (connect g2 0 gain 0)
  (connect g3 0 gain 0)
  (connect clk 0 f 0)
  (connect del 0 f 1)
  (connect gain 0 f 2)
  (connect f 0 sc 0)
  (connect f 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
