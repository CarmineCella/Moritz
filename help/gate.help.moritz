; gate.help.moritz - help for gate
(patch
  (obj title comment "gate [n] [open]: passes messages to one of n outlets (n is 1 by default), or to none" (pos 20 12))
  (obj sub comment "Left inlet: which outlet is open, 1 to n; 0 closes the gate (it starts closed unless open is given). Above n opens the last." (pos 20 34))
  (obj sub2 comment "Right inlet: any message, sent out of the open outlet. Mind the order: the choice is on the left, the data on the right." (pos 20 52))
  (obj g0 message 0 (pos 20 85))
  (obj g1 message 1 (pos 60 85))
  (obj g2 message 2 (pos 100 85))
  (obj cg comment "closed, outlet 1, outlet 2" (pos 150 86))
  (obj data flonum (pos 330 85))
  (obj cdata comment "data: drag me" (pos 395 86))
  (obj gt gate 2 (pos 20 140))
  (obj o1 flonum (pos 20 180))
  (obj o2 flonum (pos 110 180))
  (obj c1 comment "outlet 1" (pos 20 210))
  (obj c2 comment "outlet 2" (pos 110 210))
  (obj c3 comment "Use: a toggle as an on/off switch for a stream of numbers (gate 1: 1 = open, 0 = closed)." (pos 20 255))
  (obj tog toggle (pos 20 280))
  (obj sl slider 0 100 (pos 100 280))
  (obj g gate (pos 20 320))
  (obj out number (pos 20 360))
  (obj cout comment "follows the slider while the toggle is on" (pos 85 361))
  (connect g0 0 gt 0)
  (connect g1 0 gt 0)
  (connect g2 0 gt 0)
  (connect data 0 gt 1)
  (connect gt 0 o1 0)
  (connect gt 1 o2 0)
  (connect tog 0 g 0)
  (connect sl 0 g 1)
  (connect g 0 out 0))
