; noise~.help.moritz - help for noise~
(patch
  (obj title comment "noise~: white noise, from -1 to 1" (pos 20 12))
  (obj sub comment "No arguments, and its inlet takes no messages. Every noise~ starts from its own seed, so two of them are independent." (pos 20 34))
  (obj nl noise~ (pos 20 75))
  (obj nr noise~ (pos 120 75))
  (obj cn comment "two noise~: different noise in each channel" (pos 190 76))
  (obj sc scope~ (pos 440 130))
  (obj mt meter~ (pos 640 130))
  (obj on message "0.1 50" (pos 220 130))
  (obj off message "0 50" (pos 285 130))
  (obj cv comment "volume on / off" (pos 345 131))
  (obj ramp line~ (pos 220 165))
  (obj vl *~ (pos 20 200))
  (obj vr *~ (pos 120 200))
  (obj out dac~ (pos 20 245))
  (obj tip comment "White noise has equal energy at all frequencies. Filter it to colour it: try noise~ -> lores~ 500 0.5, or reson~." (pos 20 290))
  (connect nl 0 sc 0)
  (connect nl 0 mt 0)
  (connect nl 0 vl 0)
  (connect nr 0 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
