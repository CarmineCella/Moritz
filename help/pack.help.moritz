; pack.help.moritz - help for pack and unpack
(patch
  (obj title comment "pack [items]: builds a list from separate values.   unpack [items]: splits a list into them" (pos 20 12))
  (obj sub comment "pack has one inlet per item (pack alone is pack 0 0). Left inlet (hot): a number sets the first item and outputs the list," (pos 20 34))
  (obj sub2 comment "bang outputs it again. The other inlets only store. The arguments are the first values (f, i and s start as 0, 0 and empty)." (pos 20 52))
  (obj a flonum (pos 20 85))
  (obj b flonum (pos 100 85))
  (obj c flonum (pos 180 85))
  (obj cabc comment "drag b and c, then a" (pos 245 86))
  (obj pk pack 0 0 0 (pos 20 130))
  (obj ss message "set $1 $2 $3" (pos 20 175))
  (obj show message "0 0 0" (pos 20 210))
  (obj cshow comment "the list (set ... writes it into this box)" (pos 150 211))
  (obj sub3 comment "unpack has one outlet per argument (unpack alone has 2) and sends the items out from right to left:" (pos 20 260))
  (obj l3 message "1 2 3" (pos 20 285))
  (obj l4 message "7 8 9 10" (pos 75 285))
  (obj l1 message 5 (pos 150 285))
  (obj up unpack 0 0 0 (pos 20 325))
  (obj o1 flonum (pos 20 365))
  (obj o2 flonum (pos 100 365))
  (obj o3 flonum (pos 180 365))
  (obj cup comment "extra items are dropped; a shorter list sets only the first outlets" (pos 20 400))
  (connect a 0 pk 0)
  (connect b 0 pk 1)
  (connect c 0 pk 2)
  (connect pk 0 ss 0)
  (connect ss 0 show 0)
  (connect l3 0 up 0)
  (connect l4 0 up 0)
  (connect l1 0 up 0)
  (connect up 0 o1 0)
  (connect up 1 o2 0)
  (connect up 2 o3 0))
