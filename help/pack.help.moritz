; pack.help.moritz - help for pack and unpack
(patch
  (obj title comment "pack [items]: builds a list from separate values.   unpack [items]: splits a list into them" (pos 20 12))
  (obj sub comment "pack has one inlet per item (pack alone is pack 0 0). Left inlet (hot): a number sets the first item and outputs the list;" (pos 20 34))
  (obj sub2 comment "bang outputs it again, set stores without output. The other inlets only store. Each argument is a first value and a type:" (pos 20 52))
  (obj sub4 comment "as in Max, 0 or i is an integer (decimals are truncated), 0. or f a decimal, s or a word a symbol. Here the second item is an integer." (pos 20 70))
  (obj a flonum (pos 20 100))
  (obj b flonum (pos 100 100))
  (obj c flonum (pos 180 100))
  (obj cabc comment "drag b and c, then a" (pos 245 101))
  (obj pk pack 0. 0 0. (pos 20 135))
  (obj ss message "set $1 $2 $3" (pos 20 175))
  (obj show message "0 0 0" (pos 20 210))
  (obj cshow comment "the list (set ... writes it into this box)" (pos 150 211))
  (obj sub3 comment "unpack has one outlet per argument (unpack alone is unpack 0 0) and sends the items out from right to left, typed in the same way:" (pos 20 260))
  (obj l3 message "1.5 2.5 3.5" (pos 20 285))
  (obj l4 message "7 8 9 10" (pos 115 285))
  (obj l1 message 5 (pos 190 285))
  (obj up unpack 0. 0 0. (pos 20 325))
  (obj o1 flonum (pos 20 365))
  (obj o2 flonum (pos 100 365))
  (obj o3 flonum (pos 180 365))
  (obj cup comment "extra items are dropped; a shorter list sets only the first outlets. The middle outlet is an integer: 2.5 gives 2." (pos 20 400))
  (connect a 0 pk 0)
  (connect b 0 pk 1)
  (connect c 0 pk 2)
  (connect pk 0 ss 0)
  (connect ss 0 show 0)
  (connect l3 0 up 0)
  (connect l4 0 up 0)
  (connect l1 0 up 0)
  (connect up 0 o1 0)
  (connect up 1 o2 0)
  (connect up 2 o3 0))
