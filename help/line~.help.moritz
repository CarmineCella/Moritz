; line~.help.moritz - help for line~
(patch
  (obj title comment "line~ [start]: signal ramps, for envelopes and smooth changes" (pos 20 12))
  (obj sub comment "Left inlet: target-time pairs make segments that start from the current value. A new message replaces the pending ones." (pos 20 34))
  (obj sub2 comment "A float alone jumps, or ramps over the time sent to the right inlet (used for one float only). stop freezes the ramp." (pos 20 52))
  (obj m1 message "1 10 0 300" (pos 20 85))
  (obj c1 comment "a short note: to 1 in 10 ms, then to 0 in 300 ms" (pos 110 89))
  (obj m2 message "1 1000" (pos 45 115))
  (obj c2 comment "to 1 in one second" (pos 110 119))
  (obj m3 message "0 2000" (pos 70 145))
  (obj c3 comment "back to 0 in two seconds" (pos 135 149))
  (obj m4 message stop (pos 95 175))
  (obj c4 comment "freeze the ramp where it is" (pos 145 179))
  (obj m5 message 1 (pos 120 205))
  (obj m6 message 0 (pos 160 205))
  (obj c5 comment "a float alone jumps to that value" (pos 205 209))
  (obj time flonum 0 (pos 145 237))
  (obj c6 comment "... or ramps over this time (ms), once" (pos 207 238))
  (obj ln line~ (pos 20 280))
  (obj osc cycle~ 440 (pos 120 280))
  (obj env *~ (pos 20 320))
  (obj snap snapshot~ 20 (pos 400 320))
  (obj val flonum 0 (pos 400 355))
  (obj cval comment "the value of line~" (pos 495 356))
  (obj on message "0.15 50" (pos 100 360))
  (obj off message "0 50" (pos 170 360))
  (obj cv comment "volume on / off" (pos 230 361))
  (obj ramp line~ (pos 100 395))
  (obj vca *~ (pos 20 430))
  (obj out dac~ (pos 20 470))
  (connect m1 0 ln 0)
  (connect m2 0 ln 0)
  (connect m3 0 ln 0)
  (connect m4 0 ln 0)
  (connect m5 0 ln 0)
  (connect m6 0 ln 0)
  (connect time 0 ln 1)
  (connect ln 0 env 0)
  (connect osc 0 env 1)
  (connect ln 0 snap 0)
  (connect snap 0 val 0)
  (connect env 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
