; selector~.help.moritz - help for selector~ and gate~
(patch
  (obj title comment "selector~ n [initial]: pass one of n signals.   gate~ n [initial]: send a signal to one of n outlets" (pos 20 12))
  (obj sub comment "The left inlet picks 1..n (0 = none). Switching crossfades over 5 ms, so it never clicks." (pos 20 34))
  (obj s0 message 0 (pos 20 70))
  (obj s1 message 1 (pos 60 70))
  (obj s2 message 2 (pos 100 70))
  (obj s3 message 3 (pos 140 70))
  (obj a cycle~ 220 (pos 200 70))
  (obj b saw~ 220 (pos 290 70))
  (obj c noise~ (pos 370 70))
  (obj sel selector~ 3 1 (pos 20 115))
  (obj csel comment "1 = sine, 2 = saw, 3 = noise" (pos 130 116))
  (obj g0 message 0 (pos 20 165))
  (obj g1 message 1 (pos 60 165))
  (obj g2 message 2 (pos 100 165))
  (obj gate gate~ 2 1 (pos 20 205))
  (obj cgate comment "gate~ 2: 1 = left channel, 2 = right channel, 0 = closed" (pos 120 206))
  (obj on message "0.1 50" (pos 300 245))
  (obj off message "0 50" (pos 370 245))
  (obj cv comment "volume on / off" (pos 430 246))
  (obj ramp line~ (pos 300 280))
  (obj vl *~ (pos 20 320))
  (obj vr *~ (pos 120 320))
  (obj out dac~ (pos 20 360))
  (connect s0 0 sel 0)
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect a 0 sel 1)
  (connect b 0 sel 2)
  (connect c 0 sel 3)
  (connect sel 0 gate 1)
  (connect g0 0 gate 0)
  (connect g1 0 gate 0)
  (connect g2 0 gate 0)
  (connect gate 0 vl 0)
  (connect gate 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
