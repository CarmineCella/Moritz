; pvlock~.help.moritz - help for pvlock~
(patch
  (obj title comment "pvlock~: phase vocoder resynthesis phase, with identity phase locking" (pos 20 12))
  (obj sub comment "Inlets: amplitude, analysed phase, phase difference from the previous frame, reset. Use it in a pfft~: it needs a whole frame." (pos 20 34))
  (obj sub2 comment "It finds the amplitude peaks. A peak's phase advances by its phase difference; the bins around it keep their analysed offset from it." (pos 20 52))
  (obj lb loadbang (pos 20 80))
  (obj buf buffer~ helppvl ../data/Vox.wav (pos 100 80))
  (obj init message "loop 1, 0" (pos 20 115))
  (obj rate sig~ 1 (pos 110 115))
  (obj gr groove~ helppvl (pos 20 150))
  (obj cgr comment "Vox.wav, looping" (pos 120 151))
  (obj lk0 message 0 (pos 360 105))
  (obj lk1 message 1 (pos 395 105))
  (obj clk comment "phase: 0 from pvlock~, 1 plain frameaccum~ 1" (pos 430 106))
  (obj fz1 message 1 (pos 360 140))
  (obj fz0 message 0 (pos 395 140))
  (obj cfz comment "freeze, live" (pos 430 141))
  (obj pf pfft~ help-pvlock 1024 4 (pos 20 205))
  (obj cpf comment "inlets: signal, freeze, phase" (pos 170 206))
  (obj sp spectroscope~ 360 130 (pos 240 255))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj e1 comment "Reset: if any bin of the reset signal is not 0, the whole frame outputs the analysed phase (after a jump, or while live)." (pos 20 415))
  (obj e2 comment "Freeze, then compare: with plain phases each bin of a partial drifts on its own and the voice sounds phasey." (pos 20 433))
  (obj e3 comment "examples/06-spectral/pvoc.moritz uses pvlock~ to time-stretch a phrase." (pos 20 451))
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect rate 0 gr 0)
  (connect gr 0 pf 0)
  (connect fz1 0 pf 1)
  (connect fz0 0 pf 1)
  (connect lk1 0 pf 2)
  (connect lk0 0 pf 2)
  (connect pf 0 sp 0)
  (connect pf 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
