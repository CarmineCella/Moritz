; specenv~.help.moritz - help for specenv~
(patch
  (obj title comment "specenv~ [order] [iterations]: the spectral envelope of each frame, inside pfft~" (pos 20 12))
  (obj sub comment "Left inlet: the amplitudes (from cartopol~). Outlets: the envelope (the formants: the colour of the sound) and the fine structure" (pos 20 34))
  (obj sub2 comment "(the amplitudes divided by the envelope: the harmonics or the noise, flat). order: the resolution, about sr / (2 f0); right inlet." (pos 20 52))
  (obj sub3 comment "iterations: 12 by default, the true envelope, which rides on the harmonic peaks; 0 for the plain cepstral smoothing." (pos 20 70))
  (obj b buffer~ helpsevox ../examples/sounds/Vox.wav (pos 20 105))
  (obj pl message "loop 1, start" (pos 20 140))
  (obj v groove~ helpsevox (pos 20 175))
  (obj rate sig~ 1 (pos 150 140))
  (obj m1 message 1 (pos 300 140))
  (obj m2 message 2 (pos 340 140))
  (obj m3 message 3 (pos 380 140))
  (obj cm comment "1 voice, 2 envelope alone (a whisper), 3 fine structure alone" (pos 420 141))
  (obj co comment "order" (pos 300 175))
  (obj o slider 5 150 (pos 300 195))
  (obj on number (pos 455 195))
  (obj fx pfft~ help-specenv 1024 4 (pos 20 240))
  (obj on1 message "0.5 50" (pos 250 280))
  (obj off1 message "0 50" (pos 320 280))
  (obj ramp line~ (pos 250 315))
  (obj vca *~ (pos 20 315))
  (obj out dac~ (pos 20 355))
  (obj spec spectroscope~ 300 100 (pos 450 250))
  (obj lb loadbang (pos 600 140))
  (obj oi message 40 (pos 600 170))
  (obj note comment "Uses: cross-synthesis by envelope (examples/spectral-envelope.moritz), formant preservation, whitening." (pos 20 400))
  (connect pl 0 v 0)
  (connect rate 0 v 0)
  (connect v 0 fx 0)
  (connect m1 0 fx 1)
  (connect m2 0 fx 1)
  (connect m3 0 fx 1)
  (connect o 0 on 0)
  (connect on 0 fx 2)
  (connect fx 0 vca 0)
  (connect fx 0 spec 0)
  (connect on1 0 ramp 0)
  (connect off1 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect lb 0 oi 0)
  (connect oi 0 o 0))
