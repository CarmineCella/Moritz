; help-specenv.moritz - for specenv~.help.moritz: the spectral patch, run by
; pfft~ once per frame. Mode 1: the voice; 2: its envelope alone, on random
; phases (a whisper); 3: its fine structure alone (the formants taken out).
(patch
  (obj c0 comment "mode 1 voice, 2 envelope (whisper), 3 fine structure" (pos 20 10))
  (obj v fftin~ 1 (pos 20 45))
  (obj mode inlet (pos 200 45))
  (obj order inlet (pos 260 45))
  (obj cp cartopol~ (pos 20 85))
  (obj se specenv~ 40 (pos 20 125))
  (obj boost *~ 4 (pos 150 165))
  (obj nz noise~ (pos 330 125))
  (obj rp *~ 3.1416 (pos 330 165))
  (obj amp selector~ 3 1 (pos 20 210))
  (obj ph selector~ 3 1 (pos 250 210))
  (obj pc poltocar~ (pos 20 250))
  (obj out fftout~ 1 (pos 20 290))
  (connect v 0 cp 0)
  (connect v 1 cp 1)
  (connect cp 0 se 0)
  (connect order 0 se 1)
  (connect se 1 boost 0)
  (connect nz 0 rp 0)
  (connect mode 0 amp 0)
  (connect mode 0 ph 0)
  (connect cp 0 amp 1)
  (connect se 0 amp 2)
  (connect boost 0 amp 3)
  (connect cp 1 ph 1)
  (connect rp 0 ph 2)
  (connect cp 1 ph 3)
  (connect amp 0 pc 0)
  (connect ph 0 pc 1)
  (connect pc 0 out 0))
