; onsets.help.moritz - help for onsets
(patch
  (obj title comment "onsets [threshold] [size] [hop]: where the notes and hits of a buffer~ begin" (pos 20 12))
  (obj sub comment "run sound [curve]: the peaks of the spectral flux (how much the spectrum grows) above threshold times its moving median, each placed" (pos 20 34))
  (obj sub2 comment "where the energy jumps. Out: onset times (ms), the flux into curve. Then segment k gives start and end of segment k, for play~." (pos 20 52))
  (obj src buffer~ hosrc ../data/drums.wav (pos 20 85))
  (obj fx buffer~ hoflux (pos 280 85))
  (obj lb loadbang (pos 20 120))
  (obj run message "run hosrc hoflux" (pos 20 150))
  (obj t1 message "threshold 1.5" (pos 160 150))
  (obj t2 message "threshold 4" (pos 265 150))
  (obj gap message "gap 100" (pos 360 150))
  (obj ct comment "fewer or more onsets" (pos 160 175))
  (obj on onsets 2 1024 256 (pos 20 200))
  (obj prog flonum (pos 20 240))
  (obj done button (pos 90 240))
  (obj nseg number (pos 280 240))
  (obj cn comment "segments" (pos 340 241))
  (obj w plot hosrc 600 110 (pos 440 120))
  (obj f plot hoflux 600 70 (pos 440 240))
  (obj cw comment "the drums with their onsets; the flux below. Click the drums to play from there." (pos 440 315))
  (obj cs comment "play the segments in a random order: a new pattern from the same hits" (pos 20 350))
  (obj tg toggle (pos 20 375))
  (obj met metro 250 (pos 20 405))
  (obj rnd random 28 (pos 20 435))
  (obj seg message "segment $1" (pos 20 465))
  (obj k number (pos 130 435))
  (obj ck comment "or play one" (pos 190 436))
  (obj pl message "start $1 $2" (pos 20 525))
  (obj ck2 comment "start end (ms)" (pos 115 526))
  (obj clk message "start $1" (pos 440 345))
  (obj play play~ hosrc 2 (pos 20 560))
  (obj on1 message "0.4 50" (pos 200 560))
  (obj off message "0 50" (pos 265 560))
  (obj cv comment "volume" (pos 320 561))
  (obj ramp line~ (pos 200 590))
  (obj vl *~ (pos 20 620))
  (obj vr *~ (pos 110 620))
  (obj out dac~ (pos 20 655))
  (connect lb 0 run 0)
  (connect run 0 on 0)
  (connect t1 0 on 0)
  (connect t2 0 on 0)
  (connect gap 0 on 0)
  (connect on 0 prog 0)
  (connect on 1 done 0)
  (connect on 2 w 1)
  (connect on 2 f 1)
  (connect on 4 nseg 0)
  (connect on 4 rnd 1)
  (connect tg 0 met 0)
  (connect met 0 rnd 0)
  (connect rnd 0 seg 0)
  (connect k 0 seg 0)
  (connect seg 0 on 0)
  (connect on 3 pl 0)
  (connect pl 0 play 0)
  (connect w 0 clk 0)
  (connect clk 0 play 0)
  (connect play 0 vl 0)
  (connect play 1 vr 0)
  (connect on1 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
