; sfrecord~.help.moritz - help for sfrecord~
(patch
  (obj title comment "sfrecord~ [channels]: record signals to a 24-bit WAV file" (pos 20 12))
  (obj sub comment "open file.wav names the file (relative to the patch), 1 starts, 0 stops; the file is complete once it stops. Audio must be on." (pos 20 34))
  (obj sub2 comment "Each inlet records one channel. Recording again overwrites the file. The outlet reports the time recorded, every 250 ms." (pos 20 52))
  (obj lb loadbang (pos 20 80))
  (obj of message "open ../examples/sounds/flute.wav" (pos 20 115))
  (obj orec message "open help-recording.wav" (pos 260 115))
  (obj p1 message 1 (pos 260 155))
  (obj p0 message 0 (pos 300 155))
  (obj cp comment "play the flute" (pos 340 156))
  (obj src sfplay~ 1 (pos 20 195))
  (obj tog toggle (pos 150 255))
  (obj ctog comment "record on / off" (pos 180 257))
  (obj rec sfrecord~ 1 (pos 150 300))
  (obj ms flonum (pos 150 340))
  (obj cms comment "ms recorded" (pos 240 341))
  (obj cpb comment "then play the file:" (pos 430 236))
  (obj pb message "open help-recording.wav, 1" (pos 430 260))
  (obj play sfplay~ 1 (pos 430 300))
  (obj on message "0.15 50" (pos 480 355))
  (obj off message "0 50" (pos 550 355))
  (obj cv comment "volume on / off" (pos 610 356))
  (obj ramp line~ (pos 480 390))
  (obj vm *~ (pos 20 430))
  (obj vp *~ (pos 430 430))
  (obj out dac~ (pos 20 470))
  (connect lb 0 of 0)
  (connect lb 0 orec 0)
  (connect of 0 src 0)
  (connect orec 0 rec 0)
  (connect p1 0 src 0)
  (connect p0 0 src 0)
  (connect src 0 rec 0)
  (connect tog 0 rec 0)
  (connect rec 0 ms 0)
  (connect pb 0 play 0)
  (connect src 0 vm 0)
  (connect play 0 vp 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vm 1)
  (connect ramp 0 vp 1)
  (connect vm 0 out 0)
  (connect vm 0 out 1)
  (connect vp 0 out 0)
  (connect vp 0 out 1))
