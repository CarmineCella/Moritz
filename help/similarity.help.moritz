; similarity.help.moritz - help for similarity and novelty
(patch
  (obj title comment "similarity [frames], novelty [width] [threshold]: the form of a piece" (pos 20 12))
  (obj sub comment "similarity: run features matrix compares every frame of a feature matrix (a chromagram, MFCCs) with every other (Foote 1999): sections" (pos 20 34))
  (obj sub2 comment "are squares on the diagonal, repeats are stripes beside it. novelty: run similarity curve finds where the past and the future differ (Foote 2000)." (pos 20 52))
  (obj bee buffer~ hsmbee ../examples/sounds/Beethoven_Symph7.wav (pos 20 85))
  (obj ch buffer~ hsmchroma (pos 380 85))
  (obj ss buffer~ hsmssm (pos 510 85))
  (obj nv buffer~ hsmnov (pos 620 85))
  (obj lb loadbang (pos 20 120))
  (obj r1 message "run hsmbee hsmchroma" (pos 20 150))
  (obj a1 chromagram (pos 20 180))
  (obj r2 message "run hsmchroma hsmssm" (pos 20 215))
  (obj a2 similarity 1000 (pos 20 245))
  (obj c2 comment "at most 1000 frames (averaged)" (pos 20 270))
  (obj r3 message "run hsmssm hsmnov" (pos 20 300))
  (obj a3 novelty 32 1.5 (pos 20 330))
  (obj c3 comment "kernel 32 frames, threshold 1.5" (pos 20 355))
  (obj pre prepend set (pos 20 450))
  (obj bounds message "" (pos 20 680))
  (obj cb comment "the boundaries (ms) below" (pos 110 451))
  (obj st message "standardize 1" (pos 160 245))
  (obj w1 message "width 16" (pos 160 330))
  (obj w2 message "width 64" (pos 230 330))
  (obj l1 loadbang (pos 20 390))
  (obj lab message "labels chroma" (pos 20 420))
  (obj p1 plot hsmchroma 400 100 (pos 330 120))
  (obj p2 plot hsmssm 320 320 (pos 330 235))
  (obj p3 plot hsmnov 400 80 (pos 330 570))
  (obj c4 comment "click the matrix: it plays from there" (pos 660 235))
  (obj clk message "start $1" (pos 660 260))
  (obj play play~ hsmbee (pos 660 290))
  (obj stp message stop (pos 760 260))
  (obj vca *~ 0.3 (pos 660 320))
  (obj out dac~ (pos 660 350))
  (connect lb 0 r1 0)
  (connect r1 0 a1 0)
  (connect a1 1 r2 0)
  (connect r2 0 a2 0)
  (connect a2 1 r3 0)
  (connect r3 0 a3 0)
  (connect st 0 a2 0)
  (connect w1 0 a3 0)
  (connect w2 0 a3 0)
  (connect a3 2 pre 0)
  (connect pre 0 bounds 0)
  (connect a3 2 p3 1)
  (connect a3 2 p1 1)
  (connect l1 0 lab 0)
  (connect lab 0 p1 0)
  (connect p2 0 clk 0)
  (connect clk 0 play 0)
  (connect stp 0 play 0)
  (connect play 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
