; sfplay~.help.moritz - help for sfplay~
(patch
  (obj title comment "sfplay~ [channels]: play a sound file" (pos 20 12))
  (obj sub comment "open file loads a WAV, FLAC or MP3 file (relative to the patch). 1 or bang plays it from the start, 0 stops." (pos 20 34))
  (obj sub2 comment "loop 1/0 turns looping on/off; speed x changes speed and pitch together (1 = normal). The argument is the number of outlets." (pos 20 52))
  (obj lb loadbang (pos 200 80))
  (obj of message "open ../examples/sounds/flute.wav" (pos 200 115))
  (obj ov message "open ../examples/sounds/voice.wav" (pos 200 150))
  (obj ob message "open ../examples/sounds/bell.wav" (pos 200 185))
  (obj p1 message 1 (pos 170 230))
  (obj p0 message 0 (pos 210 230))
  (obj l1 message "loop 1" (pos 260 230))
  (obj l0 message "loop 0" (pos 320 230))
  (obj spd flonum 1 (pos 420 195))
  (obj cspd comment "speed (1 = normal)" (pos 485 196))
  (obj sm message "speed $1" (pos 420 230))
  (obj sf sfplay~ 2 (pos 20 290))
  (obj c2 comment "left and right outlets (a mono file plays on both)" (pos 100 291))
  (obj on message "0.15 50" (pos 200 330))
  (obj off message "0 50" (pos 270 330))
  (obj cv comment "volume on / off" (pos 330 331))
  (obj ramp line~ (pos 200 365))
  (obj vl *~ (pos 20 400))
  (obj vr *~ (pos 120 400))
  (obj out dac~ (pos 20 440))
  (connect lb 0 of 0)
  (connect of 0 sf 0)
  (connect ov 0 sf 0)
  (connect ob 0 sf 0)
  (connect p1 0 sf 0)
  (connect p0 0 sf 0)
  (connect l1 0 sf 0)
  (connect l0 0 sf 0)
  (connect spd 0 sm 0)
  (connect sm 0 sf 0)
  (connect sf 0 vl 0)
  (connect sf 1 vr 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vl 1)
  (connect ramp 0 vr 1)
  (connect vl 0 out 0)
  (connect vr 0 out 1))
