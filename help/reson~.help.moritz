; reson~.help.moritz - help for reson~
(patch
  (obj title comment "reson~ [gain cf Q]: two-pole resonant band-pass filter" (pos 20 12))
  (obj sub comment "Inlets: signal, gain (the gain at the centre frequency), centre frequency cf in Hz, and Q: the bandwidth is cf / Q." (pos 20 34))
  (obj sub2 comment "Defaults 1, 1000, 10. A list gain cf Q in the left inlet sets all three. Signals in the right inlets are read once per block." (pos 20 52))
  (obj src noise~ (pos 20 80))
  (obj p1 message "8 440 20" (pos 100 80))
  (obj p2 message "2 2000 4" (pos 180 80))
  (obj p3 message "25 300 80" (pos 260 80))
  (obj cp comment "lists: gain cf Q" (pos 345 84))
  (obj gain flonum 4 (pos 200 120))
  (obj cf flonum 1000 (pos 280 120))
  (obj q flonum 10 (pos 360 120))
  (obj cflo comment "gain, cf (Hz), Q" (pos 425 121))
  (obj f reson~ 4 1000 10 (pos 20 165))
  (obj sc scope~ (pos 480 210))
  (obj on message "0.15 50" (pos 200 240))
  (obj off message "0 50" (pos 270 240))
  (obj cv comment "volume on / off" (pos 330 241))
  (obj ramp line~ (pos 200 275))
  (obj vca *~ (pos 20 310))
  (obj out dac~ (pos 20 350))
  (obj tip comment "Noise through a narrower band (higher Q) is quieter: raise the gain to make up for it. clear resets the filter's memory." (pos 20 390))
  (connect src 0 f 0)
  (connect p1 0 f 0)
  (connect p2 0 f 0)
  (connect p3 0 f 0)
  (connect gain 0 f 1)
  (connect cf 0 f 2)
  (connect q 0 f 3)
  (connect f 0 sc 0)
  (connect f 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
