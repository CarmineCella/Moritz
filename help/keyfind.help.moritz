; keyfind.help.moritz - help for keyfind
(patch
  (obj title comment "keyfind [size] [hop]: the key of a buffer~" (pos 20 12))
  (obj sub comment "run sound: the chromagram averaged over the sound (how much of each pitch class there is), correlated with Krumhansl and Kessler's profile" (pos 20 34))
  (obj sub2 comment "of each major and minor key (how well each pitch class fits it, from listening experiments). The best correlation names the key." (pos 20 52))
  (obj bee buffer~ hkfbee ../examples/sounds/Beethoven_Symph7.wav (pos 20 85))
  (obj gam buffer~ hkfgam ../examples/sounds/Gambale_cut.wav (pos 380 85))
  (obj lb loadbang (pos 20 120))
  (obj r1 message "run hkfbee" (pos 20 150))
  (obj r2 message "run hkfgam" (pos 110 150))
  (obj c1 comment "Beethoven, 7th symphony, Allegretto; a guitar phrase" (pos 200 151))
  (obj kf keyfind 4096 1024 (pos 20 185))
  (obj show message "set $1 $2" (pos 20 225))
  (obj key message "" (pos 20 255))
  (obj r flonum (pos 160 255))
  (obj cr comment "correlation" (pos 245 256))
  (obj l1 loadbang (pos 20 300))
  (obj lab1 message "labels chroma, title pitch classes" (pos 20 330))
  (obj pcd plot 360 120 bars (pos 20 365))
  (obj l2 loadbang (pos 400 300))
  (obj lab2 message "labels keys, title all 24 keys" (pos 400 330))
  (obj ks plot 480 120 bars (pos 400 365))
  (obj c2 comment "the key is the highest bar on the right; its relative (major or minor) and its neighbours on the circle of fifths come close" (pos 20 500))
  (connect lb 0 r1 0)
  (connect r1 0 kf 0)
  (connect r2 0 kf 0)
  (connect kf 2 show 0)
  (connect show 0 key 0)
  (connect kf 3 r 0)
  (connect kf 4 pcd 0)
  (connect kf 5 ks 0)
  (connect l1 0 lab1 0)
  (connect lab1 0 pcd 0)
  (connect l2 0 lab2 0)
  (connect lab2 0 ks 0))
