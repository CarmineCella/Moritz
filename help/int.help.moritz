; int.help.moritz - help for int and float (i, f)
(patch
  (obj title comment "int [value], float [value] (or i, f): store a number, and output it again on bang" (pos 20 12))
  (obj sub comment "Left inlet: a number is stored and output; bang outputs the stored number; set x stores x without output." (pos 20 34))
  (obj sub2 comment "Right inlet (cold): stores a number without output. int drops the fraction: 3.7 becomes 3, and -3.7 becomes -3." (pos 20 52))
  (obj in flonum 3.7 (pos 20 85))
  (obj cin comment "try 3.7 and -3.7" (pos 85 86))
  (obj ii int (pos 20 125))
  (obj iout flonum (pos 20 165))
  (obj ciout comment "no fraction" (pos 85 166))
  (obj recall button (pos 300 85))
  (obj crecall comment "recall" (pos 328 88))
  (obj store flonum 0.25 (pos 400 85))
  (obj cstore comment "store" (pos 465 86))
  (obj ff f 0.25 (pos 300 125))
  (obj fout flonum (pos 300 165))
  (obj cfout comment "the stored float, on bang" (pos 365 166))
  (obj c2 comment "Use: remember a value now, send it later (here, the slider position when you click the button)." (pos 20 220))
  (obj sl slider 0 127 (pos 20 245))
  (obj snap button (pos 200 245))
  (obj csnap comment "send it" (pos 228 248))
  (obj mem i (pos 200 285))
  (obj mout number (pos 200 325))
  (connect in 0 ii 0)
  (connect ii 0 iout 0)
  (connect recall 0 ff 0)
  (connect store 0 ff 1)
  (connect ff 0 fout 0)
  (connect sl 0 mem 1)
  (connect snap 0 mem 0)
  (connect mem 0 mout 0))
