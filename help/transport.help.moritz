; transport.help.moritz - help for transport
(patch
  (obj title comment "transport [bpm] [num den]: the patch's clock, one for the patch and its subpatches" (pos 20 12))
  (obj sub comment "Every transport object in the patch shows and drives the same clock; every score object in it plays on it. Another patch open has its own." (pos 20 34))
  (obj sub2 comment "Bars and beats are counted at the tempo (beats a minute; a beat is 1/den) and the meter; scores are in seconds." (pos 20 52))
  (obj play message play (pos 20 85))
  (obj stop message stop (pos 70 85))
  (obj loc message "locate 3" (pos 120 85))
  (obj loc2 message "locate 2 3" (pos 190 85))
  (obj seek message "seek 500" (pos 275 85))
  (obj loop message "loop 1 2" (pos 350 85))
  (obj noloop message "loop 0" (pos 420 85))
  (obj tempo message "tempo 90" (pos 490 85))
  (obj meter message "meter 3 4" (pos 565 85))
  (obj bang message bang (pos 645 85))
  (obj tr transport 120 4 4 (pos 20 130))
  (obj bar number (pos 20 170))
  (obj beat number (pos 90 170))
  (obj ms flonum (pos 160 170))
  (obj state number (pos 260 170))
  (obj c1 comment "bar, beat (at every beat while it plays), ms, playing" (pos 330 171))
  (obj sel select 1 (pos 90 210))
  (obj clk click~ (pos 90 245))
  (obj out dac~ (pos 90 280))
  (obj c2 comment "a click on the first beat of every bar" (pos 160 246))
  (obj tip comment "loop bar1 bar2 plays from bar1 up to bar2 again and again once the transport is before bar2." (pos 20 320))
  (connect play 0 tr 0)
  (connect stop 0 tr 0)
  (connect loc 0 tr 0)
  (connect loc2 0 tr 0)
  (connect seek 0 tr 0)
  (connect loop 0 tr 0)
  (connect noloop 0 tr 0)
  (connect tempo 0 tr 0)
  (connect meter 0 tr 0)
  (connect bang 0 tr 0)
  (connect tr 0 bar 0)
  (connect tr 1 beat 0)
  (connect tr 2 ms 0)
  (connect tr 3 state 0)
  (connect tr 1 sel 0)
  (connect sel 0 clk 0)
  (connect clk 0 out 0)
  (connect clk 0 out 1))
