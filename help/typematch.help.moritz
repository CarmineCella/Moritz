; typematch.help.moritz - help for typematch
(patch
  (obj title comment "typematch: a sound rebuilt with the types of another (SoundTypes' rematch)" (pos 20 12))
  (obj sub comment "run A B out [level]: every frame, unit or gesture of A replaced by the closest of B, in the closest type. Level 0: frames as grains; 1: units;" (pos 20 34))
  (obj sub2 comment "level 2: whole gestures. fit 1 keeps A's times (B cut or continued to each unit's length); fit 0 plays B's units at their own lengths." (pos 20 52))
  (obj a buffer~ htmvox ../examples/sounds/cage.wav (pos 20 85))
  (obj b buffer~ htmdrums ../examples/sounds/beachboys.wav (pos 290 85))
  (obj o buffer~ htmout (pos 570 85))
  (obj lb loadbang (pos 20 115))
  (obj aa message "types 32 16, smooth 3, analyse htmvox" (pos 20 145))
  (obj ab message "types 32 16, smooth 3, analyse htmdrums" (pos 290 175))
  (obj sa soundtypes htmA (pos 20 175))
  (obj sb soundtypes htmB (pos 290 205))
  (obj r1 message "run htmA htmB htmout 1" (pos 20 255))
  (obj r0 message "run htmA htmB htmout 0" (pos 20 230))
  (obj r2 message "run htmA htmB htmout 2" (pos 200 255))
  (obj f1 message "fit 1" (pos 380 255))
  (obj f0 message "fit 0" (pos 430 255))
  (obj c0 message "contour 0" (pos 490 255))
  (obj c7 message "contour 0.7" (pos 570 255))
  (obj cr comment "John Cage's speech made of the Beach Boys: unit by unit (1), gesture by gesture (2); contour: his loudness imposed" (pos 20 280))
  (obj tm typematch (pos 20 310))
  (obj prog flonum (pos 20 345))
  (obj done button (pos 90 345))
  (obj pa message start (pos 20 385))
  (obj pb message start (pos 100 385))
  (obj cp comment "Cage, the match" (pos 160 386))
  (obj play1 play~ htmvox (pos 20 415))
  (obj play2 play~ htmout (pos 100 415))
  (obj mix +~ (pos 20 450))
  (obj vca *~ 0.5 (pos 20 480))
  (obj out dac~ (pos 20 515))
  (obj w plot htmout 400 80 (pos 330 345))
  (obj c3 comment "A and B must be analysed the same way (both sounds, or both books). xfade ms (10); contour c (0): A's loudness by c; space own/joint: each sound standardised on its own (default) or together." (pos 20 560))
  (connect lb 0 aa 0)
  (connect sa 1 ab 0)
  (connect aa 0 sa 0)
  (connect ab 0 sb 0)
  (connect sb 1 r1 0)
  (connect r1 0 tm 0)
  (connect r0 0 tm 0)
  (connect r2 0 tm 0)
  (connect f1 0 tm 0)
  (connect f0 0 tm 0)
  (connect c0 0 tm 0)
  (connect c7 0 tm 0)
  (connect tm 0 prog 0)
  (connect tm 1 done 0)
  (connect pa 0 play1 0)
  (connect pb 0 play2 0)
  (connect play1 0 mix 0)
  (connect play2 0 mix 0)
  (connect mix 0 vca 0)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
