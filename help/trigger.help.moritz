; trigger.help.moritz - help for trigger (t)
(patch
  (obj title comment "trigger (or t) b f i l a s ...: sends its input out of every outlet, from right to left" (pos 20 12))
  (obj sub comment "One outlet per argument: b a bang, f the first number, i that number without its fraction, l or a the whole message," (pos 20 34))
  (obj sub2 comment "s the first word. Any other argument (a number or a word) is sent as it is. With no arguments it is t b b." (pos 20 52))
  (obj in flonum 3.7 (pos 20 85))
  (obj cin comment "try 3.7 or -3.7" (pos 85 86))
  (obj tr trigger b i f (pos 20 130))
  (obj ob button (pos 20 175))
  (obj oi number (pos 100 175))
  (obj of flonum (pos 180 175))
  (obj c3 comment "3rd" (pos 20 205))
  (obj c2 comment "2nd" (pos 100 205))
  (obj c1 comment "1st" (pos 180 205))
  (obj x flonum 5 (pos 380 85))
  (obj cx comment "x" (pos 445 86))
  (obj tff t f f (pos 380 130))
  (obj add + (pos 380 175))
  (obj sum flonum (pos 380 215))
  (obj csum comment "x + x" (pos 445 216))
  (obj cuse comment "t f f: the right outlet fills the cold inlet of + first, then the left one makes + output." (pos 20 255))
  (obj c4 comment "Words and constants:" (pos 20 290))
  (obj word message "hello 1 2" (pos 20 315))
  (obj tw t s 440 (pos 20 355))
  (obj show message "-" (pos 20 435))
  (obj ss message "set $1" (pos 20 395))
  (obj cs comment "the first word (set $1 writes it into this box)" (pos 85 436))
  (obj hz number (pos 150 395))
  (obj chz comment "the constant 440" (pos 215 396))
  (connect in 0 tr 0)
  (connect tr 0 ob 0)
  (connect tr 1 oi 0)
  (connect tr 2 of 0)
  (connect x 0 tff 0)
  (connect tff 0 add 0)
  (connect tff 1 add 1)
  (connect add 0 sum 0)
  (connect word 0 tw 0)
  (connect tw 0 ss 0)
  (connect ss 0 show 0)
  (connect tw 1 hz 0))
