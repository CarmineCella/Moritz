; delay.help.moritz - help for delay (del)
(patch
  (obj title comment "delay [ms] (or del): sends a bang ms milliseconds after it gets one" (pos 20 12))
  (obj sub comment "Left inlet: bang starts it, and a bang while it waits starts the wait again; stop cancels it." (pos 20 34))
  (obj sub2 comment "A number in the left inlet sets the time and starts. Right inlet: the time in ms, stored for the next bang." (pos 20 52))
  (obj go button (pos 20 85))
  (obj cgo comment "start" (pos 48 88))
  (obj stop message stop (pos 100 85))
  (obj now2 message 2000 (pos 160 85))
  (obj cnow2 comment "set 2000 ms and start" (pos 205 86))
  (obj t250 message 250 (pos 360 85))
  (obj t1000 message 1000 (pos 410 85))
  (obj dtime number 1000 (pos 360 120))
  (obj cdtime comment "time for the next bang (ms)" (pos 425 121))
  (obj dl delay 1000 (pos 20 165))
  (obj done button (pos 20 210))
  (obj cdone comment "flashes when the time is up" (pos 50 213))
  (obj c2 comment "Use: a toggle that switches itself off. t b b first turns it on, then starts del." (pos 20 265))
  (obj go2 button (pos 20 295))
  (obj tr t b b (pos 20 335))
  (obj on1 message 1 (pos 110 375))
  (obj d2 del 1500 (pos 20 375))
  (obj off0 message 0 (pos 20 415))
  (obj lamp toggle (pos 110 450))
  (obj clamp comment "on for 1.5 seconds" (pos 140 452))
  (connect go 0 dl 0)
  (connect stop 0 dl 0)
  (connect now2 0 dl 0)
  (connect t250 0 dtime 0)
  (connect t1000 0 dtime 0)
  (connect dtime 0 dl 1)
  (connect dl 0 done 0)
  (connect go2 0 tr 0)
  (connect tr 1 on1 0)
  (connect tr 0 d2 0)
  (connect d2 0 off0 0)
  (connect on1 0 lamp 0)
  (connect off0 0 lamp 0))
