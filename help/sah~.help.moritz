; sah~.help.moritz - help for sah~
(patch
  (obj title comment "sah~ [threshold]: sample and hold" (pos 20 12))
  (obj sub comment "Left inlet: the signal to sample. Right inlet: a trigger signal. Each time the trigger rises above the threshold (default 0)," (pos 20 34))
  (obj sub2 comment "the output takes the current value of the left signal and holds it. A float in the right inlet sets the threshold." (pos 20 52))
  (obj r1 message 2 (pos 150 85))
  (obj r2 message 8 (pos 190 85))
  (obj r3 message 16 (pos 230 85))
  (obj src noise~ (pos 20 120))
  (obj rate flonum 8 (pos 150 120))
  (obj crate comment "trigger rate (Hz)" (pos 212 121))
  (obj trig phasor~ 8 (pos 150 160))
  (obj sh sah~ 0.5 (pos 20 205))
  (obj csh comment "the phasor~ ramp rises past 0.5 once per cycle: a new random value each time" (pos 110 209))
  (obj depth *~ 400 (pos 20 245))
  (obj snap snapshot~ 50 (pos 150 245))
  (obj base +~ 600 (pos 20 280))
  (obj val flonum 0 (pos 150 280))
  (obj cval comment "the held value" (pos 240 281))
  (obj osc cycle~ (pos 20 315))
  (obj cosc comment "-1..1 becomes 200 to 1000 Hz" (pos 90 319))
  (obj on message "0.15 50" (pos 300 315))
  (obj off message "0 50" (pos 370 315))
  (obj cv comment "volume on / off" (pos 430 316))
  (obj ramp line~ (pos 300 350))
  (obj vca *~ (pos 20 385))
  (obj out dac~ (pos 20 425))
  (connect r1 0 rate 0)
  (connect r2 0 rate 0)
  (connect r3 0 rate 0)
  (connect rate 0 trig 0)
  (connect src 0 sh 0)
  (connect trig 0 sh 1)
  (connect sh 0 depth 0)
  (connect sh 0 snap 0)
  (connect snap 0 val 0)
  (connect depth 0 base 0)
  (connect base 0 osc 0)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
