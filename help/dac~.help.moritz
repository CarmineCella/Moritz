; dac~.help.moritz - help for dac~ and adc~
(patch
  (obj title comment "dac~ [channels]: audio output.   adc~ [channels]: audio input" (pos 20 12))
  (obj sub comment "dac~ has an inlet per output channel, adc~ an outlet per input channel (1 and 2 by default). start / stop turn audio on / off." (pos 20 34))
  (obj sub2 comment "A message box with ; dsp start or ; dsp stop does the same. Audio input opens only while a patch contains adc~." (pos 20 52))
  (obj ds1 message "; dsp start" (pos 20 80))
  (obj ds2 message "; dsp stop" (pos 110 80))
  (obj cds comment "audio on / off, like the Audio button" (pos 200 82))
  (obj st message start (pos 400 105))
  (obj sp message stop (pos 450 105))
  (obj cst comment "the same, sent to adc~" (pos 500 106))
  (obj osc cycle~ 440 (pos 20 150))
  (obj cosc comment "test tone" (pos 100 151))
  (obj mic adc~ 1 (pos 400 150))
  (obj cmic comment "microphone (input 1)" (pos 455 151))
  (obj met meter~ (pos 440 190))
  (obj cmet comment "input level" (pos 465 195))
  (obj mon message "0.2 50" (pos 560 190))
  (obj moff message "0 50" (pos 620 190))
  (obj cmon comment "monitor on / off:" (pos 560 255))
  (obj cmon2 comment "headphones only," (pos 560 271))
  (obj cmon3 comment "or it will feed back!" (pos 560 287))
  (obj mramp line~ (pos 560 225))
  (obj mvca *~ (pos 400 310))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 220 385))
  (obj cout comment "both go to output channels 1 and 2" (pos 280 386))
  (obj e1 comment "dac~ 2 would play on the right channel only; dac~ 1 2 3 4 has four inlets. The output is clipped to -1..1." (pos 20 430))
  (obj e2 comment "macOS asks for microphone access the first time. Patch > Audio Setup... picks the devices." (pos 20 448))
  (connect st 0 mic 0)
  (connect sp 0 mic 0)
  (connect mic 0 met 0)
  (connect mic 0 mvca 0)
  (connect mon 0 mramp 0)
  (connect moff 0 mramp 0)
  (connect mramp 0 mvca 1)
  (connect mvca 0 out 0)
  (connect mvca 0 out 1)
  (connect osc 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
