; number.help.moritz - help for number and flonum
(patch
  (obj title comment "number, flonum [value]: number boxes. number keeps whole numbers, flonum keeps decimals" (pos 20 12))
  (obj sub comment "Locked: drag up or down, or click, type a value and press Enter. On a flonum, left of the point steps by 1, right of it by 0.01." (pos 20 34))
  (obj sub2 comment "A number in the inlet is shown and sent; bang sends the value again; set x shows x without sending it." (pos 20 52))
  (obj a1 message 3.7 (pos 20 85))
  (obj a2 message -2.9 (pos 62 85))
  (obj a3 message bang (pos 114 85))
  (obj a4 message "set 10" (pos 166 85))
  (obj num number (pos 20 125))
  (obj numout number (pos 20 165))
  (obj cnumout comment "what it sends" (pos 85 166))
  (obj cnum comment "number: 3.7 becomes 3, -2.9 becomes -2" (pos 20 205))
  (obj b1 message 3.7 (pos 380 85))
  (obj b2 message -2.9 (pos 422 85))
  (obj b3 message bang (pos 474 85))
  (obj b4 message "set 10" (pos 526 85))
  (obj flo flonum (pos 380 125))
  (obj floout flonum (pos 380 165))
  (obj cfloout comment "what it sends" (pos 445 166))
  (obj cflo comment "flonum: keeps the decimals" (pos 380 205))
  (obj cset comment "After set 10 the box shows 10, but the box below it does not change: nothing was sent." (pos 20 250))
  (obj carg comment "The argument is the starting value: number 60 starts at 60. It is not sent when the patch opens." (pos 20 270))
  (connect a1 0 num 0)
  (connect a2 0 num 0)
  (connect a3 0 num 0)
  (connect a4 0 num 0)
  (connect num 0 numout 0)
  (connect b1 0 flo 0)
  (connect b2 0 flo 0)
  (connect b3 0 flo 0)
  (connect b4 0 flo 0)
  (connect flo 0 floout 0))
