; zscore.help.moritz - help for zscore
(patch
  (obj title comment "zscore: standardises lists: (x - mean) / standard deviation, value by value" (pos 20 12))
  (obj sub comment "add x y ... adds a point; train measures each value's mean and spread; a list then comes out standardised, so values in" (pos 20 34))
  (obj sub2 comment "different units (Hz, levels, 0..1) become comparable: 0 is the mean, 1 one standard deviation above it. clear, write/read." (pos 20 52))
  (obj pts message "add 400 0.1 0.2, add 800 0.3 0.4, add 1200 0.2 0.9, add 2000 0.4 0.5" (pos 20 85))
  (obj cpts comment "centroid (Hz), rms, flatness" (pos 20 110))
  (obj tr message train (pos 20 135))
  (obj q1 message "1100 0.25 0.5" (pos 80 135))
  (obj q2 message "3000 0.1 0.9" (pos 190 135))
  (obj z zscore (pos 20 175))
  (obj split unpack 0. 0. 0. (pos 20 210))
  (obj a flonum (pos 20 245))
  (obj b flonum (pos 100 245))
  (obj c flonum (pos 180 245))
  (obj cc comment "standardised" (pos 260 246))
  (obj lb loadbang (pos 420 85))
  (obj t t b b (pos 420 115))
  (connect lb 0 t 0)
  (connect t 1 pts 0)
  (connect t 0 tr 0)
  (connect pts 0 z 0)
  (connect tr 0 z 0)
  (connect q1 0 z 0)
  (connect q2 0 z 0)
  (connect z 0 split 0)
  (connect split 0 a 0)
  (connect split 1 b 0)
  (connect split 2 c 0))
