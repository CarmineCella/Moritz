; pca.help.moritz - help for pca
(patch
  (obj title comment "pca: principal component analysis: the directions along which the points vary most" (pos 20 12))
  (obj sub comment "add x y z ... adds a point; train [dims] finds the components (2 by default) and outputs the share of variance each explains;" (pos 20 34))
  (obj sub2 comment "a list then gives its coordinates along them: many descriptors seen on two axes. explained, normalize 0/1, clear, write/read." (pos 20 52))
  (obj pts message "add 1 2.1 0.5, add 2 3.9 0.4, add 3 6.2 0.6, add 4 8.1 0.5, add 5 9.8 0.4, add 6 12.2 0.6" (pos 20 85))
  (obj cpts comment "three values; the first two move together, so component 1 carries both and component 2 the third" (pos 20 110))
  (obj tr message "train 2" (pos 20 140))
  (obj pc pca (pos 20 175))
  (obj ex message "set $1 $2" (pos 260 210))
  (obj exd message (pos 260 245))
  (obj cex comment "<- share of the variance of each component" (pos 420 246))
  (obj q message "3.5 7 0.5" (pos 100 140))
  (obj q2 message "7 14 0.5" (pos 180 140))
  (obj cq comment "points to project" (pos 260 141))
  (obj split unpack 0. 0. (pos 20 210))
  (obj p1 flonum (pos 20 245))
  (obj p2 flonum (pos 100 245))
  (obj cp comment "coordinates on components 1 and 2" (pos 20 275))
  (obj lb loadbang (pos 560 85))
  (obj t t b b (pos 560 115))
  (connect lb 0 t 0)
  (connect t 1 pts 0)
  (connect t 0 tr 0)
  (connect pts 0 pc 0)
  (connect tr 0 pc 0)
  (connect q 0 pc 0)
  (connect q2 0 pc 0)
  (connect pc 0 split 0)
  (connect split 0 p1 0)
  (connect split 1 p2 0)
  (connect pc 1 ex 0)
  (connect ex 0 exd 0))
