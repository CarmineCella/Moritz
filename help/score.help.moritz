; score.help.moritz - help for score
(patch
  (obj title comment "score name [file.score] [channels]: a score that plays itself on the patch's transport" (pos 20 12))
  (obj sub comment "Notes and messages leave it as lists at their time; its sounds come out as audio, each on its sample." (pos 20 34))
  (obj sub2 comment "This one is kept in the patch (its .score text is saved inside it); read file.score loads one, write saves it." (pos 20 52))
  (obj play message play (pos 20 85))
  (obj stop message stop (pos 70 85))
  (obj loc message "locate 1" (pos 120 85))
  (obj loop message "loop 1 3" (pos 190 85))
  (obj noloop message "loop 0" (pos 260 85))
  (obj add message "add note 2.5 0.5 Cl 74 f ord" (pos 330 85))
  (obj clr message clear (pos 540 85))
  (obj info message info (pos 600 85))
  (obj cadd comment "add a note (at dur row pitch dynamics technique: seconds, a MIDI number or a name such as G5)" (pos 330 110))
  (obj s score help (pos 20 140)
    (script
      "; a score (Musil data: read with score-read, or opened by Moritz's score object)"
      "(score \"help\""
      "  (sr 44100) (bpm 120) (meter 4 4) (next-id 9)"
      "  (row Cl treble)"
      "  (note 0 0.45 Cl 67 mf ord (id 1))"
      "  (note 0.5 0.45 Cl 70 mf ord (id 2))"
      "  (note 1 0.45 Cl 74 f ord (id 3))"
      "  (note 1.5 0.9 Cl 72.5 p ord (id 4))"
      "  (msg 0 tonic 67 (id 5))"
      "  (msg 1.5 tonic 72 (id 6))"
      "  (sound 1 0.6 \"drums.wav\" (id 7) (gain 0.5) (az 40))"
      "  (sound 2 0.4 \"drums.wav\" (id 8) (gain 0.4) (az -40) (from 0.5)))"))
  (obj tl t l l (pos 220 200))
  (obj up unpack 0 0 0 (pos 300 230))
  (obj mt mtof (pos 300 260))
  (obj osc cycle~ (pos 300 290))
  (obj env message "0.15 5, 0 $3" (pos 220 260))
  (obj ln line~ (pos 220 290))
  (obj vca *~ (pos 300 325))
  (obj cn comment "notes: pitch velocity duration-ms row dynamics technique: here a sine" (pos 380 290))
  (obj pm print message (pos 420 200))
  (obj cm comment "messages: name values" (pos 520 201))
  (obj pi print info (pos 560 170))
  (obj ci comment "end, info" (pos 640 171))
  (obj out dac~ (pos 20 360))
  (obj cs comment "its sounds, placed at their azimuth (two channels here)" (pos 90 361))
  (obj tip comment "A code box sends a score made in Musil with (out 1 s); its sounds read files or buffer~s by name." (pos 20 400))
  (connect play 0 s 0)
  (connect stop 0 s 0)
  (connect loc 0 s 0)
  (connect loop 0 s 0)
  (connect noloop 0 s 0)
  (connect add 0 s 0)
  (connect clr 0 s 0)
  (connect info 0 s 0)
  (connect s 0 out 0)
  (connect s 1 out 1)
  (connect s 2 tl 0)
  (connect tl 1 up 0)
  (connect up 0 mt 0)
  (connect mt 0 osc 0)
  (connect tl 0 env 0)
  (connect env 0 ln 0)
  (connect osc 0 vca 0)
  (connect ln 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect s 3 pm 0)
  (connect s 4 pi 0))
