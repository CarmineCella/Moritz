; score.help.moritz - help for score
(patch
  (obj title comment "score name [file.score] [channels] [@size w h] [@view v]: a score that plays itself on the patch's transport" (pos 20 12))
  (obj sub comment "Notes and messages leave it as lists at their time; its sounds come out as audio, each on its sample." (pos 20 34))
  (obj sub2 comment "This one is kept in the patch (its .score text is saved inside it); read file.score loads one, write saves it." (pos 20 52))
  (obj play message play (pos 20 85))
  (obj stop message stop (pos 70 85))
  (obj loc message "locate 1" (pos 120 85))
  (obj loop message "loop 1 3" (pos 190 85))
  (obj noloop message "loop 0" (pos 260 85))
  (obj add message "add note 2.5 0.5 Cl 74 f ord" (pos 330 85))
  (obj clr message clear (pos 540 85))
  (obj info message info (pos 600 85))
  (obj open message open (pos 650 85))
  (obj opentl message "open timeline" (pos 700 85))
  (obj cadd comment "add a note (at dur row pitch dynamics technique: seconds, a MIDI number or a name such as G5)" (pos 330 110))
  (obj sel message "select row Cl" (pos 20 135))
  (obj seln message "select none" (pos 120 135))
  (obj tup message "transpose 2" (pos 210 135))
  (obj tdn message "transpose -2" (pos 295 135))
  (obj inv message invert (pos 385 135))
  (obj ret message retrograde (pos 440 135))
  (obj aug message "augment 2" (pos 520 135))
  (obj dim message "diminish 2" (pos 595 135))
  (obj qua message "quantize 0.25" (pos 675 135))
  (obj ctr comment "transformations of the selection (all of it when none), as Musil's score-transpose! ...: also shift, humanize, thin, density" (pos 20 160))
  (obj s score help @size 560 200 (pos 20 185)
    (script
      "; a score (Musil data: read with score-read, or opened by Moritz's score object)"
      "(score \"help\""
      "  (sr 44100) (bpm 120) (meter 4 4) (next-id 9)"
      "  (row Cl treble)"
      "  (note 0 0.45 Cl 67 mf ord (id 1))"
      "  (note 0.5 0.45 Cl 70 mf ord (id 2) (cents 19))"
      "  (note 1 0.45 Cl 74 f ord (id 3))"
      "  (note 1.5 0.9 Cl 72.5 p ord (id 4))"
      "  (msg 0 tonic 67 (id 5))"
      "  (msg 1.5 tonic 72 (id 6))"
      "  (sound 1 0.6 \"drums.wav\" (id 7) (gain 0.5) (az 40))"
      "  (sound 2 0.4 \"drums.wav\" (id 8) (gain 0.4) (az -40) (from 0.5)))"))
  (obj croll comment "The box is a roll: click a note, drag it" (pos 600 190))
  (obj croll2 comment "(later, higher), drag its end; Alt-drag copies;" (pos 600 208))
  (obj croll3 comment "a rectangle selects; Delete, the arrows" (pos 600 226))
  (obj croll4 comment "(Edit > Undo takes an edit back)." (pos 600 244))
  (obj croll5 comment "Alt+Up, Alt+Down: a cent (Shift: ten);" (pos 600 262))
  (obj croll6 comment "the cents always shown (+19 by the head)." (pos 600 280))
  (obj croll7 comment "Double-click it: its window (Timeline, Roll," (pos 600 304))
  (obj croll9 comment "Piano roll, List: one score, views in place)." (pos 600 340))
  (obj croll8 comment "In edit mode, its corner sizes it." (pos 600 358))
  (obj croll10 comment "A score orchidea made: a mark (\"2/5\") at each" (pos 600 376))
  (obj croll11 comment "segment; a click on it, its solutions by cost." (pos 600 390))
  (obj tl t l l (pos 220 405))
  (obj up unpack 0 0 0 (pos 300 435))
  (obj mt mtof (pos 300 465))
  (obj osc cycle~ (pos 300 495))
  (obj env message "0.15 5, 0 $3" (pos 220 465))
  (obj ln line~ (pos 220 495))
  (obj vca *~ (pos 300 530))
  (obj cn comment "notes: pitch velocity duration-ms row dynamics technique: here a sine" (pos 380 495))
  (obj pm print message (pos 420 405))
  (obj cm comment "messages: name values" (pos 520 406))
  (obj pi print info (pos 560 435))
  (obj ci comment "end, info" (pos 640 436))
  (obj out dac~ (pos 20 565))
  (obj cs comment "its sounds, placed at their azimuth (two channels here)" (pos 90 566))
  (obj tip comment "A code box sends a score made in Musil with (out 1 s); its sounds read files or buffer~s by name. orchidea sends its solution as a score." (pos 20 605))
  (obj tipm comment "score token puts that score in place of this one; merge token adds its events and rows to this one (an orchestration's sections, one after another: a message box merge $2 between an orchidea and the score)." (pos 20 717))
  (obj tipc comment "A note Musil takes from a database (note, chord, an orchestration) keeps its sample: the box plays it. Compositions so: examples/17-composition; whole pieces: examples/18-pieces." (pos 20 737))
  (obj tl2 comment "Its window's Timeline shows it as tracks (gain, pan, mute, solo; each sized by its lower edge), its events clips," (pos 20 625))
  (obj tl3 comment "its messages lanes that reach the receives of their name (a click on a lane's name selects them). @view timeline: it opens there." (pos 20 643))
  (obj tl4 comment "The box and its window's views are one score: an edit in one is in the others, with one undo and one selection; Space plays." (pos 20 661))
  (obj aud comment "A click on a note sounds it (here out of the notes outlet, into the sine; a note with a sample of its own plays it); the roll's Audition button turns that off." (pos 20 679))
  (obj tr1 comment "play plays this patch's transport (another patch open has its own); at the score's end, from the start; it stops at the end." (pos 20 697))
  (obj xml message "export musicxml ~/Documents/Moritz/score-help.musicxml" (pos 20 762))
  (obj mid message "export midi ~/Documents/Moritz/score-help.mid bend" (pos 400 762))
  (obj cx comment "export: the score as MusicXML (Musil's notation: quantized, voices, quarter tones; its report in the Console) or as a MIDI file (a track per part; bend: the microtones with pitch bend, else rounded). The window's File menu and the box's menu have Export too." (pos 20 790))
  (connect play 0 s 0)
  (connect xml 0 s 0)
  (connect mid 0 s 0)
  (connect stop 0 s 0)
  (connect loc 0 s 0)
  (connect loop 0 s 0)
  (connect noloop 0 s 0)
  (connect add 0 s 0)
  (connect clr 0 s 0)
  (connect info 0 s 0)
  (connect open 0 s 0)
  (connect opentl 0 s 0)
  (connect sel 0 s 0)
  (connect seln 0 s 0)
  (connect tup 0 s 0)
  (connect tdn 0 s 0)
  (connect inv 0 s 0)
  (connect ret 0 s 0)
  (connect aug 0 s 0)
  (connect dim 0 s 0)
  (connect qua 0 s 0)
  (connect s 0 out 0)
  (connect s 1 out 1)
  (connect s 2 tl 0)
  (connect tl 1 up 0)
  (connect up 0 mt 0)
  (connect mt 0 osc 0)
  (connect tl 0 env 0)
  (connect env 0 ln 0)
  (connect osc 0 vca 0)
  (connect ln 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1)
  (connect s 3 pm 0)
  (connect s 4 pi 0))
