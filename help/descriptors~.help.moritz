; descriptors~.help.moritz - help for descriptors~
(patch
  (obj title comment "descriptors~ [size] [hop] [names...]: low-level descriptors, f0 (YIN), MFCCs, chroma and mel bands of a signal, every hop samples" (pos 20 12))
  (obj sub comment "Names choose the outlets: rms centroid spread skewness kurtosis flux hfc zcr flatness periodicity f0 (all, by default), and the lists mfcc chroma melbands." (pos 20 34))
  (obj sub2 comment "Frame 2048, hop 1024 by default; analysis runs while audio is on; bang analyses now. Hover an outlet for its meaning. Musil's descriptors and yin give the same numbers." (pos 20 52))
  (obj s1 message 1 (pos 20 85))
  (obj s2 message 2 (pos 60 85))
  (obj s3 message 3 (pos 100 85))
  (obj s4 message 4 (pos 140 85))
  (obj cs comment "1 sine 440, 2 saw 220, 3 noise, 4 a voice" (pos 180 86))
  (obj a cycle~ 440 (pos 20 120))
  (obj b saw~ 220 (pos 120 120))
  (obj c noise~ (pos 210 120))
  (obj vb buffer~ helpdesc ../data/Vox.wav (pos 290 120))
  (obj vg groove~ helpdesc (pos 290 150))
  (obj lb loadbang (pos 590 120))
  (obj lp message "loop 1" (pos 590 150))
  (obj one sig~ 1 (pos 480 150))
  (obj sel selector~ 4 1 (pos 20 190))
  (obj half *~ 0.5 (pos 20 225))
  (obj d descriptors~ (pos 20 265))
  (obj n0 flonum (pos 20 310))
  (obj n1 flonum (pos 100 310))
  (obj n2 flonum (pos 180 310))
  (obj n3 flonum (pos 260 310))
  (obj n4 flonum (pos 340 310))
  (obj n5 flonum (pos 420 310))
  (obj c1 comment "rms, centroid, spread, skewness, kurtosis, flux" (pos 20 340))
  (obj n6 flonum (pos 20 375))
  (obj n7 flonum (pos 100 375))
  (obj n8 flonum (pos 180 375))
  (obj n9 flonum (pos 260 375))
  (obj n10 flonum (pos 340 375))
  (obj c2 comment "hfc, zcr, flatness, periodicity, f0" (pos 20 405))
  (obj d2 descriptors~ 4096 2048 f0 centroid (pos 420 265))
  (obj c3 comment "only f0 and centroid, longer frames" (pos 420 240))
  (obj m0 flonum (pos 420 375))
  (obj m1 flonum (pos 500 375))
  (obj th message "threshold 0.15" (pos 650 240))
  (obj rg message "range 80 1000" (pos 650 265))
  (obj cth comment "YIN: a higher threshold calls more frames voiced; range: the f0 searched (50 to 4000 Hz)" (pos 650 290))
  (obj d3 descriptors~ 4096 1024 f0 chroma (pos 420 445))
  (obj c4 comment "f0 and the 12 pitch classes from the same FFT" (pos 420 420))
  (obj m2 flonum (pos 420 480))
  (obj lb2 loadbang (pos 760 420))
  (obj lab message "labels chroma" (pos 760 445))
  (obj pc plot 220 90 bars (pos 520 480))
  (obj on message "0.1 50" (pos 20 445))
  (obj off message "0 50" (pos 85 445))
  (obj cv comment "volume (the analysis runs either way)" (pos 140 446))
  (obj ramp line~ (pos 20 480))
  (obj vca *~ (pos 160 480))
  (obj out dac~ (pos 160 515))
  (connect s1 0 sel 0)
  (connect s2 0 sel 0)
  (connect s3 0 sel 0)
  (connect s4 0 sel 0)
  (connect a 0 sel 1)
  (connect b 0 sel 2)
  (connect c 0 sel 3)
  (connect lb 0 lp 0)
  (connect lp 0 vg 0)
  (connect one 0 vg 0)
  (connect vg 0 sel 4)
  (connect sel 0 half 0)
  (connect half 0 d 0)
  (connect half 0 d2 0)
  (connect d 0 n0 0)
  (connect d 1 n1 0)
  (connect d 2 n2 0)
  (connect d 3 n3 0)
  (connect d 4 n4 0)
  (connect d 5 n5 0)
  (connect d 6 n6 0)
  (connect d 7 n7 0)
  (connect d 8 n8 0)
  (connect d 9 n9 0)
  (connect d 10 n10 0)
  (connect d2 0 m0 0)
  (connect d2 1 m1 0)
  (connect th 0 d2 0)
  (connect rg 0 d2 0)
  (connect half 0 d3 0)
  (connect d3 0 m2 0)
  (connect d3 1 pc 0)
  (connect lb2 0 lab 0)
  (connect lab 0 pc 0)
  (connect half 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
