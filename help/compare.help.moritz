; compare.help.moritz - help for == != > < >= <=
(patch
  (obj title comment "==  !=  >  <  >=  <= [arg]: compare two numbers, output 1 (true) or 0 (false)" (pos 20 12))
  (obj sub comment "Left inlet (hot): a number to compare; it outputs the result, and bang outputs it again." (pos 20 34))
  (obj sub2 comment "Right inlet (cold): the number to compare with (the argument, 0 by default). A list \"a b\" sets both. As in Max, an integer argument" (pos 20 52))
  (obj sub3 comment "(or none) truncates the input: 0.5 > 0 is 0. Write > 0. to compare decimals." (pos 20 70))
  (obj a number 3 (pos 20 105))
  (obj ca comment "left: drag me" (pos 85 106))
  (obj b number 5 (pos 330 105))
  (obj cb comment "right: stored only" (pos 395 106))
  (obj eq == 5 (pos 20 170))
  (obj ne != 5 (pos 90 170))
  (obj gt > 5 (pos 160 170))
  (obj lt < 5 (pos 230 170))
  (obj ge >= 5 (pos 300 170))
  (obj le <= 5 (pos 370 170))
  (obj req number (pos 20 210))
  (obj rne number (pos 90 210))
  (obj rgt number (pos 160 210))
  (obj rlt number (pos 230 210))
  (obj rge number (pos 300 210))
  (obj rle number (pos 370 210))
  (obj cres comment "1 = true, 0 = false" (pos 440 211))
  (obj cold comment "After changing the right number, drag the left one again to see the new results." (pos 20 245))
  (obj c2 comment "Use: a threshold. The toggle is on while the slider is above 64." (pos 20 290))
  (obj sl slider 0 127 (pos 20 315))
  (obj thr > 64 (pos 20 350))
  (obj on toggle (pos 20 385))
  (connect a 0 eq 0)
  (connect a 0 ne 0)
  (connect a 0 gt 0)
  (connect a 0 lt 0)
  (connect a 0 ge 0)
  (connect a 0 le 0)
  (connect b 0 eq 1)
  (connect b 0 ne 1)
  (connect b 0 gt 1)
  (connect b 0 lt 1)
  (connect b 0 ge 1)
  (connect b 0 le 1)
  (connect eq 0 req 0)
  (connect ne 0 rne 0)
  (connect gt 0 rgt 0)
  (connect lt 0 rlt 0)
  (connect ge 0 rge 0)
  (connect le 0 rle 0)
  (connect sl 0 thr 0)
  (connect thr 0 on 0))
