; lrshift~.help.moritz - help for lrshift~
(patch
  (obj title comment "lrshift~ n: shift a signal vector by n samples. In a pfft~, every bin moves n bins up (negative: down)" (pos 20 12))
  (obj sub comment "The values shifted in from outside the vector are 0. n is set by the argument only. Outside a pfft~ it shifts each 64-sample vector." (pos 20 34))
  (obj sub2 comment "pfft~ passes its arguments after the overlap to the patch as #1, #2...: here lrshift~ #1 shifts the real and imaginary parts." (pos 20 52))
  (obj m1 message 1 (pos 20 125))
  (obj m2 message 2 (pos 55 125))
  (obj m3 message 3 (pos 90 125))
  (obj src saw~ 220 (pos 230 80))
  (obj csrc comment "harmonics of 220 Hz" (pos 300 81))
  (obj up pfft~ help-lrshift 1024 4 8 (pos 230 125))
  (obj down pfft~ help-lrshift 1024 4 -8 (pos 430 125))
  (obj sel selector~ 3 1 (pos 20 180))
  (obj csel comment "1 original, 2 up 8 bins (+344 Hz), 3 down 8 bins (-344 Hz)" (pos 130 192))
  (obj sp spectroscope~ 360 130 (pos 240 225))
  (obj on message "0.08 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj e1 comment "One bin is 44100 / 1024 = 43 Hz, so 8 bins add 344 Hz to every partial: the harmonics become inharmonic." (pos 20 415))
  (obj e2 comment "Shift by a multiple of the overlap (4 here), or the moved bins' phases no longer line up from frame to frame." (pos 20 433))
  (obj e3 comment "lrshift~ 1 and lrshift~ -1 give each bin its neighbours' values, e.g. to find the peaks of a spectrum." (pos 20 451))
  (connect m1 0 sel 0)
  (connect m2 0 sel 0)
  (connect m3 0 sel 0)
  (connect src 0 sel 1)
  (connect src 0 up 0)
  (connect src 0 down 0)
  (connect up 0 sel 2)
  (connect down 0 sel 3)
  (connect sel 0 sp 0)
  (connect sel 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
