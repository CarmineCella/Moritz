; dspstatus~.help.moritz - help for dspstatus~
(patch
  (obj title comment "dspstatus~ [ms]: report the state of the audio" (pos 20 12))
  (obj sub comment "Outlets: 1 / 0 for audio on / off, CPU load (%), sample rate, I/O buffer size, signal vector size (samples)." (pos 20 34))
  (obj sub2 comment "It reports on bang, when audio starts, stops or is reopened, and every ms while audio runs. A number sets ms (0 = never)." (pos 20 52))
  (obj ds1 message "; dsp start" (pos 20 80))
  (obj ds2 message "; dsp stop" (pos 110 80))
  (obj cds comment "audio on / off" (pos 200 82))
  (obj lb loadbang (pos 20 140))
  (obj bng button (pos 110 140))
  (obj cbng comment "report now" (pos 135 141))
  (obj i0 message 0 (pos 230 140))
  (obj i100 message 100 (pos 268 140))
  (obj i1000 message 1000 (pos 316 140))
  (obj ci comment "report every ms" (pos 378 141))
  (obj st dspstatus~ 500 (pos 20 185))
  (obj on number (pos 20 250))
  (obj cpu flonum (pos 105 250))
  (obj sr number (pos 190 250))
  (obj buf number (pos 290 250))
  (obj vs number (pos 375 250))
  (obj con comment "on / off" (pos 20 275))
  (obj ccpu comment "CPU %" (pos 105 275))
  (obj csr comment "sample rate" (pos 190 275))
  (obj cbuf comment "I/O buffer" (pos 290 275))
  (obj cvs comment "vector size" (pos 375 275))
  (obj e1 comment "While audio is off it reports 0 for on and CPU, and the last sample rate and buffer size (set in Patch > Audio Setup...)." (pos 20 310))
  (obj e2 comment "The CPU load is the time spent computing each audio buffer, as a share of the buffer's duration (smoothed)." (pos 20 328))
  (obj pb button (pos 20 370))
  (obj cpb comment "click: ask the dspstatus~ inside the pfft~" (pos 50 371))
  (obj pf pfft~ help-dspstatus 1024 4 (pos 20 405))
  (obj pvs number (pos 20 445))
  (obj cpf comment "Inside a pfft~ the signal vector is one frame: pfft~ 1024 gives 512 (bins)." (pos 110 446))
  (connect lb 0 st 0)
  (connect bng 0 st 0)
  (connect i0 0 st 0)
  (connect i100 0 st 0)
  (connect i1000 0 st 0)
  (connect st 0 on 0)
  (connect st 1 cpu 0)
  (connect st 2 sr 0)
  (connect st 3 buf 0)
  (connect st 4 vs 0)
  (connect pb 0 pf 0)
  (connect pf 0 pvs 0))
