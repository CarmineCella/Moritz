; framedelta~.help.moritz - help for framedelta~ and frameaccum~
(patch
  (obj title comment "framedelta~: difference from the previous frame.   frameaccum~ [wrap]: running sum, per bin" (pos 20 12))
  (obj sub comment "In a pfft~ each bin works with the same bin of the previous frame; outside a pfft~, with the previous sample." (pos 20 34))
  (obj sub2 comment "frameaccum~ inlets: value to add, value to restart from, reset (where not 0, that bin restarts). wrap 1 keeps the sum in -pi..pi." (pos 20 52))
  (obj lb loadbang (pos 20 80))
  (obj buf buffer~ helpfz ../examples/sounds/flute.wav (pos 100 80))
  (obj init message "loop 1, 0" (pos 20 115))
  (obj rate sig~ 1 (pos 110 115))
  (obj gr groove~ helpfz (pos 20 150))
  (obj cgr comment "flute.wav, looping" (pos 120 151))
  (obj fz1 message 1 (pos 400 115))
  (obj cfz1 comment "freeze" (pos 435 116))
  (obj fz0 message 0 (pos 400 145))
  (obj cfz0 comment "live" (pos 435 146))
  (obj pf pfft~ help-freeze 1024 4 (pos 20 205))
  (obj cpf comment "double-click to see inside" (pos 175 206))
  (obj sp spectroscope~ 360 130 (pos 240 255))
  (obj on message "0.15 50" (pos 20 265))
  (obj off message "0 50" (pos 90 265))
  (obj cv comment "volume on / off" (pos 150 266))
  (obj ramp line~ (pos 20 300))
  (obj vca *~ (pos 20 335))
  (obj out dac~ (pos 20 375))
  (obj e1 comment "Inside: cartopol~ -> phase -> framedelta~ -> phasewrap~ gives each bin's frequency (its phase change per frame)." (pos 20 415))
  (obj e2 comment "Two frameaccum~ with nothing to add hold the amplitude and the frequency while frozen (reset = 0)," (pos 20 433))
  (obj e3 comment "and frameaccum~ 1 adds the frequency to the phase every frame, so the frozen sound goes on." (pos 20 451))
  (connect lb 0 init 0)
  (connect init 0 gr 0)
  (connect rate 0 gr 0)
  (connect gr 0 pf 0)
  (connect fz1 0 pf 1)
  (connect fz0 0 pf 1)
  (connect pf 0 sp 0)
  (connect pf 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
