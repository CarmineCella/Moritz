; ambienc~.help.moritz - help for ambienc~, ambirot~ and ambidec~
(patch
  (obj title comment "ambienc~ [order] [az] [el]: encode.   ambirot~ [order]: rotate.   ambidec~ order az ...: decode to speakers" (pos 20 12))
  (obj sub comment "A sound field of order N has (N+1)^2 channels (AmbiX: ACN order, SN3D). Order 1: W (everywhere), Y (left-right), Z (up-down), X (front-back)." (pos 20 34))
  (obj sub2 comment "Azimuth in degrees, 0 in front, positive to the left; elevation positive up (numbers or signals). Fields add channel by channel." (pos 20 52))
  (obj sub3 comment "Here a constant 1 is encoded, so the channels show the gains of the direction: W = 1, Y = sin(az) cos(el), Z = sin(el), X = cos(az) cos(el)." (pos 20 70))
  (obj one sig~ 1 (pos 20 105))
  (obj caz comment "azimuth" (pos 120 90))
  (obj az number 30 (pos 120 105))
  (obj cel comment "elevation" (pos 200 90))
  (obj el number 0 (pos 200 105))
  (obj enc ambienc~ 1 30 0 (pos 20 145))
  (obj crot comment "rotate by (yaw)" (pos 280 90))
  (obj yaw number 0 (pos 280 105))
  (obj rot ambirot~ 1 (pos 20 185))
  (obj s1 snapshot~ 100 (pos 20 225))
  (obj s2 snapshot~ 100 (pos 120 225))
  (obj s3 snapshot~ 100 (pos 220 225))
  (obj s4 snapshot~ 100 (pos 320 225))
  (obj n1 flonum (pos 20 260))
  (obj n2 flonum (pos 120 260))
  (obj n3 flonum (pos 220 260))
  (obj n4 flonum (pos 320 260))
  (obj cn1 comment "W" (pos 85 261))
  (obj cn2 comment "Y" (pos 185 261))
  (obj cn3 comment "Z" (pos 285 261))
  (obj cn4 comment "X" (pos 400 261))
  (obj dec ambidec~ 1 45 135 -135 -45 (pos 20 320))
  (obj d1 snapshot~ 100 (pos 20 360))
  (obj d2 snapshot~ 100 (pos 120 360))
  (obj d3 snapshot~ 100 (pos 220 360))
  (obj d4 snapshot~ 100 (pos 320 360))
  (obj e1 flonum (pos 20 395))
  (obj e2 flonum (pos 120 395))
  (obj e3 flonum (pos 220 395))
  (obj e4 flonum (pos 320 395))
  (obj ce comment "speakers: front left, back left, back right, front right (ambidec~ 1 45 135 -135 -45)" (pos 20 420))
  (obj see comment "For sound: examples/ambisonics.moritz (four speakers) and binaural.moritz (headphones)." (pos 20 450))
  (connect one 0 enc 0)
  (connect az 0 enc 1)
  (connect el 0 enc 2)
  (connect enc 0 rot 0)
  (connect enc 1 rot 1)
  (connect enc 2 rot 2)
  (connect enc 3 rot 3)
  (connect yaw 0 rot 4)
  (connect rot 0 s1 0)
  (connect rot 1 s2 0)
  (connect rot 2 s3 0)
  (connect rot 3 s4 0)
  (connect s1 0 n1 0)
  (connect s2 0 n2 0)
  (connect s3 0 n3 0)
  (connect s4 0 n4 0)
  (connect rot 0 dec 0)
  (connect rot 1 dec 1)
  (connect rot 2 dec 2)
  (connect rot 3 dec 3)
  (connect dec 0 d1 0)
  (connect dec 1 d2 0)
  (connect dec 2 d3 0)
  (connect dec 3 d4 0)
  (connect d1 0 e1 0)
  (connect d2 0 e2 0)
  (connect d3 0 e3 0)
  (connect d4 0 e4 0))
