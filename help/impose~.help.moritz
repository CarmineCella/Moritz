; impose~.help.moritz - help for impose~ (an abstraction in the library)
(patch
  (obj title comment "impose~ [order]: the carrier (right) with the spectral envelope of the modulator (left)" (pos 20 12))
  (obj sub comment "The carrier keeps what it plays (its harmonics or its noise) and takes the colour (the formants) of the modulator: a speaking orchestra." (pos 20 34))
  (obj sub2 comment "Right inlet: the envelope's order (resolution, 60 by default). An abstraction: double-click it to see how it is made (specenv~ in pfft~)." (pos 20 52))
  (obj b1 buffer~ helpimpvox ../data/Vox.wav (pos 20 85))
  (obj b2 buffer~ helpimpbeet ../data/Beethoven_Symph7.wav (pos 240 85))
  (obj pl message "loop 1, start" (pos 20 120))
  (obj pb message "loop 1, start 36000" (pos 240 120))
  (obj v sparkle~ helpimpvox (pos 20 155))
  (obj b sparkle~ helpimpbeet (pos 240 155))
  (obj nz noise~ (pos 420 155))
  (obj nzg *~ 0.2 (pos 420 190))
  (obj c1 message 1 (pos 520 120))
  (obj c2 message 2 (pos 560 120))
  (obj cc comment "carrier: 1 Beethoven, 2 noise" (pos 600 121))
  (obj car selector~ 2 1 (pos 240 230))
  (obj imp impose~ 60 (pos 20 270))
  (obj on message "0.5 50" (pos 250 310))
  (obj off message "0 50" (pos 320 310))
  (obj ramp line~ (pos 250 345))
  (obj vca *~ (pos 20 345))
  (obj out dac~ (pos 20 385))
  (connect pl 0 v 0)
  (connect pb 0 b 0)
  (connect nz 0 nzg 0)
  (connect c1 0 car 0)
  (connect c2 0 car 0)
  (connect b 0 car 1)
  (connect nzg 0 car 2)
  (connect v 0 imp 0)
  (connect car 0 imp 1)
  (connect imp 0 vca 0)
  (connect on 0 ramp 0)
  (connect off 0 ramp 0)
  (connect ramp 0 vca 1)
  (connect vca 0 out 0)
  (connect vca 0 out 1))
