; test_load.moritz — load resolution: relative to the loading file, once per file, cycles safe.
var loads (list)
load "load/a.moritz"
assert (equal? loads (list "a" "b" "c")) "each file runs exactly once, in load order:" loads
assert (equal? (from-a) "a") "definitions from a.moritz are visible"
assert (equal? (from-b) "b+c") "definitions from b.moritz and sub/c.moritz are visible"
load "load/a.moritz"
load "load/sub/../a.moritz"
assert (== (length loads) 3) "reloading by another spelling of the same path is a no-op"
assert (>= (find (try (load "load/nope.moritz") catch e e) "not found") 0) "missing file is a clean error"
var err (try (load "load/bad.moritz") catch e e)
assert (>= (find err "bad.moritz:2") 0) "errors inside a loaded file name that file and line:" err
var err2 (try (load "load/bad.moritz") catch e e)
assert (equal? err err2) "a module that failed is not cached: loading it again reports the error again"
assert (equal? (type (try (load "load/bad.moritz") catch e 0)) "scalar") "and it still fails the third time"
print "test_load: ok"
