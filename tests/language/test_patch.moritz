; test_patch.moritz — patches as values of the language: (patch ...), (obj ...), (connect ...)
; Run with: moritz --run test_patch.moritz

load "test"

; --- a patch written as in a file -----------------------------------------------------
var p (patch
  (obj osc cycle~ 440 (pos 20 70))
  (obj amp *~ 0.25 (pos 20 110))
  (obj out dac~ (pos 20 150))
  (connect osc 0 amp 0)
  (connect amp 0 out 0)
  (connect amp 0 out 1))
check (patch? p) "patch?"
check (not (patch? 3)) "patch?: a number is not"
var boxes (patch-boxes p)
check (== (length boxes) 3) "patch-boxes: three boxes"
check (equal? (get (head boxes) 'class) "cycle~") "patch-boxes: the class"
check (equal? (get (head boxes) 'args) (list 440)) "patch-boxes: the arguments"
check (== (get (head boxes) 'y) 70) "patch-boxes: the position"
check (contains? (patch-text p) "(connect amp 0 out 1)") "patch-text: the cables"

; --- numbers as written: 2. stays a float, as in a file ------------------------------------
var q (patch (obj a + 2. (pos 0 0)) (obj b pack 0. 0 (pos 0 40)))
check (contains? (patch-text q) "(obj a + 2. ") "a float stays a float"
check (contains? (patch-text q) "(obj b pack 0. 0 ") "pack 0. 0 as written"

; --- a comma computes -----------------------------------------------------------------------
var f 330
var r (patch (obj osc cycle~ ,f (pos ,(* 2 10) 70)) (obj g gain~ ,(+ 0.5 0.25) (pos 0 0)))
check (contains? (patch-text r) "cycle~ 330 (pos 20 70)") ",x and ,(...) in arguments and positions"
check (contains? (patch-text r) "gain~ 0.75") "a computed float"
var s (patch (obj m pack ,(list 1 2 3) (pos 0 0)))
check (contains? (patch-text s) "pack 1 2 3") "a list is spliced"
var t (patch (obj c comment "two words" (pos 0 0)))
check (contains? (patch-text t) "comment \"two words\"") "strings are quoted"

; --- a loop writes the boxes ------------------------------------------------------------------
var voices (patch
  (obj mix +~ (pos 20 300))
  (obj out dac~ 1 2 (pos 20 340))
  (connect mix 0 out 0)
  (each (range 8) (function (k) {
      obj ,(concat "osc" (str k)) cycle~ ,(* 110 (+ k 1)) (pos ,(* k 90) 100)
      connect ,(concat "osc" (str k)) 0 mix 0
  })))
check (== (length (patch-boxes voices)) 10) "a loop: eight oscillators, a mix and an output"
check (contains? (patch-text voices) "(obj osc7 cycle~ 880 (pos 630 100))") "a loop: the eighth oscillator"
check (contains? (patch-text voices) "(connect osc3 0 mix 0)") "a loop: its cables"

; --- functions make patches -------------------------------------------------------------------
function voice (freq) (patch (obj o cycle~ ,freq (pos 0 0)) (obj out outlet~ (pos 0 40)) (connect o 0 out 0))
var v1 (voice 220)
var v2 (voice 440)
check (contains? (patch-text v1) "cycle~ 220") "a function makes a patch"
check (contains? (patch-text v2) "cycle~ 440") "...each time with its arguments"

; --- a patch inside a box (p) ---------------------------------------------------------------------
var outer (patch (obj sub p (pos 0 0) (patch (obj i inlet (pos 0 0)) (obj o outlet (pos 0 40)) (connect i 0 o 0))))
check (contains? (patch-text outer) "(obj sub p (pos 0 0)") "a subpatch box"
check (contains? (patch-text outer) "(connect i 0 o 0)") "...with its patch inside"

; --- errors ---------------------------------------------------------------------------------------
check (contains? (error-of (function () (patch (obj a b (pos 0 0)) (obj a c (pos 0 0))))) "two boxes") "two boxes with one id"
check (contains? (error-of (function () (obj a b))) "only inside") "obj outside a patch"
check (contains? (error-of (function () (patch (obj a b (list 1 2))))) "compute it") "a list must be computed"
check (contains? (error-of (function () (map (list 1) obj))) "a form") "obj is a form, not a function"

; --- saved and read back ------------------------------------------------------------------------------
save-patch voices "/tmp/moritz_test_voices.moritz"
var back (read-patch "/tmp/moritz_test_voices.moritz")
check (equal? (patch-text back) (patch-text voices)) "save-patch and read-patch: the same patch"

report "test_patch"
