; impose-fx.moritz - spectral patch of impose~ (run by pfft~ once per frame):
; the carrier's fine structure (its amplitudes divided by its envelope)
; times the modulator's envelope, with the carrier's phases.
(patch
  (obj c0 comment "carrier fine structure x modulator envelope, carrier phases" (pos 20 10))
  (obj m fftin~ 1 (pos 20 45))
  (obj c fftin~ 2 (pos 220 45))
  (obj order inlet (pos 420 45))
  (obj mp cartopol~ (pos 20 85))
  (obj cp cartopol~ (pos 220 85))
  (obj me specenv~ 60 (pos 20 125))
  (obj ce specenv~ 60 (pos 220 125))
  (obj x *~ (pos 20 170))
  (obj pc poltocar~ (pos 20 210))
  (obj out fftout~ 1 (pos 20 250))
  (connect m 0 mp 0)
  (connect m 1 mp 1)
  (connect c 0 cp 0)
  (connect c 1 cp 1)
  (connect mp 0 me 0)
  (connect cp 0 ce 0)
  (connect order 0 me 1)
  (connect order 0 ce 1)
  (connect me 0 x 1)
  (connect ce 1 x 0)
  (connect x 0 pc 0)
  (connect cp 1 pc 1)
  (connect pc 0 out 0))
