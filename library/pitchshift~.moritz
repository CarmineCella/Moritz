; pitchshift~.moritz - an abstraction: a live pitch shifter.
;   pitchshift~ [semitones]
; Inlets: the signal, the transposition in semitones (decimals allowed),
; formant preservation 1/0 (on at the start: a voice keeps its timbre; 0:
; the formants move with the pitch). Outlet: the transposed signal, one
; window (2048 samples) late. It is sparkle~ without a buffer~, its pitch
; ratio 2^(semitones/12), and envelope 60 for the formants.
(patch
  (obj c0 comment "pitchshift~ #1: transposes by semitones, keeping the formants" (pos 20 10))
  (obj in inlet~ (pos 20 45))
  (obj st inlet (pos 150 45))
  (obj fm inlet (pos 300 45))
  (obj lb loadbang (pos 420 45))
  (obj a1 message #1 (pos 420 80))
  (obj on message 1 (pos 490 80))
  (obj ratio expr "pow(2, $f1 / 12.)" (pos 150 120))
  (obj env expr "($i1 != 0) * 60" (pos 300 120))
  (obj envm message "envelope $1" (pos 300 155))
  (obj sp sparkle~ (pos 20 200))
  (obj out outlet~ (pos 20 240))
  (connect in 0 sp 0)
  (connect st 0 ratio 0)
  (connect ratio 0 sp 1)
  (connect fm 0 env 0)
  (connect env 0 envm 0)
  (connect envm 0 sp 0)
  (connect lb 0 a1 0)
  (connect lb 0 on 0)
  (connect a1 0 ratio 0)
  (connect on 0 env 0)
  (connect sp 0 out 0))
