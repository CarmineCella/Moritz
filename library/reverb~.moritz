; reverb~.moritz - an abstraction: a stereo Freeverb.
;   reverb~ [mix] [T60]
; Inlets: the signal; wet/dry mix, 0 (dry) to 1 (wet); decay time T60 in
; seconds (0.1 to 100). Without arguments (or with 0) mix starts at 0.3 and
; T60 at 2 s. Outlets: left, right.
;
; Per channel, eight fvcomb~ in parallel, then four allpass~ (gain 0.5) in
; series. The right channel's delays are 23 samples (at 44.1 kHz) longer
; than the left's, which decorrelates the two outputs. Each comb's feedback
; is g = 10^(-3 d / T60) for its delay d, so the tail falls by 60 dB in T60
; seconds (see fvcomb~.moritz).
(patch
  (obj c0 comment "reverb~ #1 #2: stereo Freeverb. Inlets: signal, mix 0-1, T60 (s)" (pos 20 10))
  (obj in inlet~ (pos 20 40))
  (obj mixin inlet (pos 700 40))
  (obj t60in inlet (pos 940 40))
  (obj lb loadbang (pos 820 40))
  (obj arg1 message #1 (pos 820 75))
  (obj nodef1 sel 0 (pos 820 110))
  (obj def1 message 0.3 (pos 820 145))
  (obj clip expr "min(max($f1, 0), 1)" (pos 700 185))
  (obj ramp message "$1 20" (pos 700 220))
  (obj wetg line~ (pos 700 255))
  (obj dryg expr~ "1 - $v1" (pos 840 295))
  (obj arg2 message #2 (pos 1060 75))
  (obj nodef2 sel 0 (pos 1060 110))
  (obj def2 message 2 (pos 1060 145))
  (obj tclip expr "min(max($f1, 0.1), 100)" (pos 940 185))
  (obj tsend send #0-t60 (pos 940 220))
  (obj gain *~ 0.1 (pos 20 80))
  (obj cl1 fvcomb~ 25.3061 #0 (pos 20 130))
  (obj cl2 fvcomb~ 26.9388 #0 (pos 100 130))
  (obj cl3 fvcomb~ 28.9569 #0 (pos 180 130))
  (obj cl4 fvcomb~ 30.7483 #0 (pos 260 130))
  (obj cl5 fvcomb~ 32.2449 #0 (pos 20 165))
  (obj cl6 fvcomb~ 33.8095 #0 (pos 100 165))
  (obj cl7 fvcomb~ 35.3061 #0 (pos 180 165))
  (obj cl8 fvcomb~ 36.6667 #0 (pos 260 165))
  (obj cr1 fvcomb~ 25.8277 #0 (pos 360 130))
  (obj cr2 fvcomb~ 27.4603 #0 (pos 440 130))
  (obj cr3 fvcomb~ 29.4785 #0 (pos 520 130))
  (obj cr4 fvcomb~ 31.2698 #0 (pos 600 130))
  (obj cr5 fvcomb~ 32.7664 #0 (pos 360 165))
  (obj cr6 fvcomb~ 34.3311 #0 (pos 440 165))
  (obj cr7 fvcomb~ 35.8277 #0 (pos 520 165))
  (obj cr8 fvcomb~ 37.1882 #0 (pos 600 165))
  (obj al1 allpass~ 20 12.6077 0.5 (pos 20 215))
  (obj al2 allpass~ 20 10 0.5 (pos 20 250))
  (obj al3 allpass~ 20 7.7324 0.5 (pos 20 285))
  (obj al4 allpass~ 20 5.102 0.5 (pos 20 320))
  (obj ar1 allpass~ 20 13.1293 0.5 (pos 360 215))
  (obj ar2 allpass~ 20 10.5215 0.5 (pos 360 250))
  (obj ar3 allpass~ 20 8.254 0.5 (pos 360 285))
  (obj ar4 allpass~ 20 5.6236 0.5 (pos 360 320))
  (obj wetl *~ (pos 20 370))
  (obj wetr *~ (pos 360 370))
  (obj dry *~ (pos 560 370))
  (obj mixl +~ (pos 20 410))
  (obj mixr +~ (pos 360 410))
  (obj outl outlet~ (pos 20 450))
  (obj outr outlet~ (pos 360 450))
  (connect lb 0 arg1 0)
  (connect arg1 0 nodef1 0)
  (connect nodef1 0 def1 0)
  (connect nodef1 1 clip 0)
  (connect def1 0 clip 0)
  (connect mixin 0 clip 0)
  (connect clip 0 ramp 0)
  (connect ramp 0 wetg 0)
  (connect wetg 0 dryg 0)
  (connect lb 0 arg2 0)
  (connect arg2 0 nodef2 0)
  (connect nodef2 0 def2 0)
  (connect nodef2 1 tclip 0)
  (connect def2 0 tclip 0)
  (connect t60in 0 tclip 0)
  (connect tclip 0 tsend 0)
  (connect in 0 gain 0)
  (connect gain 0 cl1 0)
  (connect gain 0 cl2 0)
  (connect gain 0 cl3 0)
  (connect gain 0 cl4 0)
  (connect gain 0 cl5 0)
  (connect gain 0 cl6 0)
  (connect gain 0 cl7 0)
  (connect gain 0 cl8 0)
  (connect cl1 0 al1 0)
  (connect cl2 0 al1 0)
  (connect cl3 0 al1 0)
  (connect cl4 0 al1 0)
  (connect cl5 0 al1 0)
  (connect cl6 0 al1 0)
  (connect cl7 0 al1 0)
  (connect cl8 0 al1 0)
  (connect al1 0 al2 0)
  (connect al2 0 al3 0)
  (connect al3 0 al4 0)
  (connect gain 0 cr1 0)
  (connect gain 0 cr2 0)
  (connect gain 0 cr3 0)
  (connect gain 0 cr4 0)
  (connect gain 0 cr5 0)
  (connect gain 0 cr6 0)
  (connect gain 0 cr7 0)
  (connect gain 0 cr8 0)
  (connect cr1 0 ar1 0)
  (connect cr2 0 ar1 0)
  (connect cr3 0 ar1 0)
  (connect cr4 0 ar1 0)
  (connect cr5 0 ar1 0)
  (connect cr6 0 ar1 0)
  (connect cr7 0 ar1 0)
  (connect cr8 0 ar1 0)
  (connect ar1 0 ar2 0)
  (connect ar2 0 ar3 0)
  (connect ar3 0 ar4 0)
  (connect al4 0 wetl 0)
  (connect ar4 0 wetr 0)
  (connect wetg 0 wetl 1)
  (connect wetg 0 wetr 1)
  (connect in 0 dry 0)
  (connect dryg 0 dry 1)
  (connect wetl 0 mixl 0)
  (connect wetr 0 mixr 0)
  (connect dry 0 mixl 1)
  (connect dry 0 mixr 1)
  (connect mixl 0 outl 0)
  (connect mixr 0 outr 0))
